<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Skip localized resource DLLs for dependencies (cs/de/es/... folders
         in publish output) — the app only needs English messages. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="HtmlSanitizer" Version="9.2.1039" />
    <PackageReference Include="MailKit" Version="4.17.0" />
    <PackageReference Include="SkiaSharp" Version="4.153.1" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="DBAccess/DBAccess.csproj" />
  </ItemGroup>

  <!-- Never publish environment-specific settings. The live server keeps its
       own appsettings.Production.json (real DB password, API key, CORS
       origins, upload folders) which ASP.NET loads on top of the blank
       appsettings.json template — so a deploy can overwrite appsettings.json
       freely and nothing needs patching afterwards. The local
       appsettings.Production.json (hosted-DB creds for migration tooling) and
       appsettings.Development.json must never reach the server either. -->
  <!-- User uploads are runtime data, not part of the app: keep them out of
       the build's static-asset manifest (a deleted upload otherwise breaks the
       build) and out of every publish (local test files must never reach the
       live server). Live uploads live outside the site (Uploads:Path). -->
  <ItemGroup>
    <Content Remove="wwwroot\Uploads\**" />
    <None Remove="wwwroot\Uploads\**" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="appsettings.Production.json;appsettings.Development.json">
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <!-- DBAccess now lives inside this project's own folder (moved here so a
       deploy host whose build root is pinned to Web_Backend/ can still see
       it — see ENVIRONMENTS.md). The SDK's default **/*.cs glob would
       otherwise compile its two source files a second time directly into
       this project (on top of the ProjectReference above), producing two
       separate IDBAccess/MSSQLDataAccess type identities (CS0436). -->
  <ItemGroup>
    <Compile Remove="DBAccess/**/*.cs" />
  </ItemGroup>

  <!-- On every publish, regenerate Database/generated/pending-migrations.sql
       (the not-yet-applied files under Database/migrations, concatenated) so
       there's always a single script ready to hand-run against the hosted DB
       after uploading the publish output. Reads hosted DB creds straight out
       of appsettings.Production.json — never duplicated into this file.

       Skipped unless that file is actually present: the hosted container
       build clones only the repo (appsettings.Production.json is gitignored)
       and has no pwsh, so there the Exec could only ever fail — it logged
       MSB3073 "pwsh: not found" on every deploy. -->
  <Target Name="GeneratePendingMigrations" AfterTargets="Publish" Condition="Exists('$(ProjectDir)appsettings.Production.json')">
    <Exec Command="pwsh -NoProfile -File &quot;$(ProjectDir)..\Database\tools\generate-pending-from-appsettings.ps1&quot; -AppSettingsPath &quot;$(ProjectDir)appsettings.Production.json&quot;" ContinueOnError="WarnAndContinue" />
  </Target>

</Project>
