<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Skip localized resource DLLs for dependencies (cs/de/es/... folders
         in publish output) — the app only needs English messages. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MailKit" Version="4.17.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DBAccess\DBAccess.csproj" />
  </ItemGroup>

  <!-- On every publish, regenerate Database/generated/pending-migrations.sql
       (the not-yet-applied files under Database/migrations, concatenated) so
       there's always a single script ready to hand-run against the hosted DB
       after uploading the publish output. Reads hosted DB creds straight out
       of appsettings.Production.json — never duplicated into this file. -->
  <Target Name="GeneratePendingMigrations" AfterTargets="Publish">
    <Exec Command="pwsh -NoProfile -File &quot;$(ProjectDir)..\Database\tools\generate-pending-from-appsettings.ps1&quot; -AppSettingsPath &quot;$(ProjectDir)appsettings.Production.json&quot;"
          ContinueOnError="WarnAndContinue" />
  </Target>

</Project>
