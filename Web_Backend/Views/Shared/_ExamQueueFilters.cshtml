@*
    Filter bar for the exam grading/review queues (Lecturer ExamReview,
    Admin ExamGrading). GET form so filters live in the URL (shareable,
    survive refresh). Data from Classes/ExamQueueFilter.ExamQueueView.
*@
@{
    var f = ViewBag.QueueFilter as Web_Backend.Classes.ExamQueueFilter ?? new();
    var exams = ViewBag.ExamOptions as List<(string, string)> ?? new();
    var batches = ViewBag.BatchOptions as List<(string ScheduleID, string Name)> ?? new();
    var initialTab = ViewBag.InitialTab as string ?? "grading";
    const string Input = "w-full px-3 py-2 rounded-xl border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-800 text-sm text-slate-700 dark:text-slate-200 focus:outline-none focus:ring-2 focus:ring-[#7c3aed]/30 focus:border-[#7c3aed]";
}
<form method="get" id="exam-queue-filters" class="bg-white dark:bg-slate-900/60 rounded-[24px] shadow-sm border border-slate-100 dark:border-slate-700 p-4 md:p-5">
    <input type="hidden" name="tab" id="exam-queue-tab" value="@initialTab" />
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-6 gap-3 items-end">
        <div class="lg:col-span-2">
            <label class="block text-xs font-medium text-slate-500 dark:text-slate-400 mb-1">Student</label>
            <div class="relative">
                <i data-lucide="search" class="w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-slate-400"></i>
                <input type="search" name="Q" value="@f.Q" placeholder="Name or email" class="@Input pl-9" />
            </div>
        </div>
        <div>
            <label class="block text-xs font-medium text-slate-500 dark:text-slate-400 mb-1">Exam</label>
            <select name="ExamID" class="@Input">
                <option value="">All exams</option>
                @foreach (var (id, title) in exams)
                {
                    <option value="@id" selected="@(f.ExamID == id)">@title</option>
                }
            </select>
        </div>
        <div>
            <label class="block text-xs font-medium text-slate-500 dark:text-slate-400 mb-1">Batch</label>
            <select name="BatchID" class="@Input">
                <option value="">All batches</option>
                @foreach (var b in batches)
                {
                    <option value="@b.ScheduleID" selected="@(f.BatchID == b.ScheduleID)">@b.Name</option>
                }
            </select>
        </div>
        <div>
            <label class="block text-xs font-medium text-slate-500 dark:text-slate-400 mb-1">Submitted from</label>
            <input type="date" name="From" value="@(f.From?.ToString("yyyy-MM-dd"))" class="@Input" />
        </div>
        <div>
            <label class="block text-xs font-medium text-slate-500 dark:text-slate-400 mb-1">Submitted to</label>
            <input type="date" name="To" value="@(f.To?.ToString("yyyy-MM-dd"))" class="@Input" />
        </div>
    </div>
    <div class="flex flex-wrap items-center gap-3 mt-3">
        <label class="inline-flex items-center gap-2 text-sm text-slate-600 dark:text-slate-300 cursor-pointer select-none">
            <input type="checkbox" name="StrikesOnly" value="true" @(f.StrikesOnly ? "checked" : "") class="w-4 h-4 accent-[#7c3aed]" />
            Only attempts with strikes
        </label>
        <div class="ml-auto flex items-center gap-2">
            @if (f.IsActive)
            {
                <a href="?tab=@initialTab" class="px-4 py-2 rounded-xl text-sm font-medium text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors">Clear filters</a>
            }
            <button type="submit" class="inline-flex items-center gap-2 px-4 py-2 rounded-xl text-sm font-medium bg-[#7c3aed] text-white hover:bg-[#6d28d9] shadow-sm transition-colors">
                <i data-lucide="filter" class="w-4 h-4"></i> Apply
            </button>
        </div>
    </div>
    @if (f.IsActive)
    {
        <p class="mt-3 text-xs text-[#7c3aed] dark:text-purple-300 font-medium">
            Filtered: grading @ViewBag.FilteredGrading of @ViewBag.GradingTotal &middot; review @ViewBag.FilteredReview of @ViewBag.ReviewTotal
        </p>
    }
</form>
<script>
    // Keep the active tab when filtering (tabs switch client-side).
    document.addEventListener('click', e => {
        const t = e.target.closest('[data-tab]');
        if (t && t.dataset.tab) document.getElementById('exam-queue-tab').value = t.dataset.tab;
    });
    // Selects and the checkbox apply straight away.
    document.querySelectorAll('#exam-queue-filters select, #exam-queue-filters input[type=checkbox], #exam-queue-filters input[type=date]')
        .forEach(el => el.addEventListener('change', () => el.form.submit()));
</script>
