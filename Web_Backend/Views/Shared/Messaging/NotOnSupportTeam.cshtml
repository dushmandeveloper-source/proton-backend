@{
    // Shown to Admin-portal staff who open Messages but aren't on the
    // Support Team (msg.SupportHandler) — see MessagesControllerBase.Index.
}
<div class="max-w-lg mx-auto mt-10 text-center bg-white dark:bg-slate-900 rounded-3xl border border-slate-100 dark:border-slate-700 p-8">
    <div class="w-16 h-16 mx-auto mb-4 rounded-2xl bg-violet-50 dark:bg-violet-950 text-violet-600 dark:text-violet-300 flex items-center justify-center">
        <i data-lucide="messages-square" class="w-8 h-8"></i>
    </div>
    <h1 class="text-xl font-semibold text-slate-800 dark:text-slate-100">You're not on the Support Team yet</h1>
    <p class="text-sm text-slate-500 dark:text-slate-400 mt-2">
        Student messages to <b>Proton Support</b> go to a shared inbox that only Support Team members can read and reply to.
        Ask your Master Admin to add you under <b>Messages → Support Team</b>.
    </p>
    <a href="/Admin/Dashboard/Index" class="inline-block mt-6 px-4 py-2 rounded-xl text-sm font-medium bg-[#7c3aed] text-white hover:bg-[#6d28d9]">Back to dashboard</a>
</div>
