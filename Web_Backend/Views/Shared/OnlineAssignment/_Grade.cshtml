@model List<Web_Backend.Areas.Admin.Models.ExamAttemptAnswer>
@using Web_Backend.Areas.Admin.Models
@*
    Mark one online-assignment submission (Admin + Lecturer). Written answers
    get a marks box; MCQs are auto-marked. "Approve & release" shows the marks
    and answers to the student and notifies them. Back goes to this
    assignment's Submissions page, never the exam queues.
*@
@{
    var attempt = (ExamAttempt)ViewBag.Attempt;
    var exam = (Exam)ViewBag.Exam;
    var canEdit = ViewBag.CanEdit as bool? ?? false;
    var optionsByQuestion = ViewBag.OptionsByQuestion as Dictionary<string, List<ExamQuestionOption>> ?? new();
    var released = attempt.ResultReleasedDate.HasValue;
    var ungraded = Model.Count(a => !a.IsMCQ && !a.MarksAwarded.HasValue);
    var awarded = attempt.TotalMarksAwarded ?? 0;
    var pct = attempt.TotalMarks > 0 ? Math.Round(awarded / attempt.TotalMarks * 100) : 0;
    var passMark = exam.PassingPercentage ?? 0;
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.18.4/dist/katex.min.css" integrity="sha384-u1zONI5gPXUx0UKI62c75/zww972y0v2rSK5ZYlVdS6xEuWDeZWUI66v6t1gvlXJ" crossorigin="anonymous">
<script defer src="https://cdn.jsdelivr.net/npm/katex@0.18.4/dist/katex.min.js" integrity="sha384-ykMNcWQhhTUb0YV9SPpPUFURHZ+tWmubkakGBP+OgNK/UXdO2gtzglWx0Rj9hnO3" crossorigin="anonymous"></script>
<script defer src="https://cdn.jsdelivr.net/npm/katex@0.18.4/dist/contrib/mhchem.min.js" integrity="sha384-fB8BH//9nBzROkMUsu/Dr35jWHIbnKesUo9rW0hfEgw8mZGnkAyBAjKX9F98OVuo" crossorigin="anonymous"></script>
<script defer src="~/js/exam-math.js" asp-append-version="true"></script>

<div class="max-w-4xl mx-auto page-enter space-y-6">
    <a href="@Url.Action("Results", new { id = exam.ExamID })" class="text-sm text-slate-500 dark:text-slate-400 hover:text-[#7c3aed] inline-flex items-center gap-1">
        <i data-lucide="arrow-left" class="w-4 h-4"></i> Back to submissions &middot; @exam.ExamTitle
    </a>

    @if (!string.IsNullOrEmpty(ViewBag.MarkerNote as string))
    {
        <div class="rounded-2xl border border-sky-100 dark:border-sky-900 bg-sky-50 dark:bg-sky-950/40 p-4 flex items-center gap-3 text-sm text-sky-800 dark:text-sky-200">
            <i data-lucide="info" class="w-5 h-5 flex-shrink-0"></i> @ViewBag.MarkerNote You can view it.
        </div>
    }

    <div class="bg-white dark:bg-slate-900/60 rounded-[24px] shadow-sm border border-slate-100 dark:border-slate-700 p-6">
        <div class="flex items-start justify-between gap-4 flex-wrap">
            <div class="min-w-0">
                <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full text-[10px] font-semibold uppercase tracking-wide bg-purple-50 dark:bg-purple-950 text-[#7c3aed] dark:text-purple-300">
                    <i data-lucide="notebook-pen" class="w-3 h-3"></i> Online assignment
                </span>
                <h2 class="text-2xl font-bold text-slate-800 dark:text-slate-100 tracking-tight mt-1.5">@attempt.StudentName</h2>
                <p class="text-sm text-slate-500 dark:text-slate-400">@exam.ExamTitle &middot; submitted @attempt.SubmittedDate?.ToString("dd MMM, hh:mm tt")</p>
            </div>
            <div class="text-right">
                <p class="text-3xl font-bold text-[#7c3aed] dark:text-[#a78bfa]">@awarded.ToString("0.##")<span class="text-base text-slate-400"> / @attempt.TotalMarks.ToString("0.##")</span></p>
                <p class="text-xs text-slate-500 mt-1">@pct% &middot; pass mark @passMark.ToString("0.##")%</p>
            </div>
        </div>

        <div class="mt-5 pt-5 border-t border-slate-100 dark:border-slate-700 flex items-center justify-between gap-3 flex-wrap">
            @if (released)
            {
                <p class="text-sm text-emerald-700 dark:text-emerald-300 inline-flex items-center gap-2"><i data-lucide="check-circle-2" class="w-4 h-4"></i> Released @attempt.ResultReleasedDate?.ToString("dd MMM yyyy, hh:mm tt") — the student can see their marks and answers.</p>
            }
            else if (attempt.IsInProgress)
            {
                <p class="text-sm text-amber-700 dark:text-amber-300 inline-flex items-center gap-2"><i data-lucide="clock" class="w-4 h-4"></i> The student is still working on this.</p>
            }
            else if (ungraded > 0)
            {
                <p class="text-sm text-slate-600 dark:text-slate-300 inline-flex items-center gap-2"><i data-lucide="pencil" class="w-4 h-4 text-amber-500"></i> Give marks for @ungraded written answer@(ungraded == 1 ? "" : "s") below, then release.</p>
            }
            else
            {
                <p class="text-sm text-slate-600 dark:text-slate-300 inline-flex items-center gap-2"><i data-lucide="check" class="w-4 h-4 text-emerald-500"></i> All answers are marked. Check them, then release.</p>
            }

            @if (canEdit && !released && !attempt.IsInProgress)
            {
                <form method="post" action="@Url.Action("Release")" onsubmit="return confirm('Release these marks to @attempt.StudentName? They will be notified and can see their answers.');">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="attemptId" value="@attempt.AttemptID" />
                    <button type="submit" @(ungraded > 0 ? "disabled" : "") title="@(ungraded > 0 ? "Mark every written answer first" : "")"
                            class="px-5 py-2.5 rounded-xl font-medium text-sm bg-[#7c3aed] text-white hover:bg-[#6d28d9] shadow-sm disabled:opacity-40 disabled:cursor-not-allowed inline-flex items-center gap-2">
                        <i data-lucide="send" class="w-4 h-4"></i> Approve &amp; release
                    </button>
                </form>
            }
        </div>
    </div>

    <div class="space-y-4">
        @for (var i = 0; i < Model.Count; i++)
        {
            var ans = Model[i];
            <div class="bg-white dark:bg-slate-900/60 rounded-[24px] shadow-sm border @(!ans.IsMCQ && !ans.MarksAwarded.HasValue && !attempt.IsInProgress ? "border-amber-200 dark:border-amber-800" : "border-slate-100 dark:border-slate-700") p-6">
                <div class="flex items-start justify-between gap-4 mb-4">
                    <div class="flex items-start gap-3 min-w-0">
                        <span class="flex-shrink-0 w-7 h-7 rounded-full bg-[#ede7fc] dark:bg-slate-700 text-[#7c3aed] dark:text-[#a78bfa] text-xs font-semibold flex items-center justify-center mt-0.5">@(i + 1)</span>
                        <div class="min-w-0 flex-1">
                            <div class="katex-render text-slate-800 dark:text-slate-100 font-medium leading-relaxed" data-latex="@ans.QuestionTextLatex">@ans.QuestionTextLatex</div>
                            @if (!string.IsNullOrEmpty(ans.ImageURL))
                            {
                                <img src="@ans.ImageURL" alt="Question @(i + 1) figure" loading="lazy" decoding="async" class="block max-w-full sm:max-w-md h-auto mt-3 rounded-xl border border-slate-100 dark:border-slate-700 bg-white p-2" />
                            }
                        </div>
                    </div>
                    <span class="flex-shrink-0 text-xs font-medium text-slate-500 dark:text-slate-400 bg-slate-50 dark:bg-slate-800 border border-slate-100 dark:border-slate-700 rounded-full px-3 py-1 whitespace-nowrap">@(ans.IsMCQ ? "MCQ" : "Written") &middot; @ans.Marks.ToString("0.##") marks</span>
                </div>

                @if (ans.IsMCQ)
                {
                    <partial name="~/Views/Shared/_McqAnswerReview.cshtml" model="ans"
                             view-data='new ViewDataDictionary(ViewData) { ["Options"] = optionsByQuestion.GetValueOrDefault(ans.QuestionID) }' />
                }
                else
                {
                    <div class="ml-10 space-y-3">
                        <div class="rounded-xl bg-slate-50 dark:bg-slate-800 border border-slate-100 dark:border-slate-700 p-4">
                            <p class="text-xs text-slate-500 dark:text-slate-400 mb-1">Student's answer</p>
                            <p class="text-sm text-slate-700 dark:text-slate-200 whitespace-pre-wrap leading-relaxed">@(string.IsNullOrEmpty(ans.WrittenAnswerText) ? "(no answer)" : ans.WrittenAnswerText)</p>
                        </div>
                        @if (canEdit && !released && !attempt.IsInProgress)
                        {
                            <form method="post" action="@Url.Action("SaveGrade")" class="flex items-center gap-2 flex-wrap">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="attemptId" value="@attempt.AttemptID" />
                                <input type="hidden" name="questionId" value="@ans.QuestionID" />
                                <label for="m-@ans.QuestionID" class="text-xs text-slate-500 dark:text-slate-400">Marks</label>
                                <input id="m-@ans.QuestionID" type="number" step="0.5" name="marksAwarded" value="@ans.MarksAwarded" max="@ans.Marks" min="0" required
                                       class="w-24 px-3 py-1.5 rounded-xl border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-800 text-sm focus:outline-none focus:ring-2 focus:ring-[#7c3aed]/40" />
                                <span class="text-xs text-slate-400">/ @ans.Marks.ToString("0.##")</span>
                                <button type="submit" class="px-3 py-1.5 rounded-xl font-medium bg-[#7c3aed] text-white hover:bg-[#6d28d9] shadow-sm text-xs">@(ans.MarksAwarded.HasValue ? "Update" : "Save marks")</button>
                                @if (ans.MarksAwarded.HasValue)
                                {
                                    <span class="text-xs text-emerald-600 dark:text-emerald-400 inline-flex items-center gap-1"><i data-lucide="check" class="w-3.5 h-3.5"></i> Saved</span>
                                }
                            </form>
                        }
                        else
                        {
                            <p class="text-sm font-medium text-slate-600 dark:text-slate-300">Marks: <span class="text-[#7c3aed] dark:text-[#a78bfa]">@(ans.MarksAwarded?.ToString("0.##") ?? "-")</span> / @ans.Marks.ToString("0.##")</p>
                        }
                    </div>
                }
            </div>
        }
    </div>
</div>
