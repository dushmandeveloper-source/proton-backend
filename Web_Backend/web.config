<?xml version="1.0" encoding="utf-8"?>
<!--
  Source template for the publish-time web.config (SDK merges in the
  aspNetCore handler/module block automatically at `dotnet publish`).

  Deviation from the Lecturer Portal plan's assumption: the plan noted "no
  IIS integration was found in Program.cs/.csproj so far, so the per-action
  [RequestSizeLimit]/[RequestFormLimits] attribute alone is likely
  sufficient" and flagged this for verification at implementation time.
  Verification found generated web.config files with hostingModel="inprocess"
  under Web_Backend/publish and Web_Backend/bin/*/publish from prior publish
  runs, meaning this app IS published behind IIS with the ASP.NET Core
  Module (in-process hosting). Under that model, IIS's own
  requestLimits/maxAllowedContentLength (default about 30 MB) sits in front
  of Kestrel and rejects any request body over that limit before the
  [RequestSizeLimit] attribute on NotesController.Upload or
  LectureNoteController.Upload ever gets a chance to run, so the 100 MB
  lecture-material uploads (Section F) would silently fail with a 404.13 in
  production, even though local Kestrel-only dev testing (`dotnet run`)
  would never surface the problem.

  110,000,000 bytes matches the [RequestFormLimits(MultipartBodyLengthLimit)]
  and [RequestSizeLimit] values already used on the upload actions.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\Web_Backend.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" />
      <security>
        <requestFiltering>
          <requestLimits maxAllowedContentLength="110000000" />
        </requestFiltering>
      </security>
    </system.webServer>
  </location>
</configuration>
