@model List<AgentDocumentView>
@{
    ViewData["Title"] = "Documents";
}

<div class="max-w-4xl mx-auto page-enter">
    <div class="mb-6">
        <h2 class="text-3xl font-bold text-slate-800 dark:text-slate-100 tracking-tight">Documents</h2>
        <p class="text-slate-500 dark:text-slate-400 mt-2">Files shared with you by Proton. You can view these here, but they can't be downloaded.</p>
    </div>

    <div class="bg-white dark:bg-slate-900/60 rounded-[24px] shadow-sm border border-slate-100 dark:border-slate-700 overflow-hidden">
        @if (!Model.Any())
        {
            <div class="p-12 text-center">
                <p class="text-sm text-slate-400 dark:text-slate-500">No documents have been shared with you yet.</p>
            </div>
        }
        else
        {
            <div class="divide-y divide-slate-50 dark:divide-slate-800">
                @foreach (var d in Model)
                {
                    <a asp-action="Preview" asp-route-id="@d.DocumentID" class="flex items-center gap-4 px-6 py-4 hover:bg-slate-50/60 dark:hover:bg-slate-800/60 transition-colors">
                        <div class="w-10 h-10 rounded-xl bg-red-50 dark:bg-red-950 flex items-center justify-center text-[#dc2626] dark:text-red-300 flex-shrink-0">
                            <i data-lucide="@(d.IsImage ? "image" : "file-text")" class="w-5 h-5"></i>
                        </div>
                        <div class="flex-1 min-w-0">
                            <p class="text-sm font-medium text-slate-800 dark:text-slate-100 truncate">@d.Title</p>
                            <p class="text-xs text-slate-500 dark:text-slate-400 truncate">@(string.IsNullOrEmpty(d.Description) ? d.OriginalFileName : d.Description)</p>
                        </div>
                        <span class="text-xs text-slate-400 dark:text-slate-500 flex-shrink-0">@d.FileSizeLabel</span>
                        <i data-lucide="eye" class="w-4 h-4 text-slate-400 dark:text-slate-500 flex-shrink-0"></i>
                    </a>
                }
            </div>
        }
    </div>
</div>
