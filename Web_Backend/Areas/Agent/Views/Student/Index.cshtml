@model List<Student>
@{
    ViewData["Title"] = "My Students";
    var keyW = ViewBag.KeyW as string ?? "";
    var showInactive = ViewBag.ShowInactive as bool? ?? false;
}

<div class="page-enter">
    <div class="flex flex-col md:flex-row md:items-center justify-between mb-6 gap-4">
        <div>
            <h2 class="text-2xl font-bold text-slate-800 dark:text-slate-100 tracking-tight">My Students</h2>
            <p class="text-slate-500 dark:text-slate-400 mt-1 text-sm">Students you've registered. You can't see other agents' students.</p>
        </div>
        <a asp-action="Add" class="px-4 py-2 rounded-xl font-medium bg-[#dc2626] text-white hover:bg-[#b91c1c] shadow-sm text-sm flex items-center gap-2 w-fit">
            <i data-lucide="plus" class="w-4 h-4"></i> Register Student
        </a>
    </div>

    <form method="get" class="flex flex-wrap items-center gap-3 mb-6">
        <div class="relative w-full md:w-auto">
            <i data-lucide="search" class="w-4 h-4 text-slate-400 dark:text-slate-500 absolute left-3 top-1/2 -translate-y-1/2"></i>
            <input type="text" name="KeyW" value="@keyW" placeholder="Search name, email or passport no..."
                   class="w-full md:w-72 pl-9 pr-4 py-2 rounded-xl border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-800 text-slate-800 dark:text-slate-100 text-sm focus:outline-none focus:border-red-400 focus:ring-1 focus:ring-red-400" />
        </div>
        <label class="flex items-center gap-2 text-sm text-slate-600 dark:text-slate-300 cursor-pointer">
            <input type="checkbox" name="showInactive" value="true" checked="@showInactive"
                   class="rounded border-slate-300 dark:border-slate-600 text-[#dc2626] focus:ring-[#dc2626]" />
            Show inactive
        </label>
        <button type="submit" class="px-4 py-2 rounded-xl font-medium bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-200 border border-slate-200 dark:border-slate-600 hover:bg-slate-50 dark:hover:bg-slate-700 transition-all text-sm">Filter</button>
    </form>

    <div class="bg-white dark:bg-slate-900/60 rounded-[24px] shadow-sm border border-slate-100 dark:border-slate-700 overflow-hidden">
        @if (!Model.Any())
        {
            <div class="p-12 text-center">
                <p class="text-sm text-slate-400 dark:text-slate-500">You haven't registered any students yet.</p>
            </div>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="w-full text-sm">
                    <thead>
                        <tr class="text-left text-xs text-slate-400 dark:text-slate-500 uppercase tracking-wide border-b border-slate-100 dark:border-slate-700">
                            <th class="px-6 py-3 font-medium">Student</th>
                            <th class="px-6 py-3 font-medium">Email</th>
                            <th class="px-6 py-3 font-medium">Phone</th>
                            <th class="px-6 py-3 font-medium">Registered</th>
                            <th class="px-6 py-3 font-medium">Status</th>
                            <th class="px-6 py-3 font-medium"></th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 dark:divide-slate-700">
                        @foreach (var s in Model)
                        {
                            <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/60 transition-colors">
                                <td class="px-6 py-3">
                                    <div class="flex items-center gap-3">
                                        <div class="w-8 h-8 rounded-full bg-purple-50 dark:bg-purple-950 flex items-center justify-center text-[#7c3aed] dark:text-purple-300 font-semibold text-xs flex-shrink-0">
                                            @(s.FirstName.Length > 0 ? s.FirstName[0].ToString().ToUpper() : "?")
                                        </div>
                                        <span class="font-medium text-slate-800 dark:text-slate-100">@s.FullName</span>
                                    </div>
                                </td>
                                <td class="px-6 py-3 text-slate-600 dark:text-slate-300">@s.Email</td>
                                <td class="px-6 py-3 text-slate-600 dark:text-slate-300">@s.Phone</td>
                                <td class="px-6 py-3 text-slate-500 dark:text-slate-400">@s.CreatedDate.ToString("MMM d, yyyy")</td>
                                <td class="px-6 py-3">
                                    <span class="px-2 py-0.5 rounded-full text-xs font-medium @(s.IsActive == "A" ? "bg-emerald-50 dark:bg-emerald-950 text-emerald-700 dark:text-emerald-300" : "bg-slate-100 dark:bg-slate-800 text-slate-500 dark:text-slate-400")">
                                        @s.StatusLabel
                                    </span>
                                </td>
                                <td class="px-6 py-3 text-right">
                                    <div class="flex items-center justify-end gap-2">
                                        <a asp-action="Details" asp-route-id="@s.StudentID" class="p-2 rounded-lg text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-700" title="View">
                                            <i data-lucide="eye" class="w-4 h-4"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@s.StudentID" class="p-2 rounded-lg text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-700" title="Edit">
                                            <i data-lucide="pencil" class="w-4 h-4"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
