@using Web_Backend.Areas.Admin.Models
@model List<ExamAttempt>
@{
    ViewData["Title"] = "Live Exam Viewing";
}

<div class="max-w-7xl mx-auto page-enter space-y-4">
    <div class="flex items-center justify-between flex-wrap gap-3">
        <div>
            <h1 class="text-xl font-bold text-slate-800 dark:text-slate-100 flex items-center gap-2">
                <i data-lucide="monitor" class="w-5 h-5 text-slate-400 dark:text-slate-500"></i>
                Live Exam Viewing
            </h1>
            <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">
                Students currently taking an exam you're assigned to. A tile only shows video if the
                student opted in to live viewing.
            </p>
        </div>
        <span id="liveCount" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-semibold uppercase tracking-wide bg-slate-900 text-emerald-400">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
            @((ViewBag.OnlineIds as HashSet<string>)?.Count ?? 0) live now
        </span>
    </div>

    @* Both always rendered: the page polls itself and adds/removes tiles live. *@
    <div id="watchEmpty" class="@(Model.Any() ? "hidden " : "")rounded-[24px] border-2 border-dashed border-slate-200 dark:border-slate-700 p-16 text-center">
        <i data-lucide="video-off" class="w-10 h-10 text-slate-300 dark:text-slate-600 mx-auto mb-3"></i>
        <p class="text-sm text-slate-400 dark:text-slate-500">No exams currently in progress.</p>
        <p class="text-xs text-slate-400 dark:text-slate-500 mt-1">Students appear here automatically when they start.</p>
    </div>
        <div id="watchGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
            @{ var onlineIds = ViewBag.OnlineIds as HashSet<string> ?? new HashSet<string>(); }
            @foreach (var a in Model)
            {
                var online = onlineIds.Contains(a.AttemptID);
                <div class="watch-tile group relative rounded-2xl overflow-hidden bg-slate-950 border border-slate-800 shadow-lg shadow-black/30 cursor-pointer transition-all hover:ring-2 hover:ring-[#7c3aed] hover:-translate-y-0.5 @(online ? "" : "opacity-60")"
                     data-attempt-id="@a.AttemptID" data-student-name="@a.StudentName" data-exam-title="@a.ExamTitle" data-online="@(online ? "1" : "0")">
                    <div class="relative aspect-video bg-slate-900 flex items-center justify-center">
                        <video class="tile-video w-full h-full object-cover hidden" autoplay playsinline muted></video>
                        <div class="tile-placeholder flex flex-col items-center gap-2 text-slate-600">
                            <i data-lucide="user-round" class="w-8 h-8"></i>
                            <span class="text-[10px] uppercase tracking-wider">No feed</span>
                        </div>

                        <span class="tile-status absolute top-2 left-2">
                            @if (online)
                            {
                                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-semibold uppercase tracking-wide bg-black/60 backdrop-blur-sm text-emerald-400">
                                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span> Live
                                </span>
                            }
                            else
                            {
                                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-semibold uppercase tracking-wide bg-black/60 backdrop-blur-sm text-amber-300" title="The exam page is closed. The attempt stays open until its timer runs out.">
                                    <span class="w-1.5 h-1.5 rounded-full bg-amber-300"></span> Left exam page
                                </span>
                            }
                        </span>

                        @if (a.StrikeCount > 0)
                        {
                            <span class="absolute top-2 right-2 inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-semibold bg-red-600/90 backdrop-blur-sm text-white">
                                <i data-lucide="alert-octagon" class="w-3 h-3"></i> @a.StrikeCount
                            </span>
                        }

                        <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity flex items-end justify-center pb-3">
                            <span class="text-white text-xs font-medium flex items-center gap-1.5">
                                <i data-lucide="maximize-2" class="w-3.5 h-3.5"></i> Click to focus
                            </span>
                        </div>
                    </div>
                    <div class="px-3 py-2.5 bg-slate-900 flex items-center gap-2">
                        <div class="min-w-0 flex-1">
                            <p class="text-sm font-semibold text-slate-100 truncate">@a.StudentName</p>
                            <p class="text-xs text-slate-400 truncate">@a.ExamTitle</p>
                        </div>
                        <button type="button" class="end-exam-btn flex-shrink-0 inline-flex items-center gap-1 px-2.5 py-1.5 rounded-lg text-[11px] font-semibold text-red-300 bg-red-500/10 hover:bg-red-500/20 focus:outline-none focus:ring-2 focus:ring-red-400/50 transition-colors"
                                title="Stop this exam and send it to review">
                            <i data-lucide="square" class="w-3 h-3"></i> End exam
                        </button>
                    </div>
                </div>
            }
        </div>
</div>

@* ---------- Focused/expanded view: Zoom-style call layout -- the
   student's SCREEN-SHARE is the big, centered main stage (what a lecturer
   actually needs to watch closely for proctoring); their camera is a
   smaller floating self-view-style tile in the corner, just to confirm
   the student is present. ---------- *@
<div id="focusOverlay" class="hidden fixed inset-0 z-[100] bg-black flex flex-col">
    <div class="flex items-center justify-between px-6 py-3 bg-slate-950/90 backdrop-blur-sm border-b border-slate-800 flex-shrink-0 gap-4">
        <div class="flex items-center gap-3 flex-shrink-0">
            <span id="focusLiveBadge" class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[10px] font-semibold uppercase tracking-wide bg-red-600/90 text-white">
                <span class="w-1.5 h-1.5 rounded-full bg-white animate-pulse"></span> Live
            </span>
            <div>
                <p id="focusStudentName" class="text-white font-semibold text-sm"></p>
                <p id="focusExamTitle" class="text-slate-400 text-xs"></p>
            </div>
        </div>

        @* Always-available student switcher -- lets the lecturer shift to
           any other in-progress student at any time, without first closing
           the focused view. *@
        <div id="focusSwitcher" class="flex items-center gap-2 overflow-x-auto flex-1 justify-center">
            @foreach (var a in Model)
            {
                <button type="button" class="switcher-btn flex-shrink-0 px-3 py-1.5 rounded-full text-xs font-medium bg-white/10 text-slate-200 hover:bg-white/20 transition-colors whitespace-nowrap"
                        data-attempt-id="@a.AttemptID" data-student-name="@a.StudentName" data-exam-title="@a.ExamTitle">
                    @a.StudentName
                </button>
            }
        </div>

        <button type="button" id="focusCloseBtn" class="p-2.5 rounded-full bg-white/10 hover:bg-white/20 text-white transition-colors flex-shrink-0">
            <i data-lucide="x" class="w-5 h-5"></i>
        </button>
    </div>

    <div class="relative flex-1 min-h-0 bg-slate-950 flex items-center justify-center p-2 md:p-3">
        @* Big centered screen-share stage -- uses nearly the full available
           area (no max-width cap) since the actual exam content needs to be
           readable, not just visible. *@
        <div class="relative w-full h-full rounded-2xl overflow-hidden bg-slate-900 flex items-center justify-center">
            <video id="focusScreenVideo" class="w-full h-full object-contain hidden" autoplay playsinline></video>
            <div id="focusScreenPlaceholder" class="flex flex-col items-center gap-2 text-slate-600">
                <i data-lucide="monitor" class="w-10 h-10"></i>
                <span class="text-xs uppercase tracking-wider">No screen feed</span>
            </div>
            <span class="absolute top-3 left-3 inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-semibold uppercase tracking-wide bg-black/60 backdrop-blur-sm text-slate-200">
                <i data-lucide="monitor" class="w-3 h-3"></i> Screen
            </span>
        </div>

        @* Small floating camera tile, bottom-right -- Zoom-style
           self-view/secondary-feed placement. *@
        <div class="absolute bottom-6 right-6 md:bottom-10 md:right-10 w-48 md:w-64 aspect-video rounded-xl overflow-hidden border-2 border-slate-700 shadow-2xl bg-slate-900">
            <video id="focusCameraVideo" class="w-full h-full object-cover hidden" autoplay playsinline></video>
            <div id="focusCameraPlaceholder" class="w-full h-full flex flex-col items-center justify-center gap-1.5 text-slate-600">
                <i data-lucide="camera" class="w-6 h-6"></i>
                <span class="text-[10px] uppercase tracking-wider">No camera feed</span>
            </div>
            <span class="absolute bottom-1.5 left-1.5 inline-flex items-center gap-1 px-1.5 py-0.5 rounded-full text-[9px] font-semibold uppercase tracking-wide bg-black/60 text-white">
                <i data-lucide="camera" class="w-2.5 h-2.5"></i> Camera
            </span>
        </div>

        <div id="focusPlaceholder" class="hidden absolute inset-0 bg-slate-950 flex flex-col items-center justify-center gap-3 text-slate-600">
            <i data-lucide="loader-circle" class="w-10 h-10 animate-spin"></i>
            <span class="text-sm">Connecting…</span>
        </div>
    </div>
</div>

@* ---------- Confirm: end a student's exam ---------- *@
<div id="endExamModal" class="hidden fixed inset-0 z-[110] flex items-end sm:items-center justify-center p-4 bg-slate-900/60 backdrop-blur-sm" role="dialog" aria-modal="true" aria-labelledby="endExamTitle">
    <div class="w-full max-w-md bg-white dark:bg-slate-900 rounded-[24px] shadow-2xl border border-slate-100 dark:border-slate-700 p-6">
        @Html.AntiForgeryToken()
        <div class="flex items-start gap-3 mb-4">
            <span class="flex-shrink-0 w-10 h-10 rounded-full bg-red-50 dark:bg-red-950/60 text-red-600 dark:text-red-300 flex items-center justify-center">
                <i data-lucide="octagon-x" class="w-5 h-5"></i>
            </span>
            <div class="min-w-0">
                <h2 id="endExamTitle" class="text-lg font-semibold text-slate-800 dark:text-slate-100">End this exam?</h2>
                <p id="endExamSubtitle" class="text-sm text-slate-500 dark:text-slate-400 truncate"></p>
            </div>
        </div>
        <p class="text-sm text-slate-600 dark:text-slate-300 rounded-2xl bg-slate-50 dark:bg-slate-800/60 p-3">
            The exam stops now and every answer saved so far is kept. It goes to <strong>Exam Grading &amp; Review</strong>,
            where you can grade it, <strong>reject</strong> it, or <strong>let the student redo</strong> the exam.
        </p>
        <p id="endExamError" class="hidden text-xs text-red-600 dark:text-red-300 mt-3"></p>
        <div class="flex flex-col-reverse sm:flex-row sm:justify-end gap-2 mt-6">
            <button type="button" id="endExamCancel"
                    class="px-4 py-2 rounded-xl font-medium text-sm border border-slate-200 dark:border-slate-600 text-slate-600 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-700/50 transition-all">
                Cancel
            </button>
            <button type="button" id="endExamConfirm"
                    class="px-4 py-2 rounded-xl font-medium text-sm bg-red-600 text-white hover:bg-red-700 shadow-sm focus:outline-none focus:ring-2 focus:ring-red-500/40 disabled:opacity-50 transition-all">
                End exam &amp; send to review
            </button>
        </div>
    </div>
</div>

<script>
    (function () {
        var hubConnection =new signalR.HubConnectionBuilder().withUrl('/hubs/exam-watch').withAutomaticReconnect().build();
        var peerConnection = null;
        var currentAttemptId = null;
        var currentStreamRoles = {}; // MediaStream.id -> 'camera' | 'screen', from the offer's payload
        // Same public STUN servers as the student side (Take.cshtml).
        var WATCH_ICE = { iceServers: [{ urls: ['stun:stun.l.google.com:19302', 'stun:stun1.l.google.com:19302', 'stun:stun.cloudflare.com:3478'] }] };
        var studentConnectionId = null; // learned from the student's offer
        var outgoingCandidates = [];    // ours, gathered before we know where to send them
        var incomingCandidates = [];    // theirs, arrived before the offer was applied

        // invoke() throws "Cannot send data if the connection is not in the
        // 'Connected' State" while the hub is still starting or reconnecting
        // -- wait for it (or restart it) first.
        async function ensureConnected() {
            for (var i = 0; i < 60; i++) {
                var state = hubConnection.state;
                if (state === signalR.HubConnectionState.Connected) return;
                if (state === signalR.HubConnectionState.Disconnected) {
                    try { await hubConnection.start(); return; } catch (e) { }
                }
                await new Promise(function (r) { setTimeout(r, 250); });
            }
            throw new Error('Could not reach the live-view server. Check your internet connection and try again.');
        }

        var focusOverlay = document.getElementById('focusOverlay');
        // The page wrapper is animated (transform), which traps position:fixed
        // inside it -- the overlay's top bar (close / switch student) ended up
        // under the portal header. Re-parent the overlays onto <body>.
        document.body.appendChild(focusOverlay);
        document.body.appendChild(document.getElementById('endExamModal'));
        var focusScreenVideo = document.getElementById('focusScreenVideo');
        var focusScreenPlaceholder = document.getElementById('focusScreenPlaceholder');
        var focusCameraVideo = document.getElementById('focusCameraVideo');
        var focusCameraPlaceholder = document.getElementById('focusCameraPlaceholder');
        var focusPlaceholder = document.getElementById('focusPlaceholder');
        var focusStudentName = document.getElementById('focusStudentName');
        var focusExamTitle = document.getElementById('focusExamTitle');
        var focusCloseBtn = document.getElementById('focusCloseBtn');

        hubConnection.on('SignalReceived', async function (attemptId, fromConnectionId, payload) {
            if (attemptId !== currentAttemptId || !peerConnection) return;
            if (payload.type === 'offer') {
                studentConnectionId = fromConnectionId;
                currentStreamRoles = payload.streamRoles || {};
                await peerConnection.setRemoteDescription({ type: 'offer', sdp: payload.sdp });
                var queuedIn = incomingCandidates; incomingCandidates = [];
                for (var i = 0; i < queuedIn.length; i++) await peerConnection.addIceCandidate(queuedIn[i]).catch(function () { });
                var answer = await peerConnection.createAnswer();
                await peerConnection.setLocalDescription(answer);
                await hubConnection.invoke('SendSignal', attemptId, fromConnectionId, { type: 'answer', sdp: answer.sdp });
                var queuedOut = outgoingCandidates; outgoingCandidates = [];
                queuedOut.forEach(function (c) { hubConnection.invoke('SendSignal', attemptId, fromConnectionId, { type: 'ice-candidate', candidate: c }).catch(function () { }); });
            } else if (payload.type === 'ice-candidate' && payload.candidate) {
                if (!peerConnection.remoteDescription) incomingCandidates.push(payload.candidate);
                else await peerConnection.addIceCandidate(payload.candidate).catch(function () { });
            }
        });

        function resetFocusVideo() {
            currentStreamRoles = {};
            focusScreenVideo.srcObject = null;
            focusScreenVideo.classList.add('hidden');
            focusScreenPlaceholder.classList.remove('hidden');
            focusCameraVideo.srcObject = null;
            focusCameraVideo.classList.add('hidden');
            focusCameraPlaceholder.classList.remove('hidden');
            focusPlaceholder.classList.remove('hidden');
        }

        // A student sends two separate MediaStreams (camera + screen-share)
        // as two separate WebRTC tracks -- ontrack fires once per stream.
        // Matched primarily by the explicit stream-id -> role map the
        // student's offer sends alongside its SDP (see Take.cshtml) --
        // NOT by the video track's displaySurface setting, which is a
        // getDisplayMedia-only hint that is not reliably preserved on the
        // received/remote track after WebRTC negotiation across browsers,
        // which was the actual cause of the screen-share feed sometimes
        // never appearing even though the peer connection worked fine.
        // Falls back to the displaySurface heuristic only if no role
        // mapping arrived at all (e.g. an older offer payload).
        function isScreenShareStream(stream) {
            if (currentStreamRoles && stream.id in currentStreamRoles) {
                return currentStreamRoles[stream.id] === 'screen';
            }
            var videoTrack = stream.getVideoTracks()[0];
            if (!videoTrack) return false;
            var settings = videoTrack.getSettings ? videoTrack.getSettings() : {};
            return !!settings.displaySurface;
        }

        function updateTileFeed(attemptId, stream) {
            // The grid tile shows whichever feed is the main/screen one --
            // matches the focused view's own "screen is the big feed" choice.
            if (!isScreenShareStream(stream)) return;
            var tile = document.querySelector('.watch-tile[data-attempt-id="' + attemptId + '"]');
            if (!tile) return;
            var video = tile.querySelector('.tile-video');
            var placeholder = tile.querySelector('.tile-placeholder');
            video.srcObject = stream;
            video.classList.remove('hidden');
            placeholder.classList.add('hidden');
        }

function setActiveSwitcherButton(attemptId) {
            document.querySelectorAll('.switcher-btn').forEach(function (btn) {
                var isActive = btn.dataset.attemptId === attemptId;
                btn.classList.toggle('bg-white/20', isActive);
                btn.classList.toggle('bg-white/10', !isActive);
                btn.classList.toggle('font-semibold', isActive);
            });
        }

        // Accepts a plain {attemptId, studentName, examTitle} descriptor
        // rather than requiring a specific DOM element, so both a grid
        // tile's click and the always-visible in-focus switcher (which the
        // lecturer can use to shift to any other student at any time,
        // without first closing the current view) can call this the same way.
        async function watch(descriptor) {
            var attemptId = descriptor.attemptId;
            if (attemptId === currentAttemptId) return; // already watching this one

            if (peerConnection) {
                if (currentAttemptId) hubConnection.invoke('StopWatching', currentAttemptId).catch(function () { });
                peerConnection.close();
                peerConnection = null;
            }

            currentAttemptId = attemptId;
            studentConnectionId = null;
            outgoingCandidates = [];
            incomingCandidates = [];
            resetFocusVideo();
            focusStudentName.textContent = descriptor.studentName;
            focusExamTitle.textContent = descriptor.examTitle;
            focusOverlay.classList.remove('hidden');
            setActiveSwitcherButton(attemptId);

            // TURN credentials come from the server (see IceServerProvider).
            try { await ensureConnected(); WATCH_ICE.iceServers = await hubConnection.invoke('GetIceServers'); } catch (e) { }
            if (attemptId !== currentAttemptId) return; // switched student while waiting
            peerConnection = new RTCPeerConnection(WATCH_ICE);
            // Our candidates go to the STUDENT's connection (this used to send
            // them to our own connection id, so the student never got them).
            peerConnection.onicecandidate = function (e) {
                if (!e.candidate) return;
                if (!studentConnectionId) { outgoingCandidates.push(e.candidate); return; }
                hubConnection.invoke('SendSignal', attemptId, studentConnectionId, { type: 'ice-candidate', candidate: e.candidate }).catch(function () { });
            };
            peerConnection.onconnectionstatechange = function () {
                if (peerConnection && peerConnection.connectionState === 'failed') {
                    showFocusError('The video connection could not be established (the student\'s or your network may be blocking it). Try again, or try another network.');
                }
            };
            peerConnection.ontrack = function (e) {
                var stream = e.streams[0];
                focusPlaceholder.classList.add('hidden');

                if (isScreenShareStream(stream)) {
                    focusScreenVideo.srcObject = stream;
                    focusScreenVideo.classList.remove('hidden');
                    focusScreenPlaceholder.classList.add('hidden');
                } else {
                    focusCameraVideo.srcObject = stream;
                    focusCameraVideo.classList.remove('hidden');
                    focusCameraPlaceholder.classList.add('hidden');
                }

                updateTileFeed(attemptId, stream);
            };

            try {
                await ensureConnected();
                await hubConnection.invoke('RequestWatch', attemptId);
            } catch (err) {
                // HubException text arrives wrapped ("...HubException: <msg>") -- show just the message.
                showFocusError(String(err.message || 'Could not connect').replace(/^.*HubException:\s*/, ''));
            }
        }

        function showFocusError(message) {
            var span = document.createElement('span');
            span.className = 'text-sm text-red-300 max-w-md text-center px-6';
            span.textContent = message;
            focusPlaceholder.innerHTML = '<i data-lucide="circle-x" class="w-8 h-8 text-red-400"></i>';
            focusPlaceholder.appendChild(span);
            focusPlaceholder.classList.remove('hidden');
            if (window.lucide) lucide.createIcons();
        }

        async function stopWatching() {
            if (peerConnection && currentAttemptId) {
                hubConnection.invoke('StopWatching', currentAttemptId).catch(function () { });
                peerConnection.close();
                peerConnection = null;
            }
            currentAttemptId = null;
            focusOverlay.classList.add('hidden');
        }

        // Fires when the student's own connection drops (exam submitted,
        // auto-submitted, terminated, or the tab was simply closed) --
        // only ever affects the lecturer's view if THIS is the attempt
        // currently focused; every other student's tile/feed is completely
        // unaffected, matching the one-watcher-per-attempt design.
        hubConnection.on('ExamEnded', function (attemptId) {
            if (attemptId !== currentAttemptId) return;
            peerConnection = null; // student side already tore its connection down, nothing to StopWatching
            currentAttemptId = null;
            focusOverlay.classList.add('hidden');

            var tile = document.querySelector('.watch-tile[data-attempt-id="' + attemptId + '"]');
            if (tile) tile.remove();
            var switcherBtn = document.querySelector('.switcher-btn[data-attempt-id="' + attemptId + '"]');
            if (switcherBtn) switcherBtn.remove();
        });

        function tileDescriptor(el) {
            return { attemptId: el.dataset.attemptId, studentName: el.dataset.studentName, examTitle: el.dataset.examTitle };
        }

        function showToastOnTile(tile, message) {
            var note = document.createElement('div');
            note.className = 'absolute inset-x-2 bottom-2 rounded-xl bg-black/80 text-amber-200 text-xs text-center px-3 py-2 pointer-events-none';
            note.textContent = message;
            tile.querySelector('.aspect-video').appendChild(note);
            setTimeout(function () { note.remove(); }, 2500);
        }

        // ---------- End exam ----------
        var endModal = document.getElementById('endExamModal');
        var endConfirm = document.getElementById('endExamConfirm');
        var endError = document.getElementById('endExamError');
        var endTarget = null;
        function closeEndModal() { endModal.classList.add('hidden'); endTarget = null; }
        document.getElementById('endExamCancel').addEventListener('click', closeEndModal);
        endModal.addEventListener('click', function (e) { if (e.target === endModal) closeEndModal(); });
        document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && !endModal.classList.contains('hidden')) closeEndModal(); });
        endConfirm.addEventListener('click', async function () {
            if (!endTarget) return;
            endConfirm.disabled = true;
            endError.classList.add('hidden');
            try {
                var token = endModal.querySelector('input[name="__RequestVerificationToken"]').value;
                var res = await fetch('/Lecturer/ExamWatch/End', {
                    method: 'POST',
                    credentials: 'same-origin',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': token },
                    body: new URLSearchParams({ attemptId: endTarget.dataset.attemptId, __RequestVerificationToken: token })
                });
                var data = await res.json();
                if (!data.success) throw new Error(data.message || 'Could not end the exam.');
                var id = endTarget.dataset.attemptId;
                if (id === currentAttemptId) stopWatching();
                endTarget.remove();
                var sw = document.querySelector('.switcher-btn[data-attempt-id="' + id + '"]');
                if (sw) sw.remove();
                closeEndModal();
                refreshList();
            } catch (err) {
                endError.textContent = err.message;
                endError.classList.remove('hidden');
            } finally {
                endConfirm.disabled = false;
            }
        });

        // Delegated, so tiles/buttons added by refreshList() work too.
        document.addEventListener('click', function (e) {
            var endBtn = e.target.closest('.end-exam-btn');
            if (endBtn) {
                e.stopPropagation();
                endTarget = endBtn.closest('.watch-tile');
                document.getElementById('endExamSubtitle').textContent = endTarget.dataset.studentName + ' · ' + endTarget.dataset.examTitle;
                endError.classList.add('hidden');
                endModal.classList.remove('hidden');
                endConfirm.focus();
                return;
            }
            var el = e.target.closest('.watch-tile, .switcher-btn');
            if (!el) return;
            var tile = document.querySelector('.watch-tile[data-attempt-id="' + el.dataset.attemptId + '"]');
            if (tile && tile.dataset.online === '0') {
                showToastOnTile(tile, 'This student has closed the exam page.');
                return;
            }
            watch(tileDescriptor(el));
        });

        focusCloseBtn.addEventListener('click', stopWatching);
        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape' && !focusOverlay.classList.contains('hidden')) stopWatching();
        });

        // Live list: re-fetch this page every 10s and add students who just
        // started / drop ones who finished. Existing tiles are left in place
        // so a playing feed isn't interrupted.
        var watchGrid = document.getElementById('watchGrid');
        var focusSwitcher = document.getElementById('focusSwitcher');
        function syncChildren(container, fresh, selector) {
            var freshIds = {};
            fresh.querySelectorAll(selector).forEach(function (el) {
                freshIds[el.dataset.attemptId] = true;
                var existing = container.querySelector(selector + '[data-attempt-id="' + el.dataset.attemptId + '"]');
                if (!existing) {
                    container.appendChild(document.importNode(el, true));
                } else if (el.dataset.online !== undefined && existing.dataset.online !== el.dataset.online) {
                    // Student opened/closed the exam page since the last poll.
                    existing.dataset.online = el.dataset.online;
                    existing.classList.toggle('opacity-60', el.dataset.online !== '1');
                    existing.querySelector('.tile-status').innerHTML = el.querySelector('.tile-status').innerHTML;
                }
            });
            container.querySelectorAll(selector).forEach(function (el) {
                if (!freshIds[el.dataset.attemptId] && el.dataset.attemptId !== currentAttemptId) el.remove();
            });
        }
        async function refreshList() {
            if (document.hidden) return;
            try {
                var res = await fetch(location.pathname, { credentials: 'same-origin', cache: 'no-store' });
                if (!res.ok || res.redirected) return;
                var doc = new DOMParser().parseFromString(await res.text(), 'text/html');
                syncChildren(watchGrid, doc.getElementById('watchGrid'), '.watch-tile');
                syncChildren(focusSwitcher, doc.getElementById('focusSwitcher'), '.switcher-btn');
                var count = watchGrid.querySelectorAll('.watch-tile').length;
                document.getElementById('watchEmpty').classList.toggle('hidden', count > 0);
                var liveCount = document.getElementById('liveCount');
                liveCount.lastChild.textContent = ' ' + watchGrid.querySelectorAll('.watch-tile[data-online="1"]').length + ' live now';
                if (window.lucide) lucide.createIcons();
            } catch (e) { }
        }
        setInterval(refreshList, 10000);
        document.addEventListener('visibilitychange', function () { if (!document.hidden) refreshList(); });

        ensureConnected().catch(function () { });
    })();
</script>
