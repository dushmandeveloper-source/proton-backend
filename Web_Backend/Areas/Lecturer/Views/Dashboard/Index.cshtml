@model Web_Backend.Areas.LecturerPortal.Models.LecturerDashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<form id="af-token-form">@Html.AntiForgeryToken()</form>

<div class="max-w-5xl mx-auto space-y-8 page-enter">

    <div>
        <p class="text-sm font-medium text-slate-500 dark:text-slate-400 mb-2">@DateTime.Now.ToString("ddd, MMMM d")</p>
        <h1 class="text-3xl md:text-4xl font-bold text-slate-800 dark:text-slate-100 tracking-tight">
            Hello, @Model.LecturerName
        </h1>
    </div>

    @* ---------- Stat tiles ---------- *@
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-white dark:bg-slate-900/60 p-6 rounded-[24px] shadow-sm border border-slate-100 dark:border-slate-700">
            <div class="p-3 rounded-2xl bg-purple-50 dark:bg-purple-950 text-purple-600 dark:text-purple-300 w-fit mb-4"><i data-lucide="graduation-cap" class="w-5 h-5"></i></div>
            <h3 class="text-3xl font-bold text-slate-800 dark:text-slate-100 mb-1">@Model.AssignedBatchCount</h3>
            <p class="text-sm text-slate-500 dark:text-slate-400 font-medium">Assigned Batches</p>
        </div>
        <div class="bg-white dark:bg-slate-900/60 p-6 rounded-[24px] shadow-sm border border-slate-100 dark:border-slate-700">
            <div class="p-3 rounded-2xl bg-amber-50 dark:bg-amber-950 text-amber-600 dark:text-amber-300 w-fit mb-4"><i data-lucide="calendar-clock" class="w-5 h-5"></i></div>
            <h3 class="text-3xl font-bold text-slate-800 dark:text-slate-100 mb-1">@Model.PendingRescheduleCount</h3>
            <p class="text-sm text-slate-500 dark:text-slate-400 font-medium">Pending Reschedules</p>
        </div>
        <div class="bg-white dark:bg-slate-900/60 p-6 rounded-[24px] shadow-sm border border-slate-100 dark:border-slate-700">
            <div class="p-3 rounded-2xl bg-indigo-50 dark:bg-indigo-950 text-indigo-600 dark:text-indigo-300 w-fit mb-4"><i data-lucide="file-text" class="w-5 h-5"></i></div>
            <h3 class="text-3xl font-bold text-slate-800 dark:text-slate-100 mb-1">@Model.RecentMaterials.Count</h3>
            <p class="text-sm text-slate-500 dark:text-slate-400 font-medium">Recent Materials</p>
        </div>
    </div>

    @* ---------- This Week's Classes ---------- *@
    <div class="bg-white dark:bg-slate-900/60 rounded-[24px] shadow-sm border border-slate-100 dark:border-slate-700 overflow-hidden">
        <div class="p-6 border-b border-slate-100 dark:border-slate-700 flex items-center gap-3">
            <div class="bg-indigo-50 dark:bg-indigo-950 p-2 rounded-lg"><i data-lucide="calendar-days" class="w-5 h-5 text-indigo-600 dark:text-indigo-300"></i></div>
            <h3 class="font-semibold text-lg text-slate-800 dark:text-slate-100">This Week's Classes</h3>
        </div>
        <div class="divide-y divide-slate-100 dark:divide-slate-700">
            @foreach (var day in Model.WeekSchedule)
            {
                <div class="p-5 flex flex-col md:flex-row gap-3 md:gap-6">
                    <div class="md:w-32 flex-shrink-0">
                        <p class="text-sm font-semibold text-slate-800 dark:text-slate-100">@day.DayLabel</p>
                        <p class="text-xs text-slate-400 dark:text-slate-500">@day.Date.ToString("MMM d")</p>
                    </div>
                    <div class="flex-1 space-y-2">
                        @if (day.Segments.Count == 0)
                        {
                            <p class="text-sm text-slate-400 dark:text-slate-500">No classes</p>
                        }
                        else
                        {
                            @foreach (var seg in day.Segments)
                            {
                                // Join unlocks 15 min before StartTime and stays enabled
                                // indefinitely after (classes don't reliably end on the
                                // dot, so there's no auto-disable at EndTime) -- same
                                // rule as the student dashboard's Join button.
                                var joinAt = day.Date.Date.Add(seg.StartTime).AddMinutes(-15);
                                var isToday = day.Date.Date == DateTime.Today;
                                <div class="rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-100 dark:border-slate-700 px-4 py-3">
                                    <div class="flex items-start justify-between gap-3">
                                        <div class="min-w-0">
                                            <p class="text-sm font-semibold text-slate-800 dark:text-slate-100">@seg.CourseTitle</p>
                                            <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
                                                @seg.ScheduleName &middot; @seg.StartTime.ToString(@"hh\:mm") - @seg.EndTime.ToString(@"hh\:mm") &middot; @seg.Location
                                            </p>
                                        </div>
                                        @if (!string.IsNullOrEmpty(seg.MeetingLink))
                                        {
                                            @if (isToday)
                                            {
                                                <a href="@seg.MeetingLink" target="_blank" rel="noopener" data-join-link data-join-at="@joinAt.ToString("yyyy-MM-ddTHH:mm:ss")"
                                                   class="join-link px-3 py-1.5 rounded-lg font-medium text-xs bg-[#7c3aed] text-white hover:bg-[#6d28d9] transition-colors flex items-center gap-1 flex-shrink-0">
                                                    <i data-lucide="video" class="w-3.5 h-3.5"></i> <span class="join-label">Join</span>
                                                </a>
                                            }
                                            else
                                            {
                                                <span class="px-3 py-1.5 rounded-lg font-medium text-xs bg-slate-100 dark:bg-slate-800 text-slate-400 dark:text-slate-500 cursor-not-allowed flex-shrink-0"
                                                      title="Only available on the scheduled day">
                                                    Join
                                                </span>
                                            }
                                        }
                                    </div>
                                    <div class="mt-2 meeting-link-row" data-schedule-id="@seg.ScheduleID" data-segment-id="@seg.SegmentID">
                                        <div class="meeting-link-display">
                                            <button type="button" class="meeting-link-edit-btn text-xs text-slate-400 hover:text-[#7c3aed] dark:hover:text-purple-400 inline-flex items-center gap-1">
                                                <i data-lucide="pencil" class="w-3 h-3"></i> @(string.IsNullOrEmpty(seg.MeetingLink) ? "Add" : "Update") link
                                            </button>
                                        </div>
                                        <div class="meeting-link-form hidden flex items-center gap-2 mt-1">
                                            <input type="url" class="meeting-link-input flex-1 px-2 py-1 rounded-lg border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-900 text-xs" placeholder="Meeting link" value="@seg.MeetingLink" />
                                            <button type="button" class="meeting-link-save-btn px-2 py-1 rounded-lg text-xs font-medium bg-[#7c3aed] text-white hover:bg-[#6d28d9]">Save</button>
                                            <button type="button" class="meeting-link-cancel-btn px-2 py-1 rounded-lg text-xs text-slate-500 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-700">Cancel</button>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>
            }
        </div>
    </div>

    @* ---------- Recent Materials ---------- *@
    <div class="bg-white dark:bg-slate-900/60 rounded-[24px] shadow-sm border border-slate-100 dark:border-slate-700 overflow-hidden">
        <div class="p-6 border-b border-slate-100 dark:border-slate-700 flex items-center gap-3">
            <div class="bg-purple-50 dark:bg-purple-950 p-2 rounded-lg"><i data-lucide="file-text" class="w-5 h-5 text-purple-600 dark:text-purple-300"></i></div>
            <h3 class="font-semibold text-lg text-slate-800 dark:text-slate-100">Recent Materials</h3>
            <a asp-area="Lecturer" asp-controller="Notes" asp-action="Index" class="ml-auto text-sm font-medium text-[#7c3aed] hover:underline">View all</a>
        </div>
        @if (Model.RecentMaterials.Count == 0)
        {
            <div class="p-10 text-center">
                <p class="text-sm text-slate-400 dark:text-slate-500">No materials uploaded yet.</p>
            </div>
        }
        else
        {
            <div class="divide-y divide-slate-100 dark:divide-slate-700">
                @foreach (var m in Model.RecentMaterials)
                {
                    <div class="p-4 px-6 flex items-center justify-between gap-4">
                        <div>
                            <p class="text-sm font-medium text-slate-800 dark:text-slate-100">@m.Title</p>
                            <p class="text-xs text-slate-400 dark:text-slate-500">@m.MaterialDate.ToString("MMM d, yyyy") &middot; @m.FileType</p>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <div class="flex justify-center pb-4">
        <a asp-area="Lecturer" asp-controller="Courses" asp-action="Index"
           class="px-6 py-3 rounded-xl font-medium text-sm bg-[#7c3aed] text-white hover:bg-[#6d28d9] shadow-sm transition-all flex items-center gap-2">
            <i data-lucide="graduation-cap" class="w-4 h-4"></i> View My Batches
        </a>
    </div>
</div>

<script>
    (function () {
        document.querySelectorAll('.meeting-link-row').forEach(row => {
            const scheduleId = row.dataset.scheduleId;
            const segmentId = row.dataset.segmentId;
            const display = row.querySelector('.meeting-link-display');
            const form = row.querySelector('.meeting-link-form');
            const editBtn = row.querySelector('.meeting-link-edit-btn');
            const saveBtn = row.querySelector('.meeting-link-save-btn');
            const cancelBtn = row.querySelector('.meeting-link-cancel-btn');
            const input = row.querySelector('.meeting-link-input');

            editBtn.addEventListener('click', () => {
                display.classList.add('hidden');
                form.classList.remove('hidden');
                input.focus();
            });
            cancelBtn.addEventListener('click', () => {
                form.classList.add('hidden');
                display.classList.remove('hidden');
            });
            saveBtn.addEventListener('click', async () => {
                const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
                saveBtn.disabled = true;
                saveBtn.textContent = 'Saving...';
                try {
                    const res = await fetch('@Url.Action("SetSegmentMeetingLink", "Courses", new { area = "Lecturer" })', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                        body: new URLSearchParams({ scheduleId, segmentId, meetingLink: input.value.trim(), __RequestVerificationToken: token })
                    });
                    const data = await res.json();
                    if (!data.success) throw new Error(data.error || 'Save failed');
                    showToast('Meeting link saved.', 'success');
                    display.innerHTML = `<button type="button" class="meeting-link-edit-btn text-xs text-slate-400 hover:text-[#7c3aed] dark:hover:text-purple-400 inline-flex items-center gap-1"><i data-lucide="pencil" class="w-3 h-3"></i> ${data.meetingLink ? 'Update' : 'Add'} link</button>`;
                    display.querySelector('.meeting-link-edit-btn').addEventListener('click', () => {
                        display.classList.add('hidden');
                        form.classList.remove('hidden');
                        input.focus();
                    });
                    form.classList.add('hidden');
                    display.classList.remove('hidden');
                    if (window.lucide) lucide.createIcons();
                } catch (err) {
                    showToast(err.message || 'Could not save meeting link.', 'error');
                } finally {
                    saveBtn.disabled = false;
                    saveBtn.textContent = 'Save';
                }
            });
        });
    })();

    (function () {
        // Gates each Join link until 15 min before its class start time (see
        // joinAt computed server-side above). Disabled links show "Available
        // at HH:mm" instead of navigating, and the whole set re-checks every
        // 30s so a link flips live without a reload -- same behavior as the
        // student dashboard's Join button.
        function formatTime(date) {
            return date.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
        }

        function refreshJoinLinks() {
            var now = new Date();
            document.querySelectorAll('[data-join-link]').forEach(function (link) {
                var joinAt = new Date(link.dataset.joinAt);
                var label = link.querySelector('.join-label');
                if (now >= joinAt) {
                    link.classList.remove('opacity-40', 'cursor-not-allowed', 'pointer-events-none');
                    link.removeAttribute('aria-disabled');
                    if (label) label.textContent = 'Join';
                } else {
                    link.classList.add('opacity-40', 'cursor-not-allowed', 'pointer-events-none');
                    link.setAttribute('aria-disabled', 'true');
                    if (label) label.textContent = 'Available at ' + formatTime(joinAt);
                }
            });
        }

        refreshJoinLinks();
        setInterval(refreshJoinLinks, 30000);
    })();
</script>
