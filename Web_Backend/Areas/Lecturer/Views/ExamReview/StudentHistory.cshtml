@using Web_Backend.Areas.Admin.Models
@model List<ExamAttempt>
@{
    ViewData["Title"] = "Student Exam History";
    var student = (StudentRosterEntry)ViewBag.Student;
}

<div class="max-w-5xl mx-auto page-enter space-y-6">
    <a asp-action="Index" asp-controller="Courses" asp-area="Lecturer"
       class="text-sm text-slate-500 dark:text-slate-400 hover:text-slate-800 dark:hover:text-slate-100 inline-flex items-center gap-1">
        <i data-lucide="arrow-left" class="w-4 h-4"></i> Back to My Batches
    </a>

    <div class="bg-white dark:bg-slate-900/60 rounded-[24px] shadow-sm border border-slate-100 dark:border-slate-700 p-6 flex items-center gap-4">
        @if (!string.IsNullOrEmpty(student.ProfileImageUrl))
        {
            <img src="@student.ProfileImageUrl" alt="" class="w-12 h-12 rounded-full object-cover flex-shrink-0" />
        }
        else
        {
            <div class="w-12 h-12 rounded-full bg-purple-50 dark:bg-purple-950 flex items-center justify-center text-[#7c3aed] dark:text-purple-300 font-semibold flex-shrink-0">
                @(student.StudentName.Length > 0 ? student.StudentName[0].ToString().ToUpper() : "?")
            </div>
        }
        <div>
            <h2 class="text-xl font-bold text-slate-800 dark:text-slate-100">@student.StudentName</h2>
            <p class="text-sm text-slate-500 dark:text-slate-400">@student.StudentEmail</p>
        </div>
    </div>

    <div class="bg-white dark:bg-slate-900/60 rounded-[24px] shadow-sm border border-slate-100 dark:border-slate-700 overflow-hidden">
        <div class="p-6 border-b border-slate-100 dark:border-slate-700">
            <h3 class="font-semibold text-lg text-slate-800 dark:text-slate-100">Exam History</h3>
            <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">Every exam attempt by this student, most recent first.</p>
        </div>

        @if (!Model.Any())
        {
            <div class="p-10 text-center">
                <p class="text-sm text-slate-400 dark:text-slate-500">No exam attempts yet.</p>
            </div>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="w-full text-sm">
                    <thead>
                        <tr class="border-b border-slate-100 dark:border-slate-700 text-left text-xs font-medium text-slate-500 dark:text-slate-400 uppercase tracking-wide">
                            <th class="px-6 py-3">Exam</th>
                            <th class="px-6 py-3">Started</th>
                            <th class="px-6 py-3">Status</th>
                            <th class="px-6 py-3">Marks</th>
                            <th class="px-6 py-3">Verdict</th>
                            <th class="px-6 py-3"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var a in Model)
                        {
                            <tr class="border-b border-slate-50 dark:border-slate-800 last:border-0 hover:bg-slate-50/60 dark:hover:bg-slate-800/40">
                                <td class="px-6 py-3 text-slate-800 dark:text-slate-100 font-medium whitespace-nowrap">@a.ExamTitle</td>
                                <td class="px-6 py-3 text-slate-600 dark:text-slate-300 whitespace-nowrap">@a.StartedDate.ToString("g")</td>
                                <td class="px-6 py-3 text-slate-600 dark:text-slate-300 whitespace-nowrap">@a.Status</td>
                                <td class="px-6 py-3 text-slate-600 dark:text-slate-300 whitespace-nowrap">@a.TotalMarksAwarded / @a.TotalMarks</td>
                                <td class="px-6 py-3 whitespace-nowrap">
                                    @if (!a.ResultReleasedDate.HasValue)
                                    {
                                        <span class="text-xs text-slate-400 dark:text-slate-500">Not released</span>
                                    }
                                    else if (a.Passed == true)
                                    {
                                        <span class="inline-flex items-center gap-1 text-xs font-medium text-emerald-600 dark:text-emerald-300"><i data-lucide="check-circle" class="w-3.5 h-3.5"></i> Pass</span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center gap-1 text-xs font-medium text-red-600 dark:text-red-300"><i data-lucide="circle-x" class="w-3.5 h-3.5"></i> Fail</span>
                                    }
                                </td>
                                <td class="px-6 py-3 text-right whitespace-nowrap">
                                    @if (a.IsFullyGraded)
                                    {
                                        <a asp-action="Grade" asp-controller="ExamReview" asp-area="Lecturer" asp-route-attemptId="@a.AttemptID"
                                           class="px-3 py-1.5 rounded-xl font-medium border border-slate-200 dark:border-slate-600 text-slate-600 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-700/50 text-xs">
                                            View Answers
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
