@model List<Web_Backend.Areas.Admin.Models.CourseSchedule>
@{
    ViewData["Title"] = "My Batches";
}

<div class="max-w-5xl mx-auto space-y-8 page-enter">

    <div>
        <p class="text-sm font-medium text-slate-500 dark:text-slate-400 mb-2">Teaching</p>
        <h1 class="text-3xl md:text-4xl font-bold text-slate-800 dark:text-slate-100 tracking-tight">My Batches</h1>
    </div>

    <div class="bg-white dark:bg-slate-900/60 rounded-[24px] shadow-sm border border-slate-100 dark:border-slate-700 overflow-hidden">
        @if (Model.Count == 0)
        {
            <div class="p-10 text-center">
                <p class="text-sm text-slate-400 dark:text-slate-500">You are not assigned to any batches yet.</p>
            </div>
        }
        else
        {
            <div class="divide-y divide-slate-100 dark:divide-slate-700">
                @foreach (var batch in Model)
                {
                    <div class="p-5 flex flex-col md:flex-row md:items-center justify-between gap-3">
                        <div>
                            <p class="text-sm font-semibold text-slate-800 dark:text-slate-100">@batch.CourseTitle</p>
                            <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">@batch.ScheduleName &middot; @batch.Location</p>
                            <p class="text-xs text-slate-400 dark:text-slate-500 mt-1">@batch.SegmentsSummary</p>
                        </div>
                        <div class="flex items-center gap-3 flex-shrink-0">
                            <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-medium bg-slate-100 dark:bg-slate-800 text-slate-500 dark:text-slate-400">
                                <i data-lucide="users" class="w-3 h-3"></i> @batch.EnrolledCount enrolled
                            </span>
                            <a asp-action="Details" asp-route-scheduleId="@batch.ScheduleID"
                               class="px-4 py-2 rounded-xl font-medium text-sm bg-slate-50 dark:bg-slate-800 text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-700 transition-colors">
                                View
                            </a>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>
