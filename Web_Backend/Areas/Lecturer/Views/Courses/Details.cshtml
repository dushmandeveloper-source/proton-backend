@model Web_Backend.Areas.Admin.Models.CourseSchedule
@{
    ViewData["Title"] = "Batch Details";
    var materials = ViewBag.Materials as List<Web_Backend.Areas.Admin.Models.LectureMaterial> ?? new();
    var roster = ViewBag.Roster as List<Web_Backend.Areas.Admin.Models.StudentRosterEntry> ?? new();
    var rosterPayments = ViewBag.RosterPayments as Dictionary<string, Web_Backend.Areas.Admin.Models.RosterPaymentSummary> ?? new();
}

<div class="max-w-5xl mx-auto space-y-8 page-enter">

    <div class="flex items-center justify-between flex-wrap gap-4">
        <div>
            <p class="text-sm font-medium text-slate-500 dark:text-slate-400 mb-2">My Batches</p>
            <h1 class="text-3xl md:text-4xl font-bold text-slate-800 dark:text-slate-100 tracking-tight">
                @Model.CourseTitle
            </h1>
        </div>
        <a asp-action="Index"
           class="px-4 py-2 rounded-xl font-medium text-sm bg-slate-50 dark:bg-slate-800 text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-700 transition-colors flex items-center gap-2 w-fit">
            <i data-lucide="arrow-left" class="w-4 h-4"></i> Back to My Batches
        </a>
    </div>

    @* ---------- Batch info ---------- *@
    <div class="bg-white dark:bg-slate-900/60 rounded-[24px] shadow-sm border border-slate-100 dark:border-slate-700 overflow-hidden">
        <div class="p-6 border-b border-slate-100 dark:border-slate-700 flex items-center gap-3">
            <div class="bg-purple-50 dark:bg-purple-950 p-2 rounded-lg"><i data-lucide="graduation-cap" class="w-5 h-5 text-purple-600 dark:text-purple-300"></i></div>
            <h3 class="font-semibold text-lg text-slate-800 dark:text-slate-100">Batch Information</h3>
            <span class="ml-auto inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-medium bg-slate-100 dark:bg-slate-800 text-slate-500 dark:text-slate-400">
                <i data-lucide="users" class="w-3 h-3"></i> @Model.EnrolledCount enrolled
            </span>
        </div>
        <div class="p-6 grid grid-cols-1 md:grid-cols-2 gap-6 text-sm">
            <div>
                <p class="text-xs text-slate-400 dark:text-slate-500 uppercase tracking-wider mb-0.5">Batch Name</p>
                <p class="text-slate-700 dark:text-slate-200 font-medium">@Model.ScheduleName</p>
            </div>
            <div>
                <p class="text-xs text-slate-400 dark:text-slate-500 uppercase tracking-wider mb-0.5">Location</p>
                <p class="text-slate-700 dark:text-slate-200 font-medium">@Model.Location</p>
            </div>
        </div>
    </div>

    @* ---------- Enrolled students ---------- *@
    <div class="bg-white dark:bg-slate-900/60 rounded-[24px] shadow-sm border border-slate-100 dark:border-slate-700 overflow-hidden">
        <div class="p-6 border-b border-slate-100 dark:border-slate-700 flex items-center gap-3">
            <div class="bg-sky-50 dark:bg-sky-950 p-2 rounded-lg"><i data-lucide="users" class="w-5 h-5 text-sky-600 dark:text-sky-300"></i></div>
            <h3 class="font-semibold text-lg text-slate-800 dark:text-slate-100">Enrolled Students</h3>
            <span class="ml-auto text-xs font-medium text-slate-400 dark:text-slate-500">@roster.Count student(s)</span>
        </div>
        @if (roster.Count == 0)
        {
            <div class="p-10 text-center">
                <p class="text-sm text-slate-400 dark:text-slate-500">No students enrolled in this batch yet.</p>
            </div>
        }
        else
        {
            <div class="divide-y divide-slate-100 dark:divide-slate-700">
                @foreach (var student in roster)
                {
                    <div class="p-4 px-6 flex items-center gap-4">
                        @if (!string.IsNullOrEmpty(student.ProfileImageUrl))
                        {
                            <img src="@student.ProfileImageUrl" alt="" class="w-10 h-10 rounded-full object-cover flex-shrink-0" />
                        }
                        else
                        {
                            <div class="w-10 h-10 rounded-full bg-purple-50 dark:bg-purple-950 flex items-center justify-center text-[#7c3aed] dark:text-purple-300 font-semibold text-sm flex-shrink-0">
                                @(student.StudentName.Length > 0 ? student.StudentName[0].ToString().ToUpper() : "?")
                            </div>
                        }
                        <div class="min-w-0 flex-1">
                            <p class="text-sm font-medium text-slate-800 dark:text-slate-100 truncate">@student.StudentName</p>
                            <p class="text-xs text-slate-400 dark:text-slate-500 truncate">
                                @student.StudentEmail
                                @if (student.DateOfBirth.HasValue)
                                {
                                    <span>&middot; DOB: @student.DateOfBirth.Value.ToString("MMM d, yyyy")</span>
                                }
                            </p>
                            @if (rosterPayments.TryGetValue(student.StudentID, out var pay))
                            {
                                @* Lecturers see the payment status only -- no amounts, plan or dues. *@
                                var (payLabel, payCls) = pay.BalanceDue <= 0
                                    ? ("Paid", "bg-emerald-50 dark:bg-emerald-950 text-emerald-700 dark:text-emerald-300")
                                    : pay.AmountPaid > 0
                                        ? ("Partially paid", "bg-sky-50 dark:bg-sky-950 text-sky-700 dark:text-sky-300")
                                        : ("Pending", "bg-amber-50 dark:bg-amber-950 text-amber-700 dark:text-amber-300");
                                <p class="text-xs mt-1"><span class="px-2 py-0.5 rounded-lg text-[11px] font-medium @payCls">@payLabel</span></p>
                            }
                        </div>

                        <a asp-action="StudentHistory" asp-controller="ExamReview" asp-area="Lecturer" asp-route-studentId="@student.StudentID"
                           class="flex-shrink-0 px-3 py-1.5 rounded-lg font-medium text-xs bg-slate-50 dark:bg-slate-800 text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-700 transition-colors">
                            Exam History
                        </a>
                    </div>
                }
            </div>
        }
    </div>

    @* ---------- Segments ---------- *@
    <div class="bg-white dark:bg-slate-900/60 rounded-[24px] shadow-sm border border-slate-100 dark:border-slate-700 overflow-hidden">
        <div class="p-6 border-b border-slate-100 dark:border-slate-700 flex items-center gap-3">
            <div class="bg-indigo-50 dark:bg-indigo-950 p-2 rounded-lg"><i data-lucide="calendar-days" class="w-5 h-5 text-indigo-600 dark:text-indigo-300"></i></div>
            <h3 class="font-semibold text-lg text-slate-800 dark:text-slate-100">Class Schedule</h3>
        </div>
        @if (Model.Segments.Count == 0)
        {
            <div class="p-10 text-center">
                <p class="text-sm text-slate-400 dark:text-slate-500">No schedule segments found for this batch.</p>
            </div>
        }
        else
        {
            <form id="meeting-link-form" method="post" asp-action="SetMeetingLink" asp-route-scheduleId="@Model.ScheduleID">
                @Html.AntiForgeryToken()
                <input type="hidden" name="SegmentIDsJSON" id="segment-ids-field" value="[]" />

                <div class="p-5 space-y-3">
                    @foreach (var seg in Model.Segments.OrderBy(s => s.SortOrder))
                    {
                        <div class="rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-100 dark:border-slate-700 px-4 py-3 flex items-center justify-between gap-4">
                            <label class="flex items-center gap-3 min-w-0 cursor-pointer">
                                <input type="checkbox" class="segment-checkbox rounded border-slate-300 dark:border-slate-600 text-[#7c3aed] focus:ring-[#7c3aed]" value="@seg.SegmentID" />
                                <div class="min-w-0">
                                    <p class="text-sm font-semibold text-slate-800 dark:text-slate-100">
                                        @seg.DateRangeText &middot; @seg.DaysOfWeekLabel &middot; @seg.TimeRangeText
                                    </p>
                                    @if (seg.ExceptionCount > 0)
                                    {
                                        <p class="text-xs text-amber-600 dark:text-amber-300 mt-0.5">@seg.ExceptionCount day(s) skipped</p>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(seg.TimeOverrides))
                                    {
                                        <p class="text-xs text-sky-600 dark:text-sky-300 mt-0.5">Different time on: @Web_Backend.Areas.Admin.Models.SegmentTimeOverrides.Describe(seg.TimeOverrides)</p>
                                    }
                                    @if (!string.IsNullOrEmpty(seg.MeetingLink))
                                    {
                                        <a href="@seg.MeetingLink" target="_blank" rel="noopener" class="text-xs text-[#7c3aed] hover:underline mt-0.5 inline-flex items-center gap-1">
                                            <i data-lucide="video" class="w-3 h-3"></i> Join meeting
                                        </a>
                                    }
                                </div>
                            </label>
                            <div class="flex items-center gap-2 flex-shrink-0">
                                <a asp-area="Lecturer" asp-controller="Reschedule" asp-action="Create" asp-route-scheduleId="@Model.ScheduleID" asp-route-segmentId="@seg.SegmentID"
                                   class="px-3 py-1.5 rounded-lg font-medium text-xs bg-amber-50 dark:bg-amber-950 text-amber-700 dark:text-amber-300 hover:bg-amber-100 dark:hover:bg-amber-900 transition-colors">
                                    Request Reschedule
                                </a>
                            </div>
                        </div>
                    }
                </div>

                <div class="px-5 pb-5 flex flex-wrap items-center gap-2">
                    <button type="button" id="select-all-segments" class="text-xs text-[#7c3aed] hover:underline">Select all dates</button>
                    <input type="url" name="MeetingLink" placeholder="Paste Zoom / VooV / Teams meeting link"
                           class="flex-1 min-w-[240px] px-3 py-2 rounded-xl border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-800 text-sm" />
                    <button type="submit" id="apply-meeting-link" disabled
                            class="px-4 py-2 rounded-xl font-medium text-sm bg-[#7c3aed] text-white hover:bg-[#6d28d9] transition-colors disabled:opacity-40 disabled:cursor-not-allowed">
                        Apply to selected
                    </button>
                </div>
            </form>

            <script>
                (function () {
                    const form = document.getElementById('meeting-link-form');
                    if (!form) return;
                    const checkboxes = Array.from(form.querySelectorAll('.segment-checkbox'));
                    const segmentIdsField = document.getElementById('segment-ids-field');
                    const applyBtn = document.getElementById('apply-meeting-link');
                    const selectAllBtn = document.getElementById('select-all-segments');

                    function syncState() {
                        const selected = checkboxes.filter(cb => cb.checked).map(cb => cb.value);
                        segmentIdsField.value = JSON.stringify(selected);
                        applyBtn.disabled = selected.length === 0;
                    }

                    checkboxes.forEach(cb => cb.addEventListener('change', syncState));
                    selectAllBtn.addEventListener('click', () => {
                        const allSelected = checkboxes.every(cb => cb.checked);
                        checkboxes.forEach(cb => { cb.checked = !allSelected; });
                        syncState();
                    });

                    syncState();
                })();
            </script>
        }
    </div>

    @* ---------- Lecture materials: grouped by category like the Classroom ---------- *@
    @{
        var matCats = new[]
        {
            (Key: "LectureNote", Label: "Lecture Notes", Icon: "file-text", Cls: "bg-emerald-50 dark:bg-emerald-950 text-emerald-600 dark:text-emerald-300"),
            (Key: "Video", Label: "Videos", Icon: "play-circle", Cls: "bg-sky-50 dark:bg-sky-950 text-sky-600 dark:text-sky-300"),
            (Key: "Homework", Label: "Homework", Icon: "clipboard-check", Cls: "bg-amber-50 dark:bg-amber-950 text-amber-600 dark:text-amber-300"),
            (Key: "Assignment", Label: "Assignments", Icon: "clipboard-list", Cls: "bg-rose-50 dark:bg-rose-950 text-rose-600 dark:text-rose-300"),
        };
        var catKeys = matCats.Select(x => x.Key).ToHashSet();
        string CatOf(Web_Backend.Areas.Admin.Models.LectureMaterial m) => catKeys.Contains(m.Category) ? m.Category : "LectureNote";
        string TypeIcon(string t) => t switch { "Link" => "link", "Video" => "play-circle", "Image" => "image", "Audio" => "music", _ => "file-text" };
    }
    <div class="bg-white dark:bg-slate-900/60 rounded-[24px] shadow-sm border border-slate-100 dark:border-slate-700 overflow-hidden">
        <div class="p-6 border-b border-slate-100 dark:border-slate-700 flex flex-wrap items-center gap-3">
            <div class="bg-emerald-50 dark:bg-emerald-950 p-2 rounded-lg"><i data-lucide="library" class="w-5 h-5 text-emerald-600 dark:text-emerald-300"></i></div>
            <div>
                <h3 class="font-semibold text-lg text-slate-800 dark:text-slate-100">Lecture Materials</h3>
                <p class="text-xs text-slate-400 dark:text-slate-500">@materials.Count item@(materials.Count == 1 ? "" : "s") &middot; grouped like the Classroom</p>
            </div>
            <div class="ml-auto flex items-center gap-2">
                <a asp-area="Lecturer" asp-controller="Classroom" asp-action="Batch" asp-route-id="@Model.ScheduleID"
                   class="px-3 py-1.5 rounded-lg font-medium text-xs bg-slate-50 dark:bg-slate-800 text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-700 transition-colors flex items-center gap-1">
                    <i data-lucide="school" class="w-3.5 h-3.5"></i> Open Classroom
                </a>
                <a asp-area="Lecturer" asp-controller="Notes" asp-action="Upload" asp-route-scheduleId="@Model.ScheduleID"
                   class="px-3 py-1.5 rounded-lg font-medium text-xs bg-[#7c3aed] text-white hover:bg-[#6d28d9] transition-all flex items-center gap-1">
                    <i data-lucide="upload" class="w-3.5 h-3.5"></i> Upload
                </a>
            </div>
        </div>
        @if (materials.Count == 0)
        {
            <div class="p-10 text-center">
                <div class="w-12 h-12 rounded-2xl bg-slate-50 dark:bg-slate-800 flex items-center justify-center mx-auto mb-3"><i data-lucide="folder-open" class="w-6 h-6 text-slate-400"></i></div>
                <p class="text-sm text-slate-400 dark:text-slate-500">No materials uploaded for this batch yet.</p>
            </div>
        }
        else
        {
            <div class="px-6 pt-4 flex flex-wrap gap-2" id="matTabs" role="tablist">
                <button type="button" data-cat="all" class="mat-tab px-3 py-1.5 rounded-full text-xs font-medium transition-colors">All <span class="opacity-60">@materials.Count</span></button>
                @foreach (var mc in matCats)
                {
                    var n = materials.Count(m => CatOf(m) == mc.Key);
                    if (n == 0) { continue; }
                    <button type="button" data-cat="@mc.Key" class="mat-tab px-3 py-1.5 rounded-full text-xs font-medium transition-colors inline-flex items-center gap-1.5"><i data-lucide="@mc.Icon" class="w-3.5 h-3.5"></i>@mc.Label <span class="opacity-60">@n</span></button>
                }
            </div>
            <div class="p-6 pt-4 space-y-5">
                @foreach (var mc in matCats)
                {
                    var items = materials.Where(m => CatOf(m) == mc.Key).OrderByDescending(m => m.MaterialDate).ToList();
                    if (items.Count == 0) { continue; }
                    <section class="mat-group" data-cat="@mc.Key">
                        <div class="flex items-center gap-2 mb-2">
                            <span class="p-1.5 rounded-lg @mc.Cls"><i data-lucide="@mc.Icon" class="w-4 h-4"></i></span>
                            <h4 class="text-sm font-semibold text-slate-700 dark:text-slate-200">@mc.Label</h4>
                            <span class="text-xs text-slate-400">@items.Count</span>
                        </div>
                        <div class="rounded-2xl border border-slate-100 dark:border-slate-700 divide-y divide-slate-100 dark:divide-slate-700 overflow-hidden">
                            @foreach (var m in items)
                            {
                                var external = m.FileType == "Link" || m.FileType == "Video";
                                <div class="p-3 px-4 flex items-center gap-3 hover:bg-slate-50/70 dark:hover:bg-slate-800/40 transition-colors">
                                    <span class="w-9 h-9 rounded-xl bg-slate-50 dark:bg-slate-800 flex items-center justify-center flex-shrink-0"><i data-lucide="@TypeIcon(m.FileType)" class="w-4 h-4 text-slate-500 dark:text-slate-400"></i></span>
                                    <div class="min-w-0 flex-1">
                                        <p class="text-sm font-medium text-slate-800 dark:text-slate-100 truncate">@m.Title</p>
                                        <p class="text-xs text-slate-400 dark:text-slate-500">
                                            @m.MaterialDate.ToString("MMM d, yyyy") &middot; @m.FileType &middot; @m.UploadedByName
                                            @if (m.DueDate.HasValue) { <text> &middot; <span class="text-rose-600 dark:text-rose-300">Due @m.DueDate.Value.ToString("MMM d, h:mm tt")</span></text> }
                                            @if (m.MaxMarks.HasValue) { <text> &middot; @m.MaxMarks.Value.ToString("0.##") marks</text> }
                                        </p>
                                    </div>
                                    <button type="button" data-url="@m.FileURL" data-type="@m.FileType" data-title="@m.Title"
                                            onclick="if (this.dataset.type === 'Link' || this.dataset.type === 'Video' || this.dataset.type === 'Audio') window.open(this.dataset.url, '_blank', 'noopener'); else openMaterialPreview(this.dataset.url, this.dataset.type, this.dataset.title)"
                                            class="px-3 py-1.5 rounded-lg font-medium text-xs bg-slate-50 dark:bg-slate-800 text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-700 transition-colors flex-shrink-0 inline-flex items-center gap-1">
                                        <i data-lucide="@(external ? "external-link" : "eye")" class="w-3.5 h-3.5"></i> @(external ? "Open" : "View")
                                    </button>
                                </div>
                            }
                        </div>
                    </section>
                }
            </div>
            <script>
                (function () {
                    var tabs = document.querySelectorAll('#matTabs .mat-tab'), groups = document.querySelectorAll('.mat-group');
                    var on = ['bg-[#7c3aed]', 'text-white'], off = ['bg-slate-100', 'dark:bg-slate-800', 'text-slate-600', 'dark:text-slate-300', 'hover:bg-slate-200', 'dark:hover:bg-slate-700'];
                    function pick(cat) {
                        tabs.forEach(function (t) {
                            var a = t.dataset.cat === cat;
                            on.forEach(function (c) { t.classList.toggle(c, a); });
                            off.forEach(function (c) { t.classList.toggle(c, !a); });
                            t.setAttribute('aria-selected', a);
                        });
                        groups.forEach(function (g) { g.classList.toggle('hidden', cat !== 'all' && g.dataset.cat !== cat); });
                    }
                    tabs.forEach(function (t) { t.addEventListener('click', function () { pick(t.dataset.cat); }); });
                    pick('all');
                })();
            </script>
        }
    </div>
</div>

@await Html.PartialAsync("_MaterialPreviewModal")

