@model List<Web_Backend.Areas.Admin.Models.LectureMaterial>
@{
    ViewData["Title"] = "Lecture Notes";
}

<div class="max-w-5xl mx-auto space-y-8 page-enter">

    <div class="flex items-center justify-between flex-wrap gap-4">
        <div>
            <p class="text-sm font-medium text-slate-500 dark:text-slate-400 mb-2">Class Management</p>
            <h1 class="text-3xl md:text-4xl font-bold text-slate-800 dark:text-slate-100 tracking-tight">Lecture Notes</h1>
        </div>
        <a asp-area="Lecturer" asp-controller="Courses" asp-action="Index"
           class="px-4 py-2 rounded-xl font-medium text-sm bg-[#7c3aed] text-white hover:bg-[#6d28d9] shadow-sm transition-all flex items-center gap-2 w-fit">
            <i data-lucide="upload" class="w-4 h-4"></i> Upload New
        </a>
    </div>

    <div class="bg-white dark:bg-slate-900/60 rounded-[24px] shadow-sm border border-slate-100 dark:border-slate-700 overflow-hidden">
        @if (Model.Count == 0)
        {
            <div class="p-10 text-center">
                <p class="text-sm text-slate-400 dark:text-slate-500">No lecture materials uploaded yet.</p>
            </div>
        }
        else
        {
            <div class="divide-y divide-slate-100 dark:divide-slate-700">
                @foreach (var m in Model)
                {
                    <div class="p-4 px-6 flex items-center justify-between gap-4">
                        <div>
                            <p class="text-sm font-medium text-slate-800 dark:text-slate-100">@m.Title</p>
                            <p class="text-xs text-slate-400 dark:text-slate-500 mt-0.5">@m.CourseTitle &middot; @m.ScheduleName &middot; @m.MaterialDate.ToString("MMM d, yyyy") &middot; @m.FileType</p>
                            @if (!string.IsNullOrEmpty(m.Description))
                            {
                                <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">@m.Description</p>
                            }
                        </div>
                        <div class="flex items-center gap-2 flex-shrink-0">
                            <a href="@m.FileURL" target="_blank" rel="noopener"
                               class="px-3 py-1.5 rounded-lg font-medium text-xs bg-slate-50 dark:bg-slate-800 text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-700 transition-colors">
                                View
                            </a>
                            @if (m.UploadedByRole == "Lecturer")
                            {
                                <form asp-action="Delete" asp-route-id="@m.MaterialID" method="post" onsubmit="return confirm('Delete this material?');">
                                    <button type="submit" class="px-3 py-1.5 rounded-lg font-medium text-xs bg-red-50 dark:bg-red-950 text-red-600 dark:text-red-300 hover:bg-red-100 dark:hover:bg-red-900 transition-colors">
                                        Delete
                                    </button>
                                </form>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>
