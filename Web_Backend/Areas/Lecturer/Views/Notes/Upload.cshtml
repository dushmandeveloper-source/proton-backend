@model Web_Backend.Areas.LecturerPortal.Models.LectureMaterialFormModel
@{
    ViewData["Title"] = "Upload Lecture Material";
    var batches = ViewBag.Batches as List<Web_Backend.Areas.Admin.Models.CourseSchedule> ?? new();
    var batch = batches.FirstOrDefault(b => b.ScheduleID == Model.ScheduleID);
}

<div class="max-w-2xl mx-auto space-y-8 page-enter">

    <div>
        <p class="text-sm font-medium text-slate-500 dark:text-slate-400 mb-2">@Model.CourseTitle &middot; @Model.ScheduleName</p>
        <h1 class="text-3xl md:text-4xl font-bold text-slate-800 dark:text-slate-100 tracking-tight">Upload Lecture Material</h1>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-2">Documents, images, or video for this batch. Max 100 MB. Allowed types: PDF, Word, PowerPoint, Excel, JPG/PNG/WEBP, MP4/MOV/WEBM.</p>
    </div>

    <div class="bg-white dark:bg-slate-900/60 rounded-[24px] shadow-sm border border-slate-100 dark:border-slate-700 overflow-hidden">
        <form asp-action="Upload" method="post" enctype="multipart/form-data" class="p-6 space-y-5">
            <input type="hidden" asp-for="ScheduleID" />
            <input type="hidden" asp-for="ScheduleName" />
            <input type="hidden" asp-for="CourseTitle" />

            @if (batch != null && batch.Segments.Count > 0)
            {
                <div>
                    <label class="block text-sm font-medium text-slate-700 dark:text-slate-200 mb-1.5">Class Occurrence (optional — leave blank for a batch-wide note)</label>
                    <select asp-for="SegmentID"
                            class="w-full px-4 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-slate-800 dark:text-slate-100 focus:outline-none focus:ring-2 focus:ring-[#7c3aed]/40">
                        <option value="">-- Batch-wide note --</option>
                        @foreach (var seg in batch.Segments.OrderBy(s => s.SortOrder))
                        {
                            <option value="@seg.SegmentID">@seg.DateRangeText &middot; @seg.DaysOfWeekLabel</option>
                        }
                    </select>
                </div>
            }

            <div>
                <label class="block text-sm font-medium text-slate-700 dark:text-slate-200 mb-1.5">Class Date</label>
                <input asp-for="MaterialDate" type="date"
                       class="w-full px-4 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-slate-800 dark:text-slate-100 focus:outline-none focus:ring-2 focus:ring-[#7c3aed]/40" />
                <span asp-validation-for="MaterialDate" class="text-xs text-red-600 dark:text-red-400"></span>
            </div>

            <div>
                <label class="block text-sm font-medium text-slate-700 dark:text-slate-200 mb-1.5">Title</label>
                <input asp-for="Title" type="text"
                       class="w-full px-4 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-slate-800 dark:text-slate-100 focus:outline-none focus:ring-2 focus:ring-[#7c3aed]/40" />
                <span asp-validation-for="Title" class="text-xs text-red-600 dark:text-red-400"></span>
            </div>

            <div>
                <label class="block text-sm font-medium text-slate-700 dark:text-slate-200 mb-1.5">Description (optional)</label>
                <textarea asp-for="Description" rows="3"
                          class="w-full px-4 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-slate-800 dark:text-slate-100 focus:outline-none focus:ring-2 focus:ring-[#7c3aed]/40"></textarea>
            </div>

            <div>
                <label class="block text-sm font-medium text-slate-700 dark:text-slate-200 mb-1.5">File</label>
                <input type="file" name="file" required
                       class="w-full px-4 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-slate-800 dark:text-slate-100 focus:outline-none focus:ring-2 focus:ring-[#7c3aed]/40" />
            </div>

            <div class="flex items-center gap-3 pt-2">
                <button type="submit"
                        class="px-5 py-2.5 rounded-xl font-medium text-sm bg-[#7c3aed] text-white hover:bg-[#6d28d9] shadow-sm transition-all">
                    Upload
                </button>
                <a asp-area="Lecturer" asp-controller="Courses" asp-action="Details" asp-route-scheduleId="@Model.ScheduleID"
                   class="px-5 py-2.5 rounded-xl font-medium text-sm bg-slate-50 dark:bg-slate-800 text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-700 transition-colors">
                    Cancel
                </a>
            </div>
        </form>
    </div>
</div>
