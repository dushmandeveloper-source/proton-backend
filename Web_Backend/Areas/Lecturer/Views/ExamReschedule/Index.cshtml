@model List<Web_Backend.Areas.Admin.Models.ExamScheduleReschedule>
@{
    ViewData["Title"] = "Exam Reschedule Requests";
}

<div class="max-w-5xl mx-auto space-y-8 page-enter">

    <div>
        <p class="text-sm font-medium text-slate-500 dark:text-slate-400 mb-2">Examination Scheduling</p>
        <h1 class="text-3xl md:text-4xl font-bold text-slate-800 dark:text-slate-100 tracking-tight">Exam Reschedule Requests</h1>
    </div>

    <div class="bg-white dark:bg-slate-900/60 rounded-[24px] shadow-sm border border-slate-100 dark:border-slate-700 overflow-hidden">
        @if (Model.Count == 0)
        {
            <div class="p-10 text-center">
                <p class="text-sm text-slate-400 dark:text-slate-500">You haven't submitted any exam reschedule requests yet. Go to <a asp-area="Lecturer" asp-controller="ExamSchedule" asp-action="Index" class="text-[#7c3aed] underline">Examination Scheduling</a> to request one.</p>
            </div>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="w-full text-sm">
                    <thead>
                        <tr class="text-left text-xs font-semibold text-slate-400 dark:text-slate-500 uppercase tracking-wider border-b border-slate-100 dark:border-slate-700">
                            <th class="px-6 py-3">Exam</th>
                            <th class="px-6 py-3">Original Date</th>
                            <th class="px-6 py-3">Proposed Date</th>
                            <th class="px-6 py-3">Status</th>
                            <th class="px-6 py-3">Admin Remark</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 dark:divide-slate-700">
                        @foreach (var r in Model)
                        {
                            <tr>
                                <td class="px-6 py-3 font-medium text-slate-800 dark:text-slate-100">@r.ExamTitle &middot; @r.ScheduleName</td>
                                <td class="px-6 py-3 text-slate-600 dark:text-slate-300">@r.OriginalDate.ToString("MMM d, yyyy")</td>
                                <td class="px-6 py-3 text-slate-600 dark:text-slate-300">@r.ProposedNewDate.ToString("MMM d, yyyy")</td>
                                <td class="px-6 py-3">
                                    <span class="inline-flex px-2.5 py-1 rounded-full text-xs font-medium @(r.Status == "Approved" ? "bg-emerald-50 dark:bg-emerald-950 text-emerald-600 dark:text-emerald-300" : r.Status == "Rejected" ? "bg-red-50 dark:bg-red-950 text-red-600 dark:text-red-300" : "bg-amber-50 dark:bg-amber-950 text-amber-600 dark:text-amber-300")">
                                        @r.Status
                                    </span>
                                </td>
                                <td class="px-6 py-3 text-slate-500 dark:text-slate-400 text-xs">@r.AdminRemark</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
