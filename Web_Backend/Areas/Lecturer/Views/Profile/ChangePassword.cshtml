@model ChangePasswordViewModel
@{
    ViewData["Title"] = "Change Password";
}

<div class="max-w-md mx-auto page-enter">
    <div class="flex items-center gap-3 mb-6">
        <a asp-action="Index" class="p-2 rounded-xl text-slate-400 dark:text-slate-500 hover:bg-slate-100 dark:hover:bg-slate-700 transition-colors">
            <i data-lucide="arrow-left" class="w-5 h-5"></i>
        </a>
        <h2 class="text-2xl font-bold text-slate-800 dark:text-slate-100 tracking-tight">Change Password</h2>
    </div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="mb-4 text-sm text-red-600 dark:text-red-400 bg-red-50 dark:bg-red-950 border border-red-100 dark:border-red-900 rounded-xl px-4 py-2">
            @Model.ErrorMessage
        </div>
    }

    <form method="post" asp-action="ChangePassword" class="bg-white dark:bg-slate-900/60 rounded-[24px] shadow-sm border border-slate-100 dark:border-slate-700 p-6 space-y-5">
        @Html.AntiForgeryToken()
        <div class="space-y-1">
            <label class="text-sm font-medium text-slate-700 dark:text-slate-300">Current Password</label>
            <input asp-for="CurrentPassword" type="password" class="w-full rounded-xl border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-800 text-slate-800 dark:text-slate-100 px-4 py-2.5 text-sm outline-none focus:border-[#7c3aed] focus:ring-1 focus:ring-[#7c3aed]" />
        </div>
        <div class="space-y-1">
            <label class="text-sm font-medium text-slate-700 dark:text-slate-300">New Password</label>
            <input asp-for="NewPassword" type="password" class="w-full rounded-xl border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-800 text-slate-800 dark:text-slate-100 px-4 py-2.5 text-sm outline-none focus:border-[#7c3aed] focus:ring-1 focus:ring-[#7c3aed]" />
        </div>
        <div class="space-y-1">
            <label class="text-sm font-medium text-slate-700 dark:text-slate-300">Confirm New Password</label>
            <input asp-for="ConfirmPassword" type="password" class="w-full rounded-xl border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-800 text-slate-800 dark:text-slate-100 px-4 py-2.5 text-sm outline-none focus:border-[#7c3aed] focus:ring-1 focus:ring-[#7c3aed]" />
        </div>
        <button type="submit" class="w-full py-3 rounded-xl font-medium text-base bg-[#7c3aed] text-white hover:bg-[#6d28d9] shadow-lg shadow-purple-500/25 transition-all">
            Change Password
        </button>
    </form>
</div>
