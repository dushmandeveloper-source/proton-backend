@section Scripts {
    @if (Model.ActiveTab == "about")
    {
        <script src="https://cdn.ckeditor.com/4.22.1/standard/ckeditor.js"></script>
        <script>
            ['aboutEditor', 'reqEditor', 'docsEditor'].forEach(id => {
                if (document.getElementById(id)) {
                    CKEDITOR.replace(id, {
                        allowedContent: true,
                        height: 260,
                        toolbar: [
                            { name: 'clipboard', items: ['Undo', 'Redo'] },
                            { name: 'basicstyles', items: ['Bold', 'Italic', 'Underline', '-', 'RemoveFormat'] },
                            { name: 'paragraph', items: ['NumberedList', 'BulletedList', '-', 'Outdent', 'Indent'] },
                            { name: 'links', items: ['Link', 'Unlink'] },
                            { name: 'insert', items: ['Table', 'HorizontalRule'] },
                            { name: 'styles', items: ['Format'] },
                            { name: 'tools', items: ['Maximize', 'Source'] }
                        ]
                    });
                }
            });
        </script>
    }

    @if (Model.ActiveTab == "location")
    {
        <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
        <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
        <script>
            (function () {
                const latInput = document.getElementById('latInput');
                const lngInput = document.getElementById('lngInput');
                const startLat = parseFloat(latInput.value);
                const startLng = parseFloat(lngInput.value);
                const hasStart = !isNaN(startLat) && !isNaN(startLng);

                // Default view: roughly centred on China, since that's where
                // partner universities are.
                const map = L.map('picker-map').setView(
                    hasStart ? [startLat, startLng] : [35.8617, 104.1954],
                    hasStart ? 14 : 4
                );
                window.protonApplyBasemap(map);

                const icon = window.protonPinIcon();
                let marker = hasStart ? L.marker([startLat, startLng], { icon, draggable: true }).addTo(map) : null;

                function writeInputs(latlng) {
                    latInput.value = latlng.lat.toFixed(7);
                    lngInput.value = latlng.lng.toFixed(7);
                }

                function placePin(latlng, zoom) {
                    if (marker) {
                        marker.setLatLng(latlng);
                    } else {
                        marker = L.marker(latlng, { icon, draggable: true }).addTo(map);
                        marker.on('dragend', () => writeInputs(marker.getLatLng()));
                    }
                    writeInputs(latlng);
                    map.setView(latlng, zoom || Math.max(map.getZoom(), 14));
                }

                if (marker) marker.on('dragend', () => writeInputs(marker.getLatLng()));
                map.on('click', (e) => placePin(e.latlng));

                document.getElementById('clearPin').addEventListener('click', () => {
                    if (marker) { map.removeLayer(marker); marker = null; }
                    latInput.value = '';
                    lngInput.value = '';
                });

                // Typing coordinates by hand should move the pin too.
                [latInput, lngInput].forEach(inp => inp.addEventListener('change', () => {
                    const la = parseFloat(latInput.value), ln = parseFloat(lngInput.value);
                    if (!isNaN(la) && !isNaN(ln)) placePin(L.latLng(la, ln));
                }));

                // Nominatim geocoding — free, key-free. Usage policy asks for a
                // single request per user action (no autocomplete-per-keystroke),
                // which is why this is behind an explicit Search button/Enter.
                async function runSearch() {
                    const q = document.getElementById('geoSearch').value.trim();
                    if (!q) return;
                    try {
                        const res = await fetch('https://nominatim.openstreetmap.org/search?format=json&limit=1&q=' + encodeURIComponent(q));
                        const hits = await res.json();
                        if (!hits.length) { showToast('No location found for that search.', 'error'); return; }

                        const hit = hits[0];
                        placePin(L.latLng(parseFloat(hit.lat), parseFloat(hit.lon)), 15);
                        marker.bindPopup(hit.display_name).openPopup();

                        // Backfill the address fields only where they're empty,
                        // so a manual correction is never overwritten.
                        const addr = document.getElementById('addressInput');
                        if (addr && !addr.value) addr.value = hit.display_name;
                    } catch (err) {
                        showToast('Location search failed. Check your connection.', 'error');
                    }
                }

                document.getElementById('geoSearchBtn').addEventListener('click', runSearch);
                document.getElementById('geoSearch').addEventListener('keydown', (e) => {
                    if (e.key === 'Enter') { e.preventDefault(); runSearch(); }
                });
            })();
        </script>
    }
}
