@model AppUser
@{
    ViewData["Title"] = "Lecturer Details";
    var batches = ViewBag.Batches as List<CourseSchedule> ?? new();
    bool canEdit = Web_Backend.Classes.Auth.HasPermission(Web_Backend.Classes.PermissionCode.UserManagement, 'E');
    bool canDelete = Web_Backend.Classes.Auth.HasPermission(Web_Backend.Classes.PermissionCode.UserManagement, 'D');
}

<div class="max-w-4xl mx-auto space-y-8 page-enter">

    <div class="flex items-center justify-between flex-wrap gap-4">
        <div class="flex items-center gap-4">
            @if (!string.IsNullOrEmpty(Model.ProfileImageUrl))
            {
                <img src="@Model.ProfileImageUrl" alt="" class="w-14 h-14 rounded-full object-cover" />
            }
            else
            {
                <div class="w-14 h-14 rounded-full bg-purple-50 dark:bg-purple-950 flex items-center justify-center text-[#7c3aed] dark:text-purple-300 font-semibold text-xl">
                    @(Model.FirstName.Length > 0 ? Model.FirstName[0].ToString().ToUpper() : "?")
                </div>
            }
            <div>
                <p class="text-sm font-medium text-slate-500 dark:text-slate-400">Lecturer</p>
                <h1 class="text-2xl md:text-3xl font-bold text-slate-800 dark:text-slate-100 tracking-tight">@Model.FullName</h1>
            </div>
        </div>
        <a asp-action="Index" class="px-4 py-2 rounded-xl font-medium text-sm bg-slate-50 dark:bg-slate-800 text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-700 transition-colors flex items-center gap-2 w-fit">
            <i data-lucide="arrow-left" class="w-4 h-4"></i> Back to Lecturers
        </a>
    </div>

    <div class="bg-white dark:bg-slate-900/60 rounded-[24px] shadow-sm border border-slate-100 dark:border-slate-700 overflow-hidden">
        <div class="p-6 border-b border-slate-100 dark:border-slate-700 flex items-center gap-3">
            <div class="bg-purple-50 dark:bg-purple-950 p-2 rounded-lg"><i data-lucide="user-circle" class="w-5 h-5 text-purple-600 dark:text-purple-300"></i></div>
            <h3 class="font-semibold text-lg text-slate-800 dark:text-slate-100">Account Information</h3>
            <span class="ml-auto px-2 py-0.5 rounded-full text-xs font-semibold @(Model.IsActive == "A" ? "bg-emerald-100 dark:bg-emerald-950 text-emerald-700 dark:text-emerald-300" : "bg-slate-100 dark:bg-slate-800 text-slate-500 dark:text-slate-400")">@Model.StatusLabel</span>
        </div>
        <div class="p-6 grid grid-cols-1 md:grid-cols-2 gap-6 text-sm">
            <div>
                <p class="text-xs text-slate-400 dark:text-slate-500 uppercase tracking-wider mb-0.5">Email</p>
                <p class="text-slate-700 dark:text-slate-200 font-medium">@Model.Email</p>
            </div>
            <div>
                <p class="text-xs text-slate-400 dark:text-slate-500 uppercase tracking-wider mb-0.5">Phone</p>
                <p class="text-slate-700 dark:text-slate-200 font-medium">@(string.IsNullOrEmpty(Model.Phone) ? "-" : Model.Phone)</p>
            </div>
        </div>
        @if (canEdit || canDelete)
        {
            <div class="px-6 pb-6 flex flex-wrap items-center gap-3">
                @if (canEdit)
                {
                    <form method="post" asp-action="ResetAndSendPassword" asp-route-userId="@Model.UserID"
                          data-confirm="Generate a new temporary password and email it to this lecturer?" data-confirm-title="Reset password" data-confirm-label="Reset">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="px-4 py-2 rounded-xl font-medium text-sm bg-slate-50 dark:bg-slate-800 text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-700 transition-colors">
                            Reset &amp; Email Password
                        </button>
                    </form>
                }
                @if (canDelete)
                {
                    <form method="post" asp-action="Delete" asp-route-id="@Model.UserID"
                          data-confirm="Deactivate this lecturer account?" data-confirm-title="Deactivate lecturer" data-confirm-label="Deactivate">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="px-4 py-2 rounded-xl font-medium text-sm bg-red-50 dark:bg-red-950 text-red-600 dark:text-red-300 hover:bg-red-100 dark:hover:bg-red-900 transition-colors">
                            Deactivate
                        </button>
                    </form>
                }
            </div>
        }
    </div>

    @* ---------- Assigned batches ---------- *@
    <div class="bg-white dark:bg-slate-900/60 rounded-[24px] shadow-sm border border-slate-100 dark:border-slate-700 overflow-hidden">
        <div class="p-6 border-b border-slate-100 dark:border-slate-700 flex items-center gap-3">
            <div class="bg-indigo-50 dark:bg-indigo-950 p-2 rounded-lg"><i data-lucide="graduation-cap" class="w-5 h-5 text-indigo-600 dark:text-indigo-300"></i></div>
            <h3 class="font-semibold text-lg text-slate-800 dark:text-slate-100">Assigned Batches</h3>
        </div>
        @if (batches.Count == 0)
        {
            <div class="p-10 text-center">
                <p class="text-sm text-slate-400 dark:text-slate-500">Not assigned to any batches. Assign via Course Schedules.</p>
            </div>
        }
        else
        {
            <div class="divide-y divide-slate-100 dark:divide-slate-700">
                @foreach (var b in batches)
                {
                    <div class="p-4 px-6">
                        <p class="text-sm font-medium text-slate-800 dark:text-slate-100">@b.CourseTitle &middot; @b.ScheduleName</p>
                        <button type="button" class="view-periods-btn mt-1 px-2.5 py-1 rounded-lg text-xs font-medium bg-slate-50 dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700 transition-colors inline-flex items-center gap-1"
                                data-schedule-name="@(string.IsNullOrEmpty(b.ScheduleName) ? b.CourseTitle : b.ScheduleName)"
                                data-periods='@Html.Raw(System.Text.Json.JsonSerializer.Serialize(b.Segments.OrderBy(seg => seg.SortOrder).Select(seg => new {
                                    dateRange = seg.DateRangeText, days = seg.DaysOfWeekLabel, time = seg.TimeRangeText,
                                    daysOff = seg.ExceptionCount, meetingLink = seg.MeetingLink
                                })))'>
                            <i data-lucide="calendar-days" class="w-3.5 h-3.5"></i>
                            @b.Segments.Count period@(b.Segments.Count == 1 ? "" : "s")
                        </button>
                    </div>
                }
            </div>
        }
    </div>
</div>

@* ---------- Periods popup (shared by the "N periods" button) ---------- *@
<div id="periods-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/40" role="dialog" aria-modal="true">
    <div class="bg-white dark:bg-slate-900 rounded-[24px] shadow-xl border border-slate-100 dark:border-slate-700 w-full max-w-lg max-h-[80vh] flex flex-col">
        <div class="p-5 border-b border-slate-100 dark:border-slate-700 flex items-center justify-between gap-3">
            <h3 id="periods-modal-title" class="font-semibold text-slate-800 dark:text-slate-100"></h3>
            <button type="button" id="periods-modal-close" class="p-1.5 rounded-lg text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800">
                <i data-lucide="x" class="w-4 h-4"></i>
            </button>
        </div>
        <div id="periods-modal-body" class="p-5 space-y-3 overflow-y-auto"></div>
    </div>
</div>
<script>
    (function () {
        const modal = document.getElementById('periods-modal');
        const title = document.getElementById('periods-modal-title');
        const body = document.getElementById('periods-modal-body');

        function openModal(scheduleName, periods) {
            title.textContent = scheduleName;
            body.innerHTML = periods.length === 0
                ? '<p class="text-sm text-slate-400 dark:text-slate-500">No periods defined.</p>'
                : periods.map(p => `
                    <div class="rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-100 dark:border-slate-700 px-4 py-3">
                        <p class="text-sm font-semibold text-slate-800 dark:text-slate-100">${p.dateRange}</p>
                        <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">${p.days}${p.time ? ' · ' + p.time : ''}</p>
                        ${p.daysOff > 0 ? `<p class="text-xs text-amber-600 dark:text-amber-300 mt-0.5">${p.daysOff} day${p.daysOff === 1 ? '' : 's'} off</p>` : ''}
                        ${p.meetingLink ? `<a href="${p.meetingLink}" target="_blank" rel="noopener" class="text-xs text-[#7c3aed] hover:underline mt-1 inline-flex items-center gap-1"><i data-lucide="video" class="w-3 h-3"></i> Join meeting</a>` : ''}
                    </div>`).join('');
            modal.classList.remove('hidden');
            if (window.lucide) lucide.createIcons();
        }

        function closeModal() { modal.classList.add('hidden'); }

        document.querySelectorAll('.view-periods-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                const periods = JSON.parse(btn.dataset.periods || '[]');
                openModal(btn.dataset.scheduleName || '', periods);
            });
        });

        document.getElementById('periods-modal-close').addEventListener('click', closeModal);
        modal.addEventListener('click', (e) => { if (e.target === modal) closeModal(); });
        document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeModal(); });
    })();
</script>
