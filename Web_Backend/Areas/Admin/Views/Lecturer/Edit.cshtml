@model AppUser
@{
    var isNew = string.IsNullOrEmpty(Model.UserID);
    ViewData["Title"] = isNew ? "Add Lecturer" : "Edit Lecturer";
}

<div class="max-w-2xl mx-auto page-enter">
    <div class="flex items-center gap-3 mb-6">
        <a asp-action="Index" class="p-2 rounded-xl text-slate-400 dark:text-slate-500 hover:bg-slate-100 dark:hover:bg-slate-700 transition-colors">
            <i data-lucide="arrow-left" class="w-5 h-5"></i>
        </a>
        <h2 class="text-2xl font-bold text-slate-800 dark:text-slate-100 tracking-tight">@ViewData["Title"]</h2>
    </div>

    <form method="post" asp-action="Save" enctype="multipart/form-data" class="bg-white dark:bg-slate-900/60 rounded-[24px] shadow-sm border border-slate-100 dark:border-slate-700 p-6 space-y-5">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="UserID" />

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="space-y-1">
                <label class="text-sm font-medium text-slate-700 dark:text-slate-300">First Name</label>
                <input asp-for="FirstName" required class="w-full rounded-xl border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-800 text-slate-800 dark:text-slate-100 px-4 py-2.5 text-sm outline-none focus:border-[#7c3aed] focus:ring-1 focus:ring-[#7c3aed]" />
                <span asp-validation-for="FirstName" class="text-xs text-red-600 dark:text-red-400"></span>
            </div>
            <div class="space-y-1">
                <label class="text-sm font-medium text-slate-700 dark:text-slate-300">Last Name</label>
                <input asp-for="LastName" required class="w-full rounded-xl border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-800 text-slate-800 dark:text-slate-100 px-4 py-2.5 text-sm outline-none focus:border-[#7c3aed] focus:ring-1 focus:ring-[#7c3aed]" />
                <span asp-validation-for="LastName" class="text-xs text-red-600 dark:text-red-400"></span>
            </div>
            <div class="space-y-1">
                <label class="text-sm font-medium text-slate-700 dark:text-slate-300">Email</label>
                <input asp-for="Email" type="email" required readonly="@(!isNew)" class="w-full rounded-xl border border-slate-200 dark:border-slate-600 @(isNew ? "bg-white dark:bg-slate-800" : "bg-slate-50 dark:bg-slate-800/60 text-slate-500 dark:text-slate-400 cursor-not-allowed") text-slate-800 dark:text-slate-100 px-4 py-2.5 text-sm outline-none focus:border-[#7c3aed] focus:ring-1 focus:ring-[#7c3aed]" />
                <span asp-validation-for="Email" class="text-xs text-red-600 dark:text-red-400"></span>
            </div>
            <div class="space-y-1">
                <label class="text-sm font-medium text-slate-700 dark:text-slate-300">Phone</label>
                <input asp-for="Phone" class="w-full rounded-xl border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-800 text-slate-800 dark:text-slate-100 px-4 py-2.5 text-sm outline-none focus:border-[#7c3aed] focus:ring-1 focus:ring-[#7c3aed]" />
                <span asp-validation-for="Phone" class="text-xs text-red-600 dark:text-red-400"></span>
            </div>
        </div>

        <div class="space-y-1">
            <label class="text-sm font-medium text-slate-700 dark:text-slate-300">Profile Photo</label>
            <input type="file" name="profileImage" accept="image/*,.svg"
                   class="text-sm text-slate-600 dark:text-slate-300 file:mr-3 file:py-1.5 file:px-3 file:rounded-lg file:border-0 file:text-xs file:font-medium file:bg-purple-50 dark:file:bg-purple-950 file:text-[#7c3aed] dark:file:text-purple-300" />
        </div>

        @if (isNew)
        {
            <label class="flex items-center gap-2 text-sm text-slate-600 dark:text-slate-300 cursor-pointer">
                <input type="checkbox" name="sendWelcomeEmail" value="true" checked
                       class="rounded border-slate-300 dark:border-slate-600 text-[#7c3aed] focus:ring-[#7c3aed]" />
                Email a temporary password to this lecturer
            </label>
        }
        else
        {
            <div class="space-y-1">
                <label class="text-sm font-medium text-slate-700 dark:text-slate-300">Status</label>
                <select asp-for="IsActive" class="w-full md:w-48 rounded-xl border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-800 text-slate-800 dark:text-slate-100 px-4 py-2.5 text-sm outline-none focus:border-[#7c3aed] focus:ring-1 focus:ring-[#7c3aed]">
                    <option value="A">Active</option>
                    <option value="I">Inactive</option>
                </select>
            </div>
        }

        <div class="flex items-center justify-end gap-3 pt-4 border-t border-slate-100 dark:border-slate-700">
            <a asp-action="Index" class="px-5 py-2.5 rounded-xl font-medium text-sm bg-slate-50 dark:bg-slate-800 text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-700 transition-colors">Cancel</a>
            <button type="submit" class="px-5 py-2.5 rounded-xl font-medium text-sm bg-[#7c3aed] text-white hover:bg-[#6d28d9] shadow-sm transition-all">Save</button>
        </div>
    </form>
</div>
