@model List<EmailTemplate>
@{
    ViewData["Title"] = "Email Templates";
    bool canAddEmailTemplate = Web_Backend.Classes.Auth.HasPermission(Web_Backend.Classes.PermissionCode.EmailTemplates, 'A');
    bool canEditEmailTemplate = Web_Backend.Classes.Auth.HasPermission(Web_Backend.Classes.PermissionCode.EmailTemplates, 'E');
    bool canDeleteEmailTemplate = Web_Backend.Classes.Auth.HasPermission(Web_Backend.Classes.PermissionCode.EmailTemplates, 'D');
    var deleteImpacts = ViewBag.DeleteImpacts as Dictionary<string, EmailTemplateDeleteImpact> ?? new();
}

<div class="max-w-5xl mx-auto page-enter">
    <div class="flex flex-col md:flex-row md:items-center justify-between mb-8 gap-4">
        <div>
            <h2 class="text-3xl font-bold text-slate-800 dark:text-slate-100 tracking-tight">Email Templates</h2>
            <p class="text-slate-500 dark:text-slate-400 mt-2">Reusable subject/body content for account and notification emails.</p>
        </div>
        @if (canAddEmailTemplate)
        {
            <a asp-action="Add" class="px-4 py-2 rounded-xl font-medium bg-[#7c3aed] text-white hover:bg-[#6d28d9] shadow-sm text-sm flex items-center gap-2">
                <i data-lucide="plus" class="w-4 h-4"></i> New Template
            </a>
        }
    </div>

    <div class="bg-white dark:bg-slate-900/60 rounded-[24px] shadow-sm border border-slate-100 dark:border-slate-700 overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="border-b border-slate-100 dark:border-slate-700 bg-slate-50/50 dark:bg-slate-800/50">
                        <th class="px-6 py-4 text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Template</th>
                        <th class="px-6 py-4 text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Code</th>
                        <th class="px-6 py-4 text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Subject</th>
                        <th class="px-6 py-4 text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Status</th>
                        <th class="px-6 py-4 text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 dark:divide-slate-700">
                    @if (!Model.Any())
                    {
                        <tr><td colspan="5" class="px-6 py-8 text-center text-sm text-slate-400 dark:text-slate-500">No templates yet.</td></tr>
                    }
                    @foreach (var t in Model)
                    {
                        <tr class="hover:bg-slate-50/50 dark:hover:bg-slate-800/50 transition-colors">
                            <td class="px-6 py-4 font-medium text-slate-800 dark:text-slate-100 text-sm">@t.TemplateName</td>
                            <td class="px-6 py-4 text-sm text-slate-500 dark:text-slate-400"><code class="bg-slate-100 dark:bg-slate-800 px-2 py-0.5 rounded">@t.TemplateCode</code></td>
                            <td class="px-6 py-4 text-sm text-slate-600 dark:text-slate-300">@t.Subject</td>
                            <td class="px-6 py-4">
                                @{
                                    var statusColor = t.IsActive == "A" ? "bg-emerald-100 dark:bg-emerald-950 text-emerald-700 dark:text-emerald-300" : "bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300";
                                }
                                <span class="px-2.5 py-0.5 rounded-full text-xs font-medium @statusColor">@(t.IsActive == "A" ? "Active" : "Inactive")</span>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <div class="flex items-center justify-end gap-1 flex-nowrap">
                                    @if (canEditEmailTemplate)
                                    {
                                        <a asp-action="Edit" asp-route-id="@t.TemplateID" title="Edit"
                                           class="text-slate-400 dark:text-slate-500 hover:text-[#7c3aed] dark:hover:text-[#a78bfa] p-1.5 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-700 transition-colors inline-flex">
                                            <i data-lucide="pencil" class="w-4 h-4"></i>
                                        </a>
                                    }
                                    @{
                                        deleteImpacts.TryGetValue(t.TemplateID, out var impact);
                                        var isSystemTemplate = impact?.IsSystemTemplate ?? false;
                                    }
                                    @if (isSystemTemplate)
                                    {
                                        <span title="The app sends mail through this template, so it can only be edited — not turned off or deleted."
                                              class="inline-flex items-center gap-1 px-2 py-1 rounded-lg text-[11px] font-medium bg-slate-100 dark:bg-slate-800 text-slate-500 dark:text-slate-400 cursor-help">
                                            <i data-lucide="lock" class="w-3.5 h-3.5"></i> In use by the app
                                        </span>
                                    }
                                    else
                                    {
                                        if (canEditEmailTemplate && t.IsActive != "A")
                                        {
                                            <form method="post" asp-action="Activate" asp-route-id="@t.TemplateID" class="inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" title="Activate" class="text-slate-400 dark:text-slate-500 hover:text-emerald-600 dark:hover:text-emerald-400 p-1.5 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-700 transition-colors">
                                                    <i data-lucide="rotate-ccw" class="w-4 h-4"></i>
                                                </button>
                                            </form>
                                        }
                                        if (canDeleteEmailTemplate)
                                        {
                                            if (t.IsActive == "A")
                                            {
                                                <form method="post" asp-action="Deactivate" asp-route-id="@t.TemplateID" class="inline"
                                                      data-confirm="This stops the '@t.TemplateName' template being used, but keeps its wording so you can turn it back on later."
                                                      data-confirm-title="Deactivate template" data-confirm-label="Deactivate">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" title="Deactivate" class="text-slate-400 dark:text-slate-500 hover:text-amber-600 dark:hover:text-amber-400 p-1.5 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-700 transition-colors">
                                                        <i data-lucide="eye-off" class="w-4 h-4"></i>
                                                    </button>
                                                </form>
                                            }
                                            <form method="post" asp-action="DeletePermanently" asp-route-id="@t.TemplateID" class="inline"
                                                  data-confirm="This permanently removes the '@t.TemplateName' template and its wording. This cannot be undone."
                                                  data-confirm-title="Delete '@t.TemplateName' permanently?" data-confirm-label="Delete Permanently">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" title="Delete Permanently" class="text-red-500 dark:text-red-400 hover:text-white hover:bg-red-600 dark:hover:bg-red-600 p-1.5 rounded-lg transition-colors">
                                                    <i data-lucide="trash-2" class="w-4 h-4"></i>
                                                </button>
                                            </form>
                                        }
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
