@model List<StudentIndexRowViewModel>
@{
    ViewData["Title"] = "Students";
    var keyW = ViewBag.KeyW as string ?? "";
    var showInactive = ViewBag.ShowInactive as bool? ?? false;
    var enrollmentFilter = ViewBag.EnrollmentFilter as string ?? "";
    var paymentStatusFilter = ViewBag.PaymentStatusFilter as string ?? "";

    bool canAddStudent = Web_Backend.Classes.Auth.HasPermission(Web_Backend.Classes.PermissionCode.Students, 'A');
    bool canEditStudent = Web_Backend.Classes.Auth.HasPermission(Web_Backend.Classes.PermissionCode.Students, 'E');
    bool canDeleteStudent = Web_Backend.Classes.Auth.HasPermission(Web_Backend.Classes.PermissionCode.Students, 'D');
}

<div class="max-w-6xl mx-auto page-enter">
    <div class="flex flex-col md:flex-row md:items-center justify-between mb-6 gap-4">
        <div>
            <h2 class="text-3xl font-bold text-slate-800 dark:text-slate-100 tracking-tight">Students</h2>
            <p class="text-slate-500 dark:text-slate-400 mt-2">Registered students, whether self-registered or added by an admin.</p>
        </div>
        @if (canAddStudent)
        {
            <a asp-action="Add" class="px-4 py-2 rounded-xl font-medium bg-[#7c3aed] text-white hover:bg-[#6d28d9] shadow-sm text-sm flex items-center gap-2 w-fit">
                <i data-lucide="plus" class="w-4 h-4"></i> Register Student
            </a>
        }
    </div>

    <form method="get" class="flex flex-wrap items-center gap-3 mb-6">
        <div class="relative w-full md:w-auto">
            <i data-lucide="search" class="w-4 h-4 text-slate-400 dark:text-slate-500 absolute left-3 top-1/2 -translate-y-1/2"></i>
            <input type="text" name="KeyW" value="@keyW" placeholder="Search name, email or passport no..."
                   class="w-full md:w-auto pl-9 pr-4 py-2 rounded-xl border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-800 text-slate-800 dark:text-slate-100 text-sm focus:outline-none focus:border-purple-400 focus:ring-1 focus:ring-purple-400" />
        </div>
        <label class="flex items-center gap-2 text-sm text-slate-600 dark:text-slate-300 cursor-pointer">
            <input type="checkbox" name="showInactive" value="true" checked="@showInactive"
                   class="rounded border-slate-300 dark:border-slate-600 text-[#7c3aed] focus:ring-[#7c3aed]" />
            Show inactive
        </label>
        <select name="enrollmentFilter"
                class="w-full md:w-auto px-3 py-2 rounded-xl border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-800 text-slate-800 dark:text-slate-100 text-sm focus:outline-none focus:border-purple-400 focus:ring-1 focus:ring-purple-400">
            <option value="" selected="@(enrollmentFilter == "")">All Enrollment</option>
            <option value="Enrolled" selected="@(enrollmentFilter == "Enrolled")">Enrolled</option>
            <option value="NotEnrolled" selected="@(enrollmentFilter == "NotEnrolled")">Not Enrolled</option>
        </select>
        <select name="paymentStatusFilter"
                class="w-full md:w-auto px-3 py-2 rounded-xl border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-800 text-slate-800 dark:text-slate-100 text-sm focus:outline-none focus:border-purple-400 focus:ring-1 focus:ring-purple-400">
            <option value="" selected="@(paymentStatusFilter == "")">All Payment Status</option>
            <option value="Unpaid" selected="@(paymentStatusFilter == "Unpaid")">Unpaid</option>
            <option value="PartiallyPaid" selected="@(paymentStatusFilter == "PartiallyPaid")">Partially Paid</option>
            <option value="Paid" selected="@(paymentStatusFilter == "Paid")">Paid</option>
        </select>
        <button type="submit" class="w-full md:w-auto px-4 py-2 rounded-xl font-medium bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-200 border border-slate-200 dark:border-slate-600 hover:bg-slate-50 dark:hover:bg-slate-700 transition-all text-sm">Filter</button>
    </form>

    <div class="bg-white dark:bg-slate-900/60 rounded-[24px] shadow-sm border border-slate-100 dark:border-slate-700 overflow-hidden">
        @if (!Model.Any())
        {
            <div class="p-12 text-center">
                <p class="text-sm text-slate-400 dark:text-slate-500">No students yet. Register the first student, or wait for a self-registration from the public site.</p>
            </div>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="w-full text-sm">
                    <thead>
                        <tr class="text-left text-xs font-semibold text-slate-400 dark:text-slate-500 uppercase tracking-wider border-b border-slate-100 dark:border-slate-700">
                            <th class="px-6 py-3">Student</th>
                            <th class="px-6 py-3">Passport</th>
                            <th class="px-6 py-3">Source</th>
                            <th class="px-6 py-3">Courses</th>
                            <th class="px-6 py-3">Balance</th>
                            <th class="px-6 py-3">Status</th>
                            <th class="px-6 py-3">Registered</th>
                            <th class="px-6 py-3"></th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 dark:divide-slate-700">
                        @foreach (var row in Model)
                        {
                            var s = row.Student;
                            var summary = row.Summary;
                            var courseCount = summary?.CourseCount ?? 0;
                            var balance = summary?.TotalBalance ?? 0m;
                            <tr class="hover:bg-slate-50/60 dark:hover:bg-slate-800/60">
                                <td class="px-6 py-4">
                                    <div class="flex items-center gap-3">
                                        @if (!string.IsNullOrEmpty(s.ProfileImageUrl))
                                        {
                                            <img src="@s.ProfileImageUrl" alt="" class="w-9 h-9 rounded-full object-cover flex-shrink-0" />
                                        }
                                        else
                                        {
                                            <div class="w-9 h-9 rounded-full bg-purple-50 dark:bg-purple-950 flex items-center justify-center text-[#7c3aed] dark:text-purple-300 font-semibold text-xs flex-shrink-0">
                                                @(s.FullName.Length > 0 ? s.FullName[0].ToString().ToUpper() : "?")
                                            </div>
                                        }
                                        <div class="min-w-0">
                                            <p class="font-medium text-slate-800 dark:text-slate-100 truncate">@s.FullName</p>
                                            <p class="text-xs text-slate-400 dark:text-slate-500 truncate">@s.Email</p>
                                        </div>
                                    </div>
                                </td>
                                <td class="px-6 py-4 text-slate-600 dark:text-slate-300">
                                    @(string.IsNullOrEmpty(s.PassportNumber) ? "—" : s.PassportNumber)
                                </td>
                                <td class="px-6 py-4">
                                    @if (s.IsSelfRegistered)
                                    {
                                        <span class="px-2 py-1 rounded-lg text-[11px] font-medium bg-sky-50 dark:bg-sky-950 text-sky-700 dark:text-sky-300">Self-registered</span>
                                    }
                                    else
                                    {
                                        <span class="px-2 py-1 rounded-lg text-[11px] font-medium bg-slate-50 dark:bg-slate-800 text-slate-600 dark:text-slate-300">
                                            Added by @(string.IsNullOrEmpty(s.CreatedByName) ? "admin" : s.CreatedByName)
                                        </span>
                                    }
                                </td>
                                <td class="px-6 py-4">
                                    @if (courseCount == 0)
                                    {
                                        <span class="text-slate-400 dark:text-slate-500">—</span>
                                    }
                                    else
                                    {
                                        <a asp-action="Details" asp-route-id="@s.StudentID"
                                           class="text-[#7c3aed] dark:text-purple-300 hover:underline font-medium">
                                            @courseCount course@(courseCount == 1 ? "" : "s")
                                        </a>
                                    }
                                </td>
                                <td class="px-6 py-4">
                                    @if (courseCount == 0)
                                    {
                                        <span class="text-slate-400 dark:text-slate-500">—</span>
                                    }
                                    else if (balance > 0)
                                    {
                                        <span class="px-2 py-1 rounded-lg text-[11px] font-medium bg-red-50 dark:bg-red-950 text-red-700 dark:text-red-300">
                                            @balance.ToString("N2") due
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="px-2 py-1 rounded-lg text-[11px] font-medium bg-emerald-50 dark:bg-emerald-950 text-emerald-700 dark:text-emerald-300">
                                            Paid up
                                        </span>
                                    }
                                </td>
                                <td class="px-6 py-4">
                                    @if (s.IsActive == "A")
                                    {
                                        <span class="px-2 py-1 rounded-lg text-[11px] font-medium bg-emerald-50 dark:bg-emerald-950 text-emerald-700 dark:text-emerald-300">Active</span>
                                    }
                                    else
                                    {
                                        <span class="px-2 py-1 rounded-lg text-[11px] font-medium bg-slate-200 dark:bg-slate-700 text-slate-600 dark:text-slate-300">Inactive</span>
                                    }
                                </td>
                                <td class="px-6 py-4 text-slate-500 dark:text-slate-400 whitespace-nowrap">@s.CreatedDate.ToString("dd MMM yyyy")</td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    <div class="flex items-center justify-end gap-1 flex-nowrap">
                                        <a asp-action="Details" asp-route-id="@s.StudentID"
                                           class="px-3 py-1.5 rounded-xl text-xs font-medium bg-slate-50 dark:bg-slate-800 text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-700 transition-colors">
                                            View
                                        </a>
                                        @if (canEditStudent)
                                        {
                                            <a asp-action="Edit" asp-route-id="@s.StudentID"
                                               class="px-3 py-1.5 rounded-xl text-xs font-medium bg-slate-50 dark:bg-slate-800 text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-700 transition-colors">
                                                Edit
                                            </a>
                                        }
                                        @if (canEditStudent && s.IsActive != "A")
                                        {
                                            <form method="post" asp-action="Activate" asp-route-id="@s.StudentID" class="inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" title="Activate" class="p-2 rounded-xl text-slate-400 dark:text-slate-500 hover:text-emerald-600 dark:hover:text-emerald-400 hover:bg-slate-100 dark:hover:bg-slate-700 transition-colors">
                                                    <i data-lucide="rotate-ccw" class="w-4 h-4"></i>
                                                </button>
                                            </form>
                                        }
                                        @if (canDeleteStudent)
                                        {
                                            if (s.IsActive == "A")
                                            {
                                                <form method="post" asp-action="Deactivate" asp-route-id="@s.StudentID" class="inline"
                                                      data-confirm="This hides @s.FullName from the student list but keeps every record safe. You can bring them back at any time."
                                                      data-confirm-title="Deactivate student" data-confirm-label="Deactivate">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" title="Deactivate" class="p-2 rounded-xl text-slate-400 dark:text-slate-500 hover:text-amber-600 dark:hover:text-amber-400 hover:bg-slate-100 dark:hover:bg-slate-700 transition-colors">
                                                        <i data-lucide="eye-off" class="w-4 h-4"></i>
                                                    </button>
                                                </form>
                                            }
                                            var impact = row.DeleteImpact;
                                            var alsoDeleted = new List<string>();
                                            if (impact != null && !impact.IsBlocked)
                                            {
                                                if (impact.LoginAccountCount > 0) alsoDeleted.Add("Their login account, so they can no longer sign in to the student portal");
                                                alsoDeleted.Add("Their personal details, passport information and emergency contact");
                                            }
                                            var blockedText = impact != null && impact.IsBlocked
                                                ? $"{s.FullName} can't be deleted: they have {impact.RegistrationCount} course registration(s) and the payment history that goes with them. That record has to be kept, so deactivate them instead."
                                                : null;
                                            var confirmText = blockedText != null
                                                ? "Deleting will be refused while this student has course registrations."
                                                : $"This permanently removes {s.FullName} and everything on their record. This cannot be undone.";

                                            <form method="post" asp-action="DeletePermanently" asp-route-id="@s.StudentID" class="inline"
                                                  data-confirm="@confirmText" data-confirm-title="Delete @s.FullName permanently?" data-confirm-label="Delete Permanently"
                                                  data-confirm-blocked="@blockedText"
                                                  data-confirm-details-title="Will also be permanently deleted"
                                                  data-confirm-details="@(alsoDeleted.Count > 0 && blockedText == null ? System.Text.Json.JsonSerializer.Serialize(alsoDeleted) : "")">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" title="Delete Permanently" class="p-2 rounded-xl text-red-500 dark:text-red-400 hover:text-white hover:bg-red-600 dark:hover:bg-red-600 transition-colors">
                                                    <i data-lucide="trash-2" class="w-4 h-4"></i>
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
