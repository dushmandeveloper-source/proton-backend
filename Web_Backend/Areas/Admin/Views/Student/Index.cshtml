@model List<Student>
@{
    ViewData["Title"] = "Students";
    var keyW = ViewBag.KeyW as string ?? "";
    var showInactive = ViewBag.ShowInactive as bool? ?? false;

    bool canAddStudent = Web_Backend.Classes.Auth.HasPermission(Web_Backend.Classes.PermissionCode.Students, 'A');
    bool canEditStudent = Web_Backend.Classes.Auth.HasPermission(Web_Backend.Classes.PermissionCode.Students, 'E');
    bool canDeleteStudent = Web_Backend.Classes.Auth.HasPermission(Web_Backend.Classes.PermissionCode.Students, 'D');
}

<div class="max-w-6xl mx-auto page-enter">
    <div class="flex flex-col md:flex-row md:items-center justify-between mb-6 gap-4">
        <div>
            <h2 class="text-3xl font-bold text-slate-800 dark:text-slate-100 tracking-tight">Students</h2>
            <p class="text-slate-500 dark:text-slate-400 mt-2">Registered students, whether self-registered or added by an admin.</p>
        </div>
        @if (canAddStudent)
        {
            <a asp-action="Add" class="px-4 py-2 rounded-xl font-medium bg-[#7c3aed] text-white hover:bg-[#6d28d9] shadow-sm text-sm flex items-center gap-2 w-fit">
                <i data-lucide="plus" class="w-4 h-4"></i> Register Student
            </a>
        }
    </div>

    <form method="get" class="flex flex-wrap items-center gap-3 mb-6">
        <div class="relative">
            <i data-lucide="search" class="w-4 h-4 text-slate-400 dark:text-slate-500 absolute left-3 top-1/2 -translate-y-1/2"></i>
            <input type="text" name="KeyW" value="@keyW" placeholder="Search name, email or passport no..."
                   class="pl-9 pr-4 py-2 rounded-xl border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-800 text-slate-800 dark:text-slate-100 text-sm focus:outline-none focus:border-purple-400 focus:ring-1 focus:ring-purple-400" />
        </div>
        <label class="flex items-center gap-2 text-sm text-slate-600 dark:text-slate-300 cursor-pointer">
            <input type="checkbox" name="showInactive" value="true" checked="@showInactive"
                   class="rounded border-slate-300 dark:border-slate-600 text-[#7c3aed] focus:ring-[#7c3aed]" />
            Show deleted
        </label>
        <button type="submit" class="px-4 py-2 rounded-xl font-medium bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-200 border border-slate-200 dark:border-slate-600 hover:bg-slate-50 dark:hover:bg-slate-700 transition-all text-sm">Filter</button>
    </form>

    <div class="bg-white dark:bg-slate-900/60 rounded-[24px] shadow-sm border border-slate-100 dark:border-slate-700 overflow-hidden">
        @if (!Model.Any())
        {
            <div class="p-12 text-center">
                <p class="text-sm text-slate-400 dark:text-slate-500">No students yet. Register the first student, or wait for a self-registration from the public site.</p>
            </div>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="w-full text-sm">
                    <thead>
                        <tr class="text-left text-xs font-semibold text-slate-400 dark:text-slate-500 uppercase tracking-wider border-b border-slate-100 dark:border-slate-700">
                            <th class="px-6 py-3">Student</th>
                            <th class="px-6 py-3">Passport</th>
                            <th class="px-6 py-3">Source</th>
                            <th class="px-6 py-3">Status</th>
                            <th class="px-6 py-3">Registered</th>
                            <th class="px-6 py-3"></th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 dark:divide-slate-700">
                        @foreach (var s in Model)
                        {
                            <tr class="hover:bg-slate-50/60 dark:hover:bg-slate-800/60">
                                <td class="px-6 py-4">
                                    <div class="flex items-center gap-3">
                                        @if (!string.IsNullOrEmpty(s.ProfileImageUrl))
                                        {
                                            <img src="@s.ProfileImageUrl" alt="" class="w-9 h-9 rounded-full object-cover flex-shrink-0" />
                                        }
                                        else
                                        {
                                            <div class="w-9 h-9 rounded-full bg-purple-50 dark:bg-purple-950 flex items-center justify-center text-[#7c3aed] dark:text-purple-300 font-semibold text-xs flex-shrink-0">
                                                @(s.FullName.Length > 0 ? s.FullName[0].ToString().ToUpper() : "?")
                                            </div>
                                        }
                                        <div class="min-w-0">
                                            <p class="font-medium text-slate-800 dark:text-slate-100 truncate">@s.FullName</p>
                                            <p class="text-xs text-slate-400 dark:text-slate-500 truncate">@s.Email</p>
                                        </div>
                                    </div>
                                </td>
                                <td class="px-6 py-4 text-slate-600 dark:text-slate-300">
                                    @(string.IsNullOrEmpty(s.PassportNumber) ? "—" : s.PassportNumber)
                                </td>
                                <td class="px-6 py-4">
                                    @if (s.IsSelfRegistered)
                                    {
                                        <span class="px-2 py-1 rounded-lg text-[11px] font-medium bg-sky-50 dark:bg-sky-950 text-sky-700 dark:text-sky-300">Self-registered</span>
                                    }
                                    else
                                    {
                                        <span class="px-2 py-1 rounded-lg text-[11px] font-medium bg-slate-50 dark:bg-slate-800 text-slate-600 dark:text-slate-300">
                                            Added by @(string.IsNullOrEmpty(s.CreatedByName) ? "admin" : s.CreatedByName)
                                        </span>
                                    }
                                </td>
                                <td class="px-6 py-4">
                                    @if (s.IsActive == "A")
                                    {
                                        <span class="px-2 py-1 rounded-lg text-[11px] font-medium bg-emerald-50 dark:bg-emerald-950 text-emerald-700 dark:text-emerald-300">Active</span>
                                    }
                                    else
                                    {
                                        <span class="px-2 py-1 rounded-lg text-[11px] font-medium bg-slate-200 dark:bg-slate-700 text-slate-600 dark:text-slate-300">Deleted</span>
                                    }
                                </td>
                                <td class="px-6 py-4 text-slate-500 dark:text-slate-400 whitespace-nowrap">@s.CreatedDate.ToString("dd MMM yyyy")</td>
                                <td class="px-6 py-4 text-right whitespace-nowrap">
                                    <a asp-action="Details" asp-route-id="@s.StudentID"
                                       class="px-3 py-1.5 rounded-xl text-xs font-medium bg-slate-50 dark:bg-slate-800 text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-700 transition-colors">
                                        View
                                    </a>
                                    @if (canEditStudent)
                                    {
                                        <a asp-action="Edit" asp-route-id="@s.StudentID"
                                           class="px-3 py-1.5 rounded-xl text-xs font-medium bg-slate-50 dark:bg-slate-800 text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-700 transition-colors">
                                            Edit
                                        </a>
                                    }
                                    @if (canDeleteStudent)
                                    {
                                        <form method="post" asp-action="Delete" asp-route-id="@s.StudentID" class="inline"
                                              data-confirm="Delete @s.FullName's student record?" data-confirm-title="Delete student" data-confirm-label="Delete">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" title="Delete" class="p-2 rounded-xl text-slate-400 dark:text-slate-500 hover:text-red-600 dark:hover:text-red-400 hover:bg-slate-100 dark:hover:bg-slate-700 transition-colors">
                                                <i data-lucide="trash-2" class="w-4 h-4"></i>
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
