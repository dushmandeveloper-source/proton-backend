@model AgentFormViewModel
@{
    var isNew = string.IsNullOrEmpty(Model.UserID);
    ViewData["Title"] = isNew ? "Add Agent" : "Edit Agent";
    var steps = new[]
    {
        ("identity",  "Identity",           "user"),
        ("personal",  "Personal",           "calendar"),
        ("passport",  "Passport",           "book-open"),
        ("emergency", "Emergency Contact",  "phone")
    };
    string InputCls = "w-full rounded-xl border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-800 text-slate-800 dark:text-slate-100 px-4 py-2.5 text-sm outline-none focus:border-[#dc2626] focus:ring-1 focus:ring-[#dc2626]";
    string LabelCls = "text-sm font-medium text-slate-700 dark:text-slate-300";
    string CardCls = "bg-white dark:bg-slate-900/60 rounded-[24px] shadow-sm border border-slate-100 dark:border-slate-700 p-6";
    string PrimaryBtn = "px-5 py-2.5 rounded-xl font-medium bg-[#dc2626] text-white hover:bg-[#b91c1c] shadow-sm transition-all text-sm";
    string SecondaryBtn = "px-5 py-2.5 rounded-xl font-medium text-slate-600 dark:text-slate-300 bg-slate-50 dark:bg-slate-800 hover:bg-slate-100 dark:hover:bg-slate-700 transition-all text-sm";
    var generatedPassword = TempData["GeneratedPassword"] as string;
}

<div class="max-w-4xl mx-auto page-enter">
    <div class="mb-6 flex flex-wrap items-start justify-between gap-4">
        <div>
            <a asp-action="Index" class="text-sm text-slate-500 dark:text-slate-400 hover:text-slate-800 dark:hover:text-slate-100 flex items-center gap-1 mb-2">
                <i data-lucide="arrow-left" class="w-4 h-4"></i> Back to Agents
            </a>
            <h2 class="text-3xl font-bold text-slate-800 dark:text-slate-100 tracking-tight">@ViewData["Title"]</h2>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(generatedPassword))
    {
        <div class="mb-6 text-sm text-emerald-700 dark:text-emerald-300 bg-emerald-50 dark:bg-emerald-950 border border-emerald-100 dark:border-emerald-900 rounded-xl px-4 py-3">
            Agent account created. Temporary password: <span class="font-mono font-semibold">@generatedPassword</span> — share this with the agent so they can sign in and change it.
        </div>
    }

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="mb-6 text-sm text-red-700 dark:text-red-300 bg-red-50 dark:bg-red-950 border border-red-100 dark:border-red-900 rounded-xl px-4 py-3">
            <p class="font-medium mb-1">Please fix the following:</p>
            <ul class="list-disc list-inside space-y-0.5">
                @foreach (var entry in ViewData.ModelState)
                {
                    foreach (var err in entry.Value.Errors)
                    {
                        <li>@(string.IsNullOrEmpty(err.ErrorMessage) ? "invalid value" : err.ErrorMessage)</li>
                    }
                }
            </ul>
        </div>
    }

    @* ---------- Step indicator ---------- *@
    <div class="flex items-center gap-2 mb-6 overflow-x-auto">
        @for (var idx = 0; idx < steps.Length; idx++)
        {
            var (key, label, icon) = steps[idx];
            <div class="step-indicator flex items-center gap-2 flex-shrink-0" data-step-index="@idx">
                <div class="step-dot w-8 h-8 rounded-full flex items-center justify-center text-xs font-semibold border-2 transition-colors @(idx == 0 ? "border-[#dc2626] bg-[#dc2626] text-white" : "border-slate-200 dark:border-slate-600 text-slate-400 dark:text-slate-500")">
                    @(idx + 1)
                </div>
                <span class="step-label text-sm font-medium @(idx == 0 ? "text-slate-800 dark:text-slate-100" : "text-slate-400 dark:text-slate-500")">@label</span>
            </div>
            if (idx < steps.Length - 1)
            {
                <div class="flex-1 h-0.5 bg-slate-200 dark:bg-slate-700 min-w-[24px]"></div>
            }
        }
    </div>

    <form method="post" asp-action="Save" enctype="multipart/form-data" class="space-y-6" id="agentWizardForm">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="UserID" />
        <input type="hidden" asp-for="AgentID" />
        <input type="hidden" asp-for="IsActive" id="isActiveField" />

        @* ===== STEP 1: IDENTITY ===== *@
        <div class="wizard-step space-y-6" data-step="identity">
            <div class="@CardCls space-y-6">
                <h3 class="font-semibold text-slate-800 dark:text-slate-100">Photo</h3>
                <div class="flex items-center gap-4">
                    @if (!string.IsNullOrEmpty(Model.ProfileImageUrl))
                    {
                        <img src="@Model.ProfileImageUrl" alt="" class="w-16 h-16 rounded-full object-cover" />
                    }
                    else
                    {
                        <div class="w-16 h-16 rounded-full bg-red-50 dark:bg-red-950 flex items-center justify-center text-[#dc2626] dark:text-red-300 font-semibold text-xl">
                            @(Model.FirstName.Length > 0 ? Model.FirstName[0].ToString().ToUpper() : "?")
                        </div>
                    }
                    <input type="file" name="profileImage" accept="image/*,.svg,.jfif"
                           class="text-sm text-slate-600 dark:text-slate-300 file:mr-3 file:py-1.5 file:px-3 file:rounded-lg file:border-0 file:text-xs file:font-medium file:bg-red-50 dark:file:bg-red-950 file:text-[#dc2626] dark:file:text-red-300" />
                </div>
            </div>

            <div class="@CardCls space-y-6">
                <h3 class="font-semibold text-slate-800 dark:text-slate-100">Identity</h3>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div class="space-y-1">
                        <label class="@LabelCls">First Name <span class="text-red-500">*</span></label>
                        <input asp-for="FirstName" required class="@InputCls" />
                    </div>
                    <div class="space-y-1">
                        <label class="@LabelCls">Last Name <span class="text-red-500">*</span></label>
                        <input asp-for="LastName" required class="@InputCls" />
                    </div>
                    <div class="space-y-1">
                        <label class="@LabelCls">Email <span class="text-red-500">*</span></label>
                        @if (isNew)
                        {
                            <input asp-for="Email" type="email" required class="@InputCls" />
                        }
                        else
                        {
                            <input asp-for="Email" type="email" readonly class="w-full rounded-xl border border-slate-200 dark:border-slate-600 bg-slate-50 dark:bg-slate-800/60 text-slate-500 dark:text-slate-400 px-4 py-2.5 text-sm outline-none cursor-not-allowed" />
                        }
                    </div>
                    <div class="space-y-1">
                        <label class="@LabelCls">Phone <span class="text-red-500">*</span></label>
                        <input asp-for="Phone" required class="@InputCls" />
                    </div>
                    <div class="space-y-1 md:col-span-2">
                        <label class="@LabelCls">Company Name <span class="text-red-500">*</span></label>
                        <input asp-for="CompanyName" required class="@InputCls" />
                    </div>
                </div>

                @if (!isNew)
                {
                    <label class="flex items-center gap-2 text-sm text-slate-700 dark:text-slate-300 cursor-pointer">
                        <input type="checkbox" checked="@(Model.IsActive == "A")"
                               onchange="document.getElementById('isActiveField').value = this.checked ? 'A' : 'I'"
                               class="rounded border-slate-300 dark:border-slate-600 text-[#dc2626] focus:ring-[#dc2626]" />
                        Active
                    </label>
                }
            </div>
        </div>

        @* ===== STEP 2: PERSONAL ===== *@
        <div class="wizard-step space-y-6 hidden" data-step="personal">
            <div class="@CardCls space-y-6">
                <h3 class="font-semibold text-slate-800 dark:text-slate-100">Personal</h3>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                    <div class="space-y-1">
                        <label class="@LabelCls">Date of Birth <span class="text-red-500">*</span></label>
                        <input asp-for="DateOfBirth" type="date" required class="@InputCls" />
                    </div>
                    <div class="space-y-1">
                        <label class="@LabelCls">Gender <span class="text-red-500">*</span></label>
                        <select asp-for="Gender" required class="@InputCls">
                            <option value="">Select...</option>
                            <option value="Male">Male</option>
                            <option value="Female">Female</option>
                            <option value="Other">Other</option>
                        </select>
                    </div>
                    <div class="space-y-1">
                        <label class="@LabelCls">Nationality <span class="text-red-500">*</span></label>
                        <input asp-for="Nationality" required autocomplete="off" data-nationality-picker class="@InputCls" />
                    </div>
                </div>
            </div>

            <div class="@CardCls space-y-6">
                <h3 class="font-semibold text-slate-800 dark:text-slate-100">Address</h3>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div class="space-y-1 md:col-span-2">
                        <label class="@LabelCls">Address Line 1</label>
                        <input asp-for="AddressLine1" class="@InputCls" />
                    </div>
                    <div class="space-y-1 md:col-span-2">
                        <label class="@LabelCls">Address Line 2</label>
                        <input asp-for="AddressLine2" class="@InputCls" />
                    </div>
                    <div class="space-y-1">
                        <label class="@LabelCls">City</label>
                        <input asp-for="City" class="@InputCls" />
                    </div>
                    <div class="space-y-1">
                        <label class="@LabelCls">State / Province</label>
                        <input asp-for="StateProvince" class="@InputCls" />
                    </div>
                    <div class="space-y-1">
                        <label class="@LabelCls">Postal Code</label>
                        <input asp-for="PostalCode" class="@InputCls" />
                    </div>
                    <div class="space-y-1">
                        <label class="@LabelCls">Country</label>
                        <input asp-for="Country" autocomplete="off" data-country-picker class="@InputCls" />
                    </div>
                </div>
            </div>
        </div>

        @* ===== STEP 3: PASSPORT ===== *@
        <div class="wizard-step space-y-6 hidden" data-step="passport">
            <div class="@CardCls space-y-6">
                <h3 class="font-semibold text-slate-800 dark:text-slate-100">Passport</h3>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div class="space-y-1">
                        <label class="@LabelCls">Passport Number</label>
                        <input asp-for="PassportNumber" class="@InputCls" />
                    </div>
                    <div class="space-y-1">
                        <label class="@LabelCls">Passport Country</label>
                        <input asp-for="PassportCountry" autocomplete="off" data-country-picker class="@InputCls" />
                    </div>
                    <div class="space-y-1">
                        <label class="@LabelCls">Passport Expiry</label>
                        <input asp-for="PassportExpiryDate" type="date" class="@InputCls" />
                    </div>
                    <div class="space-y-2">
                        <label class="@LabelCls">Passport Photo</label>
                        @if (!string.IsNullOrEmpty(Model.PassportPhotoURL))
                        {
                            <img src="@Model.PassportPhotoURL" alt="" class="w-24 h-16 rounded-lg object-cover border border-slate-200 dark:border-slate-600" />
                        }
                        <input type="file" name="passportPhoto" accept="image/*,.svg,.jfif,.pdf"
                               class="block w-full text-sm text-slate-500 dark:text-slate-400 file:mr-3 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-sm file:font-medium file:bg-red-50 dark:file:bg-red-950 file:text-[#dc2626] dark:file:text-red-300 hover:file:bg-red-100" />
                    </div>
                </div>
            </div>
        </div>

        @* ===== STEP 4: EMERGENCY CONTACT ===== *@
        <div class="wizard-step space-y-6 hidden" data-step="emergency">
            <div class="@CardCls space-y-6">
                <h3 class="font-semibold text-slate-800 dark:text-slate-100">Emergency Contact</h3>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                    <div class="space-y-1">
                        <label class="@LabelCls">Name</label>
                        <input asp-for="EmergencyContactName" class="@InputCls" />
                    </div>
                    <div class="space-y-1">
                        <label class="@LabelCls">Phone</label>
                        <input asp-for="EmergencyContactPhone" class="@InputCls" />
                    </div>
                    <div class="space-y-1">
                        <label class="@LabelCls">Relationship</label>
                        <input asp-for="EmergencyRelationship" class="@InputCls" />
                    </div>
                </div>
            </div>

            @if (isNew)
            {
                <div class="@CardCls">
                    <label class="flex items-center gap-2 text-sm text-slate-600 dark:text-slate-300 cursor-pointer">
                        <input type="checkbox" name="sendWelcomeEmail" value="true" checked
                               class="rounded border-slate-300 dark:border-slate-600 text-[#dc2626] focus:ring-[#dc2626]" />
                        Email a temporary password to this agent
                    </label>
                </div>
            }
        </div>

        <div class="flex items-center justify-between">
            <a asp-action="Index" class="@SecondaryBtn">Cancel</a>
            <div class="flex items-center gap-3">
                <button type="button" id="wizardBackBtn" class="@SecondaryBtn hidden">
                    <i data-lucide="arrow-left" class="w-4 h-4 inline -mt-0.5 mr-1"></i>Back
                </button>
                <button type="button" id="wizardNextBtn" class="@PrimaryBtn">
                    Next<i data-lucide="arrow-right" class="w-4 h-4 inline -mt-0.5 ml-1"></i>
                </button>
                <button type="submit" id="wizardSaveBtn" class="@PrimaryBtn hidden">@(isNew ? "Register Agent" : "Save Changes")</button>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script src="~/js/country-picker.js"></script>
    <script>
        (function () {
            var steps = Array.from(document.querySelectorAll('.wizard-step'));
            var indicators = Array.from(document.querySelectorAll('.step-indicator'));
            var backBtn = document.getElementById('wizardBackBtn');
            var nextBtn = document.getElementById('wizardNextBtn');
            var saveBtn = document.getElementById('wizardSaveBtn');
            var current = 0;

            function showStep(index) {
                steps.forEach(function (el, i) { el.classList.toggle('hidden', i !== index); });
                indicators.forEach(function (el, i) {
                    var dot = el.querySelector('.step-dot');
                    var label = el.querySelector('.step-label');
                    var isActiveOrDone = i <= index;
                    dot.classList.toggle('border-[#dc2626]', isActiveOrDone);
                    dot.classList.toggle('bg-[#dc2626]', isActiveOrDone);
                    dot.classList.toggle('text-white', isActiveOrDone);
                    dot.classList.toggle('border-slate-200', !isActiveOrDone);
                    dot.classList.toggle('dark:border-slate-600', !isActiveOrDone);
                    dot.classList.toggle('text-slate-400', !isActiveOrDone);
                    dot.classList.toggle('dark:text-slate-500', !isActiveOrDone);
                    label.classList.toggle('text-slate-800', isActiveOrDone);
                    label.classList.toggle('dark:text-slate-100', isActiveOrDone);
                    label.classList.toggle('text-slate-400', !isActiveOrDone);
                    label.classList.toggle('dark:text-slate-500', !isActiveOrDone);
                });
                backBtn.classList.toggle('hidden', index === 0);
                var isLast = index === steps.length - 1;
                nextBtn.classList.toggle('hidden', isLast);
                if (saveBtn) saveBtn.classList.toggle('hidden', !isLast);
                current = index;
            }

            function validateCurrentStep() {
                var inputs = steps[current].querySelectorAll('input[required], select[required]');
                for (var i = 0; i < inputs.length; i++) {
                    if (!inputs[i].checkValidity()) {
                        inputs[i].reportValidity();
                        return false;
                    }
                }
                return true;
            }

            nextBtn.addEventListener('click', function () {
                if (!validateCurrentStep()) return;
                if (current < steps.length - 1) showStep(current + 1);
            });
            backBtn.addEventListener('click', function () {
                if (current > 0) showStep(current - 1);
            });

            var wizardForm = document.getElementById('agentWizardForm');
            if (wizardForm) {
                wizardForm.addEventListener('submit', function (e) {
                    if (!validateCurrentStep()) { e.preventDefault(); return; }
                    if (wizardForm.dataset.submitting === '1') { e.preventDefault(); return; }
                    wizardForm.dataset.submitting = '1';
                    if (saveBtn) {
                        saveBtn.disabled = true;
                        saveBtn.textContent = 'Saving…';
                    }
                });
            }
            indicators.forEach(function (el) {
                el.addEventListener('click', function () {
                    var target = parseInt(el.getAttribute('data-step-index'), 10);
                    if (target <= current) showStep(target);
                });
                el.style.cursor = 'pointer';
            });

            showStep(0);
        })();
    </script>
}
