@model List<Document>
@{
    ViewData["Title"] = "Documents";
    bool canAdd = Web_Backend.Classes.Auth.HasPermission(Web_Backend.Classes.PermissionCode.Documents, 'A');
}

<div class="max-w-5xl mx-auto page-enter">
    <div class="flex flex-col md:flex-row md:items-center justify-between mb-6 gap-4">
        <div>
            <h2 class="text-3xl font-bold text-slate-800 dark:text-slate-100 tracking-tight">Documents</h2>
            <p class="text-slate-500 dark:text-slate-400 mt-2">Files shared with agents — visible to all agents, or restricted to a hand-picked subset. Agents can preview these but never download them.</p>
        </div>
        @if (canAdd)
        {
            <a asp-action="Add" class="px-4 py-2 rounded-xl font-medium bg-[#dc2626] text-white hover:bg-[#b91c1c] shadow-sm text-sm flex items-center gap-2 w-fit">
                <i data-lucide="plus" class="w-4 h-4"></i> Add Document
            </a>
        }
    </div>

    <div class="bg-white dark:bg-slate-900/60 rounded-[24px] shadow-sm border border-slate-100 dark:border-slate-700 overflow-hidden">
        @if (!Model.Any())
        {
            <div class="p-12 text-center">
                <p class="text-sm text-slate-400 dark:text-slate-500">No documents yet. Add one to share it with agents.</p>
            </div>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="w-full text-sm">
                    <thead>
                        <tr class="border-b border-slate-100 dark:border-slate-700 text-left text-slate-500 dark:text-slate-400">
                            <th class="px-6 py-3 font-medium">Title</th>
                            <th class="px-6 py-3 font-medium">File</th>
                            <th class="px-6 py-3 font-medium">Visibility</th>
                            <th class="px-6 py-3 font-medium">Status</th>
                            <th class="px-6 py-3 font-medium text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var d in Model)
                        {
                            <tr class="border-b border-slate-50 dark:border-slate-800 last:border-0">
                                <td class="px-6 py-3 font-medium text-slate-800 dark:text-slate-100">@d.Title</td>
                                <td class="px-6 py-3 text-slate-600 dark:text-slate-300">@d.OriginalFileName</td>
                                <td class="px-6 py-3 text-slate-600 dark:text-slate-300">
                                    @if (d.IsAllAgents)
                                    {
                                        <span class="px-2 py-0.5 rounded-full text-xs font-semibold bg-sky-100 dark:bg-sky-950 text-sky-700 dark:text-sky-300">All Agents</span>
                                    }
                                    else
                                    {
                                        <span class="px-2 py-0.5 rounded-full text-xs font-semibold bg-violet-100 dark:bg-violet-950 text-violet-700 dark:text-violet-300">@d.AssignedAgentCount agent@(d.AssignedAgentCount == 1 ? "" : "s")</span>
                                    }
                                </td>
                                <td class="px-6 py-3">
                                    <span class="px-2 py-0.5 rounded-full text-xs font-semibold @(d.IsActive == "A" ? "bg-emerald-100 dark:bg-emerald-950 text-emerald-700 dark:text-emerald-300" : "bg-slate-100 dark:bg-slate-800 text-slate-500 dark:text-slate-400")">@(d.IsActive == "A" ? "Active" : "Inactive")</span>
                                </td>
                                <td class="px-6 py-3 text-right">
                                    <a asp-action="Details" asp-route-id="@d.DocumentID" title="View" class="p-2 rounded-xl text-slate-400 dark:text-slate-500 hover:text-[#dc2626] dark:hover:text-red-400 hover:bg-slate-100 dark:hover:bg-slate-700 transition-colors inline-block">
                                        <i data-lucide="eye" class="w-4 h-4"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
