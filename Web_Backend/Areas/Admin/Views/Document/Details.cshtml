@model Document
@{
    ViewData["Title"] = "Document Details";
    bool canEdit = Web_Backend.Classes.Auth.HasPermission(Web_Backend.Classes.PermissionCode.Documents, 'E');
    bool canDelete = Web_Backend.Classes.Auth.HasPermission(Web_Backend.Classes.PermissionCode.Documents, 'D');
}

<div class="max-w-3xl mx-auto space-y-8 page-enter">

    <div class="flex items-center justify-between flex-wrap gap-4">
        <div class="flex items-center gap-4">
            <div class="w-14 h-14 rounded-full bg-red-50 dark:bg-red-950 flex items-center justify-center text-[#dc2626] dark:text-red-300">
                <i data-lucide="file-text" class="w-6 h-6"></i>
            </div>
            <div>
                <p class="text-sm font-medium text-slate-500 dark:text-slate-400">Document</p>
                <h1 class="text-2xl md:text-3xl font-bold text-slate-800 dark:text-slate-100 tracking-tight">@Model.Title</h1>
            </div>
        </div>
        <div class="flex items-center gap-3">
            <a asp-action="Download" asp-route-id="@Model.DocumentID" class="px-4 py-2 rounded-xl font-medium text-sm bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-200 border border-slate-200 dark:border-slate-600 hover:bg-slate-50 dark:hover:bg-slate-700 transition-colors flex items-center gap-2 w-fit">
                <i data-lucide="download" class="w-4 h-4"></i> Download
            </a>
            @if (canEdit)
            {
                <a asp-action="Edit" asp-route-id="@Model.DocumentID" class="px-4 py-2 rounded-xl font-medium text-sm bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-200 border border-slate-200 dark:border-slate-600 hover:bg-slate-50 dark:hover:bg-slate-700 transition-colors flex items-center gap-2 w-fit">
                    <i data-lucide="pencil" class="w-4 h-4"></i> Edit
                </a>
            }
            <a asp-action="Index" class="px-4 py-2 rounded-xl font-medium text-sm bg-slate-50 dark:bg-slate-800 text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-700 transition-colors flex items-center gap-2 w-fit">
                <i data-lucide="arrow-left" class="w-4 h-4"></i> Back
            </a>
        </div>
    </div>

    <div class="bg-white dark:bg-slate-900/60 rounded-[24px] shadow-sm border border-slate-100 dark:border-slate-700 p-6 space-y-6">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <div>
                <p class="text-xs text-slate-400 dark:text-slate-500 uppercase tracking-wider mb-0.5">File</p>
                <p class="text-slate-700 dark:text-slate-200 font-medium">@Model.OriginalFileName</p>
            </div>
            <div>
                <p class="text-xs text-slate-400 dark:text-slate-500 uppercase tracking-wider mb-0.5">Size</p>
                <p class="text-slate-700 dark:text-slate-200 font-medium">@Model.FileSizeLabel</p>
            </div>
            <div>
                <p class="text-xs text-slate-400 dark:text-slate-500 uppercase tracking-wider mb-0.5">Visibility</p>
                <p class="text-slate-700 dark:text-slate-200 font-medium">
                    @(Model.IsAllAgents ? "All Agents" : $"{Model.AssignedAgents.Count} specific agent(s)")
                </p>
            </div>
            <div>
                <p class="text-xs text-slate-400 dark:text-slate-500 uppercase tracking-wider mb-0.5">Status</p>
                <span class="px-2 py-0.5 rounded-full text-xs font-semibold @(Model.IsActive == "A" ? "bg-emerald-100 dark:bg-emerald-950 text-emerald-700 dark:text-emerald-300" : "bg-slate-100 dark:bg-slate-800 text-slate-500 dark:text-slate-400")">@(Model.IsActive == "A" ? "Active" : "Inactive")</span>
            </div>
            <div class="sm:col-span-2">
                <p class="text-xs text-slate-400 dark:text-slate-500 uppercase tracking-wider mb-0.5">Description</p>
                <p class="text-slate-700 dark:text-slate-200">@(string.IsNullOrEmpty(Model.Description) ? "-" : Model.Description)</p>
            </div>
            <div>
                <p class="text-xs text-slate-400 dark:text-slate-500 uppercase tracking-wider mb-0.5">Added by</p>
                <p class="text-slate-700 dark:text-slate-200">@(string.IsNullOrEmpty(Model.CreatedByName) ? "-" : Model.CreatedByName)</p>
            </div>
            <div>
                <p class="text-xs text-slate-400 dark:text-slate-500 uppercase tracking-wider mb-0.5">Added on</p>
                <p class="text-slate-700 dark:text-slate-200">@Model.CreatedDate.ToString("dd MMM yyyy")</p>
            </div>
        </div>

        @if (!Model.IsAllAgents && Model.AssignedAgents.Any())
        {
            <div class="border-t border-slate-100 dark:border-slate-700 pt-6">
                <p class="text-xs text-slate-400 dark:text-slate-500 uppercase tracking-wider mb-2">Visible to</p>
                <div class="flex flex-wrap gap-2">
                    @foreach (var a in Model.AssignedAgents)
                    {
                        <span class="px-3 py-1 rounded-full text-xs font-medium bg-violet-100 dark:bg-violet-950 text-violet-700 dark:text-violet-300">@a.FullName</span>
                    }
                </div>
            </div>
        }
    </div>

    @if (canDelete)
    {
        <form asp-action="Delete" asp-route-id="@Model.DocumentID" method="post" onsubmit="return confirm('Delete this document? This cannot be undone.');">
            @Html.AntiForgeryToken()
            <button type="submit" class="px-4 py-2 rounded-xl font-medium text-sm bg-red-50 dark:bg-red-950 text-red-700 dark:text-red-300 hover:bg-red-100 dark:hover:bg-red-900 transition-colors flex items-center gap-2 w-fit">
                <i data-lucide="trash-2" class="w-4 h-4"></i> Delete Document
            </button>
        </form>
    }
</div>
