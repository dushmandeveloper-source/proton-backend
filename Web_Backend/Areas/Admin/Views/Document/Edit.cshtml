@model DocumentFormViewModel
@{
    var isNew = string.IsNullOrEmpty(Model.DocumentID);
    ViewData["Title"] = isNew ? "Add Document" : "Edit Document";
    var availableAgents = ViewBag.AvailableAgents as List<Agent> ?? new();
    var steps = new[]
    {
        ("details",    "Details",    "file-text"),
        ("visibility", "Visibility", "eye"),
    };
    string InputCls = "w-full rounded-xl border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-800 text-slate-800 dark:text-slate-100 px-4 py-2.5 text-sm outline-none focus:border-[#dc2626] focus:ring-1 focus:ring-[#dc2626]";
    string LabelCls = "text-sm font-medium text-slate-700 dark:text-slate-300";
    string CardCls = "bg-white dark:bg-slate-900/60 rounded-[24px] shadow-sm border border-slate-100 dark:border-slate-700 p-6";
    string PrimaryBtn = "px-5 py-2.5 rounded-xl font-medium bg-[#dc2626] text-white hover:bg-[#b91c1c] shadow-sm transition-all text-sm";
    string SecondaryBtn = "px-5 py-2.5 rounded-xl font-medium text-slate-600 dark:text-slate-300 bg-slate-50 dark:bg-slate-800 hover:bg-slate-100 dark:hover:bg-slate-700 transition-all text-sm";
}

<div class="max-w-3xl mx-auto page-enter">
    <div class="mb-6">
        <a asp-action="Index" class="text-sm text-slate-500 dark:text-slate-400 hover:text-slate-800 dark:hover:text-slate-100 flex items-center gap-1 mb-2">
            <i data-lucide="arrow-left" class="w-4 h-4"></i> Back to Documents
        </a>
        <h2 class="text-3xl font-bold text-slate-800 dark:text-slate-100 tracking-tight">@ViewData["Title"]</h2>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="mb-6 text-sm text-red-700 dark:text-red-300 bg-red-50 dark:bg-red-950 border border-red-100 dark:border-red-900 rounded-xl px-4 py-3">
            <p class="font-medium mb-1">Please fix the following:</p>
            <ul class="list-disc list-inside space-y-0.5">
                @foreach (var entry in ViewData.ModelState)
                {
                    foreach (var err in entry.Value.Errors)
                    {
                        <li>@(string.IsNullOrEmpty(err.ErrorMessage) ? "invalid value" : err.ErrorMessage)</li>
                    }
                }
            </ul>
        </div>
    }

    @* ---------- Step indicator ---------- *@
    <div class="flex items-center gap-2 mb-6 overflow-x-auto">
        @for (var idx = 0; idx < steps.Length; idx++)
        {
            var (key, label, icon) = steps[idx];
            <div class="step-indicator flex items-center gap-2 flex-shrink-0" data-step-index="@idx">
                <div class="step-dot w-8 h-8 rounded-full flex items-center justify-center text-xs font-semibold border-2 transition-colors @(idx == 0 ? "border-[#dc2626] bg-[#dc2626] text-white" : "border-slate-200 dark:border-slate-600 text-slate-400 dark:text-slate-500")">
                    @(idx + 1)
                </div>
                <span class="step-label text-sm font-medium @(idx == 0 ? "text-slate-800 dark:text-slate-100" : "text-slate-400 dark:text-slate-500")">@label</span>
            </div>
            if (idx < steps.Length - 1)
            {
                <div class="flex-1 h-0.5 bg-slate-200 dark:bg-slate-700 min-w-[24px]"></div>
            }
        }
    </div>

    <form asp-action="Save" method="post" enctype="multipart/form-data" class="space-y-6" id="documentWizardForm">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="DocumentID" />

        @* ===== STEP 1: DETAILS ===== *@
        <div class="wizard-step space-y-6" data-step="details">
            <div class="@CardCls space-y-6">
                <div class="space-y-1">
                    <label class="@LabelCls">Title <span class="text-red-500">*</span></label>
                    <input asp-for="Title" required class="@InputCls" />
                    <span asp-validation-for="Title" class="text-xs text-red-500"></span>
                </div>
                <div class="space-y-1">
                    <label class="@LabelCls">Description</label>
                    <textarea asp-for="Description" rows="3" class="@InputCls"></textarea>
                </div>
                <div class="space-y-2">
                    <label class="@LabelCls">File @(isNew ? Html.Raw("<span class=\"text-red-500\">*</span>") : null)</label>
                    @if (!isNew && !string.IsNullOrEmpty(Model.OriginalFileName))
                    {
                        <p class="text-xs text-slate-500 dark:text-slate-400">Current file: <span class="font-medium text-slate-700 dark:text-slate-200">@Model.OriginalFileName</span> (@(Model.FileSizeBytes < 1024 * 1024 ? $"{Model.FileSizeBytes / 1024.0:0.#} KB" : $"{Model.FileSizeBytes / (1024.0 * 1024):0.#} MB")). Choose a new file only to replace it.</p>
                    }
                    <input type="file" name="file" id="documentFileInput" accept=".pdf,.jpg,.jpeg,.png,.webp" data-required-if-new="@(isNew ? "true" : "false")"
                           class="block w-full text-sm text-slate-500 dark:text-slate-400 file:mr-3 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-sm file:font-medium file:bg-red-50 dark:file:bg-red-950 file:text-[#dc2626] dark:file:text-red-300 hover:file:bg-red-100" />
                    <p class="text-xs text-slate-400 dark:text-slate-500">PDF or image only — agents view these inline, never as a download, so only browser-renderable formats are accepted.</p>
                </div>
            </div>
        </div>

        @* ===== STEP 2: VISIBILITY ===== *@
        <div class="wizard-step space-y-6 hidden" data-step="visibility">
            <div class="@CardCls space-y-4">
                <h3 class="font-semibold text-slate-800 dark:text-slate-100">Visibility</h3>
                <div class="flex flex-col gap-3">
                    <label class="flex items-center gap-3 rounded-xl border border-slate-200 dark:border-slate-600 px-4 py-3 cursor-pointer has-[:checked]:border-[#dc2626] has-[:checked]:bg-red-50/50 dark:has-[:checked]:bg-red-950/30">
                        <input type="radio" name="VisibilityScope" value="All" id="vis-all" @(Model.VisibilityScope != "Specific" ? "checked" : "") class="accent-[#dc2626]" onchange="toggleAgentPicker()" />
                        <div>
                            <p class="text-sm font-medium text-slate-800 dark:text-slate-100">All Agents</p>
                            <p class="text-xs text-slate-500 dark:text-slate-400">Every active agent can see this document.</p>
                        </div>
                    </label>
                    <label class="flex items-center gap-3 rounded-xl border border-slate-200 dark:border-slate-600 px-4 py-3 cursor-pointer has-[:checked]:border-[#dc2626] has-[:checked]:bg-red-50/50 dark:has-[:checked]:bg-red-950/30">
                        <input type="radio" name="VisibilityScope" value="Specific" id="vis-specific" @(Model.VisibilityScope == "Specific" ? "checked" : "") class="accent-[#dc2626]" onchange="toggleAgentPicker()" />
                        <div>
                            <p class="text-sm font-medium text-slate-800 dark:text-slate-100">Specific Agents</p>
                            <p class="text-xs text-slate-500 dark:text-slate-400">Only the agents you pick below can see this document.</p>
                        </div>
                    </label>
                </div>

                <div id="agent-picker" class="@(Model.VisibilityScope == "Specific" ? "" : "hidden") space-y-2 border-t border-slate-100 dark:border-slate-700 pt-4">
                    @if (!availableAgents.Any())
                    {
                        <p class="text-sm text-slate-400 dark:text-slate-500">No approved agents yet.</p>
                    }
                    else
                    {
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 max-h-64 overflow-y-auto custom-scrollbar pr-1">
                            @foreach (var a in availableAgents)
                            {
                                <label class="flex items-center gap-2 rounded-xl border border-slate-200 dark:border-slate-600 px-3 py-2 cursor-pointer hover:bg-slate-50 dark:hover:bg-slate-800">
                                    <input type="checkbox" name="AgentUserIDs" value="@a.UserID" @(Model.AgentUserIDs.Contains(a.UserID) ? "checked" : "") class="accent-[#dc2626]" />
                                    <span class="text-sm text-slate-700 dark:text-slate-200 truncate">@a.FullName</span>
                                </label>
                            }
                        </div>
                    }
                    <span asp-validation-for="AgentUserIDs" class="text-xs text-red-500"></span>
                </div>
            </div>
        </div>

        <div class="flex items-center justify-between">
            <a asp-action="Index" class="@SecondaryBtn">Cancel</a>
            <div class="flex items-center gap-3">
                <button type="button" id="wizardBackBtn" class="@SecondaryBtn hidden">
                    <i data-lucide="arrow-left" class="w-4 h-4 inline -mt-0.5 mr-1"></i>Back
                </button>
                <button type="button" id="wizardNextBtn" class="@PrimaryBtn">
                    Next<i data-lucide="arrow-right" class="w-4 h-4 inline -mt-0.5 ml-1"></i>
                </button>
                <button type="submit" id="wizardSaveBtn" class="@PrimaryBtn hidden">Save Document</button>
            </div>
        </div>
    </form>
</div>

<script>
    function toggleAgentPicker() {
        var specific = document.getElementById('vis-specific').checked;
        document.getElementById('agent-picker').classList.toggle('hidden', !specific);
    }

    (function () {
        var steps = Array.from(document.querySelectorAll('.wizard-step'));
        var indicators = Array.from(document.querySelectorAll('.step-indicator'));
        var backBtn = document.getElementById('wizardBackBtn');
        var nextBtn = document.getElementById('wizardNextBtn');
        var saveBtn = document.getElementById('wizardSaveBtn');
        var current = 0;

        function showStep(index) {
            steps.forEach(function (el, i) { el.classList.toggle('hidden', i !== index); });
            indicators.forEach(function (el, i) {
                var dot = el.querySelector('.step-dot');
                var label = el.querySelector('.step-label');
                var isActiveOrDone = i <= index;
                dot.classList.toggle('border-[#dc2626]', isActiveOrDone);
                dot.classList.toggle('bg-[#dc2626]', isActiveOrDone);
                dot.classList.toggle('text-white', isActiveOrDone);
                dot.classList.toggle('border-slate-200', !isActiveOrDone);
                dot.classList.toggle('dark:border-slate-600', !isActiveOrDone);
                dot.classList.toggle('text-slate-400', !isActiveOrDone);
                dot.classList.toggle('dark:text-slate-500', !isActiveOrDone);
                label.classList.toggle('text-slate-800', isActiveOrDone);
                label.classList.toggle('dark:text-slate-100', isActiveOrDone);
                label.classList.toggle('text-slate-400', !isActiveOrDone);
                label.classList.toggle('dark:text-slate-500', !isActiveOrDone);
            });
            backBtn.classList.toggle('hidden', index === 0);
            var isLast = index === steps.length - 1;
            nextBtn.classList.toggle('hidden', isLast);
            if (saveBtn) saveBtn.classList.toggle('hidden', !isLast);
            current = index;
        }

        function validateCurrentStep() {
            var inputs = steps[current].querySelectorAll('input[required], select[required]');
            for (var i = 0; i < inputs.length; i++) {
                if (!inputs[i].checkValidity()) {
                    inputs[i].reportValidity();
                    return false;
                }
            }
            // The file input is only actually required for a brand-new
            // document (editing keeps the existing file unless replaced),
            // so that rule can't be a plain HTML `required` attribute.
            var fileInput = document.getElementById('documentFileInput');
            if (fileInput && fileInput.dataset.requiredIfNew === 'true' && fileInput.files.length === 0
                && steps[current].getAttribute('data-step') === 'details') {
                fileInput.setCustomValidity('A file is required.');
                fileInput.reportValidity();
                fileInput.setCustomValidity('');
                return false;
            }
            return true;
        }

        nextBtn.addEventListener('click', function () {
            if (!validateCurrentStep()) return;
            if (current < steps.length - 1) showStep(current + 1);
        });
        backBtn.addEventListener('click', function () {
            if (current > 0) showStep(current - 1);
        });

        var wizardForm = document.getElementById('documentWizardForm');
        if (wizardForm) {
            wizardForm.addEventListener('submit', function (e) {
                if (!validateCurrentStep()) { e.preventDefault(); return; }
                if (wizardForm.dataset.submitting === '1') { e.preventDefault(); return; }
                wizardForm.dataset.submitting = '1';
                if (saveBtn) {
                    saveBtn.disabled = true;
                    saveBtn.textContent = 'Saving…';
                }
            });
        }
        indicators.forEach(function (el) {
            el.addEventListener('click', function () {
                var target = parseInt(el.getAttribute('data-step-index'), 10);
                if (target <= current) showStep(target);
            });
            el.style.cursor = 'pointer';
        });

        showStep(0);
    })();
</script>
