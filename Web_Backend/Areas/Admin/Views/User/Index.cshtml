@model UserManagementViewModel
@{
    ViewData["Title"] = "User Management";
    bool isFormTab = Model.ActiveTab is "addUser" or "editUser" or "addRole" or "editRole";
    string initialPane = isFormTab ? "form" : Model.ActiveTab;
    string formTabLabel = Model.ActiveTab switch
    {
        "addUser" => "Add User",
        "editUser" => "Edit User",
        "addRole" => "Add Role",
        "editRole" => "Edit Role",
        _ => ""
    };
    string? newCredName = TempData["NewCredentialsName"] as string;
    string? newCredEmail = TempData["NewCredentialsEmail"] as string;
    string? newCredPassword = TempData["NewCredentialsPassword"] as string;
    bool newCredEmailSent = TempData["NewCredentialsEmailSent"] as bool? ?? false;
    bool showCredentials = !string.IsNullOrEmpty(newCredPassword);
}

<div class="max-w-6xl mx-auto page-enter">
    <div class="mb-6">
        <h2 class="text-3xl font-bold text-slate-800 dark:text-slate-100 tracking-tight">User Management</h2>
        <p class="text-slate-500 dark:text-slate-400 mt-2">Manage user accounts and the roles they can be assigned.</p>
    </div>

    <div class="border-b border-slate-200 dark:border-slate-700 mb-6">
        <nav class="flex gap-6" id="tab-strip">
            <button type="button" data-tab-target="users"
                    class="tab-btn pb-3 text-sm font-medium border-b-2 -mb-px transition-colors @(initialPane == "users" ? "border-[#7c3aed] text-[#7c3aed]" : "border-transparent text-slate-500 dark:text-slate-400 hover:text-slate-700 dark:hover:text-slate-200")">
                Users
            </button>
            <button type="button" data-tab-target="roles"
                    class="tab-btn pb-3 text-sm font-medium border-b-2 -mb-px transition-colors @(initialPane == "roles" ? "border-[#7c3aed] text-[#7c3aed]" : "border-transparent text-slate-500 dark:text-slate-400 hover:text-slate-700 dark:hover:text-slate-200")">
                Roles &amp; Permissions
            </button>
            @if (isFormTab)
            {
                <button type="button" data-tab-target="form"
                        class="tab-btn pb-3 text-sm font-medium border-b-2 -mb-px transition-colors border-[#7c3aed] text-[#7c3aed]">
                    @formTabLabel
                </button>
            }
        </nav>
    </div>

    <!-- ============ USERS PANE ============ -->
    <div data-tab-pane="users" class="@(initialPane == "users" ? "" : "hidden")">
        <div class="flex items-center justify-between mb-4">
            <a asp-action="Index" asp-route-tab="users" asp-route-showInactive="@(!Model.ShowInactive)"
               class="text-sm font-medium text-slate-500 dark:text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 flex items-center gap-1.5">
                <i data-lucide="@(Model.ShowInactive ? "eye-off" : "eye")" class="w-4 h-4"></i>
                @(Model.ShowInactive ? "Hide deactivated users" : "Show deactivated users")
            </a>
            <a asp-action="Add" class="px-4 py-1.5 rounded-xl font-medium bg-[#7c3aed] text-white hover:bg-[#6d28d9] shadow-sm text-sm flex items-center gap-2">
                <i data-lucide="plus" class="w-4 h-4"></i> Add User
            </a>
        </div>
        <div class="bg-white dark:bg-slate-900/60 rounded-[24px] shadow-sm border border-slate-100 dark:border-slate-700 overflow-hidden">
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="border-b border-slate-100 dark:border-slate-700 bg-slate-50/50 dark:bg-slate-800/50">
                            <th class="px-6 py-4 text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">User</th>
                            <th class="px-6 py-4 text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Status</th>
                            <th class="px-6 py-4 text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Phone</th>
                            <th class="px-6 py-4 text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Role Assignment</th>
                            <th class="px-6 py-4 text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 dark:divide-slate-700">
                        @if (!Model.Users.Any())
                        {
                            <tr><td colspan="5" class="px-6 py-8 text-center text-sm text-slate-400 dark:text-slate-500">No users yet.</td></tr>
                        }
                        @foreach (var user in Model.Users)
                        {
                            <tr class="hover:bg-slate-50/50 dark:hover:bg-slate-800/50 transition-colors group" data-user-id="@user.UserID">
                                <td class="px-6 py-4">
                                    <div class="flex items-center gap-3">
                                        <div class="w-9 h-9 rounded-full bg-gradient-to-br from-indigo-100 to-purple-100 dark:from-indigo-900 dark:to-purple-900 text-indigo-700 dark:text-indigo-300 font-bold flex items-center justify-center text-sm border border-indigo-200 dark:border-indigo-800">
                                            @(user.FullName.Length > 0 ? user.FullName.Substring(0, 1) : "?")
                                        </div>
                                        <div>
                                            <div class="font-medium text-slate-800 dark:text-slate-100 text-sm">@user.FullName</div>
                                            <div class="text-xs text-slate-500 dark:text-slate-400">@user.Email</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="px-6 py-4">
                                    @{ var statusColor = user.StatusLabel == "Active" ? "bg-emerald-100 dark:bg-emerald-950 text-emerald-700 dark:text-emerald-300" : "bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300"; }
                                    <span class="px-2.5 py-0.5 rounded-full text-xs font-medium @statusColor">@user.StatusLabel</span>
                                </td>
                                <td class="px-6 py-4 text-sm text-slate-600 dark:text-slate-300">@(string.IsNullOrEmpty(user.Phone) ? "—" : user.Phone)</td>
                                <td class="px-6 py-4">
                                    <div class="relative inline-block w-40">
                                        <select class="role-select w-full appearance-none bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-600 text-slate-700 dark:text-slate-200 py-1.5 pl-3 pr-8 rounded-lg text-sm font-medium focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent cursor-pointer"
                                                data-user-id="@user.UserID">
                                            @foreach (var userType in Model.Roles)
                                            {
                                                <option value="@userType.UserTypeID" selected="@(userType.UserTypeID == user.UserTypeID)">@userType.UserTypeName</option>
                                            }
                                        </select>
                                        <i data-lucide="chevron-down" class="absolute right-2.5 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400 dark:text-slate-500 pointer-events-none"></i>
                                    </div>
                                </td>
                                <td class="px-6 py-4 text-right whitespace-nowrap">
                                    <a asp-action="Edit" asp-route-id="@user.UserID" title="Edit"
                                       class="text-slate-400 dark:text-slate-500 hover:text-[#7c3aed] dark:hover:text-[#a78bfa] p-1.5 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-700 transition-colors inline-flex">
                                        <i data-lucide="pencil" class="w-4 h-4"></i>
                                    </a>
                                    <form method="post" asp-action="ResetPassword" asp-route-id="@user.UserID" class="inline"
                                          data-confirm="Generate a new temporary password for @user.FullName?" data-confirm-title="Reset password" data-confirm-label="Reset Password">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" title="Reset password" class="text-slate-400 dark:text-slate-500 hover:text-amber-600 dark:hover:text-amber-400 p-1.5 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-700 transition-colors">
                                            <i data-lucide="key-round" class="w-4 h-4"></i>
                                        </button>
                                    </form>
                                    <form method="post" asp-action="Delete" asp-route-id="@user.UserID" class="inline"
                                          data-confirm="Delete @user.FullName? This can be reversed later by an admin, but they won't be able to sign in until then." data-confirm-title="Delete user" data-confirm-label="Delete">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" title="Delete" class="text-slate-400 dark:text-slate-500 hover:text-red-600 dark:hover:text-red-400 p-1.5 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-700 transition-colors">
                                            <i data-lucide="trash-2" class="w-4 h-4"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- ============ ROLES PANE ============ -->
    <div data-tab-pane="roles" class="@(initialPane == "roles" ? "" : "hidden")">
        <div class="flex justify-end mb-4">
            <a asp-action="AddRole" class="px-4 py-1.5 rounded-xl font-medium bg-[#7c3aed] text-white hover:bg-[#6d28d9] shadow-sm text-sm flex items-center gap-2">
                <i data-lucide="plus" class="w-4 h-4"></i> Add Role
            </a>
        </div>
        <div class="bg-white dark:bg-slate-900/60 rounded-[24px] shadow-sm border border-slate-100 dark:border-slate-700 overflow-hidden">
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="border-b border-slate-100 dark:border-slate-700 bg-slate-50/50 dark:bg-slate-800/50">
                            <th class="px-6 py-4 text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Role</th>
                            <th class="px-6 py-4 text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Description</th>
                            <th class="px-6 py-4 text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Status</th>
                            <th class="px-6 py-4 text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 dark:divide-slate-700">
                        @foreach (var role in Model.Roles)
                        {
                            var isAdminRole = role.UserTypeName.Equals("Admin", StringComparison.OrdinalIgnoreCase) || role.UserTypeID == "MASTERADMIN";
                            <tr class="hover:bg-slate-50/50 dark:hover:bg-slate-800/50 transition-colors">
                                <td class="px-6 py-4 font-medium text-slate-800 dark:text-slate-100 text-sm">
                                    @role.UserTypeName
                                    @if (isAdminRole)
                                    {
                                        <span class="ml-2 px-2 py-0.5 rounded-full text-[10px] font-semibold bg-purple-100 dark:bg-purple-950 text-[#7c3aed] dark:text-purple-300 uppercase">Protected</span>
                                    }
                                </td>
                                <td class="px-6 py-4 text-sm text-slate-600 dark:text-slate-300">@role.Description</td>
                                <td class="px-6 py-4">
                                    @{ var roleStatusColor = role.IsActive == "A" ? "bg-emerald-100 dark:bg-emerald-950 text-emerald-700 dark:text-emerald-300" : "bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300"; }
                                    <span class="px-2.5 py-0.5 rounded-full text-xs font-medium @roleStatusColor">@(role.IsActive == "A" ? "Active" : "Inactive")</span>
                                </td>
                                <td class="px-6 py-4 text-right whitespace-nowrap">
                                    <a asp-action="EditRole" asp-route-id="@role.UserTypeID" title="Edit"
                                       class="text-slate-400 dark:text-slate-500 hover:text-[#7c3aed] dark:hover:text-[#a78bfa] p-1.5 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-700 transition-colors inline-flex">
                                        <i data-lucide="pencil" class="w-4 h-4"></i>
                                    </a>
                                    @if (!isAdminRole)
                                    {
                                        <form method="post" asp-action="DeleteRole" asp-route-id="@role.UserTypeID" class="inline"
                                              data-confirm="Delete the '@role.UserTypeName' role? Users currently assigned to it will keep the reference, but it won't be selectable anymore." data-confirm-title="Delete role" data-confirm-label="Delete">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" title="Delete" class="text-slate-400 dark:text-slate-500 hover:text-red-600 dark:hover:text-red-400 p-1.5 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-700 transition-colors">
                                                <i data-lucide="trash-2" class="w-4 h-4"></i>
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- ============ FORM PANE (Add/Edit User or Role) ============ -->
    @if (isFormTab)
    {
        <div data-tab-pane="form">
            <div class="max-w-3xl bg-white dark:bg-slate-900/60 rounded-[24px] shadow-sm border border-slate-100 dark:border-slate-700 overflow-hidden">
                <div class="p-8">
                    @if (Model.ActiveTab is "addUser" or "editUser")
                    {
                        var isEdit = Model.ActiveTab == "editUser";
                        var fName = isEdit ? Model.EditUserForm!.FirstName : Model.AddUserForm!.FirstName;
                        var lName = isEdit ? Model.EditUserForm!.LastName : Model.AddUserForm!.LastName;
                        var email = isEdit ? Model.EditUserForm!.Email : Model.AddUserForm!.Email;
                        var role = isEdit ? Model.EditUserForm!.Role : Model.AddUserForm!.Role;
                        var active = isEdit ? Model.EditUserForm!.IsActive : true;

                        <form method="post" asp-action="@(isEdit ? "Edit" : "Add")" class="space-y-6">
                            @Html.AntiForgeryToken()
                            @if (isEdit)
                            {
                                <input type="hidden" name="UserID" value="@Model.EditUserForm!.UserID" />
                            }

                            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                <div class="space-y-1">
                                    <label class="text-sm font-medium text-slate-700 dark:text-slate-300">First Name</label>
                                    <input name="FirstName" value="@fName" placeholder="e.g. Jane"
                                           class="w-full rounded-xl border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-800 text-slate-800 dark:text-slate-100 px-4 py-2.5 text-sm outline-none focus:border-[#7c3aed] focus:ring-1 focus:ring-[#7c3aed]" />
                                    <span class="text-xs text-red-500">@Html.ValidationMessage("FirstName")</span>
                                </div>
                                <div class="space-y-1">
                                    <label class="text-sm font-medium text-slate-700 dark:text-slate-300">Last Name</label>
                                    <input name="LastName" value="@lName" placeholder="e.g. Smith"
                                           class="w-full rounded-xl border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-800 text-slate-800 dark:text-slate-100 px-4 py-2.5 text-sm outline-none focus:border-[#7c3aed] focus:ring-1 focus:ring-[#7c3aed]" />
                                    <span class="text-xs text-red-500">@Html.ValidationMessage("LastName")</span>
                                </div>
                            </div>

                            <div class="space-y-1">
                                <label class="text-sm font-medium text-slate-700 dark:text-slate-300">Email Address</label>
                                <div class="relative">
                                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                                        <i data-lucide="mail" class="h-5 w-5 text-slate-400 dark:text-slate-500"></i>
                                    </div>
                                    <input name="Email" type="email" value="@email" placeholder="jane.smith@example.com"
                                           class="w-full rounded-xl border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-800 text-slate-800 dark:text-slate-100 px-4 py-2.5 pl-10 text-sm outline-none focus:border-[#7c3aed] focus:ring-1 focus:ring-[#7c3aed]" />
                                </div>
                                <span class="text-xs text-red-500">@Html.ValidationMessage("Email")</span>
                            </div>

                            <div class="space-y-1">
                                <label class="text-sm font-medium text-slate-700 dark:text-slate-300">Assign Role</label>
                                <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mt-2">
                                    @foreach (var userType in Model.Roles)
                                    {
                                        <label class="cursor-pointer relative">
                                            <input type="radio" name="Role" value="@userType.UserTypeID" class="peer sr-only" checked="@(userType.UserTypeID == role)" />
                                            <div class="w-full text-center px-4 py-3 rounded-xl border border-slate-200 dark:border-slate-600 text-sm font-medium text-slate-600 dark:text-slate-300 transition-all hover:bg-slate-50 dark:hover:bg-slate-800 peer-checked:border-[#7c3aed] peer-checked:bg-purple-50 dark:peer-checked:bg-purple-950 peer-checked:text-[#7c3aed] dark:peer-checked:text-purple-300 peer-checked:ring-1 peer-checked:ring-[#7c3aed]">
                                                @userType.UserTypeName
                                            </div>
                                        </label>
                                    }
                                </div>
                            </div>

                            <div class="space-y-2">
                                <label class="text-sm font-medium text-slate-700 dark:text-slate-300">Permissions</label>
                                <p class="text-xs text-slate-500 dark:text-slate-400">
                                    Shows what the selected role grants. Tick or untick any box to override it for this user only — leave a box as-is to keep inheriting from the role.
                                </p>
                                @{
                                    var overrides = isEdit ? Model.EditUserForm!.PermissionOverrides : Model.AddUserForm!.PermissionOverrides;
                                    var rolePermissionsByRole = ViewBag.RolePermissionsByRole as Dictionary<string, List<PermissionGridViewModel>> ?? new();
                                }
                                <div class="overflow-x-auto rounded-xl border border-slate-200 dark:border-slate-600">
                                    <table class="w-full text-left border-collapse" id="user-permission-grid" data-role-defaults="@Html.Raw(System.Text.Json.JsonSerializer.Serialize(rolePermissionsByRole))">
                                        <thead>
                                            <tr class="bg-slate-50 dark:bg-slate-800 text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">
                                                <th class="px-4 py-3">Module</th>
                                                <th class="px-4 py-3 text-center">View</th>
                                                <th class="px-4 py-3 text-center">Add</th>
                                                <th class="px-4 py-3 text-center">Edit</th>
                                                <th class="px-4 py-3 text-center">Delete</th>
                                            </tr>
                                        </thead>
                                        <tbody class="divide-y divide-slate-100 dark:divide-slate-700">
                                            @for (var i = 0; i < overrides.Count; i++)
                                            {
                                                var row = overrides[i];
                                                <tr data-module="@row.ModuleCode">
                                                    <td class="px-4 py-3 text-sm font-medium text-slate-700 dark:text-slate-200">
                                                        @row.ModuleLabel
                                                        <input type="hidden" name="PermissionOverrides[@i].ModuleCode" value="@row.ModuleCode" />
                                                        <input type="hidden" name="PermissionOverrides[@i].ModuleLabel" value="@row.ModuleLabel" />
                                                    </td>
                                                    @foreach (var action in new[] { "CanView", "CanAdd", "CanEdit", "CanDelete" })
                                                    {
                                                        var value = action switch { "CanView" => row.CanView, "CanAdd" => row.CanAdd, "CanEdit" => row.CanEdit, _ => row.CanDelete };
                                                        <td class="px-4 py-3 text-center">
                                                            <input type="checkbox" class="user-permission-checkbox rounded border-slate-300 dark:border-slate-600 text-[#7c3aed] focus:ring-[#7c3aed]"
                                                                   data-action="@action" checked="@(value ?? false)" />
                                                            <input type="hidden" name="PermissionOverrides[@i].@action" class="user-permission-hidden" value="@(value.HasValue ? value.Value.ToString().ToLower() : "")" />
                                                        </td>
                                                    }
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>

                            @if (isEdit)
                            {
                                <label class="flex items-center gap-2 text-sm text-slate-700 dark:text-slate-300 cursor-pointer">
                                    <input type="checkbox" name="IsActive" value="true" checked="@active" class="rounded border-slate-300 dark:border-slate-600 text-[#7c3aed] focus:ring-[#7c3aed]" />
                                    Active
                                </label>
                            }

                            <div class="pt-6 border-t border-slate-100 dark:border-slate-700 flex items-center justify-end gap-3">
                                <a asp-action="Index" asp-route-tab="users" class="px-4 py-2 rounded-xl font-medium bg-transparent text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition-all">Cancel</a>
                                <button type="submit" class="px-4 py-2 rounded-xl font-medium bg-[#7c3aed] text-white hover:bg-[#6d28d9] shadow-sm transition-all">
                                    @(isEdit ? "Save Changes" : "Create User Account")
                                </button>
                            </div>
                        </form>
                    }
                    else
                    {
                        var isEditRole = Model.ActiveTab == "editRole";
                        var roleForm = Model.RoleForm!;

                        <form method="post" asp-action="@(isEditRole ? "EditRole" : "AddRole")" class="space-y-6">
                            @Html.AntiForgeryToken()
                            @if (isEditRole)
                            {
                                <input type="hidden" name="UserTypeID" value="@roleForm.UserTypeID" />
                            }

                            <div class="space-y-1">
                                <label class="text-sm font-medium text-slate-700 dark:text-slate-300">Role Name</label>
                                <input name="UserTypeName" value="@roleForm.UserTypeName" placeholder="e.g. Marketing"
                                       class="w-full rounded-xl border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-800 text-slate-800 dark:text-slate-100 px-4 py-2.5 text-sm outline-none focus:border-[#7c3aed] focus:ring-1 focus:ring-[#7c3aed]" />
                                <span class="text-xs text-red-500">@Html.ValidationMessage("UserTypeName")</span>
                            </div>

                            <div class="space-y-1">
                                <label class="text-sm font-medium text-slate-700 dark:text-slate-300">Description</label>
                                <textarea name="Description" rows="3" placeholder="What this role can do"
                                          class="w-full rounded-xl border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-800 text-slate-800 dark:text-slate-100 px-4 py-2.5 text-sm outline-none focus:border-[#7c3aed] focus:ring-1 focus:ring-[#7c3aed]">@roleForm.Description</textarea>
                            </div>

                            <div class="space-y-2">
                                <label class="text-sm font-medium text-slate-700 dark:text-slate-300">Permissions</label>
                                @{ var isMasterAdminRole = roleForm.UserTypeID == "MASTERADMIN"; }
                                @if (isMasterAdminRole)
                                {
                                    <p class="text-xs text-slate-500 dark:text-slate-400">Master Admin always has full access to every module — this can't be changed.</p>
                                }
                                <div class="overflow-x-auto rounded-xl border border-slate-200 dark:border-slate-600">
                                    <table class="w-full text-left border-collapse">
                                        <thead>
                                            <tr class="bg-slate-50 dark:bg-slate-800 text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">
                                                <th class="px-4 py-3">Module</th>
                                                <th class="px-4 py-3 text-center">View</th>
                                                <th class="px-4 py-3 text-center">Add</th>
                                                <th class="px-4 py-3 text-center">Edit</th>
                                                <th class="px-4 py-3 text-center">Delete</th>
                                            </tr>
                                        </thead>
                                        <tbody class="divide-y divide-slate-100 dark:divide-slate-700">
                                            @for (var i = 0; i < roleForm.Permissions.Count; i++)
                                            {
                                                var row = roleForm.Permissions[i];
                                                <tr>
                                                    <td class="px-4 py-3 text-sm font-medium text-slate-700 dark:text-slate-200">
                                                        @row.ModuleLabel
                                                        <input type="hidden" name="Permissions[@i].ModuleCode" value="@row.ModuleCode" />
                                                        <input type="hidden" name="Permissions[@i].ModuleLabel" value="@row.ModuleLabel" />
                                                    </td>
                                                    <td class="px-4 py-3 text-center">
                                                        <input type="checkbox" name="Permissions[@i].CanView" value="true" checked="@(row.CanView ?? isMasterAdminRole)" disabled="@isMasterAdminRole"
                                                               class="rounded border-slate-300 dark:border-slate-600 text-[#7c3aed] focus:ring-[#7c3aed]" />
                                                    </td>
                                                    <td class="px-4 py-3 text-center">
                                                        <input type="checkbox" name="Permissions[@i].CanAdd" value="true" checked="@(row.CanAdd ?? isMasterAdminRole)" disabled="@isMasterAdminRole"
                                                               class="rounded border-slate-300 dark:border-slate-600 text-[#7c3aed] focus:ring-[#7c3aed]" />
                                                    </td>
                                                    <td class="px-4 py-3 text-center">
                                                        <input type="checkbox" name="Permissions[@i].CanEdit" value="true" checked="@(row.CanEdit ?? isMasterAdminRole)" disabled="@isMasterAdminRole"
                                                               class="rounded border-slate-300 dark:border-slate-600 text-[#7c3aed] focus:ring-[#7c3aed]" />
                                                    </td>
                                                    <td class="px-4 py-3 text-center">
                                                        <input type="checkbox" name="Permissions[@i].CanDelete" value="true" checked="@(row.CanDelete ?? isMasterAdminRole)" disabled="@isMasterAdminRole"
                                                               class="rounded border-slate-300 dark:border-slate-600 text-[#7c3aed] focus:ring-[#7c3aed]" />
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>

                            <label class="flex items-center gap-2 text-sm text-slate-700 dark:text-slate-300 cursor-pointer">
                                <input type="checkbox" name="IsActive" value="true" checked="@roleForm.IsActive" class="rounded border-slate-300 dark:border-slate-600 text-[#7c3aed] focus:ring-[#7c3aed]" />
                                Active
                            </label>

                            <div class="pt-6 border-t border-slate-100 dark:border-slate-700 flex items-center justify-end gap-3">
                                <a asp-action="Index" asp-route-tab="roles" class="px-4 py-2 rounded-xl font-medium bg-transparent text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition-all">Cancel</a>
                                <button type="submit" class="px-4 py-2 rounded-xl font-medium bg-[#7c3aed] text-white hover:bg-[#6d28d9] shadow-sm transition-all">
                                    @(isEditRole ? "Save Changes" : "Create Role")
                                </button>
                            </div>
                        </form>
                    }
                </div>
            </div>
        </div>
    }
</div>

@if (showCredentials)
{
    <div id="credentials-modal" class="fixed inset-0 z-[95] flex items-center justify-center bg-black/40 backdrop-blur-sm p-4">
        <div class="bg-white dark:bg-slate-800 rounded-2xl shadow-xl p-6 max-w-md w-full">
            <div class="flex items-center gap-3 mb-4">
                <div class="p-2 rounded-xl bg-emerald-50 dark:bg-emerald-950 text-emerald-600 dark:text-emerald-300"><i data-lucide="key-round" class="w-5 h-5"></i></div>
                <h3 class="text-lg font-semibold text-slate-800 dark:text-slate-100">Password for @newCredName</h3>
            </div>
            <p class="text-sm text-slate-500 dark:text-slate-400 mb-4">
                This is shown only once — copy it now and share it securely.
                @if (newCredEmailSent)
                {
                    <span class="text-emerald-600 dark:text-emerald-400">It was also emailed to @newCredEmail.</span>
                }
                else
                {
                    <span class="text-amber-600 dark:text-amber-400">The email could not be sent — check Email Settings and share this manually.</span>
                }
            </p>
            <div class="space-y-3 mb-6">
                <div>
                    <label class="text-xs font-medium text-slate-500 dark:text-slate-400 uppercase tracking-wider">Email</label>
                    <div class="mt-1 px-3 py-2 rounded-lg bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 text-sm text-slate-800 dark:text-slate-100 font-mono">@newCredEmail</div>
                </div>
                <div>
                    <label class="text-xs font-medium text-slate-500 dark:text-slate-400 uppercase tracking-wider">Temporary Password</label>
                    <div class="mt-1 flex items-center gap-2">
                        <div id="credentials-password" class="flex-1 px-3 py-2 rounded-lg bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 text-sm text-slate-800 dark:text-slate-100 font-mono">@newCredPassword</div>
                        <button type="button" id="credentials-copy" class="px-3 py-2 rounded-lg bg-slate-100 dark:bg-slate-700 text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-600 transition-colors">
                            <i data-lucide="copy" class="w-4 h-4"></i>
                        </button>
                    </div>
                </div>
            </div>
            <button type="button" id="credentials-close" class="w-full py-2.5 rounded-xl font-medium bg-[#7c3aed] text-white hover:bg-[#6d28d9] transition-all">Done</button>
        </div>
    </div>
}

@section Scripts {
    <script>
        document.querySelectorAll('.tab-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                document.querySelectorAll('.tab-btn').forEach(b => {
                    b.classList.remove('border-[#7c3aed]', 'text-[#7c3aed]');
                    b.classList.add('border-transparent', 'text-slate-500', 'dark:text-slate-400');
                });
                btn.classList.remove('border-transparent', 'text-slate-500', 'dark:text-slate-400');
                btn.classList.add('border-[#7c3aed]', 'text-[#7c3aed]');

                document.querySelectorAll('[data-tab-pane]').forEach(p => p.classList.add('hidden'));
                const target = document.querySelector(`[data-tab-pane="${btn.dataset.tabTarget}"]`);
                if (target) target.classList.remove('hidden');
            });
        });

        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
        document.querySelectorAll('.role-select').forEach(select => {
            select.addEventListener('change', async (e) => {
                const userId = e.target.dataset.userId;
                const role = e.target.value;
                await fetch('@Url.Action("SetRole", "User", new { area = "Admin" })', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: `id=${encodeURIComponent(userId)}&role=${encodeURIComponent(role)}&__RequestVerificationToken=${encodeURIComponent(token || '')}`
                });
            });
        });

        document.getElementById('credentials-close')?.addEventListener('click', () => {
            document.getElementById('credentials-modal')?.remove();
        });
        document.getElementById('credentials-copy')?.addEventListener('click', () => {
            const pwd = document.getElementById('credentials-password')?.textContent || '';
            navigator.clipboard.writeText(pwd);
            showToast('Password copied to clipboard.', 'success');
        });

        // ---------- User permission grid: preview role defaults, track overrides ----------
        (function () {
            const table = document.getElementById('user-permission-grid');
            if (!table) return;

            const roleDefaults = JSON.parse(table.dataset.roleDefaults || '{}');

            function applyRoleDefaults(roleId) {
                const defaults = roleDefaults[roleId];
                if (!defaults) return;
                table.querySelectorAll('tr[data-module]').forEach(row => {
                    const moduleCode = row.dataset.module;
                    const moduleDefaults = defaults.find(d => d.moduleCode === moduleCode || d.ModuleCode === moduleCode);
                    if (!moduleDefaults) return;
                    row.querySelectorAll('.user-permission-checkbox').forEach(cb => {
                        const action = cb.dataset.action;
                        const hidden = cb.nextElementSibling;
                        // Only repaint cells the admin hasn't explicitly overridden
                        // (hidden value still blank) — an existing override must
                        // survive switching the role radio back and forth.
                        if (hidden.value === '') {
                            const key = action.charAt(0).toLowerCase() + action.slice(1);
                            cb.checked = !!(moduleDefaults[key] ?? moduleDefaults[action]);
                        }
                    });
                });
            }

            // Any checkbox the admin actually clicks becomes an explicit override
            // from then on, regardless of which role is selected afterward.
            table.querySelectorAll('.user-permission-checkbox').forEach(cb => {
                cb.addEventListener('change', () => {
                    const hidden = cb.nextElementSibling;
                    hidden.value = cb.checked ? 'true' : 'false';
                });
            });

            document.querySelectorAll('input[name="Role"]').forEach(radio => {
                radio.addEventListener('change', (e) => applyRoleDefaults(e.target.value));
            });

            const checkedRole = document.querySelector('input[name="Role"]:checked');
            if (checkedRole) applyRoleDefaults(checkedRole.value);
        })();
    </script>
}
