@using Web_Backend.Areas.Admin.Models
@model List<ExamAttempt>
@{
    ViewData["Title"] = "Exam Grading Queue";
}

<div class="max-w-6xl mx-auto page-enter">
    <div class="mb-6">
        <h2 class="text-3xl font-bold text-slate-800 dark:text-slate-100 tracking-tight">Pending Grading</h2>
        <p class="text-slate-500 dark:text-slate-400 mt-2">Submitted attempts with Written answers still awaiting a manual mark.</p>
    </div>

    <div class="bg-white dark:bg-slate-900/60 rounded-[24px] shadow-sm border border-slate-100 dark:border-slate-700 overflow-hidden">
        @if (!Model.Any())
        {
            <div class="p-12 text-center">
                <p class="text-sm text-slate-400 dark:text-slate-500">Nothing pending — all submitted attempts are fully graded.</p>
            </div>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="w-full text-sm">
                    <thead>
                        <tr class="border-b border-slate-100 dark:border-slate-700 text-left text-xs font-medium text-slate-500 dark:text-slate-400 uppercase tracking-wide">
                            <th class="px-6 py-3">Exam</th>
                            <th class="px-6 py-3">Student</th>
                            <th class="px-6 py-3">Submitted</th>
                            <th class="px-6 py-3">Status</th>
                            <th class="px-6 py-3">Partial Marks</th>
                            <th class="px-6 py-3"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var a in Model)
                        {
                            <tr class="border-b border-slate-50 dark:border-slate-800 last:border-0 hover:bg-slate-50/60 dark:hover:bg-slate-800/40">
                                <td class="px-6 py-3 text-slate-800 dark:text-slate-100 font-medium">@a.ExamTitle</td>
                                <td class="px-6 py-3 text-slate-600 dark:text-slate-300">@a.StudentName</td>
                                <td class="px-6 py-3 text-slate-600 dark:text-slate-300">@(a.SubmittedDate?.ToString("g") ?? "-")</td>
                                <td class="px-6 py-3 text-slate-600 dark:text-slate-300">@a.Status</td>
                                <td class="px-6 py-3 text-slate-600 dark:text-slate-300">@a.TotalMarksAwarded / @a.TotalMarks</td>
                                <td class="px-6 py-3 text-right">
                                    <a asp-action="Grade" asp-route-attemptId="@a.AttemptID"
                                       class="px-3 py-1.5 rounded-xl font-medium bg-[#7c3aed] text-white hover:bg-[#6d28d9] shadow-sm text-xs">
                                        Grade
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
