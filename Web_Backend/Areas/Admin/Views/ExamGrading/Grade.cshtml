@using Web_Backend.Areas.Admin.Models
@{
    ViewData["Title"] = "Grade Exam Attempt";
    var attempt = (ExamAttempt)ViewBag.Attempt;
    var answers = (List<ExamAttemptAnswer>)ViewBag.Answers;
}

<div class="max-w-4xl mx-auto page-enter">
    <div class="mb-6">
        <a asp-action="Index" class="text-sm text-slate-500 dark:text-slate-400 hover:text-slate-800 dark:hover:text-slate-100 inline-flex items-center gap-1 mb-3">
            <i data-lucide="arrow-left" class="w-4 h-4"></i> Back to grading queue
        </a>
        <h2 class="text-3xl font-bold text-slate-800 dark:text-slate-100 tracking-tight">@attempt.ExamTitle</h2>
        <p class="text-slate-500 dark:text-slate-400 mt-2">
            @attempt.StudentName &middot; Status: @attempt.Status &middot;
            Fully Graded: @(attempt.IsFullyGraded ? "Yes" : "No") &middot;
            Total: @attempt.TotalMarksAwarded / @attempt.TotalMarks
        </p>
    </div>

    <div class="space-y-4">
        @foreach (var ans in answers.OrderBy(a => a.SortOrder))
        {
            <div class="bg-white dark:bg-slate-900/60 rounded-[24px] shadow-sm border border-slate-100 dark:border-slate-700 p-5">
                <div class="flex items-start justify-between gap-4 mb-2">
                    <p class="text-slate-800 dark:text-slate-100 font-medium">@ans.QuestionTextLatex</p>
                    <span class="text-xs text-slate-400 dark:text-slate-500 whitespace-nowrap">@ans.Marks marks</span>
                </div>

                @if (ans.IsMCQ)
                {
                    <p class="text-sm text-slate-600 dark:text-slate-300">
                        Selected Option: @(ans.SelectedOptionID ?? "-") &middot;
                        Correct: @(ans.IsCorrect == true ? "Yes" : ans.IsCorrect == false ? "No" : "-") &middot;
                        Marks: @ans.MarksAwarded
                    </p>
                }
                else
                {
                    <p class="text-sm text-slate-600 dark:text-slate-300 mb-3 whitespace-pre-wrap">@(string.IsNullOrEmpty(ans.WrittenAnswerText) ? "(no answer submitted)" : ans.WrittenAnswerText)</p>
                    <form asp-action="SaveGrade" asp-controller="ExamGrading" method="post" class="flex items-center gap-2">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="attemptId" value="@attempt.AttemptID" />
                        <input type="hidden" name="questionId" value="@ans.QuestionID" />
                        <label class="text-xs text-slate-500 dark:text-slate-400">Marks</label>
                        <input type="number" step="0.01" name="marksAwarded" value="@ans.MarksAwarded" max="@ans.Marks" min="0"
                               class="w-24 px-3 py-1.5 rounded-xl border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-800 text-sm" />
                        <button type="submit"
                                class="px-3 py-1.5 rounded-xl font-medium bg-[#7c3aed] text-white hover:bg-[#6d28d9] shadow-sm text-xs">
                            Save Grade
                        </button>
                    </form>
                }
            </div>
        }
    </div>
</div>
