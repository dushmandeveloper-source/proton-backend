@using Web_Backend.Areas.Admin.Models
@{
    ViewData["Title"] = "View Exam Attempt";
    var attempt = (ExamAttempt)ViewBag.Attempt;
    var ordered = ((List<ExamAttemptAnswer>)ViewBag.Answers).OrderBy(a => a.SortOrder).ToList();
    var optionsByQuestion = ViewBag.OptionsByQuestion as Dictionary<string, List<ExamQuestionOption>> ?? new();
    var canApprove =attempt.TeacherReviewStatus == "Approved" && attempt.AdminReviewStatus != "Approved";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.18.4/dist/katex.min.css" integrity="sha384-u1zONI5gPXUx0UKI62c75/zww972y0v2rSK5ZYlVdS6xEuWDeZWUI66v6t1gvlXJ" crossorigin="anonymous">
<script defer src="https://cdn.jsdelivr.net/npm/katex@0.18.4/dist/katex.min.js" integrity="sha384-ykMNcWQhhTUb0YV9SPpPUFURHZ+tWmubkakGBP+OgNK/UXdO2gtzglWx0Rj9hnO3" crossorigin="anonymous"></script>
<script defer src="https://cdn.jsdelivr.net/npm/katex@0.18.4/dist/contrib/mhchem.min.js" integrity="sha384-fB8BH//9nBzROkMUsu/Dr35jWHIbnKesUo9rW0hfEgw8mZGnkAyBAjKX9F98OVuo" crossorigin="anonymous"></script>
<script defer src="~/js/exam-math.js" asp-append-version="true"></script>

<div class="max-w-4xl mx-auto page-enter space-y-6">
    <a asp-action="Index" asp-route-tab="@(attempt.TeacherReviewStatus == "Approved" ? "review" : "grading")"
       class="text-sm text-slate-500 dark:text-slate-400 hover:text-slate-800 dark:hover:text-slate-100 inline-flex items-center gap-1">
        <i data-lucide="arrow-left" class="w-4 h-4"></i> Back to Exam Grading &amp; Review
    </a>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="rounded-xl border border-emerald-100 dark:border-emerald-900 bg-emerald-50 dark:bg-emerald-950 p-4 text-sm text-emerald-700 dark:text-emerald-300">
            @TempData["SuccessMessage"]
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="rounded-xl border border-red-100 dark:border-red-900 bg-red-50 dark:bg-red-950 p-4 text-sm text-red-700 dark:text-red-300">
            @TempData["ErrorMessage"]
        </div>
    }

    <div class="bg-white dark:bg-slate-900/60 rounded-[24px] shadow-sm border border-slate-100 dark:border-slate-700 p-6">
        <div class="flex items-start justify-between gap-4 flex-wrap">
            <div>
                <div class="flex items-center gap-2 flex-wrap">
                    <h2 class="text-2xl font-bold text-slate-800 dark:text-slate-100 tracking-tight">@attempt.ExamTitle</h2>
                    <span class="inline-flex items-center gap-1 text-xs font-medium text-slate-500 dark:text-slate-400 bg-slate-50 dark:bg-slate-800 border border-slate-100 dark:border-slate-700 rounded-full px-2.5 py-1">
                        <i data-lucide="eye" class="w-3 h-3"></i> Read-only
                    </span>
                </div>
                <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">@attempt.StudentName</p>
                <p class="text-xs text-slate-400 dark:text-slate-500 mt-2">
                    Teacher review: <span class="font-medium">@attempt.TeacherReviewStatus</span>
                    @if (attempt.TeacherReviewedByName != null)
                    {
                        @:(by @attempt.TeacherReviewedByName)
                    }
                    &middot;
                    Admin review: <span class="font-medium">@attempt.AdminReviewStatus</span>
                    @if (attempt.AdminReviewedByName != null)
                    {
                        @:(by @attempt.AdminReviewedByName)
                    }
                </p>
            </div>
            <div class="text-right">
                <p class="text-2xl font-bold text-[#7c3aed] dark:text-[#a78bfa]">@attempt.TotalMarksAwarded / @attempt.TotalMarks</p>
                <p class="text-xs text-slate-400 dark:text-slate-500 mt-1">
                    Status: @attempt.Status &middot; Fully Graded: @(attempt.IsFullyGraded ? "Yes" : "No")
                </p>
                @if (canApprove)
                {
                    <form asp-action="AdminApprove" asp-controller="ExamGrading" asp-area="Admin" method="post" class="mt-3">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="attemptId" value="@attempt.AttemptID" />
                        <button type="submit" class="px-4 py-2 rounded-xl font-medium text-sm bg-[#7c3aed] text-white hover:bg-[#6d28d9] shadow-sm transition-all">
                            Approve &amp; Release
                        </button>
                    </form>
                }
                else if (attempt.AdminReviewStatus == "Approved")
                {
                    <span class="inline-flex items-center gap-1.5 text-sm font-medium text-emerald-600 dark:text-emerald-300 mt-3">
                        <i data-lucide="check-circle" class="w-4 h-4"></i> Released
                    </span>
                }
                else
                {
                    <p class="text-xs text-slate-400 dark:text-slate-500 mt-3">Awaiting teacher approval first</p>
                }
            </div>
        </div>
    </div>

    <div class="space-y-4">
        @for (int i = 0; i < ordered.Count; i++)
        {
            var ans = ordered[i];
            <div class="bg-white dark:bg-slate-900/60 rounded-[24px] shadow-sm border border-slate-100 dark:border-slate-700 p-6">
                <div class="flex items-start justify-between gap-4 mb-4">
                    <div class="flex items-start gap-3 min-w-0">
                        <span class="flex-shrink-0 w-7 h-7 rounded-full bg-[#ede7fc] dark:bg-slate-700 text-[#7c3aed] dark:text-[#a78bfa] text-xs font-semibold flex items-center justify-center mt-0.5">
                            @(i + 1)
                        </span>
                        <div class="min-w-0 flex-1">
                            <div class="katex-render text-slate-800 dark:text-slate-100 font-medium leading-relaxed" data-latex="@ans.QuestionTextLatex">@ans.QuestionTextLatex</div>
                            @if (!string.IsNullOrEmpty(ans.ImageURL))
                            {
                                <img src="@ans.ImageURL" alt="Question @(i + 1) figure" loading="lazy" decoding="async" class="block max-w-full sm:max-w-md h-auto mt-3 rounded-xl border border-slate-100 dark:border-slate-700 bg-white p-2" />
                            }
                        </div>
                    </div>
                    <span class="flex-shrink-0 text-xs font-medium text-slate-500 dark:text-slate-400 bg-slate-50 dark:bg-slate-800 border border-slate-100 dark:border-slate-700 rounded-full px-3 py-1 whitespace-nowrap">
                        @(ans.IsMCQ ? "MCQ" : "Written") &middot; @ans.Marks marks
                    </span>
                </div>

                @if (ans.IsMCQ)
                {
                    <partial name="~/Views/Shared/_McqAnswerReview.cshtml" model="ans"
                             view-data="@(new ViewDataDictionary(ViewData) { ["Options"] = optionsByQuestion.GetValueOrDefault(ans.QuestionID) })" />
                }
                else
                {
                    <div class="ml-10 space-y-3">
                        <div class="rounded-xl bg-slate-50 dark:bg-slate-800 border border-slate-100 dark:border-slate-700 p-4">
                            <p class="text-sm text-slate-700 dark:text-slate-200 whitespace-pre-wrap leading-relaxed">@(string.IsNullOrEmpty(ans.WrittenAnswerText) ? "(no answer submitted)" : ans.WrittenAnswerText)</p>
                        </div>
                        <p class="text-sm font-medium text-slate-600 dark:text-slate-300">
                            Marks awarded:
                            <span class="text-[#7c3aed] dark:text-[#a78bfa]">@(ans.MarksAwarded?.ToString() ?? "Not yet graded by lecturer")</span>
                            @if (ans.MarksAwarded.HasValue)
                            {
                                @:/ @ans.Marks
                            }
                        </p>
                    </div>
                }
            </div>
        }
    </div>
</div>
