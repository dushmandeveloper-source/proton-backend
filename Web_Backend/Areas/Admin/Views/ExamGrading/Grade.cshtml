@using Web_Backend.Areas.Admin.Models
@{
    ViewData["Title"] = "View Exam Attempt";
    var attempt = (ExamAttempt)ViewBag.Attempt;
    var ordered = ((List<ExamAttemptAnswer>)ViewBag.Answers).OrderBy(a => a.SortOrder).ToList();
}

<div class="max-w-4xl mx-auto page-enter space-y-6">
    <a asp-action="Index" class="text-sm text-slate-500 dark:text-slate-400 hover:text-slate-800 dark:hover:text-slate-100 inline-flex items-center gap-1">
        <i data-lucide="arrow-left" class="w-4 h-4"></i> Back to grading queue
    </a>

    <div class="bg-white dark:bg-slate-900/60 rounded-[24px] shadow-sm border border-slate-100 dark:border-slate-700 p-6">
        <div class="flex items-start justify-between gap-4 flex-wrap">
            <div>
                <div class="flex items-center gap-2 flex-wrap">
                    <h2 class="text-2xl font-bold text-slate-800 dark:text-slate-100 tracking-tight">@attempt.ExamTitle</h2>
                    <span class="inline-flex items-center gap-1 text-xs font-medium text-slate-500 dark:text-slate-400 bg-slate-50 dark:bg-slate-800 border border-slate-100 dark:border-slate-700 rounded-full px-2.5 py-1">
                        <i data-lucide="eye" class="w-3 h-3"></i> Read-only
                    </span>
                </div>
                <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">@attempt.StudentName</p>
            </div>
            <div class="text-right">
                <p class="text-2xl font-bold text-[#7c3aed] dark:text-[#a78bfa]">@attempt.TotalMarksAwarded / @attempt.TotalMarks</p>
                <p class="text-xs text-slate-400 dark:text-slate-500 mt-1">
                    Status: @attempt.Status &middot; Fully Graded: @(attempt.IsFullyGraded ? "Yes" : "No")
                </p>
            </div>
        </div>
    </div>

    <div class="space-y-4">
        @for (int i = 0; i < ordered.Count; i++)
        {
            var ans = ordered[i];
            <div class="bg-white dark:bg-slate-900/60 rounded-[24px] shadow-sm border border-slate-100 dark:border-slate-700 p-6">
                <div class="flex items-start justify-between gap-4 mb-4">
                    <div class="flex items-start gap-3">
                        <span class="flex-shrink-0 w-7 h-7 rounded-full bg-[#ede7fc] dark:bg-slate-700 text-[#7c3aed] dark:text-[#a78bfa] text-xs font-semibold flex items-center justify-center mt-0.5">
                            @(i + 1)
                        </span>
                        <p class="text-slate-800 dark:text-slate-100 font-medium leading-relaxed">@ans.QuestionTextLatex</p>
                    </div>
                    <span class="flex-shrink-0 text-xs font-medium text-slate-500 dark:text-slate-400 bg-slate-50 dark:bg-slate-800 border border-slate-100 dark:border-slate-700 rounded-full px-3 py-1 whitespace-nowrap">
                        @(ans.IsMCQ ? "MCQ" : "Written") &middot; @ans.Marks marks
                    </span>
                </div>

                @if (ans.IsMCQ)
                {
                    <div class="ml-10 flex items-center gap-3 flex-wrap">
                        <div class="rounded-xl border @(ans.IsCorrect == true ? "border-emerald-200 dark:border-emerald-900 bg-emerald-50 dark:bg-emerald-950" : "border-red-200 dark:border-red-900 bg-red-50 dark:bg-red-950") px-4 py-2">
                            <p class="text-xs text-slate-500 dark:text-slate-400">Selected Option</p>
                            <p class="text-sm font-medium text-slate-800 dark:text-slate-100">@(ans.SelectedOptionID ?? "No answer")</p>
                        </div>
                        <span class="inline-flex items-center gap-1.5 text-sm font-medium @(ans.IsCorrect == true ? "text-emerald-600 dark:text-emerald-300" : ans.IsCorrect == false ? "text-red-600 dark:text-red-300" : "text-slate-400 dark:text-slate-500")">
                            <i data-lucide="@(ans.IsCorrect == true ? "check-circle" : ans.IsCorrect == false ? "circle-x" : "minus-circle")" class="w-4 h-4"></i>
                            @(ans.IsCorrect == true ? "Correct" : ans.IsCorrect == false ? "Incorrect" : "Not answered")
                        </span>
                        <span class="text-sm text-slate-500 dark:text-slate-400 ml-auto">Marks: @(ans.MarksAwarded?.ToString() ?? "0")</span>
                    </div>
                }
                else
                {
                    <div class="ml-10 space-y-3">
                        <div class="rounded-xl bg-slate-50 dark:bg-slate-800 border border-slate-100 dark:border-slate-700 p-4">
                            <p class="text-sm text-slate-700 dark:text-slate-200 whitespace-pre-wrap leading-relaxed">@(string.IsNullOrEmpty(ans.WrittenAnswerText) ? "(no answer submitted)" : ans.WrittenAnswerText)</p>
                        </div>
                        <p class="text-sm font-medium text-slate-600 dark:text-slate-300">
                            Marks awarded:
                            <span class="text-[#7c3aed] dark:text-[#a78bfa]">@(ans.MarksAwarded?.ToString() ?? "Not yet graded by lecturer")</span>
                            @if (ans.MarksAwarded.HasValue)
                            {
                                @:/ @ans.Marks
                            }
                        </p>
                    </div>
                }
            </div>
        }
    </div>
</div>
