@* backend/Web_Backend/Areas/Admin/Views/ExamGrading/ViolationTrail.cshtml *@
@using Web_Backend.Areas.Admin.Models
@model List<ExamAttemptViolation>
@{
    ViewBag.Title = "Violation Trail";
    var attempt = ViewBag.Attempt as ExamAttempt;
}

<div class="max-w-4xl mx-auto page-enter space-y-4">
    <h1 class="text-xl font-bold text-slate-800 dark:text-slate-100">Violation Trail</h1>

    @if (attempt != null)
    {
        <div class="bg-white dark:bg-slate-900/60 rounded-[20px] shadow-sm border border-slate-100 dark:border-slate-700 p-4">
            <p class="font-medium text-slate-800 dark:text-slate-100">@attempt.ExamTitle</p>
            <p class="text-xs text-slate-500 dark:text-slate-400">
                Attempt @attempt.AttemptID &middot; @attempt.StudentName &middot; Status: @attempt.Status
            </p>
        </div>
    }

    @if (!Model.Any())
    {
        <p class="text-sm text-slate-400 dark:text-slate-500">No violations recorded for this attempt.</p>
    }
    else
    {
        <div class="bg-white dark:bg-slate-900/60 rounded-[20px] shadow-sm border border-slate-100 dark:border-slate-700 overflow-hidden">
            <div class="overflow-x-auto">
                <table class="w-full text-sm">
                    <thead>
                        <tr class="border-b border-slate-100 dark:border-slate-700 text-left text-xs font-medium text-slate-500 dark:text-slate-400 uppercase tracking-wide">
                            <th class="px-6 py-3">Occurred</th>
                            <th class="px-6 py-3">Violation Type</th>
                            <th class="px-6 py-3">Counts as Strike</th>
                            <th class="px-6 py-3">Strike #</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var v in Model)
                        {
                            <tr class="border-b border-slate-50 dark:border-slate-800 last:border-0 hover:bg-slate-50/60 dark:hover:bg-slate-800/40">
                                <td class="px-6 py-3 text-slate-600 dark:text-slate-300">@v.OccurredDate.ToString("g")</td>
                                <td class="px-6 py-3 text-slate-800 dark:text-slate-100 font-medium">@v.ViolationType</td>
                                <td class="px-6 py-3 text-slate-600 dark:text-slate-300">@(v.CountsAsStrike ? "Yes" : "No")</td>
                                <td class="px-6 py-3 text-slate-600 dark:text-slate-300">@(v.StrikeNumber?.ToString() ?? "-")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
