@* backend/Web_Backend/Areas/Admin/Views/ExamGrading/ViolationTrail.cshtml *@
@using Web_Backend.Areas.Admin.Models
@model List<ExamAttemptViolation>
@{
    ViewBag.Title = "Violation Trail";
    var attempt = ViewBag.Attempt as ExamAttempt;
}

<div class="max-w-4xl mx-auto page-enter space-y-4">
    <h1 class="text-xl font-bold text-slate-800 dark:text-slate-100">Violation Trail</h1>

    @if (attempt != null)
    {
        <div class="bg-white dark:bg-slate-900/60 rounded-[20px] shadow-sm border border-slate-100 dark:border-slate-700 p-4">
            <p class="font-medium text-slate-800 dark:text-slate-100">@attempt.ExamTitle</p>
            <p class="text-xs text-slate-500 dark:text-slate-400">
                Attempt @attempt.AttemptID &middot; @attempt.StudentName &middot; Status: @attempt.Status
            </p>
        </div>
    }

    <partial name="~/Views/Shared/_ViolationList.cshtml" model="Model" />
</div>
