@{
    ViewData["Title"] = "Dashboard";
    var currentUser = ViewBag.CurrentUser as Web_Backend.Areas.Admin.Models.SessionUser;
}

<div class="max-w-5xl mx-auto space-y-10 page-enter">

    <div class="relative">
        <div class="absolute -top-10 right-10 w-32 h-32 bg-cyan-400/20 rounded-full blur-[40px]"></div>
        <div class="absolute top-10 right-32 w-24 h-24 bg-purple-400/20 rounded-full blur-[40px]"></div>

        <p class="text-sm font-medium text-slate-500 mb-2">@DateTime.Now.ToString("ddd, MMMM d")</p>
        <h1 class="text-4xl md:text-5xl font-bold text-slate-800 tracking-tight">
            Hello, @(currentUser?.Name ?? "Admin")
        </h1>
        <h2 class="text-3xl md:text-4xl font-bold mt-2 bg-clip-text text-transparent bg-gradient-to-r from-[#06b6d4] to-[#7c3aed] tracking-tight">
            Platform Overview
        </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-white p-6 rounded-[24px] shadow-sm border border-slate-100 hover:shadow-md transition-shadow">
            <div class="flex items-start justify-between mb-4">
                <div class="p-3 rounded-2xl bg-purple-50 text-purple-600"><i data-lucide="users" class="w-5 h-5"></i></div>
                <span class="px-2.5 py-0.5 rounded-full text-xs font-medium bg-emerald-100 text-emerald-700">+12%</span>
            </div>
            <h3 class="text-3xl font-bold text-slate-800 mb-1">2,845</h3>
            <p class="text-sm text-slate-500 font-medium">Total Students</p>
        </div>
        <div class="bg-white p-6 rounded-[24px] shadow-sm border border-slate-100 hover:shadow-md transition-shadow">
            <div class="flex items-start justify-between mb-4">
                <div class="p-3 rounded-2xl bg-cyan-50 text-cyan-600"><i data-lucide="users" class="w-5 h-5"></i></div>
                <span class="px-2.5 py-0.5 rounded-full text-xs font-medium bg-emerald-100 text-emerald-700">+3%</span>
            </div>
            <h3 class="text-3xl font-bold text-slate-800 mb-1">142</h3>
            <p class="text-sm text-slate-500 font-medium">Active Instructors</p>
        </div>
        <div class="bg-white p-6 rounded-[24px] shadow-sm border border-slate-100 hover:shadow-md transition-shadow">
            <div class="flex items-start justify-between mb-4">
                <div class="p-3 rounded-2xl bg-blue-50 text-blue-600"><i data-lucide="users" class="w-5 h-5"></i></div>
                <span class="px-2.5 py-0.5 rounded-full text-xs font-medium bg-emerald-100 text-emerald-700">+24%</span>
            </div>
            <h3 class="text-3xl font-bold text-slate-800 mb-1">8,290</h3>
            <p class="text-sm text-slate-500 font-medium">Course Completions</p>
        </div>
    </div>

    <div class="bg-white rounded-[24px] shadow-sm border border-slate-100 overflow-hidden">
        <div class="p-6 border-b border-slate-100 flex items-center justify-between">
            <div class="flex items-center gap-3">
                <div class="bg-indigo-50 p-2 rounded-lg"><i data-lucide="bell" class="w-5 h-5 text-indigo-600"></i></div>
                <h3 class="font-semibold text-lg text-slate-800">Recent Platform Activity</h3>
            </div>
            <span class="px-2.5 py-0.5 rounded-full text-xs font-medium bg-cyan-100 text-cyan-700">Today • 5 Events</span>
        </div>

        <div class="divide-y divide-slate-50">
            @{
                var activity = new[]
                {
                    ("New instructor registration pending approval", "Registration", "10 mins ago", "High", "bg-red-400"),
                    ("Advanced React Course reached 1000 enrollments", "Milestone", "1 hour ago", "Low", "bg-emerald-400"),
                    ("System maintenance scheduled for weekend", "System", "3 hours ago", "Normal", "bg-blue-400"),
                    ("Student batch upload completed", "Data", "5 hours ago", "Normal", "bg-purple-400"),
                };
            }
            @foreach (var (title, type, time, priority, dot) in activity)
            {
                var badgeColor = priority == "High" ? "bg-red-100 text-red-700" : priority == "Low" ? "bg-slate-100 text-slate-700" : "bg-blue-100 text-blue-700";
                <div class="p-4 px-6 flex items-center justify-between hover:bg-slate-50/50 transition-colors group">
                    <div class="flex items-center gap-4">
                        <i data-lucide="chevron-down" class="w-4 h-4 text-slate-300 -rotate-90 group-hover:text-slate-400"></i>
                        <div class="w-2 h-2 rounded-full @dot"></div>
                        <div>
                            <p class="font-medium text-slate-700 text-sm">@title</p>
                            <p class="text-xs text-slate-400 mt-0.5">@type</p>
                        </div>
                    </div>
                    <div class="flex items-center gap-6">
                        <span class="px-2.5 py-0.5 rounded-full text-xs font-medium @badgeColor">@priority</span>
                        <span class="text-sm font-medium text-slate-500 min-w-[80px] text-right">@time</span>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
