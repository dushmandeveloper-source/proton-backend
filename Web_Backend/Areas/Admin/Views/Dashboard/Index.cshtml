@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    var currentUser = ViewBag.CurrentUser as Web_Backend.Areas.Admin.Models.SessionUser;
}

<div class="max-w-5xl mx-auto space-y-10 page-enter">

    <div class="relative">
        <div class="absolute -top-10 right-10 w-32 h-32 bg-cyan-400/20 rounded-full blur-[40px]"></div>
        <div class="absolute top-10 right-32 w-24 h-24 bg-purple-400/20 rounded-full blur-[40px]"></div>

        <p class="text-sm font-medium text-slate-500 dark:text-slate-400 mb-2">@DateTime.Now.ToString("ddd, MMMM d")</p>
        <h1 class="text-4xl md:text-5xl font-bold text-slate-800 dark:text-slate-100 tracking-tight">
            Hello, @(currentUser?.Name ?? "Admin")
        </h1>
        <h2 class="text-3xl md:text-4xl font-bold mt-2 bg-clip-text text-transparent bg-gradient-to-r from-[#06b6d4] to-[#7c3aed] tracking-tight">
            Platform Overview
        </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-white dark:bg-slate-900/60 p-6 rounded-[24px] shadow-sm border border-slate-100 dark:border-slate-700 hover:shadow-md transition-shadow">
            <div class="p-3 rounded-2xl bg-purple-50 dark:bg-purple-950 text-purple-600 dark:text-purple-300 w-fit mb-4"><i data-lucide="users" class="w-5 h-5"></i></div>
            <h3 class="text-3xl font-bold text-slate-800 dark:text-slate-100 mb-1">@Model.TotalUsers</h3>
            <p class="text-sm text-slate-500 dark:text-slate-400 font-medium">Total Users</p>
        </div>
        <div class="bg-white dark:bg-slate-900/60 p-6 rounded-[24px] shadow-sm border border-slate-100 dark:border-slate-700 hover:shadow-md transition-shadow">
            <div class="p-3 rounded-2xl bg-emerald-50 dark:bg-emerald-950 text-emerald-600 dark:text-emerald-300 w-fit mb-4"><i data-lucide="user-check" class="w-5 h-5"></i></div>
            <h3 class="text-3xl font-bold text-slate-800 dark:text-slate-100 mb-1">@Model.ActiveUsers</h3>
            <p class="text-sm text-slate-500 dark:text-slate-400 font-medium">Active Users</p>
        </div>
        <div class="bg-white dark:bg-slate-900/60 p-6 rounded-[24px] shadow-sm border border-slate-100 dark:border-slate-700 hover:shadow-md transition-shadow">
            <div class="p-3 rounded-2xl bg-slate-100 dark:bg-slate-800 text-slate-500 dark:text-slate-400 w-fit mb-4"><i data-lucide="user-x" class="w-5 h-5"></i></div>
            <h3 class="text-3xl font-bold text-slate-800 dark:text-slate-100 mb-1">@Model.InactiveUsers</h3>
            <p class="text-sm text-slate-500 dark:text-slate-400 font-medium">Inactive Users</p>
        </div>
    </div>

    <div class="bg-white dark:bg-slate-900/60 rounded-[24px] shadow-sm border border-slate-100 dark:border-slate-700 overflow-hidden">
        <div class="p-6 border-b border-slate-100 dark:border-slate-700 flex items-center gap-3">
            <div class="bg-indigo-50 dark:bg-indigo-950 p-2 rounded-lg"><i data-lucide="bell" class="w-5 h-5 text-indigo-600 dark:text-indigo-300"></i></div>
            <h3 class="font-semibold text-lg text-slate-800 dark:text-slate-100">Recent Platform Activity</h3>
        </div>

        <div class="p-10 text-center">
            <p class="text-sm text-slate-400 dark:text-slate-500">No activity log yet — this will populate once activity tracking is added.</p>
        </div>
    </div>
</div>
