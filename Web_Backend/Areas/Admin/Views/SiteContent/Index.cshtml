@model List<SiteBanner>
@using Web_Backend.Areas.Admin.Models
@{
    ViewData["Title"] = "Site Content";
    bool canAdd = Web_Backend.Classes.Auth.HasPermission(Web_Backend.Classes.PermissionCode.SiteContent, 'A');
    bool canEdit = Web_Backend.Classes.Auth.HasPermission(Web_Backend.Classes.PermissionCode.SiteContent, 'E');
    bool canDelete = Web_Backend.Classes.Auth.HasPermission(Web_Backend.Classes.PermissionCode.SiteContent, 'D');
    var tab = ViewBag.Tab as string ?? "hero";
    var settings = ViewBag.Settings as Dictionary<string, string> ?? new();
    var stats = ViewBag.ImageStats as Web_Backend.Classes.ImageStats ?? new();
    string siteUrl = ViewBag.PublicSiteUrl as string ?? "";
    string S(string key) => settings.TryGetValue(key, out var v) ? v : "";
    // Uploaded files live on this backend; built-in /images/... ship with the public site.
    string Img(string? url) => string.IsNullOrEmpty(url) ? "" : url.StartsWith("/Uploads/", StringComparison.OrdinalIgnoreCase) || url.StartsWith("http") ? url : siteUrl + url;
    string Mb(long b) => (b / 1024d / 1024d).ToString("0.0") + " MB";

    var tabs = new[]
    {
        ("hero", "Banner", "image"),
        ("wheel", "Rotating wheel", "orbit"),
        ("announcement", "Announcement bar", "megaphone"),
        ("festival", "Festival effects", "party-popper"),
        ("images", "Home page images", "images"),
        ("speed", "Image speed", "gauge"),
    };
    var input = "w-full px-3 py-2 rounded-xl border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-800 text-sm";
    var card = "bg-white dark:bg-slate-900/60 rounded-[24px] shadow-sm border border-slate-100 dark:border-slate-700";
    var btnPrimary = "px-4 py-2 rounded-xl font-medium bg-[#7c3aed] text-white hover:bg-[#6d28d9] shadow-sm text-sm inline-flex items-center gap-2";
    var btnGhost = "px-4 py-2 rounded-xl font-medium bg-slate-50 dark:bg-slate-800 text-slate-600 dark:text-slate-300 text-sm inline-flex items-center gap-2";
}

<link rel="stylesheet" href="~/css/site-effects.css" asp-append-version="true" />
<style>
    /* The previews use the website's own animation CSS (site-effects.css,
       synced from frontend2). Only preview-box chrome lives here. */
    .anim-preview { background: linear-gradient(135deg, #0b1220, #1e3a5f); }
    .anim-preview .hero-line { display: block; }
    .anim-preview .hero-line-2 { color: #70e4fd; }
    .hero-u { display: inline-block; white-space: pre; }
    #slider-preview .hero-slide { position: absolute; inset: 0; background-size: cover; background-position: center; }
    .wheel-preview-box { background: linear-gradient(135deg, #0b1220, #1e3a5f); }
</style>

<div class="max-w-6xl mx-auto page-enter">
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-6 gap-4">
        <div>
            <h2 class="text-3xl font-bold text-slate-800 dark:text-slate-100 tracking-tight">Site Content</h2>
            <p class="text-slate-500 dark:text-slate-400 mt-2">Change the public website's banner, animations, announcement bar and home page images. Changes appear on the site right away.</p>
        </div>
        @if (!string.IsNullOrEmpty(siteUrl))
        {
            <a href="@siteUrl" target="_blank" rel="noopener" class="@btnGhost w-fit"><i data-lucide="external-link" class="w-4 h-4"></i> Open website</a>
        }
    </div>

    <div class="flex gap-1 overflow-x-auto rounded-2xl bg-slate-100 dark:bg-slate-800/60 p-1.5 mb-6">
        @foreach (var (key, label, icon) in tabs)
        {
            <a href="@Url.Action("Index", new { tab = key })"
               class="flex items-center gap-2 whitespace-nowrap px-4 py-2 rounded-xl text-sm font-medium @(tab == key ? "bg-white dark:bg-slate-900 text-slate-800 dark:text-slate-100 shadow-sm" : "text-slate-500 dark:text-slate-400 hover:text-slate-800 dark:hover:text-slate-200")">
                <i data-lucide="@icon" class="w-4 h-4"></i> @label
            </a>
        }
    </div>

    @* ================= BANNER ================= *@
    @if (tab == "hero")
    {
        var heroAnim = S("HeroTextAnimation");
        <form method="post" asp-action="SaveHeroSettings" class="@card p-6 mb-6">
            @Html.AntiForgeryToken()
            <h3 class="text-lg font-semibold text-slate-800 dark:text-slate-100 mb-1">Banner text animation</h3>
            <p class="text-sm text-slate-500 dark:text-slate-400 mb-4">How the heading "Connecting Sri Lanka &amp; China through trusted solutions." appears when the home page opens. Click an option to preview it.</p>

            <div class="grid grid-cols-1 lg:grid-cols-[1fr_1.1fr] gap-6">
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                    @foreach (var o in SiteContentCatalog.HeroTextAnimations)
                    {
                        <label class="flex items-start gap-3 p-3 rounded-xl border border-slate-200 dark:border-slate-700 cursor-pointer hover:border-[#7c3aed] has-[:checked]:border-[#7c3aed] has-[:checked]:bg-violet-50 dark:has-[:checked]:bg-violet-950/40">
                            <input type="radio" name="heroTextAnimation" value="@o.Value" checked="@(heroAnim == o.Value)" onchange="previewHeroAnim(this.value)" class="mt-1 accent-[#7c3aed]" />
                            <span>
                                <span class="block text-sm font-medium text-slate-800 dark:text-slate-100">@o.Label</span>
                                <span class="block text-xs text-slate-500 dark:text-slate-400">@o.Hint</span>
                            </span>
                        </label>
                    }
                </div>
                <div>
                    <div id="anim-preview" class="anim-preview rounded-2xl p-8 min-h-[220px] flex flex-col justify-center text-center text-white font-bold text-2xl md:text-3xl leading-tight"></div>
                    <button type="button" onclick="previewHeroAnim()" class="@btnGhost mt-3"><i data-lucide="rotate-ccw" class="w-4 h-4"></i> Replay preview</button>
                    <label class="block mt-4">
                        <span class="text-sm font-medium text-slate-600 dark:text-slate-300">Replay the animation every … seconds</span>
                        <input type="number" name="heroTextRepeatSeconds" min="0" max="60" value="@S("HeroTextRepeatSeconds")" class="@input mt-1" />
                        <span class="text-xs text-slate-400">Pause after the heading finishes, then it animates again. 0 = play once.</span>
                    </label>
                </div>
            </div>

            <hr class="my-6 border-slate-100 dark:border-slate-700" />

            <h3 class="text-lg font-semibold text-slate-800 dark:text-slate-100 mb-1">Background slider</h3>
            <p class="text-sm text-slate-500 dark:text-slate-400 mb-4">Pick a transition to see it on your banner photos below.</p>
            <div id="slider-preview" class="relative isolate overflow-hidden rounded-2xl aspect-[16/7] bg-slate-900 mb-4"
                 data-slides='@Json.Serialize(Model.Where(b => b.Placement == SiteContentCatalog.HeroSlide && b.IsActive == "A").Select(b => Img(b.ImageURL)))'>
                <div class="absolute inset-0 z-10 bg-black/40 pointer-events-none"></div>
                <span id="slider-preview-label" class="absolute bottom-3 left-3 z-20 px-2.5 py-1 rounded-full text-xs font-semibold bg-white/90 text-slate-800"></span>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <label class="block">
                    <span class="text-sm font-medium text-slate-600 dark:text-slate-300">Photo transition</span>
                    <select name="heroTransition" class="@input mt-1" onchange="startSliderPreview()">
                        @foreach (var o in SiteContentCatalog.HeroTransitions)
                        {
                            <option value="@o.Value" selected="@(S("HeroTransition") == o.Value)">@o.Label — @o.Hint</option>
                        }
                    </select>
                </label>
                <label class="block">
                    <span class="text-sm font-medium text-slate-600 dark:text-slate-300">Seconds per photo</span>
                    <input type="number" name="heroSlideSeconds" min="3" max="20" value="@S("HeroSlideSeconds")" class="@input mt-1" onchange="startSliderPreview()" />
                </label>
            </div>
            @if (canEdit)
            {
                <button type="submit" class="@btnPrimary mt-5"><i data-lucide="save" class="w-4 h-4"></i> Save banner settings</button>
            }
        </form>

        @await Html.PartialAsync("_BannerList", new SiteContentListModel(
            SiteContentCatalog.HeroSlide, "Banner photos",
            "Background photos behind the home page heading, shown in this order. Use wide landscape photos (at least 1600 × 900). They're shrunk automatically.",
            Model.Where(b => b.Placement == SiteContentCatalog.HeroSlide).ToList(), siteUrl, canAdd, canEdit, canDelete))
    }

    @* ================= WHEEL ================= *@
    @if (tab == "wheel")
    {
        <form method="post" asp-action="SaveWheelSettings" class="@card p-6 mb-6">
            @Html.AntiForgeryToken()
            <h3 class="text-lg font-semibold text-slate-800 dark:text-slate-100 mb-1">Rotating wheel style</h3>
            <p class="text-sm text-slate-500 dark:text-slate-400 mb-4">Change any option to see it below with your wheel photos.</p>
            <div id="wheel-preview" class="wheel-preview-box relative overflow-hidden rounded-2xl h-56 mb-4 flex items-center"
                 data-imgs='@Json.Serialize(Model.Where(b => b.Placement == SiteContentCatalog.HeroWheel && b.IsActive == "A").Select(b => Img(b.ImageURL)))'></div>
            <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
                <label class="block">
                    <span class="text-sm font-medium text-slate-600 dark:text-slate-300">Style</span>
                    <select name="style" class="@input mt-1" onchange="startWheelPreview()">
                        @foreach (var o in SiteContentCatalog.WheelStyles)
                        {
                            <option value="@o.Value" selected="@(S("WheelStyle") == o.Value)">@o.Label — @o.Hint</option>
                        }
                    </select>
                </label>
                <label class="block">
                    <span class="text-sm font-medium text-slate-600 dark:text-slate-300">Card shape</span>
                    <select name="shape" class="@input mt-1" onchange="startWheelPreview()">
                        @foreach (var o in SiteContentCatalog.WheelShapes)
                        {
                            <option value="@o.Value" selected="@(S("WheelShape") == o.Value)">@o.Label</option>
                        }
                    </select>
                </label>
                <label class="block">
                    <span class="text-sm font-medium text-slate-600 dark:text-slate-300">Speed</span>
                    <select name="speed" class="@input mt-1" onchange="startWheelPreview()">
                        @foreach (var o in SiteContentCatalog.Speeds)
                        {
                            <option value="@o.Value" selected="@(S("WheelSpeed") == o.Value)">@o.Label</option>
                        }
                    </select>
                </label>
                <label class="block">
                    <span class="text-sm font-medium text-slate-600 dark:text-slate-300">Direction</span>
                    <select name="direction" class="@input mt-1" onchange="startWheelPreview()">
                        @foreach (var o in SiteContentCatalog.Directions)
                        {
                            <option value="@o.Value" selected="@(S("WheelDirection") == o.Value)">@o.Label</option>
                        }
                    </select>
                </label>
            </div>
            @if (canEdit)
            {
                <button type="submit" class="@btnPrimary mt-5"><i data-lucide="save" class="w-4 h-4"></i> Save wheel settings</button>
            }
        </form>

        @await Html.PartialAsync("_BannerList", new SiteContentListModel(
            SiteContentCatalog.HeroWheel, "Rotating wheel photos",
            "Photos on the rotating 3D card wheel under the banner heading. 8 photos work best (they repeat 3 times around the wheel). Square-ish photos, at least 600 × 600.",
            Model.Where(b => b.Placement == SiteContentCatalog.HeroWheel).ToList(), siteUrl, canAdd, canEdit, canDelete))
    }

    @* ================= ANNOUNCEMENT ================= *@
    @if (tab == "announcement")
    {
        <form method="post" asp-action="SaveAnnouncementSettings" class="@card p-6 mb-6">
            @Html.AntiForgeryToken()
            <div class="flex items-center justify-between gap-4 mb-4">
                <div>
                    <h3 class="text-lg font-semibold text-slate-800 dark:text-slate-100">Announcement bar</h3>
                    <p class="text-sm text-slate-500 dark:text-slate-400">The thin bar at the very top of every page of the website.</p>
                </div>
                <label class="flex items-center gap-2 text-sm font-medium text-slate-700 dark:text-slate-200 cursor-pointer">
                    <input type="checkbox" name="enabled" value="true" checked="@(S("AnnouncementEnabled") == "1")" class="w-4 h-4 accent-[#7c3aed]" /> Show the bar
                </label>
            </div>

            <p class="text-xs font-semibold uppercase tracking-wide text-slate-400 mb-2">Live preview</p>
            <div id="ann-preview" class="relative overflow-hidden rounded-xl text-sm font-medium mb-5 whitespace-nowrap"
                 style="background:@S("AnnouncementBgColor");color:@S("AnnouncementTextColor")"
                 data-items='@Json.Serialize(Model.Where(b => b.Placement == SiteContentCatalog.Announcement && b.IsActive == "A").Select(b => b.Title))'></div>

            <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
                <label class="block md:col-span-2">
                    <span class="text-sm font-medium text-slate-600 dark:text-slate-300">Animation</span>
                    <select name="animation" class="@input mt-1" onchange="startAnnPreview()">
                        @foreach (var o in SiteContentCatalog.AnnouncementAnimations)
                        {
                            <option value="@o.Value" selected="@(S("AnnouncementAnimation") == o.Value)">@o.Label — @o.Hint</option>
                        }
                    </select>
                </label>
                <label class="block">
                    <span class="text-sm font-medium text-slate-600 dark:text-slate-300">Speed</span>
                    <select name="speed" class="@input mt-1" onchange="startAnnPreview()">
                        @foreach (var o in SiteContentCatalog.Speeds)
                        {
                            <option value="@o.Value" selected="@(S("AnnouncementSpeed") == o.Value)">@o.Label</option>
                        }
                    </select>
                </label>
                <div class="grid grid-cols-2 gap-2">
                    <label class="block">
                        <span class="text-sm font-medium text-slate-600 dark:text-slate-300">Background</span>
                        <input type="color" name="bgColor" value="@S("AnnouncementBgColor")" oninput="document.getElementById('ann-preview').style.background=this.value" class="mt-1 h-10 w-full rounded-xl border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-800 p-1" />
                    </label>
                    <label class="block">
                        <span class="text-sm font-medium text-slate-600 dark:text-slate-300">Text</span>
                        <input type="color" name="textColor" value="@S("AnnouncementTextColor")" oninput="document.getElementById('ann-preview').style.color=this.value" class="mt-1 h-10 w-full rounded-xl border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-800 p-1" />
                    </label>
                </div>
            </div>
            @if (canEdit)
            {
                <button type="submit" class="@btnPrimary mt-5"><i data-lucide="save" class="w-4 h-4"></i> Save bar settings</button>
            }
        </form>

        @await Html.PartialAsync("_BannerList", new SiteContentListModel(
            SiteContentCatalog.Announcement, "Messages",
            "Each message can have Chinese text (shown when a visitor picks 中文), an optional link and a start/end date so it turns on and off by itself.",
            Model.Where(b => b.Placement == SiteContentCatalog.Announcement).ToList(), siteUrl, canAdd, canEdit, canDelete))
    }

    @* ================= FESTIVAL EFFECTS ================= *@
    @if (tab == "festival")
    {
        var festivals = Model.Where(b => b.Placement == SiteContentCatalog.Festival).ToList();
        // Same rule as SiteApiController: the most recently saved live effect is the one shown.
        var showingId = festivals.Where(b => b.IsActive == "A" && !b.IsScheduledOut).OrderByDescending(b => b.UpdatedDate).Select(b => b.BannerID).FirstOrDefault();
        string ThemeLabel(string key) => SiteContentCatalog.FestivalThemes.FirstOrDefault(o => o.Value == key)?.Label ?? key;
        string Dt(DateTime? d) => d?.ToString("yyyy-MM-ddTHH:mm") ?? "";

        <div class="@card p-6 mb-6">
            <h3 class="text-lg font-semibold text-slate-800 dark:text-slate-100 mb-1">Festival effects</h3>
            <p class="text-sm text-slate-500 dark:text-slate-400 mb-4">Seasonal animation shown over the whole website (it never blocks clicks). Schedule each one with dates and it turns on and off by itself. If two overlap, the one saved most recently is shown.</p>

            <div class="grid grid-cols-1 lg:grid-cols-[1fr_1.2fr] gap-6">
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 content-start">
                    @foreach (var o in SiteContentCatalog.FestivalThemes)
                    {
                        <button type="button" onclick="previewFestival('@o.Value', this)" data-theme="@o.Value"
                                class="fest-pick text-left p-3 rounded-xl border border-slate-200 dark:border-slate-700 hover:border-[#7c3aed]">
                            <span class="block text-sm font-medium text-slate-800 dark:text-slate-100">@o.Label</span>
                            <span class="block text-xs text-slate-500 dark:text-slate-400">@o.Hint</span>
                        </button>
                    }
                </div>
                <div>
                    <div class="relative overflow-hidden rounded-2xl aspect-video bg-gradient-to-br from-slate-900 to-[#1e3a5f]">
                        <div id="festival-preview" class="absolute inset-0"></div>
                        <span id="festival-preview-label" class="absolute bottom-3 left-3 px-2.5 py-1 rounded-full text-xs font-semibold bg-white/90 text-slate-800">Click a theme to preview</span>
                    </div>
                    <form method="post" asp-action="SaveFestivalSettings" class="mt-4 flex flex-wrap items-end gap-3">
                        @Html.AntiForgeryToken()
                        <label class="block">
                            <span class="text-sm font-medium text-slate-600 dark:text-slate-300">Amount</span>
                            <select name="density" id="festival-density" onchange="previewFestival()" class="@input mt-1">
                                @foreach (var o in SiteContentCatalog.FestivalDensities)
                                {
                                    <option value="@o.Value" selected="@(S("FestivalDensity") == o.Value)">@o.Label</option>
                                }
                            </select>
                        </label>
                        @if (canEdit)
                        {
                            <button type="submit" class="@btnGhost"><i data-lucide="save" class="w-4 h-4"></i> Save amount</button>
                        }
                    </form>
                </div>
            </div>
        </div>

        @if (canAdd || canEdit)
        {
            <form id="festival-form" method="post" asp-action="SaveBanner" class="@card p-6 mb-6">
                @Html.AntiForgeryToken()
                <input type="hidden" name="BannerID" value="0" />
                <input type="hidden" name="Placement" value="@SiteContentCatalog.Festival" />
                <h4 id="festival-form-title" class="font-semibold text-slate-800 dark:text-slate-100 mb-4">Schedule a festival effect</h4>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <label class="block">
                        <span class="text-sm font-medium text-slate-600 dark:text-slate-300">Theme</span>
                        <select name="Title" required class="@input mt-1" onchange="previewFestival(this.value)">
                            @foreach (var o in SiteContentCatalog.FestivalThemes)
                            {
                                <option value="@o.Value">@o.Label</option>
                            }
                        </select>
                    </label>
                    <label class="block">
                        <span class="text-sm font-medium text-slate-600 dark:text-slate-300">Starts</span>
                        <input type="datetime-local" name="StartsAt" class="@input mt-1" />
                    </label>
                    <label class="block">
                        <span class="text-sm font-medium text-slate-600 dark:text-slate-300">Ends</span>
                        <input type="datetime-local" name="EndsAt" class="@input mt-1" />
                    </label>
                </div>
                <p class="text-xs text-slate-400 mt-2">Leave both dates empty to run it until you hide or delete it.</p>
                <div class="flex gap-2 mt-4">
                    <button type="submit" class="@btnPrimary"><i data-lucide="calendar-plus" class="w-4 h-4"></i> Save</button>
                    <button type="button" onclick="resetFestivalForm()" class="@btnGhost">Clear</button>
                </div>
            </form>
        }

        <div class="@card overflow-hidden mb-6">
            @if (!festivals.Any())
            {
                <div class="p-12 text-center text-sm text-slate-400 dark:text-slate-500">No festival effects scheduled.</div>
            }
            else
            {
                <ul class="divide-y divide-slate-100 dark:divide-slate-800">
                    @foreach (var b in festivals)
                    {
                        var inactive = b.IsActive != "A";
                        var runningNow = !inactive && !b.IsScheduledOut;
                        <li class="flex flex-wrap items-center gap-4 p-4 @(inactive ? "opacity-60" : "")">
                            <div class="flex-1 min-w-0">
                                <p class="text-sm font-medium text-slate-800 dark:text-slate-100">@ThemeLabel(b.Title)</p>
                                <p class="text-xs text-slate-500 dark:text-slate-400">@(b.StartsAt?.ToString("MMM d, yyyy HH:mm") ?? "now") → @(b.EndsAt?.ToString("MMM d, yyyy HH:mm") ?? "no end")</p>
                            </div>
                            @if (runningNow && b.BannerID == showingId)
                            {
                                <span class="px-2 py-0.5 rounded-full text-[10px] font-semibold uppercase bg-emerald-100 dark:bg-emerald-950 text-emerald-700 dark:text-emerald-300">Showing on site</span>
                            }
                            else if (runningNow)
                            {
                                <span class="px-2 py-0.5 rounded-full text-[10px] font-semibold uppercase bg-slate-100 dark:bg-slate-800 text-slate-500 dark:text-slate-400">Overlaps — not shown</span>
                            }
                            else if (inactive)
                            {
                                <span class="px-2 py-0.5 rounded-full text-[10px] font-semibold uppercase bg-slate-200 dark:bg-slate-700 text-slate-600 dark:text-slate-300">Hidden</span>
                            }
                            else
                            {
                                <span class="px-2 py-0.5 rounded-full text-[10px] font-semibold uppercase bg-amber-100 dark:bg-amber-950 text-amber-700 dark:text-amber-300">Scheduled</span>
                            }
                            <div class="flex items-center gap-1">
                                <button type="button" class="p-2 rounded-lg text-slate-500 hover:bg-slate-100 dark:hover:bg-slate-800" title="Preview" onclick="previewFestival('@b.Title')"><i data-lucide="play" class="w-4 h-4"></i></button>
                                @if (canEdit)
                                {
                                    <button type="button" class="p-2 rounded-lg text-slate-500 hover:bg-slate-100 dark:hover:bg-slate-800" title="Edit"
                                            onclick='editFestival(@Json.Serialize(new { id = b.BannerID, theme = b.Title, startsAt = Dt(b.StartsAt), endsAt = Dt(b.EndsAt) }))'><i data-lucide="pencil" class="w-4 h-4"></i></button>
                                    <form method="post" asp-action="ToggleBanner">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@b.BannerID" />
                                        <button type="submit" class="p-2 rounded-lg text-slate-500 hover:bg-slate-100 dark:hover:bg-slate-800" title="@(inactive ? "Show on site" : "Hide from site")"><i data-lucide="@(inactive ? "eye-off" : "eye")" class="w-4 h-4"></i></button></form>
                                }
                                @if (canDelete)
                                {
                                    <form method="post" asp-action="DeleteBanner" onsubmit="return confirm('Delete this festival effect?')">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@b.BannerID" />
                                        <button type="submit" class="p-2 rounded-lg text-slate-500 hover:bg-slate-100 dark:hover:bg-slate-800 hover:text-red-600" title="Delete"><i data-lucide="trash-2" class="w-4 h-4"></i></button></form>
                                }
                            </div>
                        </li>
                    }
                </ul>
            }
        </div>
    }

    @* ================= HOME PAGE IMAGES ================= *@
    @if (tab == "images")
    {
        <p class="text-sm text-slate-500 dark:text-slate-400 mb-4">Replace any fixed image on the home page. "Reset" goes back to the original image.</p>
        @foreach (var group in SiteContentCatalog.HomeImages.GroupBy(s => s.Section))
        {
            <h3 class="text-sm font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400 mt-6 mb-3">@group.Key</h3>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                @foreach (var slot in group)
                {
                    settings.TryGetValue(SiteContentCatalog.HomeImagePrefix + slot.Key, out var custom);
                    var current = string.IsNullOrEmpty(custom) ? slot.DefaultUrl : custom;
                    <div class="@card overflow-hidden flex flex-col">
                        <div class="relative aspect-[4/3] bg-slate-100 dark:bg-slate-800">
                            <img src="@Img(current)" alt="@slot.Label" loading="lazy" class="absolute inset-0 w-full h-full object-cover" />
                            @if (!string.IsNullOrEmpty(custom))
                            {
                                <span class="absolute top-2 left-2 px-2 py-0.5 rounded-full text-[10px] font-semibold uppercase bg-[#7c3aed] text-white">Custom</span>
                            }
                        </div>
                        <div class="p-4 flex-1 flex flex-col gap-3">
                            <p class="text-sm font-medium text-slate-800 dark:text-slate-100">@slot.Label</p>
                            @if (canEdit)
                            {
                                <form method="post" asp-action="SaveHomeImage" enctype="multipart/form-data" class="mt-auto">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="slot" value="@slot.Key" />
                                    <label class="@btnPrimary w-full justify-center cursor-pointer">
                                        <i data-lucide="upload" class="w-4 h-4"></i> Replace
                                        <input type="file" name="image" accept="image/*" class="hidden" onchange="this.form.submit()" />
                                    </label>
                                </form>
                                @if (!string.IsNullOrEmpty(custom))
                                {
                                    <form method="post" asp-action="ResetHomeImage" onsubmit="return confirm('Go back to the original image?')">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="slot" value="@slot.Key" />
                                        <button type="submit" class="@btnGhost w-full justify-center"><i data-lucide="rotate-ccw" class="w-4 h-4"></i> Reset</button>
                                    </form>
                                }
                            }
                        </div>
                    </div>
                }
            </div>
        }
    }

    @* ================= IMAGE SPEED ================= *@
    @if (tab == "speed")
    {
        <div class="@card p-6">
            <h3 class="text-lg font-semibold text-slate-800 dark:text-slate-100 mb-1">Automatic image shrinking</h3>
            <p class="text-sm text-slate-500 dark:text-slate-400 mb-5">
                Every uploaded photo is resized to at most @stats.Options.MaxDimension px on its longest side and re-saved at quality @stats.Options.Quality,
                with camera/GPS data removed. Full-size originals are kept privately on the server. PDFs and other files are never changed.
            </p>
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
                <div class="rounded-2xl bg-slate-50 dark:bg-slate-800/60 p-4"><p class="text-xs text-slate-500 dark:text-slate-400">Uploaded images</p><p class="text-2xl font-bold text-slate-800 dark:text-slate-100">@stats.Total</p></div>
                <div class="rounded-2xl bg-emerald-50 dark:bg-emerald-950/40 p-4"><p class="text-xs text-emerald-700 dark:text-emerald-300">Done</p><p class="text-2xl font-bold text-emerald-700 dark:text-emerald-300">@stats.Optimized</p></div>
                <div class="rounded-2xl bg-amber-50 dark:bg-amber-950/40 p-4"><p class="text-xs text-amber-700 dark:text-amber-300">Waiting</p><p class="text-2xl font-bold text-amber-700 dark:text-amber-300">@stats.Pending</p></div>
                <div class="rounded-2xl bg-slate-50 dark:bg-slate-800/60 p-4"><p class="text-xs text-slate-500 dark:text-slate-400">Visitors download</p><p class="text-2xl font-bold text-slate-800 dark:text-slate-100">@Mb(stats.ServedBytes)</p></div>
            </div>
            <div class="rounded-2xl border border-slate-100 dark:border-slate-700 p-4 mb-6 text-sm">
                <p class="font-semibold text-slate-700 dark:text-slate-200 mb-2">Settings <span class="font-normal text-slate-400">(appsettings.json → ApplicationSettings)</span></p>
                <dl class="grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-1 text-slate-600 dark:text-slate-300">
                    <div class="flex justify-between gap-4"><dt>ImageOptimization:Enabled</dt><dd class="font-mono">@stats.Options.Enabled</dd></div>
                    <div class="flex justify-between gap-4"><dt>ImageOptimization:MaxDimension</dt><dd class="font-mono">@stats.Options.MaxDimension px</dd></div>
                    <div class="flex justify-between gap-4"><dt>ImageOptimization:Quality</dt><dd class="font-mono">@stats.Options.Quality</dd></div>
                    <div class="flex justify-between gap-4"><dt>ImageOptimization:KeepOriginals</dt><dd class="font-mono">@stats.Options.KeepOriginals</dd></div>
                    <div class="flex justify-between gap-4"><dt>ImageOptimization:OptimizeExistingOnStartup</dt><dd class="font-mono">@stats.Options.OptimizeExistingOnStartup</dd></div>
                    <div class="flex justify-between gap-4"><dt>Uploads:Path</dt><dd class="font-mono break-all text-right">@(stats.CustomFolder ? stats.Folder : "(default) wwwroot/Uploads")</dd></div>
                    <div class="md:col-span-2 flex justify-between gap-4"><dt>Uploads:OriginalsPath</dt><dd class="font-mono break-all text-right">@stats.OriginalsFolder</dd></div>
                </dl>
                @if (!stats.CustomFolder)
                {
                    <p class="mt-3 text-amber-700 dark:text-amber-300">Uploads are stored inside the website folder. Set <span class="font-mono">Uploads:Path</span> to a folder outside it so a backend redeploy can never overwrite or delete uploaded files.</p>
                }
                else if (stats.InOldFolder > 0)
                {
                    <p class="mt-3 text-amber-700 dark:text-amber-300">@stats.InOldFolder file(s) are still in the old wwwroot/Uploads folder.</p>
                    @if (canEdit)
                    {
                        <form method="post" asp-action="MoveUploads" class="mt-2">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="@btnGhost"><i data-lucide="folder-input" class="w-4 h-4"></i> Move them to the uploads folder</button>
                        </form>
                    }
                }
            </div>
            @if (stats.Running)
            {
                <p class="text-sm text-amber-700 dark:text-amber-300 flex items-center gap-2"><i data-lucide="loader" class="w-4 h-4 animate-spin"></i> Shrinking images now… refresh in a minute.</p>
            }
            else if (canEdit)
            {
                <form method="post" asp-action="OptimizeImages">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="@btnPrimary" @(stats.Pending == 0 ? "disabled" : "")><i data-lucide="zap" class="w-4 h-4"></i> Shrink images now</button>
                    @if (stats.Pending == 0)
                    {
                        <span class="ml-3 text-sm text-slate-500 dark:text-slate-400">All images are already shrunk.</span>
                    }
                </form>
            }
        </div>
    }
</div>

@section Scripts {
    @if (tab == "festival")
    {
        <script src="https://cdn.jsdelivr.net/npm/tsparticles@3.9.1/tsparticles.bundle.min.js"></script>
        <script src="~/js/festival-fx.js" asp-append-version="true"></script>
    }
    <script>
        // All previews below build the same markup + classes as the website
        // (frontend2 Hero.jsx / MagnifyText.jsx / AnnouncementBar.jsx) and use
        // its CSS (site-effects.css), so what you see is what the site shows.

        // ---------- Hero heading animation preview ----------
        const PREVIEW_LINES = ['Connecting Sri Lanka', '& China through', 'trusted solutions.'];
        const PER_WORD = ['BlurIn', 'Zoom', 'MaskReveal'];
        const PER_LINE = ['FadeUp', 'SlideIn'];
        let currentAnim = '@(S("HeroTextAnimation"))';

        function headingTiming(anim) {
            if (anim === 'Typewriter') {
                let at = 0.2;
                const delays = PREVIEW_LINES.map(l => { const d = at; at += l.length * 0.055 + 0.1; return d; });
                return { step: 0.055, delays, end: at };
            }
            if (PER_WORD.includes(anim)) return { step: 0.12, delays: [0.15, 0.6, 1.05], end: 1.6 };
            if (PER_LINE.includes(anim)) return { step: 0, delays: [0.15, 0.45, 0.75], end: 1.4 };
            return { step: 0.028, delays: [0.15, 0.55, 0.95], end: 1.6 };
        }

        function previewHeroAnim(anim) {
            if (anim) currentAnim = anim;
            const box = document.getElementById('anim-preview');
            if (!box) return;
            box.innerHTML = '';
            const t = headingTiming(currentAnim);
            PREVIEW_LINES.forEach((text, li) => {
                const line = document.createElement('span');
                line.className = 'hero-line hero-line-' + li;
                const inner = document.createElement('span');
                if (currentAnim !== 'None') inner.className = 'hero-anim-' + currentAnim;
                let word = 0;
                [...text].forEach((ch, i) => {
                    if (ch === ' ') word++;
                    const unit = PER_LINE.includes(currentAnim) ? 0 : PER_WORD.includes(currentAnim) ? word : i;
                    const u = document.createElement('span');
                    u.className = 'hero-u';
                    u.textContent = ch === ' ' ? '\u00a0' : ch;
                    const d = t.delays[li] + unit * t.step;
                    u.style.animationDelay = currentAnim === 'Wave' ? `${d}s, ${d + 0.9}s` : `${d}s`;
                    inner.appendChild(u);
                });
                line.appendChild(inner);
                if (li === 2 && currentAnim === 'Typewriter') {
                    const caret = document.createElement('span');
                    caret.className = 'hero-caret';
                    caret.style.animationDelay = `${t.end - 0.1}s, ${t.end - 0.1}s`;
                    line.appendChild(caret);
                }
                box.appendChild(line);
            });
        }
        previewHeroAnim();

        // ---------- Slider transition preview ----------
        let sliderTimer = null;
        function startSliderPreview() {
            const box = document.getElementById('slider-preview');
            if (!box) return;
            const urls = JSON.parse(box.dataset.slides || '[]');
            const sel = document.querySelector('[name=heroTransition]');
            const secs = Math.min(Math.max(parseInt(document.querySelector('[name=heroSlideSeconds]').value) || 6, 3), 20);
            box.className = box.className.replace(/\bhero-tr-\w+/g, '') + ' hero-tr-' + sel.value;
            box.style.setProperty('--slide-ms', secs * 1000 + 'ms');
            document.getElementById('slider-preview-label').textContent = sel.options[sel.selectedIndex].text.split(' — ')[0] + ' · ' + secs + 's per photo';
            box.querySelectorAll('.hero-slide').forEach(e => e.remove());
            clearInterval(sliderTimer);
            if (!urls.length) return;
            const els = urls.map(u => {
                const d = document.createElement('div');
                d.className = 'hero-slide';
                d.style.backgroundImage = 'url("' + u + '")';
                box.prepend(d);
                return d;
            });
            let cur = 0;
            const show = () => els.forEach((e, i) => {
                e.classList.toggle('is-active', i === cur);
                e.classList.toggle('is-prev', els.length > 1 && i === (cur - 1 + els.length) % els.length);
            });
            requestAnimationFrame(show);
            // at most 4 s per photo here, so the transition is quick to judge
            sliderTimer = setInterval(() => { cur = (cur + 1) % els.length; show(); }, Math.min(secs, 4) * 1000);
        }
        startSliderPreview();

        // ---------- Announcement bar preview ----------
        let annTimer = null;
        function startAnnPreview() {
            const box = document.getElementById('ann-preview');
            if (!box) return;
            let items = JSON.parse(box.dataset.items || '[]');
            if (!items.length) items = ['Your announcement text appears here', 'Add a second message to see it rotate'];
            const anim = document.querySelector('[name=animation]').value;
            const speed = document.querySelector('[name=speed]').value;
            clearInterval(annTimer);
            box.classList.remove('announce-pulse', 'announce-glow', 'announce-shimmer');
            box.innerHTML = '';
            const esc = t => { const s = document.createElement('span'); s.textContent = t; return s.innerHTML; };
            if (anim === 'Scroll') {
                const pps = { Slow: 40, Normal: 70, Fast: 110 }[speed] || 70;
                const chars = items.reduce((n, t) => n + t.length + 8, 0);
                const copy = items.map(t => '<span style="display:inline-flex;align-items:center;padding:0 2rem">' + esc(t) + '<span style="margin-left:4rem;opacity:.5">✦</span></span>').join('');
                box.innerHTML = '<div class="announce-track" style="display:flex;width:max-content;padding:.5rem 0;animation-duration:' + Math.max(12, chars * 8 / pps) + 's"><div style="display:flex;flex:none">' + copy + '</div><div style="display:flex;flex:none">' + copy + '</div></div>';
                return;
            }
            const loop = { Pulse: 'announce-pulse', Glow: 'announce-glow', Shimmer: 'announce-shimmer' }[anim];
            if (loop) box.classList.add(loop);
            const rotates = ['Fade', 'SlideUp', 'Flip', 'Bounce'].includes(anim);
            box.style.textAlign = 'center';
            const line = document.createElement('div');
            box.appendChild(line);
            let i = 0;
            const render = () => {
                line.className = '';
                line.style.padding = '.5rem 1rem';
                void line.offsetWidth; // restart the CSS animation
                if (rotates) line.classList.add('announce-' + anim);
                line.textContent = items[i % items.length];
            };
            render();
            if (rotates) annTimer = setInterval(() => { i++; render(); }, { Slow: 6000, Normal: 4200, Fast: 2800 }[speed] || 4200);
        }
        startAnnPreview();

        // ---------- Rotating wheel preview ----------
        let wheelRaf = 0;
        function startWheelPreview() {
            const box = document.getElementById('wheel-preview');
            if (!box) return;
            cancelAnimationFrame(wheelRaf);
            const f = box.closest('form');
            const style = f.querySelector('[name=style]').value;
            const shape = f.querySelector('[name=shape]').value;
            const lap = { Slow: 110, Normal: 70, Fast: 35 }[f.querySelector('[name=speed]').value] || 70;
            const dir = f.querySelector('[name=direction]').value === 'Right' ? -1 : 1;
            let imgs = JSON.parse(box.dataset.imgs || '[]');
            if (!imgs.length) { box.innerHTML = '<p class="w-full text-center text-sm text-white/70">Add wheel photos below to preview.</p>'; return; }
            const esc = u => u.replace(/"/g, '&quot;');
            if (style === 'Marquee') {
                const cards = [...imgs, ...imgs, ...imgs, ...imgs].map(u => '<div class="wheel-marquee-card"><img src="' + esc(u) + '" alt=""></div>').join('');
                box.innerHTML = '<div class="wheel-marquee wheel-shape-' + shape + '" style="width:100%"><div class="wheel-marquee-track' + (dir < 0 ? ' is-right' : '') + '" style="animation-duration:' + (lap * 0.6) + 's">' + cards + '</div></div>';
                return;
            }
            let html = '<div class="wheel-stage wheel-style-' + style + ' wheel-shape-' + shape + '" style="width:100%;height:6rem;margin-top:5rem"><div class="wheel-wrap">';
            for (let i = 0; i < 24; i++) {
                html += '<div class="wheel-spoke" style="--spoke-angle:' + (i * 15) + 'deg"><div class="wheel-card"><div class="wheel-card-face" style="overflow:hidden"><img src="' + esc(imgs[i % imgs.length]) + '" alt="" style="width:100%;height:100%;object-fit:cover"></div></div></div>';
            }
            box.innerHTML = html + '</div></div>';
            const wrap = box.querySelector('.wheel-wrap');
            let spin = 0, last = performance.now();
            const tick = t => {
                spin = (spin + (360 / lap) * ((t - last) / 1000) * dir) % 360;
                last = t;
                wrap.style.setProperty('--wheel-spin', spin + 'deg');
                wheelRaf = requestAnimationFrame(tick);
            };
            wheelRaf = requestAnimationFrame(tick);
        }
        startWheelPreview();

        // ---------- Festival effect preview (wwwroot/js/festival-fx.js) ----------
        let festivalStop = null, festivalTheme = null;
        function previewFestival(theme, btn) {
            const canvas = document.getElementById('festival-preview');
            if (!canvas || !window.startFestivalFx) return;
            if (theme) festivalTheme = theme;
            if (!festivalTheme) return;
            if (festivalStop) festivalStop();
            const density = parseFloat(document.getElementById('festival-density')?.value || '1');
            festivalStop = window.startFestivalFx(canvas, festivalTheme, { density });
            document.querySelectorAll('.fest-pick').forEach(b => {
                const on = b.dataset.theme === festivalTheme;
                b.classList.toggle('border-[#7c3aed]', on);
                b.classList.toggle('bg-violet-50', on);
            });
            const label = document.querySelector('.fest-pick[data-theme="' + festivalTheme + '"] span');
            document.getElementById('festival-preview-label').textContent = label ? label.textContent : festivalTheme;
            const sel = document.querySelector('#festival-form [name=Title]');
            if (sel && btn) sel.value = festivalTheme;
        }
        function editFestival(d) {
            const f = document.getElementById('festival-form');
            f.querySelector('[name=BannerID]').value = d.id;
            f.querySelector('[name=Title]').value = d.theme;
            f.querySelector('[name=StartsAt]').value = d.startsAt || '';
            f.querySelector('[name=EndsAt]').value = d.endsAt || '';
            document.getElementById('festival-form-title').textContent = 'Edit festival effect';
            previewFestival(d.theme);
            f.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
        function resetFestivalForm() {
            const f = document.getElementById('festival-form');
            f.reset();
            f.querySelector('[name=BannerID]').value = 0;
            document.getElementById('festival-form-title').textContent = 'Schedule a festival effect';
        }
        if (document.getElementById('festival-preview')) previewFestival('@(Model.FirstOrDefault(b => b.Placement == SiteContentCatalog.Festival)?.Title ?? "Christmas")');

        // ---------- Add / edit form (shared by every list on this page) ----------
        function openBannerForm(placement, data) {
            const f = document.getElementById('banner-form-' + placement);
            if (!f) return;
            data = data || {};
            f.querySelector('[name=BannerID]').value = data.id || 0;
            f.querySelector('[name=Title]').value = data.title || '';
            const zh = f.querySelector('[name=TitleChinese]'); if (zh) zh.value = data.titleChinese || '';
            f.querySelector('[name=LinkURL]').value = data.link || '';
            f.querySelector('[name=StartsAt]').value = data.startsAt || '';
            f.querySelector('[name=EndsAt]').value = data.endsAt || '';
            const img = f.querySelector('[name=image]'); if (img) { img.value = ''; img.required = !data.id; }
            const prev = f.querySelector('.banner-form-preview');
            if (prev) { prev.src = data.imageUrl || ''; prev.classList.toggle('hidden', !data.imageUrl); }
            f.querySelector('.banner-form-title').textContent = data.id ? 'Edit' : 'Add new';
            f.classList.remove('hidden');
            f.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
        function closeBannerForm(placement) {
            document.getElementById('banner-form-' + placement)?.classList.add('hidden');
        }
        function previewUpload(input) {
            const prev = input.form.querySelector('.banner-form-preview');
            if (!prev || !input.files?.[0]) return;
            prev.src = URL.createObjectURL(input.files[0]);
            prev.classList.remove('hidden');
        }
    </script>
}
