@model List<Web_Backend.Areas.Admin.Data.GalleryEvent>
@{
    ViewData["Title"] = "Gallery";
    bool canAdd = Web_Backend.Classes.Auth.HasPermission(Web_Backend.Classes.PermissionCode.SiteContent, 'A');
    bool canEdit = Web_Backend.Classes.Auth.HasPermission(Web_Backend.Classes.PermissionCode.SiteContent, 'E');
    bool canDelete = Web_Backend.Classes.Auth.HasPermission(Web_Backend.Classes.PermissionCode.SiteContent, 'D');
    var iconBtn = "p-2 rounded-lg text-slate-500 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800";
}

<div id="order-toast" class="hidden fixed bottom-6 left-1/2 -translate-x-1/2 z-50 px-4 py-2 rounded-xl bg-slate-900 text-white text-sm shadow-lg"></div>
<div class="max-w-6xl mx-auto page-enter">
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-6 gap-4">
        <div>
            <h2 class="text-3xl font-bold text-slate-800 dark:text-slate-100 tracking-tight">Gallery</h2>
            <p class="text-slate-500 dark:text-slate-400 mt-2">Each event is an album on the website's Gallery page — a title, date, place and its photos. Drag <i data-lucide="grip-vertical" class="inline w-4 h-4"></i> to change the order; the first event is shown first.</p>
        </div>
        @if (canAdd)
        {
            <a asp-action="Index" asp-route-id="0" class="px-4 py-2 rounded-xl font-medium bg-[#7c3aed] text-white hover:bg-[#6d28d9] shadow-sm text-sm inline-flex items-center gap-2 shrink-0"><i data-lucide="plus" class="w-4 h-4"></i> New event</a>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="bg-white dark:bg-slate-900/60 rounded-[24px] border border-dashed border-slate-300 dark:border-slate-700 p-12 text-center">
            <div class="mx-auto w-14 h-14 rounded-2xl bg-[#7c3aed]/10 text-[#7c3aed] flex items-center justify-center"><i data-lucide="images" class="w-7 h-7"></i></div>
            <p class="mt-4 font-semibold text-slate-700 dark:text-slate-200">No events yet</p>
            <p class="mt-1 text-sm text-slate-400">Until you add one, the website shows its built-in photos. Create an event, then add its photos.</p>
            @if (canAdd)
            {
                <div class="mt-5 flex flex-col sm:flex-row items-center justify-center gap-3">
                    <form method="post" asp-action="ImportCurrent" onsubmit="this.querySelector('button').disabled=true;this.querySelector('span').textContent='Importing… (about 20 seconds)'">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-[#7c3aed] text-white text-sm font-medium hover:bg-[#6d28d9] disabled:opacity-60"><i data-lucide="download" class="w-4 h-4"></i> <span>Import the 14 photos already on the website</span></button>
                    </form>
                    <a asp-action="Index" asp-route-id="0" class="inline-flex items-center gap-2 px-4 py-2 rounded-xl border border-slate-200 dark:border-slate-600 text-slate-700 dark:text-slate-200 text-sm font-medium hover:bg-slate-50 dark:hover:bg-slate-800"><i data-lucide="plus" class="w-4 h-4"></i> Start a new event</a>
                </div>
            }
        </div>
    }
    else
    {
        <div id="sortable-list" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
            @foreach (var e in Model)
            {
                var hidden = e.IsActive != "A";
                <div data-id="@e.EventID" class="group bg-white dark:bg-slate-900 rounded-[20px] border border-slate-100 dark:border-slate-700 shadow-sm overflow-hidden @(hidden ? "opacity-60" : "")">
                    <a asp-action="Index" asp-route-id="@e.EventID" class="relative block aspect-[16/10] bg-slate-100 dark:bg-slate-800 overflow-hidden">
                        @if (!string.IsNullOrEmpty(e.CoverURL))
                        {
                            <img src="@e.CoverURL" alt="" loading="lazy" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
                        }
                        else
                        {
                            <div class="w-full h-full flex flex-col items-center justify-center text-slate-400"><i data-lucide="image-plus" class="w-8 h-8"></i><span class="mt-2 text-xs">No photos yet</span></div>
                        }
                        <span class="absolute left-3 top-3 px-2 py-1 rounded-full bg-black/60 text-white text-[11px] font-medium inline-flex items-center gap-1"><i data-lucide="images" class="w-3 h-3"></i> @e.PhotoCount</span>
                        @if (hidden) { <span class="absolute right-3 top-3 px-2 py-1 rounded-full bg-slate-900/80 text-white text-[10px] font-semibold uppercase">Hidden</span> }
                    </a>
                    <div class="p-4 flex items-start gap-2">
                        @if (canEdit) { <span class="drag-handle cursor-grab active:cursor-grabbing p-1 -ml-1 mt-0.5 text-slate-300 hover:text-slate-500" title="Drag to reorder"><i data-lucide="grip-vertical" class="w-5 h-5"></i></span> }
                        <div class="flex-1 min-w-0">
                            <a asp-action="Index" asp-route-id="@e.EventID" class="block font-semibold text-slate-800 dark:text-slate-100 truncate hover:text-[#7c3aed]">@e.Title</a>
                            <p class="text-xs text-slate-500 mt-0.5 truncate">@(e.EventDate?.ToString("d MMM yyyy") ?? "No date")@(string.IsNullOrEmpty(e.Location) ? "" : " · " + e.Location)</p>
                        </div>
                        <div class="flex items-center shrink-0">
                            @if (canEdit)
                            {
                                <form method="post" asp-action="Toggle">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@e.EventID" />
                                    <button type="submit" class="@iconBtn" title="@(hidden ? "Show on website" : "Hide from website")"><i data-lucide="@(hidden ? "eye-off" : "eye")" class="w-4 h-4"></i></button></form>
                            }
                            @if (canDelete)
                            {
                                <form method="post" asp-action="Delete" onsubmit="return confirm('Delete this event and all its photos?')">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@e.EventID" />
                                    <button type="submit" class="@iconBtn hover:text-red-600" title="Delete"><i data-lucide="trash-2" class="w-4 h-4"></i></button></form>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
        @Html.AntiForgeryToken()
    }
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.2/Sortable.min.js"></script>
    <script>
        (function () {
            const list = document.getElementById('sortable-list');
            if (!list || !window.Sortable) return;
            const toast = document.getElementById('order-toast');
            Sortable.create(list, {
                handle: '.drag-handle', animation: 180, ghostClass: 'opacity-40',
                onEnd: async () => {
                    const fd = new FormData();
                    [...list.children].forEach(el => fd.append('ids', el.dataset.id));
                    fd.append('__RequestVerificationToken', document.querySelector('input[name=__RequestVerificationToken]').value);
                    const res = await fetch('@Url.Action("Reorder")', { method: 'POST', body: fd });
                    toast.textContent = res.ok ? 'Order saved' : 'Could not save the order — please refresh';
                    toast.classList.remove('hidden');
                    clearTimeout(window.__orderToast);
                    window.__orderToast = setTimeout(() => toast.classList.add('hidden'), 2200);
                },
            });
        })();
    </script>
}
