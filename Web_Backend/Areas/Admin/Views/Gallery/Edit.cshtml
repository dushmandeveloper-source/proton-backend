@model Web_Backend.Areas.Admin.Data.GalleryEvent
@{
    var isNew = Model.EventID == 0;
    ViewData["Title"] = isNew ? "New gallery event" : Model.Title;
    var photos = (List<Web_Backend.Areas.Admin.Data.GalleryPhoto>)ViewBag.Photos;
    bool canEdit = Web_Backend.Classes.Auth.HasPermission(Web_Backend.Classes.PermissionCode.SiteContent, 'E');
    bool canDelete = Web_Backend.Classes.Auth.HasPermission(Web_Backend.Classes.PermissionCode.SiteContent, 'D');
    var input = "w-full px-3 py-2.5 rounded-xl border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-800 text-sm focus:outline-none focus:ring-2 focus:ring-[#7c3aed]/30 focus:border-[#7c3aed]";
    var card = "bg-white dark:bg-slate-900/60 rounded-[24px] shadow-sm border border-slate-100 dark:border-slate-700 p-6";
}

<div id="order-toast" class="hidden fixed bottom-6 left-1/2 -translate-x-1/2 z-50 px-4 py-2 rounded-xl bg-slate-900 text-white text-sm shadow-lg"></div>
<div class="max-w-6xl mx-auto page-enter">
    <a asp-action="Index" asp-route-id="" class="inline-flex items-center gap-1 text-sm text-slate-500 hover:text-slate-800 dark:hover:text-slate-200"><i data-lucide="arrow-left" class="w-4 h-4"></i> All events</a>
    <h2 class="mt-2 text-3xl font-bold text-slate-800 dark:text-slate-100 tracking-tight">@(isNew ? "New event" : Model.Title)</h2>

    <div class="mt-6 grid grid-cols-1 lg:grid-cols-[22rem_1fr] gap-6 items-start">
        @* ---------- details ---------- *@
        <form method="post" asp-action="Save" class="@card space-y-4 lg:sticky lg:top-24">
            @Html.AntiForgeryToken()
            <input type="hidden" name="EventID" value="@Model.EventID" />
            <p class="text-sm font-semibold text-slate-700 dark:text-slate-200">Event details</p>
            <label class="block"><span class="text-sm font-medium text-slate-600 dark:text-slate-300">Title</span>
                <input type="text" name="Title" value="@Model.Title" maxlength="200" required class="@input mt-1" placeholder="e.g. 2026 Education Fair, Colombo" /></label>
            <div class="grid grid-cols-2 gap-3">
                <label class="block"><span class="text-sm font-medium text-slate-600 dark:text-slate-300">Date</span>
                    <input type="date" name="EventDate" value="@(Model.EventDate?.ToString("yyyy-MM-dd"))" class="@input mt-1" /></label>
                <label class="block"><span class="text-sm font-medium text-slate-600 dark:text-slate-300">Place</span>
                    <input type="text" name="Location" value="@Model.Location" maxlength="200" class="@input mt-1" placeholder="e.g. Colombo" /></label>
            </div>
            <label class="block"><span class="text-sm font-medium text-slate-600 dark:text-slate-300">Short description <span class="text-slate-400 font-normal">(optional)</span></span>
                <textarea name="Description" rows="4" maxlength="1000" class="@input mt-1" placeholder="What happened at this event?">@Model.Description</textarea></label>
            <label class="flex items-center gap-3 rounded-xl border border-slate-200 dark:border-slate-600 px-3 py-2.5 text-sm text-slate-700 dark:text-slate-200 cursor-pointer">
                <input type="hidden" name="IsActive" value="@(Model.IsActive == "I" ? "I" : "A")" id="is-active" />
                <input type="checkbox" class="w-4 h-4 accent-[#7c3aed]" @(Model.IsActive == "I" ? "" : "checked") onchange="document.getElementById('is-active').value = this.checked ? 'A' : 'I'" />
                Show this event on the website
            </label>
            <button type="submit" class="w-full px-4 py-2.5 rounded-xl font-medium bg-[#7c3aed] text-white hover:bg-[#6d28d9] text-sm">@(isNew ? "Create event & add photos" : "Save details")</button>
        </form>

        @* ---------- photos ---------- *@
        <div class="@card">
            <div class="flex items-center justify-between gap-3">
                <p class="text-sm font-semibold text-slate-700 dark:text-slate-200">Photos <span id="photo-count" class="ml-1 px-2 py-0.5 rounded-full bg-slate-100 dark:bg-slate-800 text-xs text-slate-500">@photos.Count</span></p>
                @if (!isNew) { <p class="text-xs text-slate-400">Drag to reorder · the first photo is the album cover</p> }
            </div>

            @if (isNew)
            {
                <div class="mt-4 rounded-2xl border-2 border-dashed border-slate-200 dark:border-slate-700 p-10 text-center text-sm text-slate-400">
                    <i data-lucide="images" class="w-8 h-8 mx-auto"></i>
                    <p class="mt-2">Create the event first — then you can drop in its photos here.</p>
                </div>
            }
            else
            {
                <label id="drop" class="mt-4 flex flex-col items-center justify-center rounded-2xl border-2 border-dashed border-slate-200 dark:border-slate-700 p-8 text-center cursor-pointer transition hover:border-[#7c3aed] hover:bg-[#7c3aed]/5">
                    <span class="w-12 h-12 rounded-2xl bg-[#7c3aed]/10 text-[#7c3aed] flex items-center justify-center"><i data-lucide="upload-cloud" class="w-6 h-6"></i></span>
                    <span class="mt-3 text-sm font-semibold text-slate-700 dark:text-slate-200">Drop photos here or click to choose</span>
                    <span class="mt-1 text-xs text-slate-400">Choose many at once · JPG, PNG, WebP · up to 15 MB each · resized automatically for fast loading</span>
                    <input id="file-input" type="file" accept="image/*" multiple class="sr-only" />
                </label>
                <div id="upload-status" class="hidden mt-3">
                    <div class="flex justify-between text-xs text-slate-500"><span id="upload-text"></span><span id="upload-pct"></span></div>
                    <div class="mt-1 h-1.5 rounded-full bg-slate-100 dark:bg-slate-800 overflow-hidden"><div id="upload-bar" class="h-full w-0 bg-[#7c3aed] transition-all duration-300"></div></div>
                </div>

                <div id="photo-grid" class="mt-5 grid grid-cols-2 sm:grid-cols-3 xl:grid-cols-4 gap-3">
                    @foreach (var p in photos)
                    {
                        <div data-id="@p.PhotoID" class="photo-tile group relative rounded-xl overflow-hidden bg-slate-100 dark:bg-slate-800 border border-slate-100 dark:border-slate-700">
                            <img src="@p.ImageURL" alt="" loading="lazy" class="aspect-[4/3] w-full object-cover cursor-grab active:cursor-grabbing" />
                            @if (canDelete) { <button type="button" data-delete="@p.PhotoID" class="absolute right-2 top-2 p-1.5 rounded-lg bg-black/60 text-white opacity-0 group-hover:opacity-100 focus:opacity-100 transition hover:bg-red-600" title="Delete photo"><i data-lucide="trash-2" class="w-3.5 h-3.5"></i></button> }
                            <input type="text" data-caption="@p.PhotoID" value="@p.Caption" maxlength="300" placeholder="Add a caption…" class="w-full px-2.5 py-2 text-xs bg-white dark:bg-slate-900 border-0 border-t border-slate-100 dark:border-slate-700 focus:outline-none focus:ring-0" @(canEdit ? "" : "disabled") />
                        </div>
                    }
                </div>
                <p id="no-photos" class="@(photos.Any() ? "hidden" : "") mt-2 text-center text-xs text-slate-400">No photos yet — this event stays hidden on the website until it has at least one.</p>
            }
        </div>
    </div>
</div>

@section Scripts {
        <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.2/Sortable.min.js"></script>
        <script>
            (function () {
                const EVENT_ID = @Model.EventID;
                                const grid = document.getElementById('photo-grid');
                if (!grid) return;
                const token = document.querySelector('input[name=__RequestVerificationToken]').value;
                const toast = document.getElementById('order-toast');
                const say = (msg) => {
                    toast.textContent = msg; toast.classList.remove('hidden');
                    clearTimeout(window.__toast); window.__toast = setTimeout(() => toast.classList.add('hidden'), 2400);
                };
                const post = (url, data) => {
                    const fd = data instanceof FormData ? data : new FormData();
                    if (!(data instanceof FormData)) Object.entries(data).forEach(([k, v]) => [].concat(v).forEach(x => fd.append(k, x)));
                    fd.append('__RequestVerificationToken', token);
                    return fetch(url, { method: 'POST', body: fd });
                };
                const refreshCount = () => {
                    const n = grid.children.length;
                    document.getElementById('photo-count').textContent = n;
                    document.getElementById('no-photos').classList.toggle('hidden', n > 0);
                };

                // ----- reorder -----
                if (window.Sortable) Sortable.create(grid, {
                    animation: 180, ghostClass: 'opacity-40', filter: 'input,button', preventOnFilter: false,
                    onEnd: async () => {
                        const res = await post('@Url.Action("ReorderPhotos")', { eventId: EVENT_ID, ids: [...grid.children].map(el => el.dataset.id) });
                        say(res.ok ? 'Order saved' : 'Could not save the order — please refresh');
                    },
                });

                // ----- captions (saved when you leave the box) -----
                grid.addEventListener('change', async e => {
                    const id = e.target.dataset.caption;
                    if (!id) return;
                    const res = await post('@Url.Action("Caption")', { photoId: id, caption: e.target.value });
                    say(res.ok ? 'Caption saved' : 'Could not save the caption');
                });

                // ----- delete -----
                grid.addEventListener('click', async e => {
                    const btn = e.target.closest('[data-delete]');
                    if (!btn || !confirm('Delete this photo?')) return;
                    const res = await post('@Url.Action("DeletePhoto")', { eventId: EVENT_ID, photoId: btn.dataset.delete });
                    if (res.ok) { btn.closest('.photo-tile').remove(); refreshCount(); say('Photo deleted'); }
                    else say('Could not delete the photo');
                });

                // ----- upload: one photo at a time, with progress -----
                function tile(id, url) {
                    const div = document.createElement('div');
                    div.dataset.id = id;
                    div.className = 'photo-tile group relative rounded-xl overflow-hidden bg-slate-100 dark:bg-slate-800 border border-slate-100 dark:border-slate-700';
                    div.innerHTML = '<img src="' + url + '" alt="" class="aspect-[4/3] w-full object-cover cursor-grab" />' +
                        '<button type="button" data-delete="' + id + '" class="absolute right-2 top-2 p-1.5 rounded-lg bg-black/60 text-white opacity-0 group-hover:opacity-100 transition hover:bg-red-600" title="Delete photo"><i data-lucide="trash-2" class="w-3.5 h-3.5"></i></button>' +
                        '<input type="text" data-caption="' + id + '" maxlength="300" placeholder="Add a caption…" class="w-full px-2.5 py-2 text-xs bg-white dark:bg-slate-900 border-0 border-t border-slate-100 dark:border-slate-700 focus:outline-none" />';
                    return div;
                }
                async function upload(files) {
                    files = [...files].filter(f => f.type.startsWith('image/'));
                    if (!files.length) return;
                    const status = document.getElementById('upload-status');
                    const bar = document.getElementById('upload-bar');
                    status.classList.remove('hidden');
                    let done = 0, failed = [];
                    for (const f of files) {
                        document.getElementById('upload-text').textContent = 'Uploading ' + (done + 1) + ' of ' + files.length + ' — ' + f.name;
                        const fd = new FormData(); fd.append('eventId', EVENT_ID); fd.append('photo', f);
                        try {
                            const res = await post('@Url.Action("UploadPhoto")', fd);
                            const j = await res.json().catch(() => ({}));
                            if (res.ok) grid.appendChild(tile(j.id, j.url)); else failed.push(f.name + (j.error ? ' (' + j.error + ')' : ''));
                        } catch { failed.push(f.name); }
                        done++;
                        const pct = Math.round(done / files.length * 100);
                        bar.style.width = pct + '%'; document.getElementById('upload-pct').textContent = pct + '%';
                    }
                    if (window.lucide) lucide.createIcons();
                    refreshCount();
                    document.getElementById('upload-text').textContent = failed.length ? 'Done — skipped: ' + failed.join(', ') : 'All ' + files.length + ' photo' + (files.length === 1 ? '' : 's') + ' added';
                    setTimeout(() => { if (!failed.length) { status.classList.add('hidden'); bar.style.width = '0'; } }, 2500);
                }
                const drop = document.getElementById('drop');
                document.getElementById('file-input').addEventListener('change', e => { upload(e.target.files); e.target.value = ''; });
                ['dragenter', 'dragover'].forEach(t => drop.addEventListener(t, e => { e.preventDefault(); drop.classList.add('border-[#7c3aed]', 'bg-[#7c3aed]/5'); }));
                ['dragleave', 'drop'].forEach(t => drop.addEventListener(t, e => { e.preventDefault(); drop.classList.remove('border-[#7c3aed]', 'bg-[#7c3aed]/5'); }));
                drop.addEventListener('drop', e => upload(e.dataTransfer.files));
            })();
        </script>
    }
