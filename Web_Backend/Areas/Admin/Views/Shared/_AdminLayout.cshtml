@{
    var currentUser = ViewBag.CurrentUser as Web_Backend.Areas.Admin.Models.SessionUser;
    var isAuthPage = ViewData["AuthPage"] as bool? ?? false;
    string activeController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Proton Admin</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.js"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; }
        .custom-scrollbar::-webkit-scrollbar { width: 6px; }
        .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
        .custom-scrollbar::-webkit-scrollbar-thumb { background-color: #cbd5e1; border-radius: 20px; }
        @@keyframes page-enter-kf { from { opacity: 0; transform: translateY(1rem); } to { opacity: 1; transform: translateY(0); } }
        .page-enter { animation: page-enter-kf 0.5s ease-out; }
    </style>
</head>
<body class="bg-gradient-to-br from-[#ebf4fa] to-[#e4e0fb] min-h-screen">

@if (isAuthPage)
{
    @RenderBody()
}
else
{
    <div class="min-h-screen p-4 md:p-6 flex flex-col md:flex-row gap-6 font-sans">

        <aside class="w-full md:w-[260px] flex-shrink-0 bg-white/90 backdrop-blur-xl rounded-[32px] p-4 flex flex-col shadow-[0_8px_30px_rgb(0,0,0,0.02)] border border-white/60 z-20">

            <div class="flex items-center gap-3 p-3 mb-6 rounded-2xl hover:bg-slate-50 cursor-pointer transition-colors border border-transparent hover:border-slate-100">
                <div class="relative">
                    <img src="https://i.pravatar.cc/150?u=@(currentUser?.Id ?? "admin")" alt="Profile" class="w-10 h-10 rounded-full object-cover border-2 border-white shadow-sm" />
                    <div class="absolute bottom-0 right-0 w-3 h-3 bg-green-500 border-2 border-white rounded-full"></div>
                </div>
                <div class="flex-1 min-w-0">
                    <h4 class="text-sm font-semibold text-slate-800 truncate">@(currentUser?.Name ?? "Admin User")</h4>
                    <p class="text-xs text-slate-500 truncate">Online</p>
                </div>
                <i data-lucide="chevron-down" class="w-4 h-4 text-slate-400"></i>
            </div>

            <nav class="flex-1 space-y-1">
                <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index"
                   class="w-full flex items-center gap-3 px-4 py-3 rounded-2xl transition-all duration-200 group @(activeController == "Dashboard" ? "bg-slate-50/80 text-slate-900 font-semibold" : "text-slate-500 hover:bg-slate-50/50 hover:text-slate-900")">
                    <i data-lucide="home" class="w-5 h-5 @(activeController == "Dashboard" ? "text-[#5a43f1]" : "text-slate-400 group-hover:text-slate-600")"></i>
                    <span>Dashboard</span>
                </a>

                <div class="py-2">
                    <p class="px-4 text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2 mt-4">User Management</p>
                    <a asp-area="Admin" asp-controller="User" asp-action="Add"
                       class="w-full flex items-center gap-3 px-4 py-3 rounded-2xl transition-all duration-200 group @(activeController == "User" ? "bg-slate-50/80 text-slate-900 font-semibold" : "text-slate-500 hover:bg-slate-50/50 hover:text-slate-900")">
                        <i data-lucide="users" class="w-5 h-5 @(activeController == "User" ? "text-[#5a43f1]" : "text-slate-400 group-hover:text-slate-600")"></i>
                        <span>Add User</span>
                    </a>
                    <a asp-area="Admin" asp-controller="Role" asp-action="Index"
                       class="w-full flex items-center gap-3 px-4 py-3 rounded-2xl transition-all duration-200 group @(activeController == "Role" ? "bg-slate-50/80 text-slate-900 font-semibold" : "text-slate-500 hover:bg-slate-50/50 hover:text-slate-900")">
                        <i data-lucide="shield" class="w-5 h-5 @(activeController == "Role" ? "text-[#5a43f1]" : "text-slate-400 group-hover:text-slate-600")"></i>
                        <span>Roles &amp; Permissions</span>
                    </a>
                </div>

                <div class="py-2">
                    <p class="px-4 text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2 mt-4">Communication</p>
                    <a asp-area="Admin" asp-controller="EmailSettings" asp-action="Index"
                       class="w-full flex items-center gap-3 px-4 py-3 rounded-2xl transition-all duration-200 group @(activeController == "EmailSettings" ? "bg-slate-50/80 text-slate-900 font-semibold" : "text-slate-500 hover:bg-slate-50/50 hover:text-slate-900")">
                        <i data-lucide="mail" class="w-5 h-5 @(activeController == "EmailSettings" ? "text-[#5a43f1]" : "text-slate-400 group-hover:text-slate-600")"></i>
                        <span>Email Settings</span>
                    </a>
                    <a asp-area="Admin" asp-controller="EmailTemplate" asp-action="Index"
                       class="w-full flex items-center gap-3 px-4 py-3 rounded-2xl transition-all duration-200 group @(activeController == "EmailTemplate" ? "bg-slate-50/80 text-slate-900 font-semibold" : "text-slate-500 hover:bg-slate-50/50 hover:text-slate-900")">
                        <i data-lucide="file-text" class="w-5 h-5 @(activeController == "EmailTemplate" ? "text-[#5a43f1]" : "text-slate-400 group-hover:text-slate-600")"></i>
                        <span>Email Templates</span>
                    </a>
                </div>

                <div class="py-2">
                    <p class="px-4 text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2 mt-4">Platform</p>
                    <div class="w-full flex items-center justify-between px-4 py-3 rounded-2xl text-slate-500">
                        <div class="flex items-center gap-3">
                            <i data-lucide="book-open" class="w-5 h-5 text-slate-400"></i>
                            <span>Courses</span>
                        </div>
                        <span class="bg-[#5a43f1] text-white text-[10px] font-bold px-2 py-0.5 rounded-full">12</span>
                    </div>
                    <div class="w-full flex items-center gap-3 px-4 py-3 rounded-2xl text-slate-500">
                        <i data-lucide="bar-chart-2" class="w-5 h-5 text-slate-400"></i>
                        <span>Reports</span>
                    </div>
                </div>
            </nav>

            <div class="mt-auto pt-4 border-t border-slate-100 space-y-1">
                <div class="w-full flex items-center gap-3 px-4 py-3 rounded-2xl text-slate-500">
                    <i data-lucide="settings" class="w-5 h-5 text-slate-400"></i>
                    <span>Settings</span>
                </div>
                <a asp-area="Admin" asp-controller="Account" asp-action="Logout"
                   class="w-full flex items-center gap-3 px-4 py-3 rounded-2xl text-slate-500 hover:bg-slate-50/50 hover:text-slate-900 transition-all duration-200 group">
                    <i data-lucide="log-out" class="w-5 h-5 text-slate-400 group-hover:text-slate-600"></i>
                    <span>Log out</span>
                </a>
            </div>
        </aside>

        <main class="flex-1 relative bg-white/95 backdrop-blur-3xl rounded-[32px] overflow-hidden shadow-[0_8px_30px_rgb(0,0,0,0.03)] border border-white/80 flex flex-col h-[calc(100vh-3rem)]">
            <div class="absolute inset-0 z-0 pointer-events-none opacity-[0.4]"
                 style="background-image: linear-gradient(to right, #e5e7eb 1px, transparent 1px), linear-gradient(to bottom, #e5e7eb 1px, transparent 1px); background-size: 40px 40px;"></div>

            <header class="relative z-10 px-8 py-5 border-b border-slate-100 flex items-center justify-between bg-white/50 backdrop-blur-sm">
                <div class="flex items-center gap-2">
                    <div class="bg-white p-2 rounded-xl shadow-sm border border-slate-100 hidden md:flex items-center w-64">
                        <i data-lucide="search" class="w-4 h-4 text-slate-400 ml-1"></i>
                        <input type="text" placeholder="Search anything..." class="bg-transparent border-none outline-none text-sm px-2 w-full text-slate-600 placeholder-slate-400" />
                    </div>
                </div>

                <div class="flex items-center gap-4">
                    <button class="relative p-2 text-slate-400 hover:text-slate-600 hover:bg-slate-100 rounded-xl transition-colors">
                        <i data-lucide="bell" class="w-5 h-5"></i>
                        <span class="absolute top-1.5 right-1.5 w-2 h-2 bg-red-500 rounded-full border border-white"></span>
                    </button>
                    <a asp-area="Admin" asp-controller="User" asp-action="Add"
                       class="px-4 py-1.5 rounded-xl font-medium bg-[#7c3aed] text-white hover:bg-[#6d28d9] shadow-sm text-sm flex items-center gap-2">
                        <i data-lucide="plus" class="w-4 h-4"></i> Add New
                    </a>
                </div>
            </header>

            <div class="relative z-10 flex-1 overflow-y-auto p-6 md:p-10 custom-scrollbar">
                @Html.AntiForgeryToken()
                @RenderBody()
            </div>
        </main>
    </div>
}

@RenderSection("Scripts", required: false)

<script>
    if (window.lucide) { lucide.createIcons(); }
</script>

</body>
</html>
