                        <i data-lucide="mail" class="w-5 h-5 @(activeController == "EmailSettings" ? "text-[#5a43f1] dark:text-[#a78bfa]" : "text-slate-400 dark:text-slate-500 group-hover:text-slate-600 dark:group-hover:text-slate-300")"></i>
                        <span>Email Settings</span>
                    </a>
                    <a asp-area="Admin" asp-controller="EmailTemplate" asp-action="Index"
                       class="w-full flex items-center gap-3 px-4 py-3 rounded-2xl transition-all duration-200 group @(activeController == "EmailTemplate" ? "bg-slate-50/80 dark:bg-slate-700/60 text-slate-900 dark:text-slate-100 font-semibold" : "text-slate-500 dark:text-slate-400 hover:bg-slate-50/50 dark:hover:bg-slate-700/40 hover:text-slate-900 dark:hover:text-slate-100")">
                        <i data-lucide="file-text" class="w-5 h-5 @(activeController == "EmailTemplate" ? "text-[#5a43f1] dark:text-[#a78bfa]" : "text-slate-400 dark:text-slate-500 group-hover:text-slate-600 dark:group-hover:text-slate-300")"></i>
                        <span>Email Templates</span>
                    </a>
                </div>

            </nav>

            <div class="mt-auto pt-4 border-t border-slate-100 dark:border-slate-700 space-y-1">
                <a asp-area="Admin" asp-controller="User" asp-action="Index"
                   class="w-full flex items-center gap-3 px-4 py-3 rounded-2xl transition-all duration-200 group @(activeController == "User" ? "bg-slate-50/80 dark:bg-slate-700/60 text-slate-900 dark:text-slate-100 font-semibold" : "text-slate-500 dark:text-slate-400 hover:bg-slate-50/50 dark:hover:bg-slate-700/40 hover:text-slate-900 dark:hover:text-slate-100")">
                    <i data-lucide="users" class="w-5 h-5 @(activeController == "User" ? "text-[#5a43f1] dark:text-[#a78bfa]" : "text-slate-400 dark:text-slate-500 group-hover:text-slate-600 dark:group-hover:text-slate-300")"></i>
                    <span>User Management</span>
                </a>
                <a asp-area="Admin" asp-controller="Account" asp-action="Logout"
                   class="w-full flex items-center gap-3 px-4 py-3 rounded-2xl text-slate-500 dark:text-slate-400 hover:bg-slate-50/50 dark:hover:bg-slate-700/40 hover:text-slate-900 dark:hover:text-slate-100 transition-all duration-200 group">
                    <i data-lucide="log-out" class="w-5 h-5 text-slate-400 dark:text-slate-500 group-hover:text-slate-600 dark:group-hover:text-slate-300"></i>
                    <span>Log out</span>
                </a>
            </div>
        </aside>

        <main class="flex-1 relative bg-white/95 dark:bg-slate-800/95 backdrop-blur-3xl rounded-[32px] overflow-hidden shadow-[0_8px_30px_rgb(0,0,0,0.03)] border border-white/80 dark:border-slate-700/80 flex flex-col h-[calc(100vh-3rem)]">
            <div class="absolute inset-0 z-0 pointer-events-none opacity-[0.4] dark:opacity-[0.08]"
                 style="background-image: linear-gradient(to right, #e5e7eb 1px, transparent 1px), linear-gradient(to bottom, #e5e7eb 1px, transparent 1px); background-size: 40px 40px;"></div>

            <header class="relative z-10 px-4 md:px-8 py-5 border-b border-slate-100 dark:border-slate-700 flex items-center justify-between bg-white/50 dark:bg-slate-800/50 backdrop-blur-sm">
                <div class="flex items-center gap-2">
                    <button type="button" id="sidebar-open" class="md:hidden p-2 text-slate-500 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-700 rounded-xl transition-colors">
                        <i data-lucide="menu" class="w-5 h-5"></i>
                    </button>
                    <div class="bg-white dark:bg-slate-900 p-2 rounded-xl shadow-sm border border-slate-100 dark:border-slate-700 hidden md:flex items-center w-64">
                        <i data-lucide="search" class="w-4 h-4 text-slate-400 dark:text-slate-500 ml-1"></i>
                        <input type="text" placeholder="Search anything..." class="bg-transparent border-none outline-none text-sm px-2 w-full text-slate-600 dark:text-slate-300 placeholder-slate-400 dark:placeholder-slate-500" />
                    </div>
                </div>

                <div class="flex items-center gap-4">
                    <button type="button" id="theme-toggle" class="p-2 text-slate-400 dark:text-slate-500 hover:text-slate-600 dark:hover:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700 rounded-xl transition-colors">
                        <i data-lucide="sun" id="theme-icon-light" class="w-5 h-5 hidden"></i>
                        <i data-lucide="moon" id="theme-icon-dark" class="w-5 h-5 hidden"></i>
                    </button>
                    <button class="relative p-2 text-slate-400 dark:text-slate-500 hover:text-slate-600 dark:hover:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700 rounded-xl transition-colors">
                        <i data-lucide="bell" class="w-5 h-5"></i>
                    </button>
                    <a asp-area="Admin" asp-controller="User" asp-action="Add"
                       class="px-4 py-1.5 rounded-xl font-medium bg-[#7c3aed] text-white hover:bg-[#6d28d9] shadow-sm text-sm flex items-center gap-2">
                        <i data-lucide="plus" class="w-4 h-4"></i> Add New
                    </a>
                </div>
            </header>

            <div class="relative z-10 flex-1 overflow-y-auto p-6 md:p-10 custom-scrollbar">
                @Html.AntiForgeryToken()
                @RenderBody()
            </div>
        </main>
    </div>
}

<script>
    // ---------- Shared map helpers (Leaflet + Carto basemaps) ----------
    // Carto's tiles are key-free and look close to Google Maps; the dark
    // variant is swapped in so the map matches the app theme. {r} pulls
    // @@2x tiles on retina displays so labels stay crisp.
    //
    // Defined ahead of @@RenderSection("Scripts") below: child views' Scripts
    // sections call protonApplyBasemap()/protonPinIcon() synchronously as soon
    // as they render, so these must already exist by then.
    window.protonApplyBasemap = function (map) {
        const light = 'https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png';
        const dark = 'https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png';
        const attribution = '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors &copy; <a href="https://carto.com/attributions">CARTO</a>';
        const isDark = () => document.documentElement.classList.contains('dark');

        let layer = L.tileLayer(isDark() ? dark : light, { attribution, maxZoom: 19, detectRetina: true }).addTo(map);

        // Re-tile when the theme toggle flips, so an open map follows along.
        new MutationObserver(() => {
            const url = isDark() ? dark : light;
            if (layer._url !== url) {
                map.removeLayer(layer);
                layer = L.tileLayer(url, { attribution, maxZoom: 19, detectRetina: true }).addTo(map);
            }
        }).observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });

        return layer;
    };

    // Brand-coloured teardrop pin, so markers don't look like stock Leaflet.
    window.protonPinIcon = function () {
        return L.divIcon({
            className: '',
            html: '<div style="width:28px;height:28px;border-radius:50% 50% 50% 0;background:#7c3aed;transform:rotate(-45deg);box-shadow:0 2px 8px rgba(0,0,0,.35);display:flex;align-items:center;justify-content:center;">' +
                  '<div style="width:9px;height:9px;border-radius:50%;background:#fff;"></div></div>',
            iconSize: [28, 28],
            iconAnchor: [14, 28],
            popupAnchor: [0, -30]
        });
    };

    // Circular photo pin: a logo/photo in a purple ring with a teardrop tail,
    // for maps where each marker represents one identifiable entity (e.g. a
    // university) rather than a generic location. Falls back to a coloured
    // initial-letter avatar when there's no image to show.
    window.protonPhotoPinIcon = function (imageUrl, label) {
        const initial = (label || '?').trim().charAt(0).toUpperCase() || '?';
        const avatar = imageUrl
            ? '<img src="' + imageUrl + '" alt="" style="width:100%;height:100%;object-fit:cover;display:block;" onerror="this.replaceWith(Object.assign(document.createElement(\'div\'),{style:\'width:100%;height:100%;display:flex;align-items:center;justify-content:center;background:#ede7fc;color:#7c3aed;font:600 16px sans-serif;\',textContent:\'' + initial + '\'}))" />'
            : '<div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;background:#ede7fc;color:#7c3aed;font:600 16px sans-serif;">' + initial + '</div>';

        return L.divIcon({
            className: '',
            html:
                '<div style="display:flex;flex-direction:column;align-items:center;filter:drop-shadow(0 3px 6px rgba(0,0,0,.35));">' +
                    '<div style="width:36px;height:36px;border-radius:50%;border:3px solid #7c3aed;background:#fff;overflow:hidden;">' + avatar + '</div>' +
                    '<div style="width:0;height:0;border-left:6px solid transparent;border-right:6px solid transparent;border-top:8px solid #7c3aed;margin-top:-2px;"></div>' +
                '</div>',
            iconSize: [42, 50],
            iconAnchor: [21, 50],
            popupAnchor: [0, -50]
        });
    };
</script>

@RenderSection("Scripts", required: false)

<script>
    // ---------- Mobile sidebar drawer ----------
    (function () {
        const sidebar = document.getElementById('sidebar');
        const backdrop = document.getElementById('sidebar-backdrop');
        if (!sidebar || !backdrop) return;

        function openSidebar() {
            sidebar.style.transform = 'translateX(0)';
            backdrop.classList.remove('hidden');
        }
        function closeSidebar() {
            sidebar.style.transform = '';
            backdrop.classList.add('hidden');
        }
        document.getElementById('sidebar-open')?.addEventListener('click', openSidebar);
        document.getElementById('sidebar-close')?.addEventListener('click', closeSidebar);
        backdrop.addEventListener('click', closeSidebar);
        document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeSidebar(); });
        // A wider viewport (rotation, resize) always shows the sidebar statically —
        // clear any leftover inline transform/backdrop from the mobile drawer state.
        window.addEventListener('resize', () => { if (window.innerWidth >= 768) closeSidebar(); });
    })();

    // ---------- Theme toggle ----------
    (function () {
        const root = document.documentElement;
        const lightIcon = document.getElementById('theme-icon-light');
        const darkIcon = document.getElementById('theme-icon-dark');
        function syncIcon() {
            const isDark = root.classList.contains('dark');
            if (lightIcon) lightIcon.classList.toggle('hidden', !isDark);
            if (darkIcon) darkIcon.classList.toggle('hidden', isDark);
        }
        syncIcon();
        document.getElementById('theme-toggle')?.addEventListener('click', () => {
            root.classList.toggle('dark');
            localStorage.setItem('theme', root.classList.contains('dark') ? 'dark' : 'light');
            syncIcon();
        });
    })();

    // ---------- Toasts ----------
    function showToast(message, type) {
        const container = document.getElementById('toast-container');
        if (!container || !message) return;
        const isError = type === 'error';
        const toast = document.createElement('div');
        toast.className = 'toast-in pointer-events-auto max-w-sm w-full rounded-xl shadow-lg border px-4 py-3 flex items-start gap-3 ' +
            (isError
                ? 'bg-red-50 dark:bg-red-950 border-red-100 dark:border-red-900 text-red-700 dark:text-red-300'
                : 'bg-emerald-50 dark:bg-emerald-950 border-emerald-100 dark:border-emerald-900 text-emerald-700 dark:text-emerald-300');
        toast.innerHTML =
            '<i data-lucide="' + (isError ? 'circle-x' : 'circle-check') + '" class="w-5 h-5 flex-shrink-0 mt-0.5"></i>' +
            '<span class="text-sm flex-1">' + message + '</span>' +
            '<button type="button" class="flex-shrink-0 opacity-60 hover:opacity-100" onclick="this.closest(\'div.toast-in\').remove()">' +
            '<i data-lucide="x" class="w-4 h-4"></i></button>';
        container.appendChild(toast);
        if (window.lucide) lucide.createIcons();
        setTimeout(() => toast.remove(), 6000);
    }

    @if (!string.IsNullOrEmpty(successMsg))
    {
        @Html.Raw($"showToast({System.Text.Json.JsonSerializer.Serialize(successMsg)}, 'success');")
    }
    @if (!string.IsNullOrEmpty(errorMsg))
    {
        @Html.Raw($"showToast({System.Text.Json.JsonSerializer.Serialize(errorMsg)}, 'error');")
    }

    // ---------- Confirm modal (replaces browser confirm()) ----------
    // Any <form> with data-confirm="message" has its submit intercepted;
    // the native submit only fires after the user accepts the modal.
    (function () {
        const modal = document.getElementById('confirm-modal');
        const titleEl = document.getElementById('confirm-modal-title');
        const msgEl = document.getElementById('confirm-modal-message');
        const cancelBtn = document.getElementById('confirm-modal-cancel');
        const confirmBtn = document.getElementById('confirm-modal-confirm');
        let pendingForm = null;

        function closeModal() {
            modal.classList.add('hidden');
            pendingForm = null;
        }

        document.addEventListener('submit', (e) => {
            const form = e.target;
            if (form.dataset && form.dataset.confirm) {
                e.preventDefault();
                pendingForm = form;
                titleEl.textContent = form.dataset.confirmTitle || 'Are you sure?';
                msgEl.textContent = form.dataset.confirm;
                confirmBtn.textContent = form.dataset.confirmLabel || 'Confirm';
                modal.classList.remove('hidden');
            }
        });

        cancelBtn.addEventListener('click', closeModal);
        modal.addEventListener('click', (e) => { if (e.target === modal) closeModal(); });
        confirmBtn.addEventListener('click', () => {
            const form = pendingForm;
            closeModal();
            if (form) form.submit();
        });
    })();

    if (window.lucide) { lucide.createIcons(); }
</script>

</body>
</html>
