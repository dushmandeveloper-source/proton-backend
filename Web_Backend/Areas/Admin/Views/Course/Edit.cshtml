@model CourseDetailViewModel
@{
    ViewData["Title"] = Model.IsNew ? "Add Course" : "Edit Course";
    var c = Model.Course;
    var locations = ViewBag.Locations as List<CourseLocation> ?? new List<CourseLocation>();
    var instructors = ViewBag.Instructors as List<AppUser> ?? new List<AppUser>();
    var holidayList = ViewBag.Holidays as List<HolidayEvent> ?? new List<HolidayEvent>();
    bool canEdit = Web_Backend.Classes.Auth.HasPermission(Web_Backend.Classes.PermissionCode.Courses, Model.IsNew ? 'A' : 'E');
    bool canDelete = Web_Backend.Classes.Auth.HasPermission(Web_Backend.Classes.PermissionCode.Courses, 'D');

    string[] tabs = c.IsCSCA
        ? new[] { "details", "content", "pricing", "combo", "subjects", "schedules" }
        : new[] { "details", "content", "pricing", "combo", "schedules" };
    var tabLabels = new Dictionary<string, string> {
        ["details"] = "Details", ["content"] = "Content",
        ["pricing"] = "Pricing & Fees", ["combo"] = "Combo Offers", ["subjects"] = "Exam Subjects", ["schedules"] = "Schedules"
    };

    // edu.Course_AddEdit's OPENJSON ... WITH clauses read camelCase paths
    // ($.feeType, $.amountsByCurrency, ...) — every hidden "carry-through"
    // field below (a tab re-posting another tab's child list unchanged)
    // MUST serialize with this same policy, or the sproc's WHERE ISNULL(j.X,'')<>''
    // guard silently sees every row as blank and wipes that whole child
    // list on save. Plain JsonSerializer.Serialize(x) keeps C#'s PascalCase
    // property names instead, which is the bug this closure exists to avoid.
    var camelCaseJsonOptions = new System.Text.Json.JsonSerializerOptions
    {
        PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase
    };
    Func<object?, string> ToJson = (obj) => System.Text.Json.JsonSerializer.Serialize(obj, camelCaseJsonOptions);
}

<div class="max-w-5xl mx-auto page-enter">
    <div class="flex items-center gap-3 mb-6">
        <a asp-action="Index" class="p-2 rounded-xl text-slate-400 dark:text-slate-500 hover:text-slate-700 dark:hover:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-700">
            <i data-lucide="arrow-left" class="w-5 h-5"></i>
        </a>
        <div>
            <h2 class="text-3xl font-bold text-slate-800 dark:text-slate-100 tracking-tight">@ViewData["Title"]</h2>
            @if (!Model.IsNew)
            {
                <p class="text-slate-500 dark:text-slate-400 mt-1 text-sm">@c.CourseTitle &middot; @c.CourseType</p>
            }
        </div>
    </div>

    <div class="flex gap-2 mb-6 border-b border-slate-100 dark:border-slate-700 overflow-x-auto">
        @foreach (var t in tabs)
        {
            @if (Model.IsNew && t != "details")
            {
                <span title="Save the course details first — this tab unlocks afterward."
                      class="px-4 py-2 text-sm font-medium border-b-2 -mb-px whitespace-nowrap border-transparent text-slate-300 dark:text-slate-600 cursor-not-allowed">
                    @tabLabels[t]
                </span>
            }
            else
            {
                <a asp-action="Edit" asp-route-id="@c.CourseID" asp-route-tab="@t"
                   class="px-4 py-2 text-sm font-medium border-b-2 -mb-px whitespace-nowrap @((Model.IsNew ? "details" : Model.ActiveTab) == t ? "border-[#7c3aed] text-[#7c3aed]" : "border-transparent text-slate-500 dark:text-slate-400 hover:text-slate-700 dark:hover:text-slate-200")">
                    @tabLabels[t]
                </a>
            }
        }
    </div>

    <script src="~/js/country-picker.js"></script>

    @if (Model.IsNew || Model.ActiveTab == "details")
    {
        <form method="post" asp-action="Save" enctype="multipart/form-data" id="details-form" class="bg-white dark:bg-slate-900/60 rounded-[24px] shadow-sm border border-slate-100 dark:border-slate-700 p-6 space-y-5">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Course.CourseID" />
            <input type="hidden" asp-for="Course.CourseImageURL" />
            <input type="hidden" asp-for="Course.HandbookFileURL" />
            @Html.Hidden("tab", "details")
            @* Content/pricing/combo JSON is preserved across the Details-tab save via hidden fields so a Details-only submit doesn't wipe other tabs' data. *@
            <input type="hidden" name="DescriptionJSON" value="@ToJson(c.Descriptions)" />
            <input type="hidden" name="PathwayJSON" value="@ToJson(c.Pathways)" />
            <input type="hidden" name="TrainingPointJSON" value="@ToJson(c.TrainingPoints)" />
            <input type="hidden" name="OutcomeJSON" value="@ToJson(c.Outcomes)" />
            <input type="hidden" name="RequirementJSON" value="@ToJson(c.Requirements)" />
            <input type="hidden" name="PricingJSON" value="@ToJson(c.PricingDetails)" />
            <input type="hidden" name="FeeChargeJSON" value="@ToJson(c.FeeCharges)" />
            <input type="hidden" name="ComboOfferJSON" value="@ToJson(c.ComboOffers)" />
            <input type="hidden" name="FeeOptionJSON" value="@ToJson(c.FeeOptions)" />

            <div>
                <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Course Type <span class="text-red-500">*</span></label>
                <select asp-for="Course.CourseType" class="w-full px-3 py-2 rounded-xl border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-800 text-sm">
                    <option value="General">General</option>
                    <option value="CSCA">CSCA</option>
                </select>
                @if (!Model.IsNew)
                {
                    <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">Switching away from CSCA removes this course's Exam Subjects.</p>
                }
            </div>

            <div>
                <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Course Title <span class="text-red-500">*</span></label>
                <input asp-for="Course.CourseTitle" required class="w-full px-3 py-2 rounded-xl border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-800 text-sm" />
                <span asp-validation-for="Course.CourseTitle" class="text-xs text-red-600"></span>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Course Code</label>
                    <input asp-for="Course.CourseCode" class="w-full px-3 py-2 rounded-xl border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-800 text-sm" />
                </div>
                <div>
                    <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">
                        Category
                        <a asp-controller="Course" asp-action="Index" asp-route-tab="category" target="_blank" class="text-[#7c3aed] font-normal hover:underline ml-1">manage categories</a>
                    </label>
                    <select asp-for="Course.CategoryID" class="w-full px-3 py-2 rounded-xl border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-800 text-sm">
                        <option value="">-- None --</option>
                        @foreach (var cat in Model.Categories)
                        {
                            <option value="@cat.CategoryID" selected="@(cat.CategoryID == c.CategoryID)">@cat.CategoryName</option>
                        }
                    </select>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">
                        Location
                        <a asp-controller="Course" asp-action="Index" asp-route-tab="category" target="_blank" class="text-[#7c3aed] font-normal hover:underline ml-1">manage locations</a>
                    </label>
                    <select asp-for="Course.LocationID" class="w-full px-3 py-2 rounded-xl border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-800 text-sm">
                        <option value="">-- None --</option>
                        @foreach (var loc in locations)
                        {
                            <option value="@loc.LocationID" selected="@(loc.LocationID == c.LocationID)">@loc.LocationName</option>
                        }
                    </select>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Duration</label>
                    <input asp-for="Course.Duration" placeholder="e.g. 12 weeks" class="w-full px-3 py-2 rounded-xl border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-800 text-sm" />
                </div>
                <div>
                    <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Certificate Validity</label>
                    <input asp-for="Course.CertificateValidity" placeholder="e.g. 2 years" class="w-full px-3 py-2 rounded-xl border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-800 text-sm" />
                </div>
            </div>

            <div>
                <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Delivery Method</label>
                <input asp-for="Course.DeliveryMethod" placeholder="e.g. Online, In-person" class="w-full px-3 py-2 rounded-xl border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-800 text-sm" />
            </div>

            @* Currency/Base Fee/Discount/Fee Charges are edited on the
               Pricing & Fees tab now — carried through unchanged here so a
               Details-only save doesn't blank them back to defaults. *@
            <input type="hidden" asp-for="Course.CurrencyCode" />
            <input type="hidden" asp-for="Course.Fee" />
            <input type="hidden" asp-for="Course.DiscountType" />
            <input type="hidden" asp-for="Course.DiscountValueType" />
            <input type="hidden" asp-for="Course.DiscountValue" />
            <input type="hidden" asp-for="Course.DiscountFirstN" />
            <input type="hidden" name="Course.DiscountStartDate" value="@(c.DiscountStartDate?.ToString("yyyy-MM-dd"))" />
            <input type="hidden" name="Course.DiscountEndDate" value="@(c.DiscountEndDate?.ToString("yyyy-MM-dd"))" />

            <div>
                <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Short Description</label>
                <textarea asp-for="Course.ShortDescription" rows="2" class="w-full px-3 py-2 rounded-xl border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-800 text-sm"></textarea>
            </div>

            <div>
                <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">About (HTML)</label>
                <textarea asp-for="Course.AboutHtml" rows="4" class="w-full px-3 py-2 rounded-xl border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-800 text-sm font-mono"></textarea>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Course Image</label>
                    @if (!string.IsNullOrEmpty(c.CourseImageURL))
                    {
                        <img src="@c.CourseImageURL" class="w-32 h-20 object-cover rounded-lg mb-2 border border-slate-100 dark:border-slate-700" />
                    }
                    <input type="file" name="imageFile" accept="image/*,.svg,.jfif" class="text-sm" />
                </div>
                <div>
                    <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Handbook</label>
                    <input asp-for="Course.HandbookTitle" placeholder="Handbook title" class="w-full px-3 py-2 rounded-xl border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-800 text-sm mb-2" />
                    @if (!string.IsNullOrEmpty(c.HandbookFileURL))
                    {
                        <a href="@c.HandbookFileURL" target="_blank" class="text-xs text-[#7c3aed] hover:underline block mb-2">Current file</a>
                    }
                    <input type="file" name="handbookFile" accept=".pdf,.doc,.docx" class="text-sm" />
                </div>
            </div>

            <div>
                <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Course Video</label>
                <div class="flex flex-col md:flex-row gap-3 md:items-center">
                    <input type="file" id="video-file-input" name="videoFile" accept="video/*" class="text-sm" />
                    <span class="text-xs text-slate-400 dark:text-slate-500">or</span>
                    <input type="text" id="video-url-input" name="videoUrlInput" value="@c.VideoURL" placeholder="Paste a video link (YouTube, Vimeo, MP4 URL...)"
                           class="flex-1 px-3 py-2 rounded-xl border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-800 text-sm" />
                    @if (!string.IsNullOrEmpty(c.VideoURL))
                    {
                        <button type="button" onclick="openCourseVideoPreview(document.getElementById('video-url-input').value)"
                                class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-purple-50 dark:bg-purple-950 text-[#7c3aed] dark:text-purple-300 text-sm font-medium hover:bg-purple-100 dark:hover:bg-purple-900 whitespace-nowrap">
                            <i data-lucide="play-circle" class="w-4 h-4"></i> Preview
                        </button>
                    }
                </div>
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">Choosing a file uploads it and replaces any pasted link. Selecting a file clears the link box below so only one source is used.</p>
            </div>

            <div class="flex flex-wrap items-center gap-6">
                <label class="flex items-center gap-2 text-sm text-slate-600 dark:text-slate-300">
                    <input asp-for="Course.EnableExperiencePricing" type="checkbox" class="rounded border-slate-300 dark:border-slate-600 text-[#7c3aed] focus:ring-[#7c3aed]" />
                    Enable Experience Pricing
                </label>
                <label class="flex items-center gap-2 text-sm text-slate-600 dark:text-slate-300">
                    <input asp-for="Course.EnableComboOffer" type="checkbox" class="rounded border-slate-300 dark:border-slate-600 text-[#7c3aed] focus:ring-[#7c3aed]" />
                    Enable Combo Offer
                </label>
            </div>

            @if (!Model.IsNew)
            {
                <div class="flex items-center gap-2">
                    <input type="checkbox" name="IsActive" value="A" checked="@(c.IsActive == "A")"
                           onchange="this.value = this.checked ? 'A' : 'I'"
                           class="rounded border-slate-300 dark:border-slate-600 text-[#7c3aed] focus:ring-[#7c3aed]" />
                    <label class="text-sm text-slate-600 dark:text-slate-300">Active</label>
                </div>
            }

            <div class="flex justify-end gap-2 pt-2">
                <a asp-action="Index" class="px-4 py-2 rounded-xl font-medium bg-slate-50 dark:bg-slate-800 text-slate-600 dark:text-slate-300 text-sm">Cancel</a>
                @if (canEdit)
                {
                    <button type="submit" class="px-4 py-2 rounded-xl font-medium bg-[#7c3aed] text-white hover:bg-[#6d28d9] text-sm">Save</button>
                }
            </div>
        </form>
    }
    else if (Model.ActiveTab == "content")
    {
        <form method="post" asp-action="Save" id="content-form" class="bg-white dark:bg-slate-900/60 rounded-[24px] shadow-sm border border-slate-100 dark:border-slate-700 p-6 space-y-8">
            @Html.AntiForgeryToken()
            <input type="hidden" name="Course.CourseID" value="@c.CourseID" />
            <input type="hidden" name="tab" value="content" />
            @* Fields this tab's form never shows are carried through unchanged
               so saving here doesn't blank them back to defaults. Must be
               "Course.X"-prefixed to match Save's [Bind(Prefix="Course")] —
               ASP.NET Core's complex-object binder does NOT fall back to
               unprefixed keys when the prefix has zero matches; it leaves
               every property at its default instead (this is what caused
               form.CourseID to bind empty and every save silently behave
               like "create new" for any tab other than Details). *@
            <input type="hidden" name="Course.CourseType" value="@c.CourseType" />
            <input type="hidden" name="Course.CourseTitle" value="@c.CourseTitle" />
            <input type="hidden" name="Course.CourseCode" value="@c.CourseCode" />
            <input type="hidden" name="Course.CategoryID" value="@c.CategoryID" />
            <input type="hidden" name="Course.LocationID" value="@c.LocationID" />
            <input type="hidden" name="Course.Duration" value="@c.Duration" />
            <input type="hidden" name="Course.CertificateValidity" value="@c.CertificateValidity" />
            <input type="hidden" name="Course.DeliveryMethod" value="@c.DeliveryMethod" />
            <input type="hidden" name="Course.ShortDescription" value="@c.ShortDescription" />
            <input type="hidden" name="Course.AboutHtml" value="@c.AboutHtml" />
            <input type="hidden" name="Course.CurrencyCode" value="@c.CurrencyCode" />
            <input type="hidden" name="Course.Fee" value="@c.Fee" />
            <input type="hidden" name="Course.DiscountType" value="@c.DiscountType" />
            <input type="hidden" name="Course.DiscountValueType" value="@c.DiscountValueType" />
            <input type="hidden" name="Course.DiscountValue" value="@c.DiscountValue" />
            <input type="hidden" name="Course.DiscountFirstN" value="@c.DiscountFirstN" />
            <input type="hidden" name="Course.DiscountStartDate" value="@(c.DiscountStartDate?.ToString("yyyy-MM-dd"))" />
            <input type="hidden" name="Course.DiscountEndDate" value="@(c.DiscountEndDate?.ToString("yyyy-MM-dd"))" />
            <input type="hidden" name="Course.SortOrder" value="@c.SortOrder" />
            <input type="hidden" name="Course.IsActive" value="@c.IsActive" />
            <input type="hidden" name="Course.HandbookTitle" value="@c.HandbookTitle" />
            <input type="hidden" name="Course.CourseImageURL" value="@c.CourseImageURL" />
            <input type="hidden" name="Course.HandbookFileURL" value="@c.HandbookFileURL" />
            <input type="hidden" name="Course.VideoURL" value="@c.VideoURL" />
            <input type="hidden" name="Course.EnableExperiencePricing" value="@(c.EnableExperiencePricing ? "true" : "false")" />
            <input type="hidden" name="Course.EnableComboOffer" value="@(c.EnableComboOffer ? "true" : "false")" />
            <input type="hidden" name="FeeOptionJSON" value="@ToJson(c.FeeOptions)" />
            <input type="hidden" name="FeeChargeJSON" value="@ToJson(c.FeeCharges)" />

            @await Html.PartialAsync("_RepeatableList", new RepeatableListModel {
                Title = "Descriptions", FieldName = "DescriptionJSON", TextField = "descriptionText",
                Items = c.Descriptions.Select((d, i) => new RepeatableRow(d.DescriptionText, i)).ToList()
            })
            @await Html.PartialAsync("_RepeatableList", new RepeatableListModel {
                Title = "Training Points", FieldName = "TrainingPointJSON", TextField = "pointDescription",
                Items = c.TrainingPoints.Select((d, i) => new RepeatableRow(d.PointDescription, i)).ToList()
            })
            @await Html.PartialAsync("_RepeatableList", new RepeatableListModel {
                Title = "Outcomes", FieldName = "OutcomeJSON", TextField = "outcomeDescription",
                Items = c.Outcomes.Select((d, i) => new RepeatableRow(d.OutcomeDescription, i)).ToList()
            })
            @await Html.PartialAsync("_RepeatableList", new RepeatableListModel {
                Title = "Requirements", FieldName = "RequirementJSON", TextField = "requirementText",
                Items = c.Requirements.Select((d, i) => new RepeatableRow(d.RequirementText, i)).ToList()
            })

            <div>
                <h3 class="font-semibold text-slate-800 dark:text-slate-100 mb-3">Pathways</h3>
                <div id="pathway-rows" class="space-y-2">
                    @foreach (var p in c.Pathways)
                    {
                        <div class="pathway-row grid grid-cols-1 md:grid-cols-2 gap-2">
                            <input type="text" class="pw-desc px-3 py-2 rounded-xl border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-800 text-sm" value="@p.PathwayDescription" placeholder="Pathway description" />
                            <div class="flex gap-2">
                                <input type="text" class="pw-cert flex-1 px-3 py-2 rounded-xl border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-800 text-sm" value="@p.CertificationText" placeholder="Certification" />
                                <button type="button" onclick="this.closest('.pathway-row').remove()" class="p-2 text-slate-400 hover:text-red-600 dark:hover:text-red-400"><i data-lucide="x" class="w-4 h-4"></i></button>
                            </div>
                        </div>
                    }
                </div>
                <button type="button" onclick="addPathwayRow()" class="mt-2 text-sm text-[#7c3aed] hover:underline">+ Add pathway</button>
                <input type="hidden" name="PathwayJSON" id="PathwayJSON" />
            </div>

            <input type="hidden" name="PricingJSON" value="@ToJson(c.PricingDetails)" />
            <input type="hidden" name="FeeChargeJSON" value="@ToJson(c.FeeCharges)" />
            <input type="hidden" name="ComboOfferJSON" value="@ToJson(c.ComboOffers)" />

            @if (canEdit)
            {
                <div class="flex justify-end">
                    <button type="submit" onclick="return prepareContentForm()" class="px-4 py-2 rounded-xl font-medium bg-[#7c3aed] text-white hover:bg-[#6d28d9] text-sm">Save Content</button>
                </div>
            }
        </form>

        <script>
            function addPathwayRow() {
                const div = document.createElement('div');
                div.className = 'pathway-row grid grid-cols-1 md:grid-cols-2 gap-2';
                div.innerHTML = `<input type="text" class="pw-desc px-3 py-2 rounded-xl border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-800 text-sm" placeholder="Pathway description" />
                    <div class="flex gap-2">
                        <input type="text" class="pw-cert flex-1 px-3 py-2 rounded-xl border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-800 text-sm" placeholder="Certification" />
                        <button type="button" onclick="this.closest('.pathway-row').remove()" class="p-2 text-slate-400 hover:text-red-600 dark:hover:text-red-400"><i data-lucide="x" class="w-4 h-4"></i></button>
                    </div>`;
                document.getElementById('pathway-rows').appendChild(div);
                if (window.lucide) lucide.createIcons();
            }
            function prepareContentForm() {
                const pathways = [...document.querySelectorAll('.pathway-row')].map(r => ({
                    pathwayDescription: r.querySelector('.pw-desc').value,
                    certificationText: r.querySelector('.pw-cert').value
                })).filter(p => p.pathwayDescription);
                document.getElementById('PathwayJSON').value = JSON.stringify(pathways);
                serializeRepeatableFields(document.getElementById('content-form'));
                return true;
            }
        </script>
    }
    else if (Model.ActiveTab == "pricing")
    {
        <form method="post" asp-action="Save" class="bg-white dark:bg-slate-900/60 rounded-[24px] shadow-sm border border-slate-100 dark:border-slate-700 p-6 space-y-8">
            @Html.AntiForgeryToken()
            <input type="hidden" name="Course.CourseID" value="@c.CourseID" />
            <input type="hidden" name="tab" value="pricing" />
            <input type="hidden" name="DescriptionJSON" value="@ToJson(c.Descriptions)" />
            <input type="hidden" name="PathwayJSON" value="@ToJson(c.Pathways)" />
            <input type="hidden" name="TrainingPointJSON" value="@ToJson(c.TrainingPoints)" />
            <input type="hidden" name="OutcomeJSON" value="@ToJson(c.Outcomes)" />
            <input type="hidden" name="RequirementJSON" value="@ToJson(c.Requirements)" />
            <input type="hidden" name="ComboOfferJSON" value="@ToJson(c.ComboOffers)" />
            @* Fields this tab's form never shows are carried through unchanged
               so saving Pricing doesn't blank them back to defaults — see the
               matching comment on the Content tab's form above about why
               these must be "Course.X"-prefixed. *@
            <input type="hidden" name="Course.CourseType" value="@c.CourseType" />
            <input type="hidden" name="Course.CourseTitle" value="@c.CourseTitle" />
            <input type="hidden" name="Course.CourseCode" value="@c.CourseCode" />
            <input type="hidden" name="Course.CategoryID" value="@c.CategoryID" />
            <input type="hidden" name="Course.LocationID" value="@c.LocationID" />
            <input type="hidden" name="Course.Duration" value="@c.Duration" />
            <input type="hidden" name="Course.CertificateValidity" value="@c.CertificateValidity" />
            <input type="hidden" name="Course.DeliveryMethod" value="@c.DeliveryMethod" />
            <input type="hidden" name="Course.ShortDescription" value="@c.ShortDescription" />
            <input type="hidden" name="Course.AboutHtml" value="@c.AboutHtml" />
            <input type="hidden" name="Course.SortOrder" value="@c.SortOrder" />
            <input type="hidden" name="Course.IsActive" value="@c.IsActive" />
            <input type="hidden" name="Course.HandbookTitle" value="@c.HandbookTitle" />
            <input type="hidden" name="Course.CourseImageURL" value="@c.CourseImageURL" />
            <input type="hidden" name="Course.HandbookFileURL" value="@c.HandbookFileURL" />
            <input type="hidden" name="Course.VideoURL" value="@c.VideoURL" />
            <input type="hidden" name="Course.EnableExperiencePricing" value="@(c.EnableExperiencePricing ? "true" : "false")" />
            <input type="hidden" name="Course.EnableComboOffer" value="@(c.EnableComboOffer ? "true" : "false")" />

            @* Pricing Tiers are hidden from this tab (still carried through
               unchanged via this hidden field, same as any other tab that
               doesn't show a given field). *@
            <input type="hidden" name="PricingJSON" value="@ToJson(c.PricingDetails)" />

            <div>
                <h3 class="font-semibold text-slate-800 dark:text-slate-100 mb-3">Base Price</h3>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Currency</label>
                        <input type="text" name="Course.CurrencyCode" id="base-currency-input" value="@c.CurrencyCode" autocomplete="off" data-currency-picker onchange="syncFeeChargeCurrencies()" class="w-full px-3 py-2 rounded-xl border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-800 text-sm" />
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Base Fee</label>
                        <input type="number" name="Course.Fee" value="@c.Fee" step="0.01" class="w-full px-3 py-2 rounded-xl border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-800 text-sm" />
                    </div>
                </div>
            </div>

            <div>
                <h3 class="font-semibold text-slate-800 dark:text-slate-100 mb-1">Additional Currency Options</h3>
                <p class="text-xs text-slate-500 dark:text-slate-400 mb-3">Optional — let students pay this course in another currency besides the base @c.CurrencyCode fee above (e.g. also offer USD or LKR).</p>
                <div id="fee-option-rows" class="space-y-2">
                    @foreach (var fo in c.FeeOptions)
                    {
                        <div class="fee-option-row grid grid-cols-1 md:grid-cols-3 gap-2">
                            <input type="text" class="fo-currency px-3 py-2 rounded-xl border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-800 text-sm" value="@fo.CurrencyCode" placeholder="Currency" autocomplete="off" data-currency-picker onchange="syncFeeChargeCurrencies()" />
                            <div class="flex gap-2 md:col-span-2">
                                <input type="number" step="0.01" class="fo-amt flex-1 px-3 py-2 rounded-xl border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-800 text-sm" value="@fo.Fee" placeholder="Fee in that currency" />
                                <button type="button" onclick="this.closest('.fee-option-row').remove(); syncFeeChargeCurrencies()" class="p-2 text-slate-400 hover:text-red-600 dark:hover:text-red-400"><i data-lucide="x" class="w-4 h-4"></i></button>
                            </div>
                        </div>
                    }
                </div>
                <button type="button" onclick="addFeeOptionRow()" class="mt-2 text-sm text-[#7c3aed] hover:underline">+ Add currency option</button>
                <input type="hidden" name="FeeOptionJSON" id="FeeOptionJSON" />
            </div>

            <div>
                <h3 class="font-semibold text-slate-800 dark:text-slate-100 mb-1">Discount</h3>
                <p class="text-xs text-slate-500 dark:text-slate-400 mb-3">Optional — at most one discount can be active at a time. Choosing a type here clears the other type's fields on save.</p>

                <div class="flex flex-col gap-3">
                    <label class="flex items-center gap-3 rounded-xl border border-slate-200 dark:border-slate-600 px-4 py-3 cursor-pointer has-[:checked]:border-[#7c3aed] has-[:checked]:bg-purple-50/50 dark:has-[:checked]:bg-purple-950/30">
                        <input type="radio" name="Course.DiscountType" value="None" id="disc-none" @(c.DiscountType != "FirstN" && c.DiscountType != "DateRange" ? "checked" : "") class="accent-[#7c3aed]" onchange="toggleDiscountFields()" />
                        <span class="text-sm font-medium text-slate-800 dark:text-slate-100">No discount</span>
                    </label>
                    <label class="flex items-center gap-3 rounded-xl border border-slate-200 dark:border-slate-600 px-4 py-3 cursor-pointer has-[:checked]:border-[#7c3aed] has-[:checked]:bg-purple-50/50 dark:has-[:checked]:bg-purple-950/30">
                        <input type="radio" name="Course.DiscountType" value="FirstN" id="disc-firstn" @(c.DiscountType == "FirstN" ? "checked" : "") class="accent-[#7c3aed]" onchange="toggleDiscountFields()" />
                        <span class="text-sm font-medium text-slate-800 dark:text-slate-100">First N students to enroll</span>
                    </label>
                    <label class="flex items-center gap-3 rounded-xl border border-slate-200 dark:border-slate-600 px-4 py-3 cursor-pointer has-[:checked]:border-[#7c3aed] has-[:checked]:bg-purple-50/50 dark:has-[:checked]:bg-purple-950/30">
                        <input type="radio" name="Course.DiscountType" value="DateRange" id="disc-daterange" @(c.DiscountType == "DateRange" ? "checked" : "") class="accent-[#7c3aed]" onchange="toggleDiscountFields()" />
                        <span class="text-sm font-medium text-slate-800 dark:text-slate-100">Special date-range discount</span>
                    </label>
                </div>

                <div class="mt-4 grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Discount Value Type</label>
                        <select name="Course.DiscountValueType" class="w-full px-3 py-2 rounded-xl border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-800 text-sm">
                            <option value="Percent" selected="@(c.DiscountValueType != "Flat")">Percent (%)</option>
                            <option value="Flat" selected="@(c.DiscountValueType == "Flat")">Flat amount</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Discount Value</label>
                        <input type="number" step="0.01" name="Course.DiscountValue" value="@c.DiscountValue" class="w-full px-3 py-2 rounded-xl border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-800 text-sm" />
                    </div>
                    <div id="disc-firstn-field" class="@(c.DiscountType == "FirstN" ? "" : "hidden")">
                        <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">First N Students</label>
                        <input type="number" step="1" min="1" name="Course.DiscountFirstN" value="@c.DiscountFirstN" class="w-full px-3 py-2 rounded-xl border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-800 text-sm" />
                    </div>
                    <div id="disc-start-field" class="@(c.DiscountType == "DateRange" ? "" : "hidden")">
                        <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">From</label>
                        <input type="date" name="Course.DiscountStartDate" value="@(c.DiscountStartDate?.ToString("yyyy-MM-dd"))" class="w-full px-3 py-2 rounded-xl border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-800 text-sm" />
                    </div>
                    <div id="disc-end-field" class="@(c.DiscountType == "DateRange" ? "" : "hidden")">
                        <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Until</label>
                        <input type="date" name="Course.DiscountEndDate" value="@(c.DiscountEndDate?.ToString("yyyy-MM-dd"))" class="w-full px-3 py-2 rounded-xl border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-800 text-sm" />
                    </div>
                </div>
            </div>

            <div>
                <h3 class="font-semibold text-slate-800 dark:text-slate-100 mb-1">Additional Fees</h3>
                <p class="text-xs text-slate-500 dark:text-slate-400 mb-3">Optional — extra charges on top of the base fee (e.g. registration fee, materials fee). Added to the total owed at enrollment; never discounted. Enter an amount for each currency this course is offered in (base @c.CurrencyCode, plus any Additional Currency Options above) — a flat fee like this has no exchange rate to convert automatically.</p>
                <div id="fee-charge-rows" class="space-y-3">
                    @foreach (var f in c.FeeCharges)
                    {
                        <div class="fee-charge-row rounded-xl border border-slate-200 dark:border-slate-600 p-3 space-y-2">
                            <div class="grid grid-cols-1 md:grid-cols-3 gap-2">
                                <input type="text" class="fc-type px-3 py-2 rounded-xl border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-800 text-sm" value="@f.FeeType" placeholder="Fee type" />
                                <div class="flex gap-2 md:col-span-2">
                                    <input type="text" class="fc-desc flex-1 px-3 py-2 rounded-xl border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-800 text-sm" value="@f.Description" placeholder="Description" />
                                    <button type="button" onclick="this.closest('.fee-charge-row').remove()" class="p-2 text-slate-400 hover:text-red-600 dark:hover:text-red-400"><i data-lucide="x" class="w-4 h-4"></i></button>
                                </div>
                            </div>
                            <div class="fc-amounts grid grid-cols-2 md:grid-cols-4 gap-2">
                                @{
                                    var baseAmt = f.AmountsByCurrency.FirstOrDefault(a => a.CurrencyCode == c.CurrencyCode);
                                }
                                <div class="flex items-center gap-1.5">
                                    <span class="text-xs font-mono text-slate-400 w-10 shrink-0">@c.CurrencyCode</span>
                                    <input type="number" step="0.01" data-currency="@c.CurrencyCode" class="fc-amt w-full px-2 py-1.5 rounded-lg border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-800 text-sm" value="@baseAmt?.Amount" placeholder="Amount" />
                                </div>
                                @foreach (var fo in c.FeeOptions.Where(o => !string.IsNullOrEmpty(o.CurrencyCode)))
                                {
                                    var amt = f.AmountsByCurrency.FirstOrDefault(a => a.CurrencyCode == fo.CurrencyCode);
                                    <div class="flex items-center gap-1.5">
                                        <span class="text-xs font-mono text-slate-400 w-10 shrink-0">@fo.CurrencyCode</span>
                                        <input type="number" step="0.01" data-currency="@fo.CurrencyCode" class="fc-amt w-full px-2 py-1.5 rounded-lg border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-800 text-sm" value="@amt?.Amount" placeholder="Amount" />
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
                <button type="button" onclick="addFeeChargeRow()" class="mt-2 text-sm text-[#7c3aed] hover:underline">+ Add fee charge</button>
                <input type="hidden" name="FeeChargeJSON" id="FeeChargeJSON" />
            </div>

            @if (canEdit)
            {
                <div class="flex justify-end">
                    <button type="submit" onclick="return preparePricingForm()" class="px-4 py-2 rounded-xl font-medium bg-[#7c3aed] text-white hover:bg-[#6d28d9] text-sm">Save Pricing</button>
                </div>
            }
        </form>

        <script>
            function toggleDiscountFields() {
                var isFirstN = document.getElementById('disc-firstn').checked;
                var isDateRange = document.getElementById('disc-daterange').checked;
                document.getElementById('disc-firstn-field').classList.toggle('hidden', !isFirstN);
                document.getElementById('disc-start-field').classList.toggle('hidden', !isDateRange);
                document.getElementById('disc-end-field').classList.toggle('hidden', !isDateRange);
            }
            // Every currency the course is currently offered in: the base
            // currency plus whatever's typed into the Additional Currency
            // Options rows right now. Additional Fees rows always show one
            // amount input per entry in this list, kept in sync as currency
            // options are added/removed/edited (see syncFeeChargeCurrencies).
            function currentCourseCurrencies() {
                const base = document.getElementById('base-currency-input').value.trim().toUpperCase();
                const extra = [...document.querySelectorAll('.fo-currency')]
                    .map(i => i.value.trim().toUpperCase())
                    .filter(code => code && code !== base);
                return [base, ...extra];
            }
            function feeChargeAmountsHtml(currencies, amountsByCurrency) {
                amountsByCurrency = amountsByCurrency || {};
                return currencies.map(code => `
                    <div class="flex items-center gap-1.5">
                        <span class="text-xs font-mono text-slate-400 w-10 shrink-0">${code}</span>
                        <input type="number" step="0.01" data-currency="${code}" class="fc-amt w-full px-2 py-1.5 rounded-lg border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-800 text-sm" placeholder="Amount" value="${amountsByCurrency[code] ?? ''}" />
                    </div>`).join('');
            }
            function addFeeChargeRow() {
                const div = document.createElement('div');
                div.className = 'fee-charge-row rounded-xl border border-slate-200 dark:border-slate-600 p-3 space-y-2';
                div.innerHTML = `<div class="grid grid-cols-1 md:grid-cols-3 gap-2">
                        <input type="text" class="fc-type px-3 py-2 rounded-xl border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-800 text-sm" placeholder="Fee type" />
                        <div class="flex gap-2 md:col-span-2">
                            <input type="text" class="fc-desc flex-1 px-3 py-2 rounded-xl border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-800 text-sm" placeholder="Description" />
                            <button type="button" onclick="this.closest('.fee-charge-row').remove()" class="p-2 text-slate-400 hover:text-red-600 dark:hover:text-red-400"><i data-lucide="x" class="w-4 h-4"></i></button>
                        </div>
                    </div>
                    <div class="fc-amounts grid grid-cols-2 md:grid-cols-4 gap-2">${feeChargeAmountsHtml(currentCourseCurrencies())}</div>`;
                document.getElementById('fee-charge-rows').appendChild(div);
                if (window.lucide) lucide.createIcons();
            }
            function addFeeOptionRow() {
                const div = document.createElement('div');
                div.className = 'fee-option-row grid grid-cols-1 md:grid-cols-3 gap-2';
                div.innerHTML = `<input type="text" class="fo-currency px-3 py-2 rounded-xl border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-800 text-sm" placeholder="Currency" autocomplete="off" data-currency-picker onchange="syncFeeChargeCurrencies()" />
                    <div class="flex gap-2 md:col-span-2">
                        <input type="number" step="0.01" class="fo-amt flex-1 px-3 py-2 rounded-xl border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-800 text-sm" placeholder="Fee in that currency" />
                        <button type="button" onclick="this.closest('.fee-option-row').remove(); syncFeeChargeCurrencies()" class="p-2 text-slate-400 hover:text-red-600 dark:hover:text-red-400"><i data-lucide="x" class="w-4 h-4"></i></button>
                    </div>`;
                document.getElementById('fee-option-rows').appendChild(div);
                if (window.lucide) lucide.createIcons();
                // Newly-inserted row needs the picker wired up too — the
                // page-load init in country-picker.js only ran once already.
                if (window.ProtonCountryPicker) window.ProtonCountryPicker.init(div);
            }
            // Re-renders every existing Additional Fees row's amount inputs
            // to match the current currency list, preserving whatever the
            // Admin already typed for a currency that's still present.
            function syncFeeChargeCurrencies() {
                const currencies = currentCourseCurrencies();
                document.querySelectorAll('.fee-charge-row').forEach(row => {
                    const existing = {};
                    row.querySelectorAll('.fc-amt').forEach(i => {
                        if (i.dataset.currency && i.value) existing[i.dataset.currency] = i.value;
                    });
                    row.querySelector('.fc-amounts').innerHTML = feeChargeAmountsHtml(currencies, existing);
                });
            }
            function preparePricingForm() {
                // Pricing Tiers no longer render on this tab — its hidden
                // PricingJSON field above already carries the existing data
                // through unchanged, so there's nothing to serialize here
                // for it any more.
                const feeCharges = [...document.querySelectorAll('.fee-charge-row')].map(r => ({
                    feeType: r.querySelector('.fc-type').value,
                    description: r.querySelector('.fc-desc').value,
                    amountsByCurrency: [...r.querySelectorAll('.fc-amt')]
                        .map(i => ({ currencyCode: i.dataset.currency, amount: parseFloat(i.value) || null }))
                        .filter(a => a.amount !== null)
                })).filter(f => f.feeType);
                document.getElementById('FeeChargeJSON').value = JSON.stringify(feeCharges);

                const feeOptions = [...document.querySelectorAll('.fee-option-row')].map(r => ({
                    currencyCode: r.querySelector('.fo-currency').value.trim().toUpperCase(),
                    fee: parseFloat(r.querySelector('.fo-amt').value) || null
                })).filter(o => o.currencyCode && o.fee);
                document.getElementById('FeeOptionJSON').value = JSON.stringify(feeOptions);
                return true;
            }
        </script>
    }
    else if (Model.ActiveTab == "combo")
    {
        <form method="post" asp-action="Save" class="bg-white dark:bg-slate-900/60 rounded-[24px] shadow-sm border border-slate-100 dark:border-slate-700 p-6 space-y-4">
            @Html.AntiForgeryToken()
            <input type="hidden" name="Course.CourseID" value="@c.CourseID" />
            <input type="hidden" name="tab" value="combo" />
            <input type="hidden" name="DescriptionJSON" value="@ToJson(c.Descriptions)" />
            <input type="hidden" name="PathwayJSON" value="@ToJson(c.Pathways)" />
            <input type="hidden" name="TrainingPointJSON" value="@ToJson(c.TrainingPoints)" />
            <input type="hidden" name="OutcomeJSON" value="@ToJson(c.Outcomes)" />
            <input type="hidden" name="RequirementJSON" value="@ToJson(c.Requirements)" />
            <input type="hidden" name="PricingJSON" value="@ToJson(c.PricingDetails)" />
            <input type="hidden" name="FeeChargeJSON" value="@ToJson(c.FeeCharges)" />
            <input type="hidden" name="FeeOptionJSON" value="@ToJson(c.FeeOptions)" />
            @* Fields this tab's form never shows are carried through unchanged
               so saving Combo Offers doesn't blank them back to defaults — see
               the matching comment on the Content tab's form above about why
               these must be "Course.X"-prefixed. *@
            <input type="hidden" name="Course.CourseType" value="@c.CourseType" />
            <input type="hidden" name="Course.CourseTitle" value="@c.CourseTitle" />
            <input type="hidden" name="Course.CourseCode" value="@c.CourseCode" />
            <input type="hidden" name="Course.CategoryID" value="@c.CategoryID" />
            <input type="hidden" name="Course.LocationID" value="@c.LocationID" />
            <input type="hidden" name="Course.Duration" value="@c.Duration" />
            <input type="hidden" name="Course.CertificateValidity" value="@c.CertificateValidity" />
            <input type="hidden" name="Course.DeliveryMethod" value="@c.DeliveryMethod" />
            <input type="hidden" name="Course.ShortDescription" value="@c.ShortDescription" />
            <input type="hidden" name="Course.AboutHtml" value="@c.AboutHtml" />
            <input type="hidden" name="Course.CurrencyCode" value="@c.CurrencyCode" />
            <input type="hidden" name="Course.Fee" value="@c.Fee" />
            <input type="hidden" name="Course.DiscountType" value="@c.DiscountType" />
            <input type="hidden" name="Course.DiscountValueType" value="@c.DiscountValueType" />
            <input type="hidden" name="Course.DiscountValue" value="@c.DiscountValue" />
            <input type="hidden" name="Course.DiscountFirstN" value="@c.DiscountFirstN" />
            <input type="hidden" name="Course.DiscountStartDate" value="@(c.DiscountStartDate?.ToString("yyyy-MM-dd"))" />
            <input type="hidden" name="Course.DiscountEndDate" value="@(c.DiscountEndDate?.ToString("yyyy-MM-dd"))" />
            <input type="hidden" name="Course.SortOrder" value="@c.SortOrder" />
            <input type="hidden" name="Course.IsActive" value="@c.IsActive" />
            <input type="hidden" name="Course.HandbookTitle" value="@c.HandbookTitle" />
            <input type="hidden" name="Course.CourseImageURL" value="@c.CourseImageURL" />
            <input type="hidden" name="Course.HandbookFileURL" value="@c.HandbookFileURL" />
            <input type="hidden" name="Course.VideoURL" value="@c.VideoURL" />
            <input type="hidden" name="Course.EnableExperiencePricing" value="@(c.EnableExperiencePricing ? "true" : "false")" />

            <h3 class="font-semibold text-slate-800 dark:text-slate-100 mb-1">Combo Offers</h3>
            <div id="combo-rows" class="space-y-2">
                @foreach (var co in c.ComboOffers)
                {
                    <div class="combo-row grid grid-cols-1 md:grid-cols-2 gap-2">
                        <input type="text" class="co-desc px-3 py-2 rounded-xl border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-800 text-sm" value="@co.ComboDescription" placeholder="Combo description" />
                        <div class="flex gap-2">
                            <input type="text" class="co-dur flex-1 px-3 py-2 rounded-xl border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-800 text-sm" value="@co.ComboDuration" placeholder="Duration" />
                            <button type="button" onclick="this.closest('.combo-row').remove()" class="p-2 text-slate-400 hover:text-red-600 dark:hover:text-red-400"><i data-lucide="x" class="w-4 h-4"></i></button>
                        </div>
                    </div>
                }
            </div>
            <button type="button" onclick="addComboRow()" class="text-sm text-[#7c3aed] hover:underline">+ Add combo offer</button>
            <input type="hidden" name="ComboOfferJSON" id="ComboOfferJSON" />

            @if (canEdit)
            {
                <div class="flex justify-end pt-2">
                    <button type="submit" onclick="return prepareComboForm()" class="px-4 py-2 rounded-xl font-medium bg-[#7c3aed] text-white hover:bg-[#6d28d9] text-sm">Save Combo Offers</button>
                </div>
            }
        </form>

        <script>
            function addComboRow() {
                const div = document.createElement('div');
                div.className = 'combo-row grid grid-cols-1 md:grid-cols-2 gap-2';
                div.innerHTML = `<input type="text" class="co-desc px-3 py-2 rounded-xl border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-800 text-sm" placeholder="Combo description" />
                    <div class="flex gap-2">
                        <input type="text" class="co-dur flex-1 px-3 py-2 rounded-xl border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-800 text-sm" placeholder="Duration" />
                        <button type="button" onclick="this.closest('.combo-row').remove()" class="p-2 text-slate-400 hover:text-red-600 dark:hover:text-red-400"><i data-lucide="x" class="w-4 h-4"></i></button>
                    </div>`;
                document.getElementById('combo-rows').appendChild(div);
                if (window.lucide) lucide.createIcons();
            }
            function prepareComboForm() {
                const combos = [...document.querySelectorAll('.combo-row')].map(r => ({
                    comboDescription: r.querySelector('.co-desc').value,
                    comboDuration: r.querySelector('.co-dur').value
                })).filter(x => x.comboDescription);
                document.getElementById('ComboOfferJSON').value = JSON.stringify(combos);
                return true;
            }
        </script>
    }
    else if (Model.ActiveTab == "subjects")
    {
        <div class="bg-white dark:bg-slate-900/60 rounded-[24px] shadow-sm border border-slate-100 dark:border-slate-700 p-6">
            <h3 class="font-semibold text-slate-800 dark:text-slate-100 mb-4">Exam Subjects</h3>

            @if (canEdit)
            {
                <form method="post" asp-action="SaveSubject" class="grid grid-cols-1 md:grid-cols-6 gap-3 mb-6">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="CourseID" value="@c.CourseID" />
                    <input type="text" name="SubjectName" placeholder="Subject (e.g. Mathematics)" required
                           class="md:col-span-2 px-3 py-2 rounded-xl border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-800 text-sm" />
                    <select name="Language" class="px-3 py-2 rounded-xl border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-800 text-sm">
                        <option value="English">English</option>
                        <option value="Chinese">Chinese</option>
                    </select>
                    <input type="number" name="DurationMinutes" placeholder="Minutes"
                           class="px-3 py-2 rounded-xl border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-800 text-sm" />
                    <label class="flex items-center gap-2 text-sm text-slate-600 dark:text-slate-300 px-1">
                        <input type="checkbox" name="IsCompulsory" value="true" class="rounded border-slate-300 dark:border-slate-600 text-[#7c3aed] focus:ring-[#7c3aed]" />
                        Compulsory
                    </label>
                    <button type="submit" class="px-4 py-2 rounded-xl font-medium bg-[#7c3aed] text-white hover:bg-[#6d28d9] text-sm">Add</button>
                </form>
            }

            @if (!Model.Subjects.Any())
            {
                <p class="text-sm text-slate-400 dark:text-slate-500">No subjects added yet.</p>
            }
            else
            {
                <div class="overflow-x-auto">
                    <table class="w-full text-sm">
                        <thead>
                            <tr class="border-b border-slate-100 dark:border-slate-700 text-left text-slate-500 dark:text-slate-400">
                                <th class="py-2 font-medium">Subject</th>
                                <th class="py-2 font-medium">Language</th>
                                <th class="py-2 font-medium">Duration</th>
                                <th class="py-2 font-medium">Compulsory</th>
                                <th class="py-2 font-medium text-right">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var s in Model.Subjects)
                            {
                                <tr class="border-b border-slate-50 dark:border-slate-800 last:border-0">
                                    <td class="py-2 font-medium text-slate-800 dark:text-slate-100">@s.SubjectName</td>
                                    <td class="py-2 text-slate-500 dark:text-slate-400">@s.Language</td>
                                    <td class="py-2 text-slate-500 dark:text-slate-400">@(s.DurationMinutes.HasValue ? $"{s.DurationMinutes} min" : "-")</td>
                                    <td class="py-2 text-slate-500 dark:text-slate-400">@(s.IsCompulsory ? "Yes" : "Optional")</td>
                                    <td class="py-2 text-right">
                                        @if (canDelete)
                                        {
                                            <form method="post" asp-action="DeleteSubject" asp-route-courseId="@c.CourseID" asp-route-id="@s.SubjectID" class="inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" title="Remove" class="p-2 rounded-xl text-slate-400 dark:text-slate-500 hover:text-red-600 dark:hover:text-red-400 hover:bg-slate-100 dark:hover:bg-slate-700 transition-colors">
                                                    <i data-lucide="trash-2" class="w-4 h-4"></i>
                                                </button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }
    else if (Model.ActiveTab == "schedules")
    {
        <div class="bg-white dark:bg-slate-900/60 rounded-[24px] shadow-sm border border-slate-100 dark:border-slate-700 p-6">
            <h3 class="font-semibold text-slate-800 dark:text-slate-100 mb-4">Schedules</h3>

            @if (canEdit)
            {
                <form method="post" asp-action="SaveSchedule" id="add-schedule-form" class="bg-slate-50 dark:bg-slate-800/40 rounded-xl p-4 mb-6">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="CourseID" value="@c.CourseID" />
                    <input type="hidden" name="ScheduleID" id="schedule-id-field" value="" />
                    <input type="hidden" name="SegmentJSON" id="segment-json-field" />
                    <input type="hidden" name="InstructorUserIDsJSON" id="instructor-json-field" />
                    <div class="grid grid-cols-1 md:grid-cols-6 gap-3 mb-4">
                        <input type="text" name="ScheduleName" placeholder="Batch name" class="md:col-span-2 px-3 py-2 rounded-xl border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-800 text-sm" />
                        <input type="number" name="Capacity" placeholder="Capacity" class="px-3 py-2 rounded-xl border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-800 text-sm" />
                        <input type="text" name="Location" placeholder="Location" class="md:col-span-3 px-3 py-2 rounded-xl border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-800 text-sm" />
                        <div class="relative instructor-picker md:col-span-3" data-name="InstructorUserIDsJSON">
                            <input type="text" class="instructor-search px-3 py-2 rounded-xl border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-800 text-sm w-full" placeholder="Search instructors..." autocomplete="off" />
                            <div class="instructor-selected flex flex-wrap gap-1 mt-1"></div>
                            <div class="instructor-dropdown hidden absolute z-10 mt-1 w-full max-h-48 overflow-y-auto bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-600 rounded-xl shadow-lg">
                                @foreach (var instr in instructors)
                                {
                                    <label class="instructor-option flex items-center gap-2 px-3 py-2 text-sm cursor-pointer hover:bg-slate-50 dark:hover:bg-slate-700">
                                        <input type="checkbox" class="instructor-checkbox hidden" value="@instr.UserID" data-name="@instr.FullName" />
                                        <span>@instr.FullName</span>
                                    </label>
                                }
                            </div>
                        </div>
                        <input type="text" name="Notes" placeholder="Notes (optional)" class="md:col-span-3 px-3 py-2 rounded-xl border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-800 text-sm" />
                    </div>

                    <div class="mb-2 flex items-center justify-between">
                        <h4 class="text-sm font-semibold text-slate-700 dark:text-slate-200">Periods</h4>
                        <button type="button" id="add-period-btn" class="text-sm text-[#7c3aed] hover:underline">+ Add another period</button>
                    </div>
                    <div id="periods-container" class="space-y-3 mb-4"></div>

                    <div class="flex gap-2">
                        <button type="submit" id="add-schedule-submit" class="px-4 py-2 rounded-xl font-medium bg-[#7c3aed] text-white hover:bg-[#6d28d9] text-sm">Add Schedule</button>
                        <button type="button" id="cancel-edit-schedule-btn" class="hidden px-4 py-2 rounded-xl font-medium bg-slate-50 dark:bg-slate-800 text-slate-600 dark:text-slate-300 text-sm">Cancel edit / Add new</button>
                    </div>
                </form>

                <script>
                    // ---------- Searchable multi-select instructor picker ----------
                    // Posts a bare JSON array of selected UserID strings — the
                    // widget already has FullName client-side for rendering
                    // pills, so there's no need to round-trip it through the
                    // server.
                    function initInstructorPicker(picker) {
                        const search = picker.querySelector('.instructor-search');
                        const dropdown = picker.querySelector('.instructor-dropdown');
                        const selectedBox = picker.querySelector('.instructor-selected');
                        const checkboxes = Array.from(picker.querySelectorAll('.instructor-checkbox'));

                        function renderSelected() {
                            selectedBox.innerHTML = '';
                            checkboxes.filter(cb => cb.checked).forEach(cb => {
                                const pill = document.createElement('span');
                                pill.className = 'inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs bg-purple-100 dark:bg-purple-950 text-purple-700 dark:text-purple-300';
                                pill.innerHTML = `${cb.dataset.name} <button type="button" class="hover:text-red-600 dark:hover:text-red-400" aria-label="Remove">&times;</button>`;
                                pill.querySelector('button').addEventListener('click', () => {
                                    cb.checked = false;
                                    renderSelected();
                                });
                                selectedBox.appendChild(pill);
                            });
                        }

                        search.addEventListener('focus', () => dropdown.classList.remove('hidden'));
                        search.addEventListener('input', () => {
                            const term = search.value.trim().toLowerCase();
                            picker.querySelectorAll('.instructor-option').forEach(opt => {
                                const name = opt.textContent.trim().toLowerCase();
                                opt.classList.toggle('hidden', term.length > 0 && !name.includes(term));
                            });
                        });
                        document.addEventListener('click', (e) => {
                            if (!picker.contains(e.target)) dropdown.classList.add('hidden');
                        });
                        checkboxes.forEach(cb => {
                            cb.closest('.instructor-option').addEventListener('click', (e) => {
                                e.preventDefault();
                                cb.checked = !cb.checked;
                                renderSelected();
                            });
                        });

                        return {
                            getSelectedIds: () => checkboxes.filter(cb => cb.checked).map(cb => cb.value),
                            renderSelected: renderSelected
                        };
                    }
                    document.querySelectorAll('.instructor-picker').forEach(p => { p._picker = initInstructorPicker(p); });

                    // ---------- Holiday lookup ----------
                    // Same global holiday/event dates shown on the main Course
                    // Schedule calendar — informational here too: yellow marking
                    // on the period-picker grid, plus a confirmation dialog
                    // before saving a schedule whose range covers one.
                    const holidays = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(holidayList.Select(h => new { date = h.HolidayDate.ToString("yyyy-MM-dd"), title = h.Title })));
                    const holidaysByDate = {};
                    holidays.forEach(h => { (holidaysByDate[h.date] = holidaysByDate[h.date] || []).push(h); });

                    (function () {
                        const container = document.getElementById('periods-container');
                        const addBtn = document.getElementById('add-period-btn');
                        const form = document.getElementById('add-schedule-form');
                        const jsonField = document.getElementById('segment-json-field');
                        const instructorJsonField = document.getElementById('instructor-json-field');
                        if (!container || !addBtn || !form || !jsonField) return;

                        const DAYS = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'];
                        let periodCount = 0;

                        function pad(n) { return String(n).padStart(2, '0'); }
                        function toISO(y, m, d) { return `${y}-${pad(m + 1)}-${pad(d)}`; }
                        function dowCode(jsDay) { return ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'][jsDay]; }

                        // Native <input type="time"> shows 12h/24h per the browser's OS
                        // locale, not something a page can force — so a live "6:00 PM"
                        // label is shown alongside it, always in 12-hour format
                        // regardless of the visitor's locale.
                        function formatAmPm(hhmm) {
                            if (!hhmm) return '';
                            const [h, m] = hhmm.split(':').map(Number);
                            const period = h >= 12 ? 'PM' : 'AM';
                            const h12 = h % 12 === 0 ? 12 : h % 12;
                            return `${h12}:${pad(m)} ${period}`;
                        }

                        // Renders one click-to-pick-a-range month calendar per period row.
                        // Click a day to start a range, click another to complete it
                        // (either order); once at least one weekday checkbox is active,
                        // only the matching in-range days are highlighted as "selected" —
                        // otherwise the whole range shows shaded so the admin can see
                        // what they're about to pick days within.
                        function initPeriodCalendar(row, initialData = null) {
                            const calGrid = row.querySelector('.period-cal-grid');
                            const calTitle = row.querySelector('.period-cal-title');
                            const rangeLabel = row.querySelector('.period-range-label');
                            let viewDate = new Date();
                            viewDate.setDate(1);
                            let startISO = null;
                            let endISO = null;
                            const offDates = new Set();

                            if (initialData) {
                                startISO = initialData.startDate;
                                endISO = initialData.endDate;
                                (initialData.exceptionDates || '').split(',').filter(Boolean).forEach(d => offDates.add(d));
                                viewDate = new Date(initialData.startDate + 'T00:00:00');
                                viewDate.setDate(1);
                            }

                            function activeDays() {
                                return Array.from(row.querySelectorAll('.period-day:checked')).map(cb => cb.value);
                            }

                            function inRange(iso) {
                                if (!startISO) return false;
                                if (!endISO) return iso === startISO;
                                return iso >= startISO && iso <= endISO;
                            }

                            function isClassDay(iso, jsDay) {
                                const days = activeDays();
                                if (!inRange(iso)) return false;
                                if (offDates.has(iso)) return false;
                                if (days.length === 0) return true;
                                return days.includes(dowCode(jsDay));
                            }

                            function isOffDay(iso, jsDay) {
                                const days = activeDays();
                                if (!inRange(iso) || !offDates.has(iso)) return false;
                                return days.length === 0 || days.includes(dowCode(jsDay));
                            }

                            function updateLabel() {
                                const offCount = offDates.size;
                                const offText = offCount > 0 ? ` · ${offCount} day${offCount === 1 ? '' : 's'} off` : '';
                                if (startISO && endISO) {
                                    rangeLabel.textContent = `${startISO} to ${endISO}${offText}`;
                                } else if (startISO) {
                                    rangeLabel.textContent = `${startISO} — pick an end date`;
                                } else {
                                    rangeLabel.textContent = 'Click a start date, then an end date';
                                }
                            }

                            function render() {
                                const year = viewDate.getFullYear();
                                const month = viewDate.getMonth();
                                calTitle.textContent = viewDate.toLocaleDateString('en-US', { month: 'long', year: 'numeric' });

                                const firstDayOfWeek = new Date(year, month, 1).getDay();
                                const daysInMonth = new Date(year, month + 1, 0).getDate();
                                const daysInPrevMonth = new Date(year, month, 0).getDate();
                                const totalCells = Math.ceil((firstDayOfWeek + daysInMonth) / 7) * 7;

                                let cells = '';
                                for (let i = 0; i < totalCells; i++) {
                                    let cellYear = year, cellMonth = month, dayNum, isOtherMonth = false;
                                    if (i < firstDayOfWeek) {
                                        dayNum = daysInPrevMonth - firstDayOfWeek + i + 1;
                                        cellMonth = month - 1; isOtherMonth = true;
                                    } else if (i >= firstDayOfWeek + daysInMonth) {
                                        dayNum = i - firstDayOfWeek - daysInMonth + 1;
                                        cellMonth = month + 1; isOtherMonth = true;
                                    } else {
                                        dayNum = i - firstDayOfWeek + 1;
                                    }
                                    if (cellMonth < 0) { cellMonth = 11; cellYear--; }
                                    if (cellMonth > 11) { cellMonth = 0; cellYear++; }

                                    const iso = toISO(cellYear, cellMonth, dayNum);
                                    const jsDay = new Date(cellYear, cellMonth, dayNum).getDay();
                                    const selected = isClassDay(iso, jsDay);
                                    const off = isOffDay(iso, jsDay);
                                    const shaded = !isOtherMonth && inRange(iso) && !selected && !off;
                                    const isEndpoint = iso === startISO || iso === endISO;
                                    const isHoliday = holidaysByDate[iso] && holidaysByDate[iso].length > 0;
                                    const holidayTitle = isHoliday ? holidaysByDate[iso][0].title : '';

                                    const offTitle = off ? 'Click to restore this class day' : (selected ? 'Click to mark this day off' : '');
                                    const cellTitle = isHoliday ? `${offTitle ? offTitle + ' — ' : ''}Holiday: ${holidayTitle}` : offTitle;

                                    cells += `<button type="button" data-iso="${iso}" title="${cellTitle}"
                                        class="period-cal-day text-xs rounded-lg py-1.5 transition-colors
                                            ${isOtherMonth ? 'text-slate-300 dark:text-slate-700 cursor-default' : 'cursor-pointer'}
                                            ${selected ? 'bg-[#7c3aed] text-white font-semibold' : ''}
                                            ${off ? 'bg-slate-200 dark:bg-slate-700 text-slate-400 dark:text-slate-500 line-through' : ''}
                                            ${shaded ? 'bg-purple-100 dark:bg-purple-950 text-purple-700 dark:text-purple-300' : ''}
                                            ${!selected && !off && !shaded && !isOtherMonth ? 'hover:bg-slate-100 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-200' : ''}
                                            ${isEndpoint ? 'ring-2 ring-[#7c3aed]' : ''}
                                            ${isHoliday && !isOtherMonth ? 'ring-2 ring-yellow-400 dark:ring-yellow-500' : ''}
                                            ${isHoliday && !isOtherMonth && !selected && !off && !shaded ? 'bg-yellow-100 dark:bg-yellow-950/40' : ''}"
                                        ${isOtherMonth ? 'disabled' : ''}>${dayNum}</button>`;
                                }
                                calGrid.innerHTML = cells;

                                calGrid.querySelectorAll('.period-cal-day:not([disabled])').forEach(btn => {
                                    btn.addEventListener('click', () => {
                                        const iso = btn.dataset.iso;
                                        const jsDay = new Date(iso + 'T00:00:00').getDay();
                                        const rangeComplete = startISO && endISO;

                                        if (rangeComplete && (isClassDay(iso, jsDay) || isOffDay(iso, jsDay))) {
                                            if (offDates.has(iso)) offDates.delete(iso);
                                            else offDates.add(iso);
                                            updateLabel();
                                            render();
                                            return;
                                        }

                                        if (!startISO || rangeComplete) {
                                            startISO = iso;
                                            endISO = null;
                                            offDates.clear();
                                        } else if (iso < startISO) {
                                            endISO = startISO;
                                            startISO = iso;
                                        } else {
                                            endISO = iso;
                                        }
                                        updateLabel();
                                        render();
                                    });
                                });
                                updateLabel();
                            }

                            row.querySelector('.period-cal-prev').addEventListener('click', () => {
                                viewDate.setMonth(viewDate.getMonth() - 1);
                                render();
                            });
                            row.querySelector('.period-cal-next').addEventListener('click', () => {
                                viewDate.setMonth(viewDate.getMonth() + 1);
                                render();
                            });
                            row.querySelectorAll('.period-day-label').forEach(label => {
                                label.addEventListener('click', () => render());
                            });

                            render();

                            return {
                                getRange: () => ({
                                    startDate: startISO,
                                    endDate: endISO || startISO,
                                    exceptionDates: Array.from(offDates).sort().join(',')
                                })
                            };
                        }

                        function addPeriodRow(prefill = null) {
                            const idx = periodCount++;
                            const row = document.createElement('div');
                            row.className = 'period-row bg-white dark:bg-slate-900 rounded-xl p-3 border border-slate-200 dark:border-slate-600 space-y-3';
                            row.dataset.periodIndex = idx;
                            row.innerHTML = `
                                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                    <div>
                                        <div class="flex items-center justify-between mb-2">
                                            <button type="button" class="period-cal-prev p-1 rounded-lg hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-500 dark:text-slate-400">
                                                <i data-lucide="chevron-left" class="w-4 h-4"></i>
                                            </button>
                                            <span class="period-cal-title text-xs font-semibold text-slate-700 dark:text-slate-200"></span>
                                            <button type="button" class="period-cal-next p-1 rounded-lg hover:bg-slate-200 dark:hover:bg-slate-700 text-slate-500 dark:text-slate-400">
                                                <i data-lucide="chevron-right" class="w-4 h-4"></i>
                                            </button>
                                        </div>
                                        <div class="grid grid-cols-7 gap-0.5 mb-0.5 text-center">
                                            ${['S', 'M', 'T', 'W', 'T', 'F', 'S'].map(d => `<div class="text-[9px] font-semibold text-slate-400 dark:text-slate-500 uppercase">${d}</div>`).join('')}
                                        </div>
                                        <div class="period-cal-grid grid grid-cols-7 gap-0.5"></div>
                                        <p class="period-range-label text-[11px] text-slate-500 dark:text-slate-400 mt-1.5"></p>
                                    </div>
                                    <div class="space-y-3">
                                        <div>
                                            <p class="text-xs font-medium text-slate-600 dark:text-slate-300 mb-1.5">Days of week</p>
                                            <div class="flex flex-wrap gap-1">
                                                ${DAYS.map(d => `
                                                    <label class="period-day-label px-2 py-1 rounded-lg border border-slate-200 dark:border-slate-600 text-xs cursor-pointer select-none">
                                                        <input type="checkbox" class="period-day hidden" value="${d}" /> ${d}
                                                    </label>`).join('')}
                                            </div>
                                        </div>
                                        <div class="flex gap-2">
                                            <div class="flex-1">
                                                <input type="time" class="period-start-time w-full px-2 py-2 rounded-xl border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-900 text-sm" required />
                                                <p class="period-start-time-label text-[11px] text-slate-400 dark:text-slate-500 mt-0.5"></p>
                                            </div>
                                            <div class="flex-1">
                                                <input type="time" class="period-end-time w-full px-2 py-2 rounded-xl border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-900 text-sm" required />
                                                <p class="period-end-time-label text-[11px] text-slate-400 dark:text-slate-500 mt-0.5"></p>
                                            </div>
                                        </div>
                                        <button type="button" class="remove-period-btn text-xs text-red-500 hover:underline">Remove period</button>
                                    </div>
                                </div>
                            `;
                            row.querySelectorAll('.period-day-label').forEach(label => {
                                const cb = label.querySelector('input');
                                label.addEventListener('click', (e) => {
                                    e.preventDefault();
                                    cb.checked = !cb.checked;
                                    label.classList.toggle('bg-[#7c3aed]', cb.checked);
                                    label.classList.toggle('text-white', cb.checked);
                                    label.classList.toggle('border-[#7c3aed]', cb.checked);
                                });
                            });
                            row.querySelector('.remove-period-btn').addEventListener('click', () => {
                                if (container.children.length > 1) row.remove();
                            });

                            const startTimeInput = row.querySelector('.period-start-time');
                            const endTimeInput = row.querySelector('.period-end-time');
                            const startTimeLabel = row.querySelector('.period-start-time-label');
                            const endTimeLabel = row.querySelector('.period-end-time-label');
                            startTimeInput.addEventListener('input', () => { startTimeLabel.textContent = formatAmPm(startTimeInput.value); });
                            endTimeInput.addEventListener('input', () => { endTimeLabel.textContent = formatAmPm(endTimeInput.value); });

                            if (prefill) {
                                const activeDayCodes = (prefill.daysOfWeek || '').split(',').filter(Boolean);
                                row.querySelectorAll('.period-day-label').forEach(label => {
                                    const cb = label.querySelector('input');
                                    cb.checked = activeDayCodes.includes(cb.value);
                                    label.classList.toggle('bg-[#7c3aed]', cb.checked);
                                    label.classList.toggle('text-white', cb.checked);
                                    label.classList.toggle('border-[#7c3aed]', cb.checked);
                                });
                                startTimeInput.value = prefill.startTime || '';
                                endTimeInput.value = prefill.endTime || '';
                            }
                            startTimeLabel.textContent = formatAmPm(startTimeInput.value);
                            endTimeLabel.textContent = formatAmPm(endTimeInput.value);

                            container.appendChild(row);
                            row._calendar = initPeriodCalendar(row, prefill);
                            if (window.lucide) lucide.createIcons();
                        }

                        addBtn.addEventListener('click', () => addPeriodRow());
                        addPeriodRow();

                        // Mirrors the day-expansion logic used elsewhere (see
                        // CourseSchedule/Index.cshtml's own submit handler) so the
                        // client can check occurrence dates against holidaysByDate
                        // without a round trip.
                        function expandSegmentDates(segments) {
                            const dowCodeToJs = { Sun: 0, Mon: 1, Tue: 2, Wed: 3, Thu: 4, Fri: 5, Sat: 6 };
                            const dates = new Set();
                            segments.forEach(seg => {
                                const activeDays = new Set(seg.daysOfWeek.split(',').filter(Boolean));
                                const exceptionDates = new Set(seg.exceptionDates.split(',').filter(Boolean));
                                const start = new Date(seg.startDate + 'T00:00:00');
                                const end = new Date(seg.endDate + 'T00:00:00');
                                for (let d = new Date(start); d <= end; d.setDate(d.getDate() + 1)) {
                                    const iso = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
                                    const code = Object.keys(dowCodeToJs).find(k => dowCodeToJs[k] === d.getDay());
                                    if (!activeDays.has(code)) continue;
                                    if (exceptionDates.has(iso)) continue;
                                    dates.add(iso);
                                }
                            });
                            return dates;
                        }

                        form.addEventListener('submit', (e) => {
                            const segments = [];
                            const rows = Array.from(container.querySelectorAll('.period-row'));
                            const missingRange = rows.some(row => !row._calendar.getRange().startDate);
                            if (missingRange) {
                                e.preventDefault();
                                showToast('Pick a start and end date on the calendar for every period.', 'error');
                                return;
                            }
                            rows.forEach((row, i) => {
                                const days = Array.from(row.querySelectorAll('.period-day:checked')).map(cb => cb.value);
                                const range = row._calendar.getRange();
                                segments.push({
                                    startDate: range.startDate,
                                    endDate: range.endDate,
                                    daysOfWeek: DAYS.filter(d => days.includes(d)).join(','),
                                    startTime: row.querySelector('.period-start-time').value,
                                    endTime: row.querySelector('.period-end-time').value,
                                    sortOrder: i,
                                    exceptionDates: range.exceptionDates
                                });
                            });
                            if (segments.some(s => !s.daysOfWeek)) {
                                e.preventDefault();
                                showToast('Select at least one day of week for every period.', 'error');
                                return;
                            }

                            // ---------- Holiday confirmation ----------
                            // Holidays are informational, not a hard block:
                            // scheduling on a marked date is allowed, but only
                            // after an explicit confirmation naming the holiday.
                            if (!form.dataset.holidayConfirmed) {
                                const occurrenceDates = expandSegmentDates(segments);
                                const hitTitles = [];
                                occurrenceDates.forEach(iso => {
                                    (holidaysByDate[iso] || []).forEach(h => {
                                        if (!hitTitles.includes(h.title)) hitTitles.push(h.title);
                                    });
                                });
                                if (hitTitles.length > 0) {
                                    e.preventDefault();
                                    const message = hitTitles.length === 1
                                        ? `This date is marked as a holiday: ${hitTitles[0]}. Schedule anyway?`
                                        : `This date range includes marked holidays: ${hitTitles.join(', ')}. Schedule anyway?`;
                                    if (window.confirm(message)) {
                                        form.dataset.holidayConfirmed = '1';
                                        jsonField.value = JSON.stringify(segments);
                                        const picker = form.querySelector('.instructor-picker');
                                        if (picker && picker._picker && instructorJsonField) {
                                            instructorJsonField.value = JSON.stringify(picker._picker.getSelectedIds());
                                        }
                                        form.requestSubmit ? form.requestSubmit() : form.submit();
                                    }
                                    return;
                                }
                            }
                            form.dataset.holidayConfirmed = '';

                            jsonField.value = JSON.stringify(segments);

                            const picker = form.querySelector('.instructor-picker');
                            if (picker && picker._picker && instructorJsonField) {
                                instructorJsonField.value = JSON.stringify(picker._picker.getSelectedIds());
                            }
                        });

                        // ---------- Edit mode ----------
                        const scheduleIdField = document.getElementById('schedule-id-field');
                        const submitBtn = document.getElementById('add-schedule-submit');
                        const cancelEditBtn = document.getElementById('cancel-edit-schedule-btn');

                        function resetFormToAddMode() {
                            scheduleIdField.value = '';
                            ['ScheduleName', 'Capacity', 'Location', 'Notes'].forEach(name => {
                                const field = form.querySelector(`[name="${name}"]`);
                                if (field) field.value = '';
                            });
                            container.innerHTML = '';
                            periodCount = 0;
                            addPeriodRow();

                            const picker = form.querySelector('.instructor-picker');
                            form.querySelectorAll('.instructor-checkbox').forEach(cb => { cb.checked = false; });
                            if (picker && picker._picker && picker._picker.renderSelected) picker._picker.renderSelected();

                            if (submitBtn) submitBtn.textContent = 'Add Schedule';
                            if (cancelEditBtn) cancelEditBtn.classList.add('hidden');
                        }

                        if (cancelEditBtn) {
                            cancelEditBtn.addEventListener('click', () => {
                                resetFormToAddMode();
                                form.scrollIntoView({ behavior: 'smooth', block: 'start' });
                            });
                        }

                        // The schedule list table (with .edit-schedule-btn rows) is
                        // rendered further down the page, after this script block —
                        // unlike CourseSchedule/Index.cshtml where the table comes
                        // first. Querying for the buttons here would find none, since
                        // the parser hasn't reached them yet. Deferring to
                        // DOMContentLoaded lets this run once the whole page (including
                        // the table below) has been parsed.
                        document.addEventListener('DOMContentLoaded', () => {
                            document.querySelectorAll('.edit-schedule-btn').forEach(btn => {
                                btn.addEventListener('click', () => {
                                    const data = JSON.parse(btn.dataset.schedule);

                                    scheduleIdField.value = data.scheduleID;

                                    const nameField = form.querySelector('[name="ScheduleName"]');
                                    if (nameField) nameField.value = data.scheduleName || '';
                                    const capacityField = form.querySelector('[name="Capacity"]');
                                    if (capacityField) capacityField.value = data.capacity ?? '';
                                    const locationField = form.querySelector('[name="Location"]');
                                    if (locationField) locationField.value = data.location || '';
                                    const notesField = form.querySelector('[name="Notes"]');
                                    if (notesField) notesField.value = data.notes || '';

                                    container.innerHTML = '';
                                    periodCount = 0;
                                    (data.segments || []).forEach(seg => addPeriodRow(seg));
                                    if (window.lucide) lucide.createIcons();

                                    const picker = form.querySelector('.instructor-picker');
                                    const instructorIDs = data.instructorIDs || [];
                                    form.querySelectorAll('.instructor-checkbox').forEach(cb => {
                                        cb.checked = instructorIDs.includes(cb.value);
                                    });
                                    if (picker && picker._picker && picker._picker.renderSelected) picker._picker.renderSelected();

                                    if (submitBtn) submitBtn.textContent = 'Update batch';
                                    if (cancelEditBtn) cancelEditBtn.classList.remove('hidden');
                                    form.scrollIntoView({ behavior: 'smooth', block: 'start' });
                                });
                            });
                        });
                    })();
                </script>
            }

            @if (!Model.Schedules.Any())
            {
                <p class="text-sm text-slate-400 dark:text-slate-500">No schedules yet.</p>
            }
            else
            {
                <div class="overflow-x-auto">
                    <table class="w-full text-sm">
                        <thead>
                            <tr class="border-b border-slate-100 dark:border-slate-700 text-left text-slate-500 dark:text-slate-400">
                                <th class="py-2 font-medium">Batch</th>
                                <th class="py-2 font-medium">Periods</th>
                                <th class="py-2 font-medium">Location</th>
                                <th class="py-2 font-medium">Instructors</th>
                                <th class="py-2 font-medium">Capacity</th>
                                <th class="py-2 font-medium">Status</th>
                                <th class="py-2 font-medium text-right">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var s in Model.Schedules)
                            {
                                <tr class="border-b border-slate-50 dark:border-slate-800 last:border-0">
                                    <td class="py-2 font-medium text-slate-800 dark:text-slate-100">@s.ScheduleName</td>
                                    <td class="py-2">
                                        <button type="button" class="view-periods-btn px-2.5 py-1 rounded-lg text-xs font-medium bg-slate-50 dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700 transition-colors inline-flex items-center gap-1"
                                                data-schedule-name="@(string.IsNullOrEmpty(s.ScheduleName) ? s.CourseTitle : s.ScheduleName)"
                                                data-periods='@Html.Raw(System.Text.Json.JsonSerializer.Serialize(s.Segments.OrderBy(seg => seg.SortOrder).Select(seg => new {
                                                    dateRange = seg.DateRangeText, days = seg.DaysOfWeekLabel, time = seg.TimeRangeText,
                                                    daysOff = seg.ExceptionCount, meetingLink = seg.MeetingLink
                                                })))'>
                                            <i data-lucide="calendar-days" class="w-3.5 h-3.5"></i>
                                            @s.Segments.Count period@(s.Segments.Count == 1 ? "" : "s")
                                        </button>
                                    </td>
                                    <td class="py-2 text-slate-500 dark:text-slate-400">@s.Location</td>
                                    <td class="py-2 text-slate-500 dark:text-slate-400">@(string.IsNullOrEmpty(s.InstructorsLabel) ? "-" : s.InstructorsLabel)</td>
                                    <td class="py-2 text-slate-500 dark:text-slate-400">@(s.Capacity?.ToString() ?? "-")</td>
                                    <td class="py-2">
                                        <span class="px-2 py-0.5 rounded-full text-[10px] font-semibold uppercase @(s.IsActive == "A" ? "bg-emerald-50 dark:bg-emerald-950 text-emerald-700 dark:text-emerald-300" : "bg-slate-200 dark:bg-slate-700 text-slate-600 dark:text-slate-300")">@s.StatusLabel</span>
                                    </td>
                                    <td class="py-2 text-right">
                                        @if (canEdit)
                                        {
                                            <button type="button" class="edit-schedule-btn p-2 rounded-xl text-slate-400 dark:text-slate-500 hover:text-[#7c3aed] dark:hover:text-purple-400 hover:bg-slate-100 dark:hover:bg-slate-700 transition-colors"
                                                    title="Edit"
                                                    data-schedule='@Html.Raw(System.Text.Json.JsonSerializer.Serialize(new {
                                                        scheduleID = s.ScheduleID, courseID = s.CourseID, scheduleName = s.ScheduleName,
                                                        capacity = s.Capacity, location = s.Location, notes = s.Notes,
                                                        segments = s.Segments.OrderBy(seg => seg.SortOrder).Select(seg => new {
                                                            startDate = seg.StartDate.ToString("yyyy-MM-dd"), endDate = seg.EndDate.ToString("yyyy-MM-dd"),
                                                            daysOfWeek = seg.DaysOfWeek, startTime = seg.StartTime.HasValue ? seg.StartTime.Value.ToString("hh\\:mm") : "",
                                                            endTime = seg.EndTime.HasValue ? seg.EndTime.Value.ToString("hh\\:mm") : "", exceptionDates = seg.ExceptionDates
                                                        }),
                                                        instructorIDs = s.Instructors.Select(i => i.UserID)
                                                    }))'>
                                                <i data-lucide="pencil" class="w-4 h-4"></i>
                                            </button>
                                        }
                                        @if (s.IsActive != "A" && canDelete)
                                        {
                                            <form method="post" asp-action="ActivateSchedule" asp-route-courseId="@c.CourseID" asp-route-id="@s.ScheduleID" class="inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" title="Activate" class="p-2 rounded-xl text-slate-400 dark:text-slate-500 hover:text-emerald-600 dark:hover:text-emerald-400 hover:bg-slate-100 dark:hover:bg-slate-700 transition-colors">
                                                    <i data-lucide="rotate-ccw" class="w-4 h-4"></i>
                                                </button>
                                            </form>
                                        }
                                        @if (canDelete)
                                        {
                                            <form method="post" asp-action="DeleteSchedule" asp-route-courseId="@c.CourseID" asp-route-id="@s.ScheduleID" class="inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" title="Remove" class="p-2 rounded-xl text-slate-400 dark:text-slate-500 hover:text-red-600 dark:hover:text-red-400 hover:bg-slate-100 dark:hover:bg-slate-700 transition-colors">
                                                    <i data-lucide="trash-2" class="w-4 h-4"></i>
                                                </button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }
</div>

@* ---------- Periods popup (shared by the "N periods" button) ---------- *@
<div id="periods-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/40" role="dialog" aria-modal="true">
    <div class="bg-white dark:bg-slate-900 rounded-[24px] shadow-xl border border-slate-100 dark:border-slate-700 w-full max-w-lg max-h-[80vh] flex flex-col">
        <div class="p-5 border-b border-slate-100 dark:border-slate-700 flex items-center justify-between gap-3">
            <h3 id="periods-modal-title" class="font-semibold text-slate-800 dark:text-slate-100"></h3>
            <button type="button" id="periods-modal-close" class="p-1.5 rounded-lg text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800">
                <i data-lucide="x" class="w-4 h-4"></i>
            </button>
        </div>
        <div id="periods-modal-body" class="p-5 space-y-3 overflow-y-auto"></div>
    </div>
</div>
<script>
    (function () {
        const modal = document.getElementById('periods-modal');
        const title = document.getElementById('periods-modal-title');
        const body = document.getElementById('periods-modal-body');

        function openModal(scheduleName, periods) {
            title.textContent = scheduleName;
            body.innerHTML = periods.length === 0
                ? '<p class="text-sm text-slate-400 dark:text-slate-500">No periods defined.</p>'
                : periods.map(p => `
                    <div class="rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-100 dark:border-slate-700 px-4 py-3">
                        <p class="text-sm font-semibold text-slate-800 dark:text-slate-100">${p.dateRange}</p>
                        <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">${p.days}${p.time ? ' · ' + p.time : ''}</p>
                        ${p.daysOff > 0 ? `<p class="text-xs text-amber-600 dark:text-amber-300 mt-0.5">${p.daysOff} day${p.daysOff === 1 ? '' : 's'} off</p>` : ''}
                        ${p.meetingLink ? `<a href="${p.meetingLink}" target="_blank" rel="noopener" class="text-xs text-[#7c3aed] hover:underline mt-1 inline-flex items-center gap-1"><i data-lucide="video" class="w-3 h-3"></i> Join meeting</a>` : ''}
                    </div>`).join('');
            modal.classList.remove('hidden');
            if (window.lucide) lucide.createIcons();
        }

        function closeModal() { modal.classList.add('hidden'); }

        document.querySelectorAll('.view-periods-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                const periods = JSON.parse(btn.dataset.periods || '[]');
                openModal(btn.dataset.scheduleName || '', periods);
            });
        });

        document.getElementById('periods-modal-close').addEventListener('click', closeModal);
        modal.addEventListener('click', (e) => { if (e.target === modal) closeModal(); });
        document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeModal(); });
    })();
</script>

@* ---------- Video preview popup (Course Video field, Details tab) ---------- *@
<div id="course-video-modal" class="hidden fixed inset-0 z-[60] flex items-center justify-center p-4 bg-black/70" role="dialog" aria-modal="true">
    <div class="bg-black rounded-2xl shadow-2xl w-full max-w-4xl relative">
        <button type="button" id="course-video-modal-close" aria-label="Close"
                class="absolute -top-11 right-0 p-2 rounded-lg text-white/80 hover:text-white hover:bg-white/10">
            <i data-lucide="x" class="w-6 h-6"></i>
        </button>
        <div id="course-video-modal-body" class="aspect-video w-full flex items-center justify-center overflow-hidden rounded-2xl"></div>
    </div>
</div>
<script>
    // Selecting a file makes the pasted link redundant (the upload wins
    // server-side); clearing it here avoids the field looking like it'll
    // still take effect once a file is chosen.
    (function () {
        const fileInput = document.getElementById('video-file-input');
        const urlInput = document.getElementById('video-url-input');
        if (fileInput && urlInput) {
            fileInput.addEventListener('change', () => {
                if (fileInput.files && fileInput.files.length > 0) urlInput.value = '';
            });
        }
    })();

    // Recognizes YouTube/Vimeo links and embeds them (they don't serve a
    // direct video stream a <video> tag can play); anything else — an
    // uploaded file's URL or a direct .mp4/.webm link — gets a real
    // <video> element with full native controls (play/pause/seek/skip/
    // volume/fullscreen/playback speed all come from the browser's own UI).
    function openCourseVideoPreview(url) {
        const modal = document.getElementById('course-video-modal');
        const body = document.getElementById('course-video-modal-body');
        if (!url) return;

        const yt = url.match(/(?:youtube\.com\/watch\?v=|youtu\.be\/|youtube\.com\/embed\/)([\w-]+)/);
        const vimeo = url.match(/vimeo\.com\/(\d+)/);

        if (yt) {
            body.innerHTML = `<iframe class="w-full h-full" src="https://www.youtube.com/embed/${yt[1]}?autoplay=1" title="Course video" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>`;
        } else if (vimeo) {
            body.innerHTML = `<iframe class="w-full h-full" src="https://player.vimeo.com/video/${vimeo[1]}?autoplay=1" title="Course video" frameborder="0" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen></iframe>`;
        } else {
            body.innerHTML = `
                <div class="relative w-full h-full group">
                    <video id="course-video-player" class="w-full h-full" src="${url}" controls autoplay controlsList="nodownload" playsinline></video>
                    <div class="absolute inset-x-0 bottom-14 flex items-center justify-center gap-4 opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none">
                        <button type="button" onclick="document.getElementById('course-video-player').currentTime -= 30" class="pointer-events-auto flex items-center gap-1 px-3 py-1.5 rounded-full bg-black/70 text-white text-xs font-medium hover:bg-black/90">
                            <i data-lucide="rotate-ccw" class="w-3.5 h-3.5"></i> 30s
                        </button>
                        <button type="button" onclick="document.getElementById('course-video-player').currentTime += 30" class="pointer-events-auto flex items-center gap-1 px-3 py-1.5 rounded-full bg-black/70 text-white text-xs font-medium hover:bg-black/90">
                            30s <i data-lucide="rotate-cw" class="w-3.5 h-3.5"></i>
                        </button>
                    </div>
                </div>`;
        }

        modal.classList.remove('hidden');
        if (window.lucide) lucide.createIcons();
    }

    (function () {
        const modal = document.getElementById('course-video-modal');
        const body = document.getElementById('course-video-modal-body');
        function closeVideoModal() {
            modal.classList.add('hidden');
            body.innerHTML = ''; // stops playback/audio instead of just hiding it
        }
        document.getElementById('course-video-modal-close').addEventListener('click', closeVideoModal);
        modal.addEventListener('click', (e) => { if (e.target === modal) closeVideoModal(); });
        document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !modal.classList.contains('hidden')) closeVideoModal(); });
    })();
</script>
