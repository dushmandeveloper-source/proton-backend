@using Web_Backend.Areas.Admin.Data
@{
    var tab = ViewBag.Tab as string ?? "ProgrammeLevel";
    var levels = ViewBag.ProgrammeLevels as List<RegistrationOption> ?? new();
    var purposes = ViewBag.CSCAPurposes as List<RegistrationOption> ?? new();
    bool canAdd = Web_Backend.Classes.Auth.HasPermission(Web_Backend.Classes.PermissionCode.Students, 'A');
    bool canEdit = Web_Backend.Classes.Auth.HasPermission(Web_Backend.Classes.PermissionCode.Students, 'E');
    var sections = new[]
    {
        (Key: "ProgrammeLevel", Title: "Programme levels", Icon: "graduation-cap", Rows: levels,
         Hint: "Asked first on the course step of registration, e.g. “Bachelor's Degree”, “MSc”. Flag a level “CSCA course mandatory” to stop students skipping the CSCA.", Example: "e.g. Bachelor's Degree"),
        (Key: "CSCAPurpose", Title: "CSCA purposes", Icon: "target", Rows: purposes,
         Hint: "Asked only when a student selects a CSCA course — why they are taking the CSCA.", Example: "e.g. Undergraduate admission")
    };
}

<div class="max-w-5xl mx-auto page-enter">
    <div class="mb-6">
        <h2 class="text-3xl font-bold text-slate-800 dark:text-slate-100 tracking-tight">Registration Options</h2>
        <p class="text-slate-500 dark:text-slate-400 mt-2">Choices students pick on the public registration form. Only <span class="font-medium text-slate-700 dark:text-slate-200">active</span> options are shown; if a list has no active options, the question is skipped.</p>
    </div>

    <div class="inline-flex p-1 mb-6 rounded-2xl bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700" role="tablist">
        @foreach (var s in sections)
        {
            var on = s.Key == tab;
            var activeCount = s.Rows.Count(r => r.IsActive == "A");
            <button type="button" role="tab" data-ro-tab="@s.Key" aria-selected="@(on ? "true" : "false")"
                    class="ro-tab flex items-center gap-2 px-4 py-2 rounded-xl text-sm font-medium transition-all duration-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-purple-400 @(on ? "bg-white dark:bg-slate-700 text-slate-900 dark:text-slate-100 shadow-sm" : "text-slate-500 dark:text-slate-400 hover:text-slate-800 dark:hover:text-slate-200")">
                <i data-lucide="@s.Icon" class="w-4 h-4"></i>
                <span>@s.Title</span>
                <span class="px-2 py-0.5 rounded-full text-xs bg-purple-50 dark:bg-purple-900/30 text-[#7c3aed] dark:text-[#a78bfa]">@activeCount</span>
            </button>
        }
    </div>

    @foreach (var s in sections)
    {
        <section data-ro-panel="@s.Key" class="@(s.Key == tab ? "" : "hidden")">
            <div class="bg-white dark:bg-slate-800 rounded-3xl border border-slate-100 dark:border-slate-700 shadow-sm overflow-hidden">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 px-5 sm:px-6 py-5 border-b border-slate-100 dark:border-slate-700">
                    <div>
                        <h3 class="text-lg font-semibold text-slate-800 dark:text-slate-100">@s.Title</h3>
                        <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">@s.Hint</p>
                    </div>
                    @if (canAdd)
                    {
                        <button type="button" data-ro-new="@s.Key" data-example="@s.Example"
                                class="px-4 py-2 rounded-xl font-medium bg-[#7c3aed] text-white hover:bg-[#6d28d9] shadow-sm text-sm flex items-center gap-2 w-fit shrink-0 focus:outline-none focus-visible:ring-2 focus-visible:ring-purple-400">
                            <i data-lucide="plus" class="w-4 h-4"></i> Add option
                        </button>
                    }
                </div>

                @if (!s.Rows.Any())
                {
                    <div class="px-6 py-14 text-center">
                        <div class="w-12 h-12 mx-auto mb-3 rounded-2xl bg-purple-50 dark:bg-purple-900/30 flex items-center justify-center">
                            <i data-lucide="@s.Icon" class="w-6 h-6 text-[#7c3aed] dark:text-[#a78bfa]"></i>
                        </div>
                        <p class="font-medium text-slate-700 dark:text-slate-200">No options yet</p>
                        <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">Until you add one, this question isn't shown on the registration form.</p>
                    </div>
                }
                else
                {
                    <ul class="divide-y divide-slate-100 dark:divide-slate-700">
                        @foreach (var r in s.Rows)
                        {
                            var active = r.IsActive == "A";
                            <li class="flex flex-col sm:flex-row sm:items-center gap-3 px-5 sm:px-6 py-4 transition-colors hover:bg-slate-50/60 dark:hover:bg-slate-700/30 @(active ? "" : "opacity-60")">
                                <div class="flex items-center gap-4 flex-1 min-w-0">
                                    <span class="w-9 h-9 shrink-0 rounded-xl bg-slate-100 dark:bg-slate-700 text-slate-500 dark:text-slate-300 text-xs font-semibold flex items-center justify-center" title="Sort order">@r.SortOrder</span>
                                    <div class="min-w-0">
                                        <div class="flex items-center gap-2 min-w-0">
                                            <p class="font-medium text-slate-800 dark:text-slate-100 truncate">@r.Name</p>
                                            @if (s.Key == "ProgrammeLevel" && r.RequiresCSCA)
                                            {
                                                <span class="shrink-0 inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[11px] font-semibold bg-amber-50 text-amber-700 ring-1 ring-amber-200 dark:bg-amber-900/30 dark:text-amber-300 dark:ring-amber-800" title="Students choosing this programme must register for a CSCA course">
                                                    <i data-lucide="shield-check" class="w-3 h-3"></i> CSCA mandatory
                                                </span>
                                            }
                                        </div>
                                        <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">@(r.InUseCount == 1 ? "1 student" : $"{r.InUseCount} students")</p>
                                    </div>
                                </div>
                                <div class="flex items-center gap-2 sm:justify-end">
                                    <span class="px-2.5 py-1 rounded-full text-xs font-medium @(active ? "bg-emerald-50 text-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-300" : "bg-slate-100 text-slate-500 dark:bg-slate-700 dark:text-slate-400")">@(active ? "Active" : "Inactive")</span>
                                    @if (canEdit)
                                    {
                                        <button type="button" data-ro-edit="@s.Key" data-id="@r.ID" data-name="@r.Name" data-sort="@r.SortOrder" data-active="@r.IsActive" data-requires="@(r.RequiresCSCA ? "1" : "0")"
                                                class="px-3 py-1.5 rounded-xl text-sm font-medium border border-slate-200 dark:border-slate-600 text-slate-700 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-slate-700 flex items-center gap-1.5 focus:outline-none focus-visible:ring-2 focus-visible:ring-purple-400">
                                            <i data-lucide="pencil" class="w-3.5 h-3.5"></i> Edit
                                        </button>
                                        <form method="post" asp-action="ToggleActive" class="inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="type" value="@s.Key" />
                                            <input type="hidden" name="id" value="@r.ID" />
                                            <button type="submit"
                                                    class="px-3 py-1.5 rounded-xl text-sm font-medium flex items-center gap-1.5 focus:outline-none focus-visible:ring-2 focus-visible:ring-purple-400 @(active ? "text-rose-600 dark:text-rose-400 hover:bg-rose-50 dark:hover:bg-rose-900/20" : "text-emerald-600 dark:text-emerald-400 hover:bg-emerald-50 dark:hover:bg-emerald-900/20")">
                                                <i data-lucide="@(active ? "eye-off" : "eye")" class="w-3.5 h-3.5"></i> @(active ? "Deactivate" : "Activate")
                                            </button>
                                        </form>
                                    }
                                </div>
                            </li>
                        }
                    </ul>
                }
            </div>
        </section>
    }
</div>

<div id="ro-modal" class="hidden fixed inset-0 z-50 flex items-end sm:items-center justify-center p-0 sm:p-4" role="dialog" aria-modal="true" aria-labelledby="ro-title">
    <div class="absolute inset-0 bg-slate-900/40 backdrop-blur-sm" data-ro-close></div>
    <form method="post" asp-action="Save" class="relative w-full sm:max-w-md bg-white dark:bg-slate-800 rounded-t-3xl sm:rounded-3xl shadow-xl border border-slate-100 dark:border-slate-700">
        @Html.AntiForgeryToken()
        <input type="hidden" name="type" id="ro-type" />
        <input type="hidden" name="id" id="ro-id" value="0" />
        <div class="flex items-center justify-between px-6 pt-6">
            <h3 id="ro-title" class="text-lg font-semibold text-slate-800 dark:text-slate-100">Add option</h3>
            <button type="button" data-ro-close aria-label="Close" class="p-2 rounded-xl text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-700"><i data-lucide="x" class="w-4 h-4"></i></button>
        </div>
        <div class="px-6 py-5 space-y-4">
            <div>
                <label for="ro-name" class="block text-sm font-medium text-slate-700 dark:text-slate-200 mb-1.5">Name</label>
                <input id="ro-name" name="name" maxlength="150" required
                       class="w-full px-3 py-2.5 rounded-xl border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-900 text-slate-800 dark:text-slate-100 text-sm focus:outline-none focus:border-purple-400 focus:ring-1 focus:ring-purple-400" />
                <p class="text-xs text-slate-500 dark:text-slate-400 mt-1.5">Shown to students exactly as typed.</p>
            </div>
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label for="ro-sort" class="block text-sm font-medium text-slate-700 dark:text-slate-200 mb-1.5">Sort order</label>
                    <input id="ro-sort" name="sortOrder" type="number" min="0" step="1"
                           class="w-full px-3 py-2.5 rounded-xl border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-900 text-slate-800 dark:text-slate-100 text-sm focus:outline-none focus:border-purple-400 focus:ring-1 focus:ring-purple-400" />
                    <p class="text-xs text-slate-500 dark:text-slate-400 mt-1.5">Lower shows first. Blank = last.</p>
                </div>
                <div>
                    <label for="ro-active" class="block text-sm font-medium text-slate-700 dark:text-slate-200 mb-1.5">Status</label>
                    <select id="ro-active" name="isActive"
                            class="w-full px-3 py-2.5 rounded-xl border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-900 text-slate-800 dark:text-slate-100 text-sm focus:outline-none focus:border-purple-400 focus:ring-1 focus:ring-purple-400">
                        <option value="A">Active</option>
                        <option value="I">Inactive</option>
                    </select>
                </div>
            </div>
            <label id="ro-requires-wrap" for="ro-requires" class="hidden flex items-start gap-3 p-4 rounded-2xl border border-slate-200 dark:border-slate-600 bg-slate-50/60 dark:bg-slate-900/40 cursor-pointer transition-colors hover:border-purple-300 dark:hover:border-purple-500 has-[:checked]:border-amber-300 has-[:checked]:bg-amber-50/60 dark:has-[:checked]:border-amber-700 dark:has-[:checked]:bg-amber-900/20">
                <span class="relative inline-flex shrink-0 mt-0.5">
                    <input id="ro-requires" name="requiresCSCA" type="checkbox" value="true" class="peer sr-only" />
                    <span class="w-10 h-6 rounded-full bg-slate-300 dark:bg-slate-600 transition-colors peer-checked:bg-[#7c3aed] peer-focus-visible:ring-2 peer-focus-visible:ring-purple-400 peer-focus-visible:ring-offset-2 dark:peer-focus-visible:ring-offset-slate-800"></span>
                    <span class="absolute top-1 left-1 w-4 h-4 rounded-full bg-white shadow transition-transform peer-checked:translate-x-4"></span>
                </span>
                <span class="min-w-0">
                    <span class="block text-sm font-medium text-slate-800 dark:text-slate-100">CSCA course mandatory</span>
                    <span class="block text-xs text-slate-500 dark:text-slate-400 mt-1">Students choosing this programme must register for a CSCA course — they can't skip course registration.</span>
                </span>
            </label>
        </div>
        <div class="flex justify-end gap-2 px-6 pb-6">
            <button type="button" data-ro-close class="px-4 py-2 rounded-xl text-sm font-medium border border-slate-200 dark:border-slate-600 text-slate-700 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-slate-700">Cancel</button>
            <button type="submit" class="px-4 py-2 rounded-xl text-sm font-medium bg-[#7c3aed] text-white hover:bg-[#6d28d9] shadow-sm">Save</button>
        </div>
    </form>
</div>

<script>
    (function () {
        var modal = document.getElementById('ro-modal');
        function $(id) { return document.getElementById(id); }
        var onCls = ['bg-white', 'dark:bg-slate-700', 'text-slate-900', 'dark:text-slate-100', 'shadow-sm'];
        var offCls = ['text-slate-500', 'dark:text-slate-400'];
        document.querySelectorAll('[data-ro-tab]').forEach(function (b) {
            b.addEventListener('click', function () {
                var key = b.dataset.roTab;
                document.querySelectorAll('[data-ro-tab]').forEach(function (t) {
                    var on = t === b;
                    t.setAttribute('aria-selected', on ? 'true' : 'false');
                    onCls.forEach(function (c) { t.classList.toggle(c, on); });
                    offCls.forEach(function (c) { t.classList.toggle(c, !on); });
                });
                document.querySelectorAll('[data-ro-panel]').forEach(function (p) { p.classList.toggle('hidden', p.dataset.roPanel !== key); });
                try { history.replaceState(null, '', '?tab=' + key); } catch (e) { }
            });
        });
        function open(type, d, example) {
            $('ro-title').textContent = d ? 'Edit option' : 'Add option';
            $('ro-type').value = type;
            $('ro-id').value = d ? d.id : '0';
            $('ro-name').value = d ? d.name : '';
            $('ro-name').placeholder = example || '';
            $('ro-sort').value = d ? d.sort : '';
            $('ro-active').value = d ? d.active : 'A';
            var isLevel = type === 'ProgrammeLevel';
            $('ro-requires-wrap').classList.toggle('hidden', !isLevel);
            $('ro-requires').checked = isLevel && !!d && d.requires === '1';
            modal.classList.remove('hidden');
            $('ro-name').focus();
        }
        function close() { modal.classList.add('hidden'); }
        document.querySelectorAll('[data-ro-new]').forEach(function (b) { b.addEventListener('click', function () { open(b.dataset.roNew, null, b.dataset.example); }); });
        document.querySelectorAll('[data-ro-edit]').forEach(function (b) { b.addEventListener('click', function () { open(b.dataset.roEdit, b.dataset); }); });
        modal.querySelectorAll('[data-ro-close]').forEach(function (b) { b.addEventListener('click', close); });
        document.addEventListener('keydown', function (e) { if (e.key === 'Escape') close(); });
    })();
</script>
