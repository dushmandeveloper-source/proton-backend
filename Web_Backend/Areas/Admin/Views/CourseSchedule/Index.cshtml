@model List<CourseSchedule>
@{
    ViewData["Title"] = "Course Schedules";
    var keyW = ViewBag.KeyW as string ?? "";
    var courseId = ViewBag.CourseID as string ?? "";
    var showInactive = ViewBag.ShowInactive as bool? ?? false;
    var courses = ViewBag.Courses as List<Course> ?? new List<Course>();

    bool canAdd = Web_Backend.Classes.Auth.HasPermission(Web_Backend.Classes.PermissionCode.CourseSchedules, 'A');
    bool canDelete = Web_Backend.Classes.Auth.HasPermission(Web_Backend.Classes.PermissionCode.CourseSchedules, 'D');

    // Calendar renders every active/dated schedule regardless of the List
    // tab's KeyW/CourseID filters — it does its own month navigation and a
    // date-filtered subset would just look like missing data as you page
    // through months.
    var calendarEvents = Model
        .Where(s => s.ScheduleDate.HasValue)
        .Select(s => new
        {
            id = s.ScheduleID,
            date = s.ScheduleDate!.Value.ToString("yyyy-MM-dd"),
            title = string.IsNullOrEmpty(s.ScheduleName) ? s.CourseTitle : s.ScheduleName,
            courseTitle = s.CourseTitle,
            courseType = s.CourseType,
            time = s.TimeRangeText,
            location = s.Location,
            capacity = s.Capacity,
            trainer = s.TrainerName,
            status = s.StatusLabel,
            isActive = s.IsActive == "A"
        });
}

<div class="max-w-6xl mx-auto page-enter">
    <div class="flex flex-col md:flex-row md:items-center justify-between mb-6 gap-4">
        <div>
            <h2 class="text-3xl font-bold text-slate-800 dark:text-slate-100 tracking-tight">Course Schedules</h2>
            <p class="text-slate-500 dark:text-slate-400 mt-2">Batches and sessions across every course — CSCA sessions included.</p>
        </div>
        @if (canAdd)
        {
            <button type="button" onclick="document.getElementById('add-schedule-form').classList.remove('hidden')"
                    class="px-4 py-2 rounded-xl font-medium bg-[#7c3aed] text-white hover:bg-[#6d28d9] shadow-sm text-sm flex items-center gap-2 w-fit">
                <i data-lucide="plus" class="w-4 h-4"></i> Add Schedule
            </button>
        }
    </div>

    @if (canAdd)
    {
        <form id="add-schedule-form" method="post" asp-action="Save" class="hidden bg-white dark:bg-slate-900/60 rounded-[24px] shadow-sm border border-slate-100 dark:border-slate-700 p-6 mb-6 grid grid-cols-1 md:grid-cols-4 gap-4">
            @Html.AntiForgeryToken()
            <select name="CourseID" required class="md:col-span-2 px-3 py-2 rounded-xl border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-800 text-sm">
                <option value="">-- Select course --</option>
                @foreach (var c in courses)
                {
                    <option value="@c.CourseID">@c.CourseTitle (@c.CourseType)</option>
                }
            </select>
            <input type="text" name="ScheduleName" placeholder="Batch name (e.g. Jan 2027 Sitting)"
                   class="md:col-span-2 px-3 py-2 rounded-xl border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-800 text-sm" />
            <input type="date" name="ScheduleDate"
                   class="px-3 py-2 rounded-xl border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-800 text-sm" />
            <input type="time" name="StartTime"
                   class="px-3 py-2 rounded-xl border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-800 text-sm" />
            <input type="time" name="EndTime"
                   class="px-3 py-2 rounded-xl border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-800 text-sm" />
            <input type="number" name="Capacity" placeholder="Capacity"
                   class="px-3 py-2 rounded-xl border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-800 text-sm" />
            <input type="text" name="Location" placeholder="Location"
                   class="md:col-span-2 px-3 py-2 rounded-xl border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-800 text-sm" />
            <input type="text" name="TrainerName" placeholder="Trainer / Invigilator"
                   class="md:col-span-2 px-3 py-2 rounded-xl border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-800 text-sm" />
            <input type="text" name="Notes" placeholder="Notes (optional)"
                   class="md:col-span-4 px-3 py-2 rounded-xl border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-800 text-sm" />
            <div class="md:col-span-4 flex gap-2">
                <button type="submit" class="px-4 py-2 rounded-xl font-medium bg-[#7c3aed] text-white hover:bg-[#6d28d9] text-sm">Save</button>
                <button type="button" onclick="document.getElementById('add-schedule-form').classList.add('hidden')"
                        class="px-4 py-2 rounded-xl font-medium bg-slate-50 dark:bg-slate-800 text-slate-600 dark:text-slate-300 text-sm">Cancel</button>
            </div>
        </form>
    }

    <div class="border-b border-slate-200 dark:border-slate-700 mb-6">
        <nav class="flex gap-6" id="tab-strip">
            <button type="button" data-tab-target="list"
                    class="tab-btn pb-3 text-sm font-medium border-b-2 -mb-px transition-colors border-[#7c3aed] text-[#7c3aed]">
                List
            </button>
            <button type="button" data-tab-target="calendar"
                    class="tab-btn pb-3 text-sm font-medium border-b-2 -mb-px transition-colors border-transparent text-slate-500 dark:text-slate-400 hover:text-slate-700 dark:hover:text-slate-200">
                Calendar
            </button>
        </nav>
    </div>

    <!-- ============ LIST PANE ============ -->
    <div data-tab-pane="list">
        <form method="get" class="flex flex-wrap items-center gap-3 mb-6">
            <div class="relative">
                <i data-lucide="search" class="w-4 h-4 text-slate-400 dark:text-slate-500 absolute left-3 top-1/2 -translate-y-1/2"></i>
                <input type="text" name="KeyW" value="@keyW" placeholder="Search course, batch, location..."
                       class="pl-9 pr-4 py-2 rounded-xl border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-800 text-slate-800 dark:text-slate-100 text-sm focus:outline-none focus:border-purple-400 focus:ring-1 focus:ring-purple-400" />
            </div>
            <select name="CourseID" class="px-3 py-2 rounded-xl border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-800 text-sm">
                <option value="">All courses</option>
                @foreach (var c in courses)
                {
                    <option value="@c.CourseID" selected="@(c.CourseID == courseId)">@c.CourseTitle</option>
                }
            </select>
            <label class="flex items-center gap-2 text-sm text-slate-600 dark:text-slate-300 cursor-pointer">
                <input type="checkbox" name="showInactive" value="true" checked="@showInactive"
                       class="rounded border-slate-300 dark:border-slate-600 text-[#7c3aed] focus:ring-[#7c3aed]" />
                Show deleted
            </label>
            <button type="submit" class="px-4 py-2 rounded-xl font-medium bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-200 border border-slate-200 dark:border-slate-600 hover:bg-slate-50 dark:hover:bg-slate-700 transition-all text-sm">Filter</button>
        </form>

        <div class="bg-white dark:bg-slate-900/60 rounded-[24px] shadow-sm border border-slate-100 dark:border-slate-700 overflow-hidden">
            @if (!Model.Any())
            {
                <div class="p-12 text-center">
                    <p class="text-sm text-slate-400 dark:text-slate-500">No schedules yet. Add a batch or exam session to get started.</p>
                </div>
            }
            else
            {
                <div class="overflow-x-auto">
                    <table class="w-full text-sm">
                        <thead>
                            <tr class="border-b border-slate-100 dark:border-slate-700 text-left text-slate-500 dark:text-slate-400">
                                <th class="px-6 py-3 font-medium">Course</th>
                                <th class="px-6 py-3 font-medium">Batch</th>
                                <th class="px-6 py-3 font-medium">Date</th>
                                <th class="px-6 py-3 font-medium">Time</th>
                                <th class="px-6 py-3 font-medium">Location</th>
                                <th class="px-6 py-3 font-medium">Capacity</th>
                                <th class="px-6 py-3 font-medium">Status</th>
                                <th class="px-6 py-3 font-medium text-right">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var s in Model)
                            {
                                <tr class="border-b border-slate-50 dark:border-slate-800 last:border-0">
                                    <td class="px-6 py-3">
                                        <span class="font-medium text-slate-800 dark:text-slate-100">@s.CourseTitle</span>
                                        <span class="ml-2 px-2 py-0.5 rounded-full text-[10px] font-semibold uppercase @(s.CourseType == "CSCA" ? "bg-purple-100 dark:bg-purple-950 text-purple-700 dark:text-purple-300" : "bg-sky-100 dark:bg-sky-950 text-sky-700 dark:text-sky-300")">@s.CourseType</span>
                                    </td>
                                    <td class="px-6 py-3 text-slate-500 dark:text-slate-400">@s.ScheduleName</td>
                                    <td class="px-6 py-3 text-slate-500 dark:text-slate-400">@(s.ScheduleDate?.ToString("dd MMM yyyy") ?? "-")</td>
                                    <td class="px-6 py-3 text-slate-500 dark:text-slate-400">@(string.IsNullOrEmpty(s.TimeRangeText) ? "-" : s.TimeRangeText)</td>
                                    <td class="px-6 py-3 text-slate-500 dark:text-slate-400">@s.Location</td>
                                    <td class="px-6 py-3 text-slate-500 dark:text-slate-400">@(s.Capacity?.ToString() ?? "-")</td>
                                    <td class="px-6 py-3">
                                        <span class="px-2 py-0.5 rounded-full text-[10px] font-semibold uppercase @(s.IsActive == "A" ? "bg-emerald-50 dark:bg-emerald-950 text-emerald-700 dark:text-emerald-300" : "bg-slate-200 dark:bg-slate-700 text-slate-600 dark:text-slate-300")">
                                            @s.StatusLabel
                                        </span>
                                    </td>
                                    <td class="px-6 py-3 text-right">
                                        @if (canDelete && s.IsActive == "A")
                                        {
                                            <form method="post" asp-action="Delete" asp-route-id="@s.ScheduleID" class="inline"
                                                  data-confirm="Delete this schedule?" data-confirm-title="Delete schedule" data-confirm-label="Delete">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" title="Delete" class="p-2 rounded-xl text-slate-400 dark:text-slate-500 hover:text-red-600 dark:hover:text-red-400 hover:bg-slate-100 dark:hover:bg-slate-700 transition-colors">
                                                    <i data-lucide="trash-2" class="w-4 h-4"></i>
                                                </button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <!-- ============ CALENDAR PANE ============ -->
    <div data-tab-pane="calendar" class="hidden">
        <div class="bg-white dark:bg-slate-900/60 rounded-[24px] shadow-sm border border-slate-100 dark:border-slate-700 p-4 md:p-6">
            <div class="flex items-center justify-between mb-4">
                <h3 id="cal-title" class="text-lg font-semibold text-slate-800 dark:text-slate-100"></h3>
                <div class="flex items-center gap-1">
                    <button type="button" id="cal-prev" class="p-2 rounded-xl text-slate-500 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-700 transition-colors">
                        <i data-lucide="chevron-left" class="w-5 h-5"></i>
                    </button>
                    <button type="button" id="cal-today" class="px-3 py-1.5 rounded-xl text-sm font-medium text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700 transition-colors">Today</button>
                    <button type="button" id="cal-next" class="p-2 rounded-xl text-slate-500 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-700 transition-colors">
                        <i data-lucide="chevron-right" class="w-5 h-5"></i>
                    </button>
                </div>
            </div>

            <div class="grid grid-cols-7 gap-1 md:gap-2 mb-1 text-center">
                @foreach (var d in new[] { "Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat" })
                {
                    <div class="text-[10px] md:text-xs font-semibold text-slate-400 dark:text-slate-500 uppercase tracking-wider py-1">@d</div>
                }
            </div>
            <div id="cal-grid" class="grid grid-cols-7 gap-1 md:gap-2"></div>
        </div>

        <!-- Day detail drawer: shown on mobile tap / desktop click of a day with events -->
        <div id="cal-day-panel" class="hidden mt-4 bg-white dark:bg-slate-900/60 rounded-[24px] shadow-sm border border-slate-100 dark:border-slate-700 p-6">
            <div class="flex items-center justify-between mb-4">
                <h4 id="cal-day-title" class="font-semibold text-slate-800 dark:text-slate-100"></h4>
                <button type="button" id="cal-day-close" class="p-1.5 rounded-lg text-slate-400 dark:text-slate-500 hover:bg-slate-100 dark:hover:bg-slate-700">
                    <i data-lucide="x" class="w-4 h-4"></i>
                </button>
            </div>
            <div id="cal-day-events" class="space-y-2"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.querySelectorAll('.tab-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                document.querySelectorAll('.tab-btn').forEach(b => {
                    b.classList.remove('border-[#7c3aed]', 'text-[#7c3aed]');
                    b.classList.add('border-transparent', 'text-slate-500', 'dark:text-slate-400');
                });
                btn.classList.remove('border-transparent', 'text-slate-500', 'dark:text-slate-400');
                btn.classList.add('border-[#7c3aed]', 'text-[#7c3aed]');

                document.querySelectorAll('[data-tab-pane]').forEach(p => p.classList.add('hidden'));
                const target = document.querySelector(`[data-tab-pane="${btn.dataset.tabTarget}"]`);
                if (target) target.classList.remove('hidden');
                if (btn.dataset.tabTarget === 'calendar' && window.lucide) lucide.createIcons();
            });
        });

        // ---------- Schedule calendar: dependency-free month grid ----------
        (function () {
            const events = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(calendarEvents));
            const eventsByDate = {};
            events.forEach(e => {
                (eventsByDate[e.date] = eventsByDate[e.date] || []).push(e);
            });

            let viewDate = new Date();
            viewDate.setDate(1);

            const grid = document.getElementById('cal-grid');
            const title = document.getElementById('cal-title');
            const dayPanel = document.getElementById('cal-day-panel');
            const dayTitle = document.getElementById('cal-day-title');
            const dayEvents = document.getElementById('cal-day-events');

            function toKey(y, m, d) {
                return `${y}-${String(m + 1).padStart(2, '0')}-${String(d).padStart(2, '0')}`;
            }

            function render() {
                const year = viewDate.getFullYear();
                const month = viewDate.getMonth();
                title.textContent = viewDate.toLocaleDateString('en-US', { month: 'long', year: 'numeric' });

                const firstDayOfWeek = new Date(year, month, 1).getDay();
                const daysInMonth = new Date(year, month + 1, 0).getDate();
                const daysInPrevMonth = new Date(year, month, 0).getDate();
                const today = new Date();
                const todayKey = toKey(today.getFullYear(), today.getMonth(), today.getDate());

                let cells = '';
                const totalCells = Math.ceil((firstDayOfWeek + daysInMonth) / 7) * 7;

                for (let i = 0; i < totalCells; i++) {
                    let cellYear = year, cellMonth = month, dayNum, isOtherMonth = false;

                    if (i < firstDayOfWeek) {
                        dayNum = daysInPrevMonth - firstDayOfWeek + i + 1;
                        cellMonth = month - 1; isOtherMonth = true;
                    } else if (i >= firstDayOfWeek + daysInMonth) {
                        dayNum = i - firstDayOfWeek - daysInMonth + 1;
                        cellMonth = month + 1; isOtherMonth = true;
                    } else {
                        dayNum = i - firstDayOfWeek + 1;
                    }
                    if (cellMonth < 0) { cellMonth = 11; cellYear--; }
                    if (cellMonth > 11) { cellMonth = 0; cellYear++; }

                    const key = toKey(cellYear, cellMonth, dayNum);
                    const dayEventsList = eventsByDate[key] || [];
                    const isToday = key === todayKey;

                    const dotsHtml = dayEventsList.slice(0, 3).map(e =>
                        `<span class="w-1.5 h-1.5 rounded-full ${e.courseType === 'CSCA' ? 'bg-purple-500' : 'bg-sky-500'} ${!e.isActive ? 'opacity-30' : ''}"></span>`
                    ).join('');

                    const labelsHtml = dayEventsList.slice(0, 2).map(e =>
                        `<div class="hidden md:block text-[10px] leading-tight truncate px-1 py-0.5 rounded ${e.courseType === 'CSCA' ? 'bg-purple-50 text-purple-700 dark:bg-purple-950 dark:text-purple-300' : 'bg-sky-50 text-sky-700 dark:bg-sky-950 dark:text-sky-300'} ${!e.isActive ? 'opacity-40' : ''}">${e.title}</div>`
                    ).join('');
                    const moreCount = dayEventsList.length > 2 ? `<div class="hidden md:block text-[10px] text-slate-400 dark:text-slate-500 px-1">+${dayEventsList.length - 2} more</div>` : '';

                    cells += `
                        <button type="button" data-day-key="${key}"
                                class="cal-day-cell relative aspect-square md:aspect-auto md:h-24 rounded-xl border text-left p-1.5 md:p-2 flex flex-col gap-1 transition-colors
                                    ${isOtherMonth ? 'border-transparent text-slate-300 dark:text-slate-700' : 'border-slate-100 dark:border-slate-700 text-slate-700 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-slate-800'}
                                    ${isToday ? 'ring-2 ring-[#7c3aed] ring-inset' : ''}
                                    ${dayEventsList.length > 0 ? 'cursor-pointer' : 'cursor-default'}">
                            <span class="text-xs md:text-sm font-medium ${isToday ? 'text-[#7c3aed] dark:text-purple-300 font-bold' : ''}">${dayNum}</span>
                            <div class="flex md:hidden gap-0.5 flex-wrap">${dotsHtml}</div>
                            <div class="hidden md:flex md:flex-col gap-0.5 overflow-hidden">${labelsHtml}${moreCount}</div>
                        </button>`;
                }

                grid.innerHTML = cells;

                grid.querySelectorAll('.cal-day-cell').forEach(cell => {
                    const key = cell.dataset.dayKey;
                    const list = eventsByDate[key] || [];
                    if (list.length === 0) return;
                    cell.addEventListener('click', () => showDay(key, list));
                });
            }

            function showDay(key, list) {
                const d = new Date(key + 'T00:00:00');
                dayTitle.textContent = d.toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' });
                dayEvents.innerHTML = list.map(e => `
                    <div class="p-3 rounded-xl border border-slate-100 dark:border-slate-700 ${!e.isActive ? 'opacity-50' : ''}">
                        <div class="flex items-center gap-2 mb-1">
                            <span class="font-medium text-slate-800 dark:text-slate-100 text-sm">${e.title}</span>
                            <span class="px-2 py-0.5 rounded-full text-[10px] font-semibold uppercase ${e.courseType === 'CSCA' ? 'bg-purple-100 dark:bg-purple-950 text-purple-700 dark:text-purple-300' : 'bg-sky-100 dark:bg-sky-950 text-sky-700 dark:text-sky-300'}">${e.courseType}</span>
                        </div>
                        <div class="text-xs text-slate-500 dark:text-slate-400 space-y-0.5">
                            ${e.courseTitle !== e.title ? `<div>${e.courseTitle}</div>` : ''}
                            ${e.time ? `<div class="flex items-center gap-1"><i data-lucide="clock" class="w-3 h-3"></i> ${e.time}</div>` : ''}
                            ${e.location ? `<div class="flex items-center gap-1"><i data-lucide="map-pin" class="w-3 h-3"></i> ${e.location}</div>` : ''}
                            ${e.capacity ? `<div class="flex items-center gap-1"><i data-lucide="users" class="w-3 h-3"></i> Capacity ${e.capacity}</div>` : ''}
                            ${e.trainer ? `<div class="flex items-center gap-1"><i data-lucide="user" class="w-3 h-3"></i> ${e.trainer}</div>` : ''}
                        </div>
                    </div>
                `).join('');
                dayPanel.classList.remove('hidden');
                if (window.lucide) lucide.createIcons();
                dayPanel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            }

            document.getElementById('cal-prev').addEventListener('click', () => {
                viewDate.setMonth(viewDate.getMonth() - 1);
                dayPanel.classList.add('hidden');
                render();
            });
            document.getElementById('cal-next').addEventListener('click', () => {
                viewDate.setMonth(viewDate.getMonth() + 1);
                dayPanel.classList.add('hidden');
                render();
            });
            document.getElementById('cal-today').addEventListener('click', () => {
                viewDate = new Date(); viewDate.setDate(1);
                dayPanel.classList.add('hidden');
                render();
            });
            document.getElementById('cal-day-close').addEventListener('click', () => dayPanel.classList.add('hidden'));

            render();
        })();
    </script>
}
