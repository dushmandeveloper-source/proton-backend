@model ExamSchedule
@{
    ViewData["Title"] = string.IsNullOrEmpty(Model.ScheduleName) ? Model.ExamTitle : Model.ScheduleName;
    string CardCls = "bg-white dark:bg-slate-900/60 rounded-[24px] shadow-sm border border-slate-100 dark:border-slate-700 p-6";
    string LabelCls = "text-xs font-semibold text-slate-400 dark:text-slate-500 uppercase tracking-wider";

    bool canEdit = Web_Backend.Classes.Auth.HasPermission(Web_Backend.Classes.PermissionCode.Exams, 'E');
}

<div class="max-w-5xl mx-auto page-enter">
    <div class="mb-6 flex flex-wrap items-start justify-between gap-4">
        <div>
            <a asp-action="Index" class="text-sm text-slate-500 dark:text-slate-400 hover:text-slate-800 dark:hover:text-slate-100 flex items-center gap-1 mb-2">
                <i data-lucide="arrow-left" class="w-4 h-4"></i> Back to Schedules
            </a>
            <div class="flex items-center gap-3">
                <h2 class="text-3xl font-bold text-slate-800 dark:text-slate-100 tracking-tight">@(string.IsNullOrEmpty(Model.ScheduleName) ? Model.ExamTitle : Model.ScheduleName)</h2>
                <span class="px-2 py-0.5 rounded-full text-[10px] font-semibold uppercase @(Model.IsActive == "A" ? "bg-emerald-50 dark:bg-emerald-950 text-emerald-700 dark:text-emerald-300" : "bg-slate-200 dark:bg-slate-700 text-slate-600 dark:text-slate-300")">@Model.StatusLabel</span>
            </div>
            @if (!string.IsNullOrEmpty(Model.ScheduleName))
            {
                <p class="text-slate-500 dark:text-slate-400 mt-1 text-sm">@Model.ExamTitle</p>
            }
        </div>
        @if (canEdit)
        {
            <a asp-action="Index" class="px-4 py-2 rounded-xl font-medium bg-[#7c3aed] text-white hover:bg-[#6d28d9] shadow-sm text-sm flex items-center gap-2">
                <i data-lucide="pencil" class="w-4 h-4"></i> Edit
            </a>
        }
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-6">
        @if (!string.IsNullOrEmpty(Model.BatchName))
        {
            <div class="@CardCls">
                <p class="@LabelCls mb-1">Batch</p>
                <p class="text-slate-800 dark:text-slate-100">@Model.BatchName</p>
            </div>
        }
        <div class="@CardCls">
            <p class="@LabelCls mb-1">Location</p>
            <p class="text-slate-800 dark:text-slate-100">@(string.IsNullOrEmpty(Model.Location) ? "-" : Model.Location)</p>
        </div>
        <div class="@CardCls">
            <p class="@LabelCls mb-1">Capacity</p>
            <p class="text-slate-800 dark:text-slate-100">@(Model.Capacity?.ToString() ?? "-")</p>
        </div>
        <div class="@CardCls">
            <p class="@LabelCls mb-1">Instructors</p>
            <p class="text-slate-800 dark:text-slate-100">@(string.IsNullOrEmpty(Model.InstructorsLabel) ? "-" : Model.InstructorsLabel)</p>
        </div>
    </div>

    <div class="@CardCls mb-6">
        <p class="@LabelCls mb-2">Periods</p>
        @if (!Model.Segments.Any())
        {
            <p class="text-sm text-slate-400 dark:text-slate-500">No periods defined.</p>
        }
        else
        {
            <table class="w-full text-sm">
                <thead>
                    <tr class="text-left text-slate-500 dark:text-slate-400">
                        <th class="py-1.5 font-medium">Dates</th>
                        <th class="py-1.5 font-medium">Days</th>
                        <th class="py-1.5 font-medium">Time</th>
                        <th class="py-1.5 font-medium">Days off</th>
                        <th class="py-1.5 font-medium">Meeting link</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var seg in Model.Segments.OrderBy(s => s.SortOrder))
                    {
                        <tr class="border-t border-slate-50 dark:border-slate-800">
                            <td class="py-1.5 text-slate-800 dark:text-slate-100">@seg.DateRangeText</td>
                            <td class="py-1.5 text-slate-500 dark:text-slate-400">@seg.DaysOfWeekLabel</td>
                            <td class="py-1.5 text-slate-500 dark:text-slate-400">@(string.IsNullOrEmpty(seg.TimeRangeText) ? "-" : seg.TimeRangeText)</td>
                            <td class="py-1.5 text-slate-500 dark:text-slate-400">@(seg.ExceptionCount > 0 ? $"{seg.ExceptionCount} day{(seg.ExceptionCount == 1 ? "" : "s")}" : "-")</td>
                            <td class="py-1.5">
                                @if (string.IsNullOrEmpty(seg.MeetingLink))
                                {
                                    <span class="text-slate-400 dark:text-slate-500">-</span>
                                }
                                else
                                {
                                    <a href="@seg.MeetingLink" target="_blank" rel="noopener" class="text-[#7c3aed] hover:underline inline-flex items-center gap-1">
                                        <i data-lucide="video" class="w-3.5 h-3.5"></i> Join
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>

    @if (!string.IsNullOrEmpty(Model.Notes))
    {
        <div class="@CardCls mb-6">
            <p class="@LabelCls mb-2">Notes</p>
            <p class="text-slate-700 dark:text-slate-200 whitespace-pre-line">@Model.Notes</p>
        </div>
    }
</div>
