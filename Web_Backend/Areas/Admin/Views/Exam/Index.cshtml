@model List<Exam>
@{
    ViewData["Title"] = "Exams";
    var keyW = ViewBag.KeyW as string ?? "";
    var courseId = ViewBag.CourseID as string ?? "";
    var showInactive = ViewBag.ShowInactive as bool? ?? false;
    var courses = ViewBag.Courses as List<Course> ?? new List<Course>();

    bool canAdd = Web_Backend.Classes.Auth.HasPermission(Web_Backend.Classes.PermissionCode.Exams, 'A');
    bool canEdit = Web_Backend.Classes.Auth.HasPermission(Web_Backend.Classes.PermissionCode.Exams, 'E');
    bool canDelete = Web_Backend.Classes.Auth.HasPermission(Web_Backend.Classes.PermissionCode.Exams, 'D');
}

<div class="max-w-6xl mx-auto page-enter">
    <div class="flex flex-col md:flex-row md:items-center justify-between mb-6 gap-4">
        <div>
            <h2 class="text-3xl font-bold text-slate-800 dark:text-slate-100 tracking-tight">Exams</h2>
            <p class="text-slate-500 dark:text-slate-400 mt-2">Standalone exams or ones linked to a course/subject — MCQ and written questions with full math notation support.</p>
        </div>
        @if (canAdd)
        {
            <a asp-action="Add" class="px-4 py-2 rounded-xl font-medium bg-[#7c3aed] text-white hover:bg-[#6d28d9] shadow-sm text-sm flex items-center gap-2 w-fit">
                <i data-lucide="plus" class="w-4 h-4"></i> Add Exam
            </a>
        }
    </div>

    <form method="get" class="flex flex-wrap items-center gap-3 mb-6">
        <div class="relative">
            <i data-lucide="search" class="w-4 h-4 text-slate-400 dark:text-slate-500 absolute left-3 top-1/2 -translate-y-1/2"></i>
            <input type="text" name="KeyW" value="@keyW" placeholder="Search exams..."
                   class="pl-9 pr-4 py-2 rounded-xl border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-800 text-slate-800 dark:text-slate-100 text-sm focus:outline-none focus:border-purple-400 focus:ring-1 focus:ring-purple-400" />
        </div>
        <select name="CourseID" class="px-3 py-2 rounded-xl border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-800 text-sm">
            <option value="">All courses (incl. standalone)</option>
            @foreach (var c in courses)
            {
                <option value="@c.CourseID" selected="@(c.CourseID == courseId)">@c.CourseTitle</option>
            }
        </select>
        <label class="flex items-center gap-2 text-sm text-slate-600 dark:text-slate-300 cursor-pointer">
            <input type="checkbox" name="showInactive" value="true" checked="@showInactive"
                   class="rounded border-slate-300 dark:border-slate-600 text-[#7c3aed] focus:ring-[#7c3aed]" />
            Show deactivated
        </label>
        <button type="submit" class="px-4 py-2 rounded-xl font-medium bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-200 border border-slate-200 dark:border-slate-600 hover:bg-slate-50 dark:hover:bg-slate-700 transition-all text-sm">Filter</button>
    </form>

    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
        @if (!Model.Any())
        {
            <div class="md:col-span-2 xl:col-span-3 bg-white dark:bg-slate-900/60 rounded-[24px] border border-slate-100 dark:border-slate-700 p-12 text-center">
                <p class="text-sm text-slate-400 dark:text-slate-500">No exams yet. Add your first one to get started.</p>
            </div>
        }
        @foreach (var e in Model)
        {
            <div class="bg-white dark:bg-slate-900/60 rounded-[24px] shadow-sm border border-slate-100 dark:border-slate-700 p-5 flex flex-col hover:shadow-md transition-shadow">
                <div class="flex items-start justify-between gap-2 mb-2">
                    <h3 class="font-semibold text-slate-800 dark:text-slate-100 leading-tight">@e.ExamTitle</h3>
                    @if (e.IsActive != "A")
                    {
                        <span class="px-2 py-0.5 rounded-full text-[10px] font-semibold bg-slate-200 dark:bg-slate-700 text-slate-600 dark:text-slate-300 uppercase flex-shrink-0">Deactivated</span>
                    }
                </div>

                <p class="text-xs text-slate-400 dark:text-slate-500 mb-3">
                    @if (e.IsStandalone)
                    {
                        <span class="px-2 py-0.5 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300">Standalone</span>
                    }
                    else
                    {
                        <span>@e.CourseTitle@(string.IsNullOrEmpty(e.SubjectName) ? "" : $" · {e.SubjectName}")</span>
                    }
                </p>

                @if (!string.IsNullOrEmpty(e.Description))
                {
                    <p class="text-sm text-slate-600 dark:text-slate-300 line-clamp-2 mb-4">@e.Description</p>
                }

                <div class="flex flex-wrap gap-2 text-[11px] mt-auto mb-4">
                    <span class="px-2 py-1 rounded-lg bg-slate-50 dark:bg-slate-800 text-slate-600 dark:text-slate-300">@e.QuestionCount questions</span>
                    <span class="px-2 py-1 rounded-lg bg-slate-50 dark:bg-slate-800 text-slate-600 dark:text-slate-300">@e.TotalMarks marks</span>
                    @if (e.DurationMinutes.HasValue)
                    {
                        <span class="px-2 py-1 rounded-lg bg-slate-50 dark:bg-slate-800 text-slate-600 dark:text-slate-300">@e.DurationMinutes min</span>
                    }
                    <span class="px-2 py-1 rounded-lg bg-slate-50 dark:bg-slate-800 text-slate-600 dark:text-slate-300">@e.MaxAttempts attempt(s)</span>
                </div>

                <div class="flex flex-wrap items-center gap-2 pt-4 border-t border-slate-100 dark:border-slate-700">
                    @if (canEdit)
                    {
                        <a asp-action="Edit" asp-route-id="@e.ExamID"
                           class="flex-1 text-center px-3 py-2 rounded-xl text-sm font-medium bg-slate-50 dark:bg-slate-800 text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-700 transition-colors">
                            Edit
                        </a>
                    }
                    @if (canDelete && e.IsActive == "A")
                    {
                        <form method="post" asp-action="Deactivate" asp-route-id="@e.ExamID"
                              data-confirm="This will hide the exam from lists but keep all its data safe. You can restore it later." data-confirm-title="Deactivate exam" data-confirm-label="Deactivate">
                            @Html.AntiForgeryToken()
                            <button type="submit" title="Deactivate" class="p-2 rounded-xl text-slate-400 dark:text-slate-500 hover:text-red-600 dark:hover:text-red-400 hover:bg-slate-100 dark:hover:bg-slate-700 transition-colors">
                                <i data-lucide="archive" class="w-4 h-4"></i>
                            </button>
                        </form>
                    }
                    @if (canDelete && e.IsActive != "A")
                    {
                        <form method="post" asp-action="Activate" asp-route-id="@e.ExamID">
                            @Html.AntiForgeryToken()
                            <button type="submit" title="Activate" class="p-2 rounded-xl text-slate-400 dark:text-slate-500 hover:text-emerald-600 dark:hover:text-emerald-400 hover:bg-slate-100 dark:hover:bg-slate-700 transition-colors">
                                <i data-lucide="rotate-ccw" class="w-4 h-4"></i>
                            </button>
                        </form>
                    }
                    @if (canDelete)
                    {
                        <form method="post" asp-action="DeletePermanently" asp-route-id="@e.ExamID"
                              data-confirm="This will permanently delete this exam and cannot be undone." data-confirm-title="Delete exam permanently" data-confirm-label="Delete Permanently">
                            @Html.AntiForgeryToken()
                            <button type="submit" title="Delete Permanently" class="p-2 rounded-xl text-red-500 dark:text-red-400 border border-red-200 dark:border-red-900/50 hover:bg-red-50 dark:hover:bg-red-950/40 hover:text-red-700 dark:hover:text-red-300 transition-colors">
                                <i data-lucide="trash-2" class="w-4 h-4"></i>
                            </button>
                        </form>
                    }
                </div>
            </div>
        }
    </div>
</div>
