@model ExamDetailViewModel
@{
    ViewData["Title"] = Model.IsNew ? "Add Exam" : "Edit Exam";
    var e = Model.Exam;
    var courses = ViewBag.Courses as List<Course> ?? new List<Course>();
    var subjects = ViewBag.Subjects as List<CourseSubject> ?? new List<CourseSubject>();
    bool canEdit = Web_Backend.Classes.Auth.HasPermission(Web_Backend.Classes.PermissionCode.Exams, Model.IsNew ? 'A' : 'E');
    bool canDelete = Web_Backend.Classes.Auth.HasPermission(Web_Backend.Classes.PermissionCode.Exams, 'D');
}

<div class="max-w-5xl mx-auto page-enter">
    <div class="flex items-center gap-3 mb-6">
        <a asp-action="Index" class="p-2 rounded-xl text-slate-400 dark:text-slate-500 hover:text-slate-700 dark:hover:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-700">
            <i data-lucide="arrow-left" class="w-5 h-5"></i>
        </a>
        <div>
            <h2 class="text-3xl font-bold text-slate-800 dark:text-slate-100 tracking-tight">@ViewData["Title"]</h2>
            @if (!Model.IsNew)
            {
                <p class="text-slate-500 dark:text-slate-400 mt-1 text-sm">@e.ExamTitle</p>
            }
        </div>
    </div>

    <div class="flex gap-2 mb-6 border-b border-slate-100 dark:border-slate-700">
        @if (Model.IsNew)
        {
            <span class="px-4 py-2 text-sm font-medium border-b-2 -mb-px border-[#7c3aed] text-[#7c3aed]">Details</span>
            <span title="Save the exam details first — this tab unlocks afterward."
                  class="px-4 py-2 text-sm font-medium border-b-2 -mb-px border-transparent text-slate-300 dark:text-slate-600 cursor-not-allowed">Questions</span>
        }
        else
        {
            <a asp-action="Edit" asp-route-id="@e.ExamID" asp-route-tab="details"
               class="px-4 py-2 text-sm font-medium border-b-2 -mb-px @(Model.ActiveTab == "details" ? "border-[#7c3aed] text-[#7c3aed]" : "border-transparent text-slate-500 dark:text-slate-400 hover:text-slate-700 dark:hover:text-slate-200")">Details</a>
            <a asp-action="Edit" asp-route-id="@e.ExamID" asp-route-tab="questions"
               class="px-4 py-2 text-sm font-medium border-b-2 -mb-px @(Model.ActiveTab == "questions" ? "border-[#7c3aed] text-[#7c3aed]" : "border-transparent text-slate-500 dark:text-slate-400 hover:text-slate-700 dark:hover:text-slate-200")">Questions</a>
        }
    </div>

    @if (Model.IsNew || Model.ActiveTab == "details")
    {
        <form method="post" asp-action="Save" class="bg-white dark:bg-slate-900/60 rounded-[24px] shadow-sm border border-slate-100 dark:border-slate-700 p-6 space-y-5">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Exam.ExamID" />

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="flex items-start gap-2 text-sm px-4 py-3 rounded-xl bg-red-50 dark:bg-red-950 text-red-700 dark:text-red-300">
                    <i data-lucide="alert-triangle" class="w-4 h-4 flex-shrink-0 mt-0.5"></i>
                    <ul class="list-disc list-inside">
                        @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <li>@err.ErrorMessage</li>
                        }
                    </ul>
                </div>
            }

            <div>
                <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Exam Title <span class="text-red-600">*</span></label>
                <input asp-for="Exam.ExamTitle" required class="w-full px-3 py-2 rounded-xl border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-800 text-sm" />
                <span asp-validation-for="Exam.ExamTitle" class="text-xs text-red-600"></span>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Course <span class="text-slate-400 font-normal">(optional — leave blank for a standalone exam)</span></label>
                    <select asp-for="Exam.CourseID" id="course-select" class="w-full px-3 py-2 rounded-xl border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-800 text-sm">
                        <option value="">-- Standalone --</option>
                        @foreach (var c in courses)
                        {
                            <option value="@c.CourseID" selected="@(c.CourseID == e.CourseID)">@c.CourseTitle</option>
                        }
                    </select>
                </div>
                <div>
                    <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Subject <span class="text-slate-400 font-normal">(optional)</span></label>
                    <select asp-for="Exam.SubjectID" id="subject-select" class="w-full px-3 py-2 rounded-xl border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-800 text-sm">
                        <option value="">-- None --</option>
                        @foreach (var s in subjects)
                        {
                            <option value="@s.SubjectID" selected="@(s.SubjectID == e.SubjectID)">@s.SubjectName</option>
                        }
                    </select>
                </div>
            </div>

            <div>
                <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Description</label>
                <textarea asp-for="Exam.Description" rows="2" class="w-full px-3 py-2 rounded-xl border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-800 text-sm"></textarea>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Duration (minutes)</label>
                    <input asp-for="Exam.DurationMinutes" type="number" min="1" class="w-full px-3 py-2 rounded-xl border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-800 text-sm" />
                </div>
                <div>
                    <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Max Attempts</label>
                    <input asp-for="Exam.MaxAttempts" type="number" min="1" class="w-full px-3 py-2 rounded-xl border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-800 text-sm" />
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Passing Marks</label>
                    <input asp-for="Exam.PassingMarks" type="number" step="0.01" min="0" class="w-full px-3 py-2 rounded-xl border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-800 text-sm" />
                </div>
                <div>
                    <label class="block text-sm font-medium text-slate-700 dark:text-slate-300 mb-1">Passing Percentage</label>
                    <input asp-for="Exam.PassingPercentage" type="number" step="0.01" min="0" max="100" class="w-full px-3 py-2 rounded-xl border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-800 text-sm" />
                </div>
            </div>

            @if (!Model.IsNew)
            {
                <p class="text-xs text-slate-400 dark:text-slate-500">Total marks: <strong class="text-slate-600 dark:text-slate-300">@e.TotalMarks</strong> (calculated automatically from the Questions tab)</p>
                <div class="flex items-center gap-2">
                    <input type="checkbox" name="IsActive" value="A" checked="@(e.IsActive == "A")"
                           onchange="this.value = this.checked ? 'A' : 'I'"
                           class="rounded border-slate-300 dark:border-slate-600 text-[#7c3aed] focus:ring-[#7c3aed]" />
                    <label class="text-sm text-slate-600 dark:text-slate-300">Active</label>
                </div>
            }

            <div class="flex justify-end gap-2 pt-2">
                <a asp-action="Index" class="px-4 py-2 rounded-xl font-medium bg-slate-50 dark:bg-slate-800 text-slate-600 dark:text-slate-300 text-sm">Cancel</a>
                @if (canEdit)
                {
                    <button type="submit" class="px-4 py-2 rounded-xl font-medium bg-[#7c3aed] text-white hover:bg-[#6d28d9] text-sm flex items-center gap-2">
                        @if (Model.IsNew)
                        {
                            <span>Save &amp; Continue to Questions</span>
                            <i data-lucide="arrow-right" class="w-4 h-4"></i>
                        }
                        else
                        {
                            <span>Save</span>
                        }
                    </button>
                }
            </div>
        </form>

        <script>
            (function () {
                const courseSelect = document.getElementById('course-select');
                const subjectSelect = document.getElementById('subject-select');
                if (!courseSelect || !subjectSelect) return;

                courseSelect.addEventListener('change', async () => {
                    subjectSelect.innerHTML = '<option value="">-- None --</option>';
                    if (!courseSelect.value) return;
                    try {
                        const res = await fetch('@Url.Action("GetSubjects", "Exam")?courseId=' + encodeURIComponent(courseSelect.value));
                        const subjects = await res.json();
                        subjects.forEach(s => {
                            const opt = document.createElement('option');
                            opt.value = s.subjectID;
                            opt.textContent = s.subjectName;
                            subjectSelect.appendChild(opt);
                        });
                    } catch { /* leave subject list empty on error */ }
                });
            })();
        </script>
    }
    else if (Model.ActiveTab == "questions")
    {
        <partial name="~/Views/Shared/Exam/_QuestionEditor.cshtml" model="Model"
                 view-data='new ViewDataDictionary(ViewData) { ["QCtrl"] = "Exam", ["CanEdit"] = canEdit, ["CanDelete"] = canDelete }' />
    }
</div>
