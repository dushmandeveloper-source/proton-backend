        <script>
            const examId = '@e.ExamID';
            const antiForgeryToken = document.querySelector('#af-token-holder input[name="__RequestVerificationToken"]')?.value || '';

            // Question and option text are plain auto-growing textareas: a
            // single-line MathLive field scrolled sideways on long questions
            // and re-serialised plain text as math (spaces dropped, "m/s²"
            // became "m/s^2"). Maths goes in via the Equation popup below as
            // \(...\), which exam-math.js renders with KaTeX.
            function autoGrow(el) {
                el.style.height = 'auto';
                el.style.height = el.scrollHeight + 'px';
            }
            document.addEventListener('input', e => { if (e.target.classList?.contains('eq-text')) autoGrow(e.target); });

            // Chemistry tab: mhchem syntax (KaTeX contrib/mhchem.min.js), stored as \(\ce{...}\).
            let eqTarget = null, eqSelStart = 0, eqSelEnd = 0, eqTab = 'math';
            function setEquationTab(tab) {
                eqTab = tab;
                document.querySelectorAll('.eq-tab').forEach(b => {
                    const on = b.dataset.eqTab === tab;
                    b.classList.toggle('bg-white', on); b.classList.toggle('dark:bg-slate-700', on); b.classList.toggle('shadow-sm', on);
                    b.classList.toggle('text-[#7c3aed]', on); b.classList.toggle('text-slate-500', !on);
                });
                document.getElementById('eq-pane-math').classList.toggle('hidden', tab !== 'math');
                document.getElementById('eq-pane-chem').classList.toggle('hidden', tab !== 'chem');
                if (tab !== 'math' && window.mathVirtualKeyboard) mathVirtualKeyboard.hide();
                renderEquationPreview();
                setTimeout(() => document.getElementById(tab === 'chem' ? 'eq-chem' : 'eq-field').focus(), 50);
            }
            function currentEquationLatex() {
                if (eqTab === 'chem') {
                    const ce = (document.getElementById('eq-chem').value || '').trim();
                    return ce ? '\\ce{' + ce + '}' : '';
                }
                return (document.getElementById('eq-field').value || '').trim();
            }
            function openEquation(target) {
                eqTarget = target;
                eqSelStart = target.selectionStart ?? target.value.length;
                eqSelEnd = target.selectionEnd ?? eqSelStart;
                document.getElementById('eq-field').value = '';
                document.getElementById('eq-chem').value = '';
                document.getElementById('eq-modal').classList.remove('hidden');
                setEquationTab(eqTab);
            }
            function closeEquation() {
                document.getElementById('eq-modal').classList.add('hidden');
                if (window.mathVirtualKeyboard) mathVirtualKeyboard.hide();
                eqTarget?.focus();
            }
            function insertEquation() {
                const latex = currentEquationLatex();
                if (latex && eqTarget) {
                    const v = eqTarget.value, snippet = '\\(' + latex + '\\)';
                    eqTarget.value = v.slice(0, eqSelStart) + snippet + v.slice(eqSelEnd);
                    const caret = eqSelStart + snippet.length;
                    eqTarget.setSelectionRange(caret, caret);
                    autoGrow(eqTarget);
                    renderPreview();
                }
                closeEquation();
            }
            function renderEquationPreview() {
                const latex = currentEquationLatex();
                const out = document.getElementById('eq-preview');
                out.classList.toggle('text-slate-400', !latex.trim());
                if (!latex.trim()) { out.textContent = 'Your equation will appear here'; return; }
                renderMixedLatex('\\(' + latex + '\\)', out);
            }

            // renderMixedLatex lives in wwwroot/js/exam-math.js (shared with
            // the student exam and grading pages).

            function renderKatex() {
                if (typeof katex === 'undefined') return;
                document.querySelectorAll('.katex-render').forEach(el => {
                    const latex = el.dataset.latex || '';
                    if (!latex || el.dataset.rendered === '1') return;
                    renderMixedLatex(latex, el);
                    el.dataset.rendered = '1';
                });
                if (window.lucide) lucide.createIcons();
            }
            // katex.min.js loads via a deferred <script> in _AdminLayout.cshtml,
            // which runs after the document is parsed but before
            // DOMContentLoaded — calling renderKatex() inline here (before that
            // point) would find `katex` undefined and silently fall back to
            // raw LaTeX text for every question/option.
            document.addEventListener('DOMContentLoaded', () => renderKatex());

            // ---------- Add-option-row helper (question modal) ----------
            function addOptionRow(text, correct) {
                const div = document.createElement('div');
                div.className = 'q-option-row flex items-start gap-2';
                div.innerHTML = `<div class="flex-1 min-w-0 flex items-start rounded-lg border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-800 focus-within:border-[#7c3aed] focus-within:ring-2 focus-within:ring-[#7c3aed]/20 transition">
                        <textarea rows="1" placeholder="Option text" oninput="renderPreview()"
                                  class="q-option-field eq-text flex-1 min-w-0 resize-none bg-transparent px-3 py-2 text-sm leading-relaxed text-slate-800 dark:text-slate-100 placeholder:text-slate-400 focus:outline-none"></textarea>
                        <button type="button" onclick="openEquation(this.previousElementSibling)" title="Insert an equation"
                                class="m-1 p-1.5 rounded-md text-slate-400 hover:text-[#7c3aed] hover:bg-[#ede7fc] dark:hover:bg-slate-700 transition"><i data-lucide="sigma" class="w-4 h-4"></i></button>
                    </div>
                    <label class="flex items-center gap-1 mt-2.5 text-xs text-slate-500 dark:text-slate-400">
                        <input type="radio" name="q-option-correct" class="q-option-correct" onchange="renderPreview()" /> Correct
                    </label>
                    <button type="button" onclick="this.closest('.q-option-row').remove(); renderPreview();" class="mt-2.5 text-slate-400 hover:text-red-600 dark:hover:text-red-400"><i data-lucide="x" class="w-4 h-4"></i></button>`;
                document.getElementById('q-option-rows').appendChild(div);
                if (window.lucide) lucide.createIcons();
                if (text !== undefined) {
                    div.querySelector('.q-option-field').value = text;
                    if (correct) div.querySelector('.q-option-correct').checked = true;
                    renderPreview();
                }
            }

            function onQuestionTypeChange() {
                const isMCQ = document.querySelector('.q-type-radio[value="MCQ"]').checked;
                document.getElementById('q-mcq-options').style.display = isMCQ ? '' : 'none';
            }

            // ---------- Live preview ----------
            function renderPreview() {
                document.querySelectorAll('#question-modal .eq-text').forEach(autoGrow);
                const isMCQ = document.querySelector('.q-type-radio[value="MCQ"]').checked;
                const badge = document.getElementById('preview-type-badge');
                badge.textContent = isMCQ ? 'MCQ' : 'Written';
                badge.className = 'px-2 py-0.5 rounded-full text-[10px] font-semibold uppercase ' +
                    (isMCQ ? 'bg-sky-100 dark:bg-sky-950 text-sky-700 dark:text-sky-300' : 'bg-amber-100 dark:bg-amber-950 text-amber-700 dark:text-amber-300');

                const marks = document.getElementById('q-marks').value || '1';
                document.getElementById('preview-marks').textContent = marks + ' marks';

                const qLatex = document.getElementById('q-field').value || '';
                const qPreview = document.getElementById('preview-question');
                if (qLatex.trim()) {
                    renderMixedLatex(qLatex, qPreview);
                } else {
                    qPreview.textContent = 'Start typing your question…';
                }

                // Media preview
                const mediaWrap = document.getElementById('preview-media');
                mediaWrap.innerHTML = '';
                const imgFile = document.getElementById('q-image-file').files[0];
                const audFile = document.getElementById('q-audio-file').files[0];
                const vidFile = document.getElementById('q-video-file').files[0];
                if (imgFile) { const img = document.createElement('img'); img.src = URL.createObjectURL(imgFile); img.className = 'max-h-32 rounded-lg border border-slate-200 dark:border-slate-700'; mediaWrap.appendChild(img); }
                else if (!document.getElementById('q-image-current').classList.contains('hidden')) { mediaWrap.appendChild(document.getElementById('q-image-current').cloneNode()); }
                if (audFile) { const aud = document.createElement('audio'); aud.controls = true; aud.src = URL.createObjectURL(audFile); aud.className = 'w-full max-w-sm'; mediaWrap.appendChild(aud); }
                if (vidFile) { const vid = document.createElement('video'); vid.controls = true; vid.src = URL.createObjectURL(vidFile); vid.className = 'max-h-32 rounded-lg'; mediaWrap.appendChild(vid); }

                // Options / written preview
                const optionsWrap = document.getElementById('preview-options');
                const writtenWrap = document.getElementById('preview-written');
                optionsWrap.innerHTML = '';
                if (isMCQ) {
                    writtenWrap.classList.add('hidden');
                    document.querySelectorAll('.q-option-row').forEach(row => {
                        const latex = row.querySelector('.q-option-field').value || '';
                        if (!latex.trim()) return;
                        const isCorrect = row.querySelector('.q-option-correct').checked;
                        const line = document.createElement('div');
                        line.className = 'flex items-center gap-2 text-sm';
                        const iconSpan = document.createElement('span');
                        iconSpan.innerHTML = isCorrect
                            ? '<i data-lucide="check-circle-2" class="w-4 h-4 text-emerald-500"></i>'
                            : '<i data-lucide="circle" class="w-4 h-4 text-slate-300 dark:text-slate-600"></i>';
                        const textSpan = document.createElement('span');
                        renderMixedLatex(latex, textSpan);
                        line.appendChild(iconSpan); line.appendChild(textSpan);
                        optionsWrap.appendChild(line);
                    });
                    if (window.lucide) lucide.createIcons();
                } else {
                    writtenWrap.classList.remove('hidden');
                }
            }

            // ---------- Modal open/close ----------
            function resetQuestionForm() {
                document.getElementById('q-id').value = '';
                document.getElementById('q-field').value = '';
                document.getElementById('q-marks').value = '1';
                document.getElementById('q-sort').value = (document.querySelectorAll('#questions-list .border').length || 0) + 1;
                document.querySelector('.q-type-radio[value="MCQ"]').checked = true;
                document.getElementById('q-option-rows').innerHTML = '';
                ['image', 'audio', 'video'].forEach(kind => {
                    document.getElementById(`q-${kind}-file`).value = '';
                    const cur = document.getElementById(`q-${kind}-current`);
                    cur.classList.add('hidden');
                    cur.removeAttribute('src');
                });
                addOptionRow(); addOptionRow();
                onQuestionTypeChange();
            }

            async function openQuestionModal(questionId) {
                resetQuestionForm();
                document.getElementById('question-modal-title').textContent = questionId ? 'Edit Question' : 'Add Question';

                if (questionId) {
                    try {
                        const res = await fetch(`@Url.Action("GetQuestion", "Exam")?id=${encodeURIComponent(questionId)}`);
                        const q = await res.json();
                        document.getElementById('q-id').value = q.questionID;
                        document.getElementById('q-field').value = q.questionTextLatex || '';
                        document.getElementById('q-marks').value = q.marks || 1;
                        document.getElementById('q-sort').value = q.sortOrder || 1;
                        document.querySelector(`.q-type-radio[value="${q.questionType}"]`).checked = true;
                        onQuestionTypeChange();

                        if (q.imageURL) { const el = document.getElementById('q-image-current'); el.src = q.imageURL; el.classList.remove('hidden'); }
                        if (q.audioURL) { const el = document.getElementById('q-audio-current'); el.src = q.audioURL; el.classList.remove('hidden'); }
                        if (q.videoURL) { const el = document.getElementById('q-video-current'); el.src = q.videoURL; el.classList.remove('hidden'); }

                        document.getElementById('q-option-rows').innerHTML = '';
                        (q.options || []).forEach(o => addOptionRow(o.optionTextLatex, o.isCorrect));
                        if (!q.options || q.options.length === 0) { addOptionRow(); addOptionRow(); }
                    } catch {
                        showToast('Could not load question.', 'error');
                    }
                }

                document.getElementById('question-modal').classList.remove('hidden');
                setTimeout(renderPreview, 50);
            }

            function closeQuestionModal() {
                document.getElementById('question-modal').classList.add('hidden');
            }

            async function saveQuestionModal() {
                const isMCQ = document.querySelector('.q-type-radio[value="MCQ"]').checked;
                const qLatex = document.getElementById('q-field').value || '';
                if (!qLatex.trim()) { showToast('Question text is required.', 'error'); return; }

                const fd = new FormData();
                fd.append('__RequestVerificationToken', antiForgeryToken);
                fd.append('ExamID', examId);
                fd.append('QuestionID', document.getElementById('q-id').value || '');
                fd.append('QuestionType', isMCQ ? 'MCQ' : 'Written');
                fd.append('QuestionTextLatex', qLatex);
                fd.append('Marks', document.getElementById('q-marks').value || '1');
                fd.append('SortOrder', document.getElementById('q-sort').value || '1');

                const imgFile = document.getElementById('q-image-file').files[0];
                const audFile = document.getElementById('q-audio-file').files[0];
                const vidFile = document.getElementById('q-video-file').files[0];
                if (imgFile) fd.append('imageFile', imgFile);
                if (audFile) fd.append('audioFile', audFile);
                if (vidFile) fd.append('videoFile', vidFile);

                if (isMCQ) {
                    const options = [...document.querySelectorAll('.q-option-row')].map(row => ({
                        text: row.querySelector('.q-option-field').value || '',
                        correct: row.querySelector('.q-option-correct').checked
                    })).filter(o => o.text.trim());
                    if (options.length < 2) { showToast('Add at least two options.', 'error'); return; }
                    if (!options.some(o => o.correct)) { showToast('Mark one option as correct.', 'error'); return; }
                    fd.append('OptionsJson', JSON.stringify(options));
                }

                try {
                    const res = await fetch('@Url.Action("SaveQuestion", "Exam")', { method: 'POST', body: fd });
                    const d = await res.json();
                    showToast(d.message, d.success ? 'success' : 'error');
                    if (d.success) {
                        closeQuestionModal();
                        setTimeout(() => location.reload(), 400);
                    }
                } catch {
                    showToast('Could not save question.', 'error');
                }
            }

            async function deleteQuestion(id) {
                if (!confirm('Delete this question?')) return;
                try {
                    const fd = new FormData();
                    fd.append('__RequestVerificationToken', antiForgeryToken);
                    fd.append('id', id);
                    const res = await fetch('@Url.Action("DeleteQuestion", "Exam")', { method: 'POST', body: fd });
                    const d = await res.json();
                    showToast(d.message, d.success ? 'success' : 'error');
                    if (d.success) setTimeout(() => location.reload(), 300);
                } catch {
                    showToast('Could not delete question.', 'error');
                }
            }

            document.getElementById('question-modal').addEventListener('click', (e) => {
                if (e.target === e.currentTarget) closeQuestionModal();
            });
        </script>
    }
</div>
