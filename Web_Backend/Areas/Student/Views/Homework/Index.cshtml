@model List<Web_Backend.Areas.Admin.Models.LectureMaterial>
@{
    ViewData["Title"] = "Homework";
    bool restricted = ViewBag.Restricted as bool? ?? false;
}

<div class="max-w-4xl mx-auto space-y-6 page-enter">
    <div>
        <h2 class="text-2xl font-bold text-slate-800 dark:text-slate-100 tracking-tight">Homework</h2>
        <p class="text-slate-500 dark:text-slate-400 text-sm mt-1">Homework files your lecturers have posted, across all your enrolled courses.</p>
    </div>

    <div class="bg-white dark:bg-slate-900/60 rounded-[24px] shadow-sm border border-slate-100 dark:border-slate-700 overflow-hidden">
        @if (restricted)
        {
            <div class="p-10 text-center">
                <p class="text-sm text-slate-400 dark:text-slate-500">Your account is still being verified. Homework unlocks once an administrator verifies your account.</p>
            </div>
        }
        else if (Model.Count == 0)
        {
            <div class="p-10 text-center">
                <p class="text-sm text-slate-400 dark:text-slate-500">No homework has been posted for your courses yet.</p>
            </div>
        }
        else
        {
            <div class="divide-y divide-slate-100 dark:divide-slate-700">
                @foreach (var m in Model)
                {
                    <div class="p-4 px-6 flex items-center justify-between gap-4">
                        <div class="flex items-center gap-3 min-w-0">
                            <div class="p-2 rounded-lg bg-slate-50 dark:bg-slate-800 flex-shrink-0">
                                <i data-lucide="@(m.FileType == "Video" ? "video" : m.FileType == "Image" ? "image" : "file-text")" class="w-4 h-4 text-slate-500 dark:text-slate-400"></i>
                            </div>
                            <div class="min-w-0">
                                <div class="flex items-center gap-2 flex-wrap">
                                    <p class="text-sm font-medium text-slate-800 dark:text-slate-100 truncate">@m.Title</p>
                                    <span class="px-2 py-0.5 rounded-full text-xs font-medium bg-amber-50 dark:bg-amber-950 text-amber-700 dark:text-amber-300 flex-shrink-0">
                                        Homework
                                    </span>
                                </div>
                                <p class="text-xs text-slate-400 dark:text-slate-500 truncate">@m.CourseTitle &middot; @m.MaterialDate.ToString("MMM d, yyyy") &middot; @m.FileType</p>
                            </div>
                        </div>
                        <a href="@m.FileURL" target="_blank" rel="noopener"
                           class="px-3 py-1.5 rounded-lg font-medium text-xs bg-slate-50 dark:bg-slate-800 text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-700 transition-colors flex-shrink-0">
                            View
                        </a>
                    </div>
                }
            </div>
        }
    </div>
</div>
