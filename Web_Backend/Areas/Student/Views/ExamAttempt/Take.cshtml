@using Web_Backend.Areas.Admin.Models
@{
    ViewBag.Title = "Take Exam";
    var attempt = (ExamAttempt)ViewBag.Attempt;
    var answers = (List<ExamAttemptAnswer>)ViewBag.Answers;
    var optionsByQuestion = ViewBag.OptionsByQuestion as Dictionary<string, List<ExamQuestionOption>>;
    var ordered = answers.OrderBy(a => a.SortOrder).ToList();
}

<div class="max-w-3xl mx-auto space-y-6 page-enter">

    <div id="streamLossModal" class="hidden fixed inset-0 z-50 bg-slate-950/90 flex items-center justify-center p-6">
        <div class="max-w-md w-full bg-white dark:bg-slate-900 rounded-[24px] shadow-lg p-6 space-y-4 text-center">
            <div class="mx-auto w-12 h-12 rounded-full bg-red-50 dark:bg-red-950 flex items-center justify-center">
                <i data-lucide="video-off" class="w-6 h-6 text-red-600 dark:text-red-300"></i>
            </div>
            <h2 class="font-semibold text-lg text-slate-800 dark:text-slate-100">Camera or Screen Share Stopped</h2>
            <p id="streamLossMessage" class="text-sm text-slate-600 dark:text-slate-300"></p>
            <p class="text-xs text-amber-600 dark:text-amber-400">
                Your exam timer keeps running while this is shown. Restore access below before time runs out.
            </p>
            <p id="streamLossCountdown" class="text-sm font-semibold text-slate-800 dark:text-slate-100"></p>
            <button type="button" id="restoreStreamBtn"
                    class="w-full px-6 py-3 rounded-xl font-medium text-sm bg-indigo-600 text-white hover:bg-indigo-700 shadow-sm transition-all">
                Restore Camera &amp; Screen Share
            </button>
        </div>
    </div>

    @* ---------- Phase 3: violation strike warning modal ---------- *@
    <div id="violationWarningModal" class="hidden fixed inset-0 z-50 bg-slate-950/90 flex items-center justify-center p-6">
        <div class="max-w-md w-full bg-white dark:bg-slate-900 rounded-[24px] shadow-lg p-6 space-y-4 text-center">
            <div class="mx-auto w-12 h-12 rounded-full bg-amber-50 dark:bg-amber-950 flex items-center justify-center">
                <i data-lucide="triangle-alert" class="w-6 h-6 text-amber-600 dark:text-amber-300"></i>
            </div>
            <h2 class="font-semibold text-lg text-slate-800 dark:text-slate-100">Warning: Exam Rule Broken</h2>
            <p id="violationWarningMessage" class="text-sm text-slate-600 dark:text-slate-300"></p>
            <p id="violationWarningCount" class="text-sm font-semibold text-amber-600 dark:text-amber-400"></p>
            <button type="button" id="violationWarningDismissBtn"
                    class="w-full px-6 py-3 rounded-xl font-medium text-sm bg-indigo-600 text-white hover:bg-indigo-700 shadow-sm transition-all">
                I Understand
            </button>
        </div>
    </div>

    <div id="violationTerminatedModal" class="hidden fixed inset-0 z-50 bg-slate-950/95 flex items-center justify-center p-6">
        <div class="max-w-md w-full bg-white dark:bg-slate-900 rounded-[24px] shadow-lg p-6 space-y-4 text-center">
            <div class="mx-auto w-12 h-12 rounded-full bg-red-50 dark:bg-red-950 flex items-center justify-center">
                <i data-lucide="circle-x" class="w-6 h-6 text-red-600 dark:text-red-300"></i>
            </div>
            <h2 class="font-semibold text-lg text-slate-800 dark:text-slate-100">Exam Ended</h2>
            <p class="text-sm text-slate-600 dark:text-slate-300">
                This exam was ended after a third rule violation. Your answers have been submitted as they were.
            </p>
        </div>
    </div>

    @* Camera and screen-share are requested here, on entering the exam --
       NOT on the Start/rules page. Requesting them earlier and navigating
       here would force a second screen-share prompt anyway (a browser's
       screen-share grant is tied to the exact page that requested it and
       cannot carry over a navigation), so this is the one and only place
       either stream is ever requested. A one-time notice, shown before the
       browser's pickers fire, sets expectations for both. *@
    <div id="permissionIntroModal" class="fixed inset-0 z-50 bg-slate-950/90 flex items-center justify-center p-6">
        <div class="max-w-md w-full bg-white dark:bg-slate-900 rounded-[24px] shadow-lg p-6 space-y-4 text-center">
            <div class="mx-auto w-12 h-12 rounded-full bg-indigo-50 dark:bg-indigo-950 flex items-center justify-center">
                <i data-lucide="video" class="w-6 h-6 text-indigo-600 dark:text-indigo-300"></i>
            </div>
            <h2 class="font-semibold text-lg text-slate-800 dark:text-slate-100">Camera &amp; Screen Required</h2>
            <p class="text-sm text-slate-600 dark:text-slate-300">
                This exam requires your camera and your entire screen to be shared for the whole attempt.
                Nothing is recorded, saved, or sent anywhere &mdash; the small previews stay local to this browser tab.
            </p>
            <p class="text-xs text-slate-500 dark:text-slate-400">
                Your browser will ask for camera access, then ask you to choose a screen to share &mdash; choose
                <strong>Entire Screen</strong>, not a window or tab.
            </p>
            <button type="button" id="continueToPermissionsBtn"
                    class="w-full px-6 py-3 rounded-xl font-medium text-sm bg-indigo-600 text-white hover:bg-indigo-700 shadow-sm transition-all">
                Continue
            </button>
        </div>
    </div>

    @* ---------- Small always-visible camera/screen preview dock, bottom-right ---------- *@
    <div id="monitorDock" class="fixed bottom-4 right-4 z-40 flex gap-2">
        <div class="space-y-1">
            <div class="relative rounded-xl overflow-hidden bg-slate-900 border-2 border-slate-200 dark:border-slate-700 shadow-lg w-[130px] h-[98px]">
                <video id="dockCameraPreview" class="w-full h-full object-cover" autoplay playsinline muted></video>
                <span id="dockCameraLiveBadge" class="hidden absolute top-1 right-1 inline-flex items-center gap-1 px-1.5 py-0.5 rounded-full text-[9px] font-semibold uppercase tracking-wide bg-red-50/90 dark:bg-red-950/90 text-red-600 dark:text-red-300">
                    <span class="w-1.5 h-1.5 rounded-full bg-red-500 animate-pulse"></span> Live
                </span>
            </div>
            <p class="text-center text-[10px] font-medium text-slate-500 dark:text-slate-400">Camera</p>
        </div>
        <div class="space-y-1">
            <div class="relative rounded-xl overflow-hidden bg-slate-900 border-2 border-slate-200 dark:border-slate-700 shadow-lg w-[130px] h-[98px]">
                <video id="dockScreenPreview" class="w-full h-full object-cover" autoplay playsinline muted></video>
                <span id="dockScreenLiveBadge" class="hidden absolute top-1 right-1 inline-flex items-center gap-1 px-1.5 py-0.5 rounded-full text-[9px] font-semibold uppercase tracking-wide bg-red-50/90 dark:bg-red-950/90 text-red-600 dark:text-red-300">
                    <span class="w-1.5 h-1.5 rounded-full bg-red-500 animate-pulse"></span> Live
                </span>
            </div>
            <p class="text-center text-[10px] font-medium text-slate-500 dark:text-slate-400">Screen</p>
        </div>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="rounded-[20px] border border-red-100 dark:border-red-900 bg-red-50 dark:bg-red-950 p-4 flex items-center gap-3">
            <i data-lucide="circle-x" class="w-5 h-5 text-red-600 dark:text-red-300 flex-shrink-0"></i>
            <p class="text-sm text-red-700 dark:text-red-300">@TempData["ErrorMessage"]</p>
        </div>
    }

    <div class="bg-white dark:bg-slate-900/60 rounded-[24px] shadow-sm border border-slate-100 dark:border-slate-700 p-6 flex items-center justify-between gap-4 sticky top-4 z-10">
        <div>
            <h1 class="text-xl font-bold text-slate-800 dark:text-slate-100">@attempt.ExamTitle</h1>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Answers save automatically as you go &middot; you can skip and come back before submitting</p>
        </div>
        <div id="examTimer" class="px-4 py-2 rounded-xl bg-amber-50 dark:bg-amber-950 text-amber-700 dark:text-amber-300 font-bold text-sm flex-shrink-0"
             data-expires="@attempt.ExpiresDate.ToString("o")"></div>
    </div>

    @* ---------- Question palette: jump to any question, shows answered/unanswered ---------- *@
    <div class="bg-white dark:bg-slate-900/60 rounded-[24px] shadow-sm border border-slate-100 dark:border-slate-700 p-5">
        <div class="flex flex-wrap gap-2">
            @for (var i = 0; i < ordered.Count; i++)
            {
                var ans = ordered[i];
                var isAnswered = ans.IsMCQ ? !string.IsNullOrEmpty(ans.SelectedOptionID) : !string.IsNullOrEmpty(ans.WrittenAnswerText);
                <button type="button" class="palette-btn w-9 h-9 rounded-lg text-xs font-semibold border transition-colors @(isAnswered ? "bg-emerald-50 dark:bg-emerald-950 border-emerald-200 dark:border-emerald-800 text-emerald-700 dark:text-emerald-300" : "bg-slate-50 dark:bg-slate-800/60 border-slate-200 dark:border-slate-700 text-slate-500 dark:text-slate-400")"
                        data-index="@i" data-question-id="@ans.QuestionID">
                    @(i + 1)
                </button>
            }
        </div>
        <div class="flex items-center gap-4 mt-3 text-xs text-slate-400 dark:text-slate-500">
            <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded bg-emerald-50 dark:bg-emerald-950 border border-emerald-200 dark:border-emerald-800"></span> Answered</span>
            <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded bg-slate-50 dark:bg-slate-800/60 border border-slate-200 dark:border-slate-700"></span> Skipped / not answered</span>
        </div>
    </div>

    <form id="examForm" asp-action="Submit" asp-controller="ExamAttempt" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="attemptId" value="@attempt.AttemptID" />

        @for (var i = 0; i < ordered.Count; i++)
        {
            var ans = ordered[i];
            <div class="exam-question-page @(i == 0 ? "" : "hidden")" data-index="@i">
                <div class="exam-question bg-white dark:bg-slate-900/60 rounded-[20px] shadow-sm border border-slate-100 dark:border-slate-700 p-6"
                     data-question-id="@ans.QuestionID" data-attempt-id="@attempt.AttemptID">
                    <div class="flex items-center justify-between mb-3">
                        <div class="flex items-center gap-2">
                            <span class="inline-flex px-2 py-0.5 rounded-full text-[10px] font-semibold uppercase tracking-wide @(ans.IsMCQ ? "bg-indigo-50 dark:bg-indigo-950 text-indigo-600 dark:text-indigo-300" : "bg-amber-50 dark:bg-amber-950 text-amber-600 dark:text-amber-300")">
                                @(ans.IsMCQ ? "MCQ" : "Written")
                            </span>
                            <span class="text-xs text-slate-400 dark:text-slate-500">@ans.Marks.ToString("0.##") marks</span>
                        </div>
                        <span class="text-xs font-medium text-slate-400 dark:text-slate-500">Question @(i + 1) of @ordered.Count</span>
                    </div>
                    <p class="text-sm font-medium text-slate-800 dark:text-slate-100 mb-4">@ans.QuestionTextLatex</p>

                    @if (ans.IsMCQ)
                    {
                        var options = optionsByQuestion != null && optionsByQuestion.TryGetValue(ans.QuestionID, out var opts) ? opts : new List<ExamQuestionOption>();
                        <div class="space-y-2">
                            @foreach (var opt in options.OrderBy(o => o.SortOrder))
                            {
                                <label class="flex items-center gap-3 px-4 py-3 rounded-xl border border-slate-100 dark:border-slate-700 bg-slate-50 dark:bg-slate-800/60 cursor-pointer hover:border-indigo-200 dark:hover:border-indigo-700 transition-colors">
                                    <input type="radio" name="mcq-@ans.QuestionID" value="@opt.OptionID" class="mcq-option-input w-4 h-4 accent-indigo-600"
                                           data-question-id="@ans.QuestionID" @(opt.OptionID == ans.SelectedOptionID ? "checked" : "") />
                                    <span class="text-sm text-slate-700 dark:text-slate-200">@opt.OptionTextLatex</span>
                                </label>
                            }
                        </div>
                    }
                    else
                    {
                        <textarea class="written-answer-input w-full rounded-xl border border-slate-100 dark:border-slate-700 bg-slate-50 dark:bg-slate-800/60 px-4 py-3 text-sm text-slate-800 dark:text-slate-100 focus:outline-none focus:ring-2 focus:ring-amber-300 dark:focus:ring-amber-700"
                                  rows="6" data-question-id="@ans.QuestionID" placeholder="Type your answer here...">@ans.WrittenAnswerText</textarea>
                    }
                </div>
            </div>
        }

        <div class="flex items-center justify-between pt-4">
            <button type="button" id="backBtn" class="px-5 py-2.5 rounded-xl font-medium text-sm bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors disabled:opacity-40 disabled:cursor-not-allowed">
                Back
            </button>

            <div class="flex items-center gap-3">
                <p id="submitBlockedMsg" class="text-xs text-amber-600 dark:text-amber-400 hidden">Answer every question before submitting.</p>
                <button type="button" id="nextBtn" class="px-5 py-2.5 rounded-xl font-medium text-sm bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors">
                    Next
                </button>
                <button type="submit" id="submitBtn" class="px-6 py-3 rounded-xl font-medium text-sm bg-[#7c3aed] text-white hover:bg-[#6d28d9] shadow-sm transition-all hidden disabled:opacity-40 disabled:cursor-not-allowed">
                    Submit Exam
                </button>
            </div>
        </div>
    </form>
</div>

<script>
(function () {
    var timerEl = document.getElementById('examTimer');
    var expires = new Date(timerEl.getAttribute('data-expires'));

    // Submits #examForm with isForced=true -- used by both the timer-expiry
    // auto-submit below and the camera/screen-loss grace-window auto-submit
    // (see beginGraceWindow) -- neither is the student clicking "Submit
    // Exam" themselves, so neither should be blocked by the "answer every
    // question" completeness check (the Submit proc's IsForced parameter
    // skips it). The student's own manual submit button is a plain,
    // unmodified form submit and still enforces completeness as before.
    function forceSubmitExam() {
        var form = document.getElementById('examForm');
        var hidden = document.createElement('input');
        hidden.type = 'hidden';
        hidden.name = 'isForced';
        hidden.value = 'true';
        form.appendChild(hidden);
        form.submit();
    }

    function tick() {
        var remainingMs = expires - new Date();
        if (remainingMs <= 0) {
            timerEl.textContent = 'Time expired — submitting...';
            forceSubmitExam();
            return;
        }
        var totalSec = Math.floor(remainingMs / 1000);
        var mm = Math.floor(totalSec / 60);
        var ss = totalSec % 60;
        timerEl.textContent = 'Time remaining: ' + mm + ':' + (ss < 10 ? '0' : '') + ss;
        setTimeout(tick, 1000);
    }
    tick();

    var token = document.querySelector('input[name="__RequestVerificationToken"]').value;

    // ---------- Camera & screen-share re-acquisition + hard-block on stream loss ----------
    // Streams from Start.cshtml cannot survive the page navigation to this
    // page (a MediaStream is tied to the document that requested it), so we
    // re-request both here. The browser remembers the camera permission
    // grant from Start.cshtml for this origin, so getUserMedia resolves
    // silently (no second prompt); getDisplayMedia always re-shows its
    // picker by design (no browser allows silently re-granting screen
    // capture), so the student sees exactly one extra picker on this page.
    //
    // Unlike the original brief, the previews here stay small and visibly
    // rendered in a bottom-right dock (#monitorDock) for the whole exam
    // attempt, rather than being acquired invisibly in the background --
    // this is a deliberate product requirement, not an oversight. This
    // block never reads or touches attempt.ExpiresDate / examTimer / tick()
    // above; the grace window below is a separate, independent countdown
    // purely for camera/screen restoration and has no effect on exam time.
    var cameraStream = null;
    var screenStream = null;
    var streamLossModal = document.getElementById('streamLossModal');
    var streamLossMessage = document.getElementById('streamLossMessage');
    var streamLossCountdown = document.getElementById('streamLossCountdown');
    var restoreStreamBtn = document.getElementById('restoreStreamBtn');
    var dockCameraPreview = document.getElementById('dockCameraPreview');
    var dockScreenPreview = document.getElementById('dockScreenPreview');
    var dockCameraLiveBadge = document.getElementById('dockCameraLiveBadge');
    var dockScreenLiveBadge = document.getElementById('dockScreenLiveBadge');
    var permissionIntroModal = document.getElementById('permissionIntroModal');
    var continueToPermissionsBtn = document.getElementById('continueToPermissionsBtn');
    var graceTimeoutId = null;
    var graceIntervalId = null;
    var GRACE_WINDOW_SECONDS = 30;

    function beginGraceWindow() {
        if (graceTimeoutId !== null) return; // already counting down
        var remaining = GRACE_WINDOW_SECONDS;
        streamLossCountdown.textContent = 'Auto-submitting in ' + remaining + 's if not restored...';
        graceIntervalId = setInterval(function () {
            remaining -= 1;
            if (remaining > 0) {
                streamLossCountdown.textContent = 'Auto-submitting in ' + remaining + 's if not restored...';
            }
        }, 1000);
        graceTimeoutId = setTimeout(function () {
            forceSubmitExam();
        }, GRACE_WINDOW_SECONDS * 1000);
    }

    function clearGraceWindow() {
        if (graceTimeoutId !== null) {
            clearTimeout(graceTimeoutId);
            graceTimeoutId = null;
        }
        if (graceIntervalId !== null) {
            clearInterval(graceIntervalId);
            graceIntervalId = null;
        }
        streamLossCountdown.textContent = '';
    }

    function showStreamLossModal(reason) {
        streamLossMessage.textContent = reason;
        streamLossModal.classList.remove('hidden');
        submitBtn.disabled = true;
        nextBtn.disabled = true;
        backBtn.disabled = true;
    }

    function hideStreamLossModal() {
        streamLossModal.classList.add('hidden');
        nextBtn.disabled = false;
        backBtn.disabled = current === 0;
        updateSubmitGate();
    }

    function attachEndedHandler(track, label) {
        track.addEventListener('ended', function () {
            showStreamLossModal('Your ' + label + ' stopped or was stopped. This must be restored to continue the exam.');
            beginGraceWindow();
        });
    }

    async function acquireStreams() {
        try {
            cameraStream = await navigator.mediaDevices.getUserMedia({ video: true });
            dockCameraPreview.srcObject = cameraStream;
            dockCameraLiveBadge.classList.remove('hidden');
            attachEndedHandler(cameraStream.getVideoTracks()[0], 'camera');
        } catch (err) {
            showStreamLossModal('Camera access is required and could not be re-established. Click below to grant camera access again.');
            beginGraceWindow();
        }

        try {
            screenStream = await navigator.mediaDevices.getDisplayMedia({ video: true });
            var screenTrack = screenStream.getVideoTracks()[0];
            if (screenTrack.getSettings().displaySurface !== 'monitor') {
                screenTrack.stop();
                screenStream = null;
                showStreamLossModal('You must share your ENTIRE SCREEN (not a window or tab). Click below to share your entire screen.');
                beginGraceWindow();
                return;
            }
            dockScreenPreview.srcObject = screenStream;
            dockScreenLiveBadge.classList.remove('hidden');
            attachEndedHandler(screenTrack, 'screen share');
        } catch (err) {
            showStreamLossModal('Screen share is required and could not be re-established. Click below to grant screen share access again.');
            beginGraceWindow();
        }
    }

    restoreStreamBtn.addEventListener('click', async function () {
        restoreStreamBtn.disabled = true;
        restoreStreamBtn.textContent = 'Restoring...';

        var cameraOk = cameraStream !== null && cameraStream.getVideoTracks()[0].readyState === 'live';
        var screenOk = screenStream !== null && screenStream.getVideoTracks()[0].readyState === 'live';

        if (!cameraOk) {
            try {
                cameraStream = await navigator.mediaDevices.getUserMedia({ video: true });
                dockCameraPreview.srcObject = cameraStream;
                dockCameraLiveBadge.classList.remove('hidden');
                attachEndedHandler(cameraStream.getVideoTracks()[0], 'camera');
                cameraOk = true;
            } catch (err) {
                cameraOk = false;
            }
        }

        if (!screenOk) {
            try {
                screenStream = await navigator.mediaDevices.getDisplayMedia({ video: true });
                var screenTrack = screenStream.getVideoTracks()[0];
                if (screenTrack.getSettings().displaySurface !== 'monitor') {
                    screenTrack.stop();
                    screenOk = false;
                } else {
                    dockScreenPreview.srcObject = screenStream;
                    dockScreenLiveBadge.classList.remove('hidden');
                    attachEndedHandler(screenTrack, 'screen share');
                    screenOk = true;
                }
            } catch (err) {
                screenOk = false;
            }
        }

        restoreStreamBtn.disabled = false;
        restoreStreamBtn.textContent = 'Restore Camera & Screen Share';

        if (cameraOk && screenOk) {
            clearGraceWindow();
            hideStreamLossModal();
        } else {
            streamLossMessage.textContent = 'Camera and screen share must both be active. Please try again.';
        }
    });

    continueToPermissionsBtn.addEventListener('click', function () {
        // Fullscreen must be requested synchronously inside this click's own
        // handler, before any await -- browsers reject a fullscreen request
        // made from inside a promise callback or timeout, since it's no
        // longer considered "inside" the user gesture that triggered it.
        // Best-effort only: if requestFullscreen() throws synchronously
        // (unsupported browser) or its promise rejects (blocked by policy),
        // the student still proceeds into the exam -- fullscreen is a
        // proctoring aid here, not a hard gate that can strand a legitimate
        // student who simply can't grant it.
        try {
            var el = document.documentElement;
            var request = el.requestFullscreen
                ? el.requestFullscreen()
                : (el.webkitRequestFullscreen ? el.webkitRequestFullscreen() : null);
            if (request && typeof request.catch === 'function') {
                request.catch(function () { /* best-effort; ignore rejection */ });
            }
        } catch (err) {
            // best-effort; ignore
        }

        permissionIntroModal.classList.add('hidden');
        acquireStreams().finally(function () {
            // Arm violation detection once the permission flow has settled
            // (success or failure) -- the getUserMedia/getDisplayMedia
            // prompts themselves can steal window focus, and that must never
            // be mistaken for a student-caused WindowBlur/TabSwitch.
            violationDetectionArmed = true;
        });
    });

    function saveAnswer(questionId, attemptId, selectedOptionId, writtenAnswerText) {
        fetch('/Student/ExamAttempt/SaveAnswer', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': token },
            body: new URLSearchParams({
                attemptId: attemptId,
                questionId: questionId,
                selectedOptionId: selectedOptionId || '',
                writtenAnswerText: writtenAnswerText || '',
                __RequestVerificationToken: token
            })
        });
    }

    // ---------- One-question-at-a-time navigation ----------
    var pages = Array.prototype.slice.call(document.querySelectorAll('.exam-question-page'));
    var paletteButtons = Array.prototype.slice.call(document.querySelectorAll('.palette-btn'));
    var backBtn = document.getElementById('backBtn');
    var nextBtn = document.getElementById('nextBtn');
    var submitBtn = document.getElementById('submitBtn');
    var submitBlockedMsg = document.getElementById('submitBlockedMsg');
    var current = 0;

    // Tracks answered state per question index client-side, purely for
    // enabling/disabling the Submit button and coloring the palette. This is
    // a UX convenience only -- the server is still the real authority on
    // whether an attempt has answers (edu.ExamAttemptAnswer rows), and
    // ExamAttempt_Submit itself never required every question be answered
    // (a student who runs out of time can still submit whatever was saved).
    // Blocking the button client-side is a soft guardrail against
    // accidentally submitting with a forgotten question, not a security
    // boundary -- see server-side note in the Submit action.
    var answeredState = pages.map(function (page) {
        var mcqChecked = page.querySelector('.mcq-option-input:checked');
        var writtenEl = page.querySelector('.written-answer-input');
        if (mcqChecked) return true;
        if (writtenEl) return writtenEl.value.trim().length > 0;
        return false;
    });

    function updatePalette() {
        paletteButtons.forEach(function (btn, i) {
            btn.classList.toggle('bg-emerald-50', answeredState[i]);
            btn.classList.toggle('dark:bg-emerald-950', answeredState[i]);
            btn.classList.toggle('border-emerald-200', answeredState[i]);
            btn.classList.toggle('dark:border-emerald-800', answeredState[i]);
            btn.classList.toggle('text-emerald-700', answeredState[i]);
            btn.classList.toggle('dark:text-emerald-300', answeredState[i]);
            btn.classList.toggle('bg-slate-50', !answeredState[i]);
            btn.classList.toggle('dark:bg-slate-800/60', !answeredState[i]);
            btn.classList.toggle('border-slate-200', !answeredState[i]);
            btn.classList.toggle('dark:border-slate-700', !answeredState[i]);
            btn.classList.toggle('text-slate-500', !answeredState[i]);
            btn.classList.toggle('dark:text-slate-400', !answeredState[i]);
            btn.classList.toggle('ring-2', i === current);
            btn.classList.toggle('ring-indigo-400', i === current);
        });
    }

    function updateSubmitGate() {
        var allAnswered = answeredState.every(function (a) { return a; });
        submitBtn.disabled = !allAnswered;
        submitBlockedMsg.classList.toggle('hidden', allAnswered);
    }

    function showPage(index) {
        pages.forEach(function (page, i) { page.classList.toggle('hidden', i !== index); });
        current = index;
        backBtn.disabled = index === 0;
        var isLast = index === pages.length - 1;
        nextBtn.classList.toggle('hidden', isLast);
        submitBtn.classList.toggle('hidden', !isLast);
        updatePalette();
        updateSubmitGate();
    }

    backBtn.addEventListener('click', function () { if (current > 0) showPage(current - 1); });
    nextBtn.addEventListener('click', function () { if (current < pages.length - 1) showPage(current + 1); });
    paletteButtons.forEach(function (btn) {
        btn.addEventListener('click', function () { showPage(parseInt(btn.getAttribute('data-index'), 10)); });
    });

    document.getElementById('examForm').addEventListener('submit', function (e) {
        if (submitBtn.disabled) e.preventDefault();
    });

    document.querySelectorAll('.mcq-option-input').forEach(function (el) {
        el.addEventListener('change', function () {
            var q = el.closest('.exam-question');
            var page = el.closest('.exam-question-page');
            saveAnswer(q.getAttribute('data-question-id'), q.getAttribute('data-attempt-id'), el.value, null);
            answeredState[parseInt(page.getAttribute('data-index'), 10)] = true;
            updatePalette();
            updateSubmitGate();
        });
    });

    document.querySelectorAll('.written-answer-input').forEach(function (el) {
        el.addEventListener('blur', function () {
            var q = el.closest('.exam-question');
            var page = el.closest('.exam-question-page');
            saveAnswer(q.getAttribute('data-question-id'), q.getAttribute('data-attempt-id'), null, el.value);
            answeredState[parseInt(page.getAttribute('data-index'), 10)] = el.value.trim().length > 0;
            updatePalette();
            updateSubmitGate();
        });
    });

    // ---------- Phase 3: violation detection + server-authoritative strikes ----------
    // Wired alongside (never replacing) the Phase 2 camera/screen-share
    // monitoring above. copy and contextmenu are prevented outright;
    // visibilitychange/blur/fullscreenchange are detection-only (nothing to
    // preventDefault -- there is no "cancel" for the user having switched
    // tabs or exited fullscreen, only a report-after-the-fact).
    var violationWarningModal = document.getElementById('violationWarningModal');
    var violationWarningMessage = document.getElementById('violationWarningMessage');
    var violationWarningCount = document.getElementById('violationWarningCount');
    var violationWarningDismissBtn = document.getElementById('violationWarningDismissBtn');
    var violationTerminatedModal = document.getElementById('violationTerminatedModal');

    var VIOLATION_LABELS = {
        TabSwitch: 'you switched tabs or minimized the browser',
        WindowBlur: 'this window lost focus',
        FullscreenExit: 'you exited fullscreen',
        CopyPaste: 'you attempted to copy content',
        RightClick: 'you attempted to right-click'
    };

    // Listeners are attached immediately (below), but stay disarmed until the
    // camera/screen-share permission flow has actually finished -- the OS-
    // level getUserMedia/getDisplayMedia prompts can themselves steal window
    // focus, which would otherwise fire `blur`/`visibilitychange` from the
    // exam's own required setup, not from anything the student did wrong.
    var violationDetectionArmed = false;

    // Debounces near-simultaneous reports from a single physical action --
    // an alt-tab away, for instance, fires both `blur` and `visibilitychange`
    // within the same tick, which would otherwise cost two strikes for what
    // the student experiences as one action.
    var lastViolationReportAt = 0;
    var VIOLATION_DEBOUNCE_MS = 500;

    function reportViolation(violationType) {
        if (!violationDetectionArmed) return;
        var now = Date.now();
        if (now - lastViolationReportAt < VIOLATION_DEBOUNCE_MS) return;
        lastViolationReportAt = now;

        fetch('/Student/ExamAttempt/ReportViolation', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': token },
            body: new URLSearchParams({
                attemptId: '@attempt.AttemptID',
                violationType: violationType,
                __RequestVerificationToken: token
            })
        })
        .then(function (r) { return r.json(); })
        .then(function (data) {
            if (!data.success) return;

            if (data.status === 'Terminated') {
                violationWarningModal.classList.add('hidden');
                violationTerminatedModal.classList.remove('hidden');
                submitBtn.disabled = true;
                nextBtn.disabled = true;
                backBtn.disabled = true;
                setTimeout(function () {
                    window.location.href = '/Student/ExamAttempt/Result?attemptId=' + encodeURIComponent('@attempt.AttemptID');
                }, 2500);
                return;
            }

            violationWarningMessage.textContent = 'The exam detected that ' + (VIOLATION_LABELS[violationType] || 'a rule was broken') + '.';
            violationWarningCount.textContent = data.strikeCount + ' of 3 — one more ends the exam.';
            violationWarningModal.classList.remove('hidden');
        })
        .catch(function () { /* best-effort; a dropped report is still visible server-side via the next successful one, no client-side retry needed */ });
    }

    violationWarningDismissBtn.addEventListener('click', function () {
        violationWarningModal.classList.add('hidden');
    });

    document.addEventListener('visibilitychange', function () {
        if (document.visibilityState === 'hidden') reportViolation('TabSwitch');
    });

    window.addEventListener('blur', function () {
        reportViolation('WindowBlur');
    });

    document.addEventListener('fullscreenchange', function () {
        if (!document.fullscreenElement) reportViolation('FullscreenExit');
    });

    document.addEventListener('copy', function (e) {
        e.preventDefault();
        reportViolation('CopyPaste');
    });

    document.addEventListener('contextmenu', function (e) {
        e.preventDefault();
        reportViolation('RightClick');
    });

    showPage(0);
})();
</script>
