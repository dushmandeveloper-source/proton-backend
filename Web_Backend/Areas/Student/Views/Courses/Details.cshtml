@model Web_Backend.Areas.StudentPortal.Models.CourseDetailsViewModel
@{
    ViewData["Title"] = "Course Details";
    var courseTitle = Model.Course?.CourseTitle ?? Model.Registration.CourseTitle;
}

<div class="max-w-5xl mx-auto space-y-8 page-enter">

    <div class="flex items-center justify-between flex-wrap gap-4">
        <div>
            <p class="text-sm font-medium text-slate-500 dark:text-slate-400 mb-2">My Courses</p>
            <h1 class="text-3xl md:text-4xl font-bold text-slate-800 dark:text-slate-100 tracking-tight">
                @courseTitle
            </h1>
        </div>
        <a asp-action="Index"
           class="px-4 py-2 rounded-xl font-medium text-sm bg-slate-50 dark:bg-slate-800 text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-700 transition-colors flex items-center gap-2 w-fit">
            <i data-lucide="arrow-left" class="w-4 h-4"></i> Back to My Courses
        </a>
    </div>

    @if (Model.IsContentRestricted)
    {
        <div class="rounded-2xl border border-amber-200 dark:border-amber-900 bg-amber-50 dark:bg-amber-950 px-5 py-4 flex items-start gap-3">
            <i data-lucide="lock" class="w-5 h-5 text-amber-600 dark:text-amber-300 flex-shrink-0 mt-0.5"></i>
            <p class="text-sm text-amber-700 dark:text-amber-300">
                Your account is still being verified. Course materials and joining links unlock once an administrator verifies your account — you can still view and pay your balance below.
            </p>
        </div>
    }

    @* ---------- Course info ---------- *@
    <div class="bg-white dark:bg-slate-900/60 rounded-[24px] shadow-sm border border-slate-100 dark:border-slate-700 overflow-hidden">
        <div class="p-6 border-b border-slate-100 dark:border-slate-700 flex items-center gap-3">
            <div class="bg-purple-50 dark:bg-purple-950 p-2 rounded-lg"><i data-lucide="book-open" class="w-5 h-5 text-purple-600 dark:text-purple-300"></i></div>
            <h3 class="font-semibold text-lg text-slate-800 dark:text-slate-100">Course Information</h3>
        </div>
        <div class="p-6 space-y-4">
            @if (Model.Course == null)
            {
                <p class="text-sm text-slate-400 dark:text-slate-500">Course details are unavailable.</p>
            }
            else
            {
                @if (!string.IsNullOrEmpty(Model.Course.ShortDescription))
                {
                    <p class="text-sm text-slate-600 dark:text-slate-300">@Model.Course.ShortDescription</p>
                }
                <div class="flex flex-wrap gap-6 text-sm">
                    @if (!string.IsNullOrEmpty(Model.Course.Duration))
                    {
                        <div>
                            <p class="text-xs text-slate-400 dark:text-slate-500 uppercase tracking-wider mb-0.5">Duration</p>
                            <p class="text-slate-700 dark:text-slate-200 font-medium">@Model.Course.Duration</p>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(Model.Course.DeliveryMethod))
                    {
                        <div>
                            <p class="text-xs text-slate-400 dark:text-slate-500 uppercase tracking-wider mb-0.5">Delivery Method</p>
                            <p class="text-slate-700 dark:text-slate-200 font-medium">@Model.Course.DeliveryMethod</p>
                        </div>
                    }
                </div>
                @if (!string.IsNullOrEmpty(Model.Course.AboutHtml))
                {
                    <div class="prose prose-sm dark:prose-invert max-w-none text-slate-600 dark:text-slate-300">
                        @Html.Raw(Model.Course.AboutHtml)
                    </div>
                }
                @if (!string.IsNullOrEmpty(Model.Course.VideoURL))
                {
                    <button type="button" data-video-url="@Model.Course.VideoURL" onclick="openCourseVideoPreview(this.dataset.videoUrl)"
                            class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-purple-50 dark:bg-purple-950 text-[#7c3aed] dark:text-purple-300 text-sm font-medium hover:bg-purple-100 dark:hover:bg-purple-900">
                        <i data-lucide="play-circle" class="w-4 h-4"></i> Watch course video
                    </button>
                }
            }
        </div>
    </div>

    @* ---------- Payment summary ---------- *@
    <div class="bg-white dark:bg-slate-900/60 rounded-[24px] shadow-sm border border-slate-100 dark:border-slate-700 overflow-hidden">
        <div class="p-6 border-b border-slate-100 dark:border-slate-700 flex items-center gap-3">
            <div class="bg-amber-50 dark:bg-amber-950 p-2 rounded-lg"><i data-lucide="wallet" class="w-5 h-5 text-amber-600 dark:text-amber-300"></i></div>
            <h3 class="font-semibold text-lg text-slate-800 dark:text-slate-100">Payment Summary</h3>
            <span class="ml-auto inline-flex px-2.5 py-1 rounded-full text-xs font-medium @(Model.Registration.PaymentStatus == "Paid" ? "bg-emerald-50 dark:bg-emerald-950 text-emerald-600 dark:text-emerald-300" : Model.Registration.PaymentStatus == "PartiallyPaid" ? "bg-amber-50 dark:bg-amber-950 text-amber-600 dark:text-amber-300" : "bg-slate-100 dark:bg-slate-800 text-slate-500 dark:text-slate-400")">
                @Model.Registration.PaymentStatus
            </span>
        </div>
        <div class="p-6 grid grid-cols-1 md:grid-cols-3 gap-6">
            <div>
                <p class="text-xs text-slate-400 dark:text-slate-500 uppercase tracking-wider mb-1">Course Fee</p>
                @{
                    // Installment discounts (0091) already came off CourseFee too.
                    var instDiscount = Model.Installments.Sum(i => i.DiscountAmount);
                }
                @if (Model.Registration.HasPersonalDiscount || instDiscount > 0)
                {
                    <p class="text-sm line-through text-slate-400 dark:text-slate-500">@Model.Registration.CurrencyCode @((Model.Registration.FeeBeforePersonalDiscount + instDiscount).ToString("N2"))</p>
                }
                <p class="text-xl font-bold text-slate-800 dark:text-slate-100">@Model.Registration.CurrencyCode @Model.Registration.CourseFee.ToString("N2")</p>
                @if (Model.Registration.HasPersonalDiscount)
                {
                    <p class="mt-1 inline-flex items-center gap-1 px-2 py-0.5 rounded-lg text-xs font-medium bg-emerald-50 dark:bg-emerald-950 text-emerald-700 dark:text-emerald-300">
                        <i data-lucide="badge-percent" class="w-3.5 h-3.5"></i> Personal discount &minus;@Model.Registration.CurrencyCode @Model.Registration.PersonalDiscountAmount.ToString("N2")@(string.IsNullOrEmpty(Model.Registration.PersonalDiscountReason) ? "" : " · " + Model.Registration.PersonalDiscountReason)
                    </p>
                }
                @foreach (var d in Model.Installments.Where(i => i.HasDiscount))
                {
                    <p class="mt-1 inline-flex items-center gap-1 px-2 py-0.5 rounded-lg text-xs font-medium bg-emerald-50 dark:bg-emerald-950 text-emerald-700 dark:text-emerald-300">
                        <i data-lucide="badge-percent" class="w-3.5 h-3.5"></i> Installment @d.SeqNo discount &minus;@Model.Registration.CurrencyCode @d.DiscountAmount.ToString("N2")@(string.IsNullOrEmpty(d.DiscountReason) ? "" : " · " + d.DiscountReason)
                    </p>
                }
            </div>
            <div>
                <p class="text-xs text-slate-400 dark:text-slate-500 uppercase tracking-wider mb-1">Amount Paid</p>
                <p class="text-xl font-bold text-emerald-600 dark:text-emerald-300">@Model.Registration.CurrencyCode @Model.Registration.AmountPaid.ToString("N2")</p>
            </div>
            <div>
                <p class="text-xs text-slate-400 dark:text-slate-500 uppercase tracking-wider mb-1">Balance Due</p>
                <p class="text-xl font-bold text-amber-600 dark:text-amber-300">@Model.Registration.CurrencyCode @Model.Registration.BalanceDue.ToString("N2")</p>
            </div>
        </div>
        @if (Model.Registration.BalanceDue > 0)
        {
            <div class="px-6 pb-6">
                <a asp-action="PayBalance" asp-route-registrationId="@Model.Registration.RegistrationID"
                   class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl font-medium text-sm bg-[#7c3aed] text-white hover:bg-[#6d28d9] shadow-sm transition-all">
                    <i data-lucide="wallet" class="w-4 h-4"></i> Pay Balance
                </a>
            </div>
        }
    </div>

    @* ---------- Installment plan (0091) ---------- *@
    @if (Model.Installments.Count > 0)
    {
        var todayI = Web_Backend.Classes.SriLankaTime.Today;
        var instStatuses = Model.Installments.Select(i => i.StatusOn(todayI)).ToList();
        var instPaid = instStatuses.Count(x => x == "Paid");
        var instDue = instStatuses.Count(x => x is "Overdue" or "DueThisMonth" or "PartlyPaid");
        var instUpcoming = instStatuses.Count(x => x == "Upcoming");
        var dueNow = Model.Installments.Where(i => i.IsDueBy(todayI)).Sum(i => i.Remaining);
        <div class="bg-white dark:bg-slate-900/60 rounded-[24px] shadow-sm border border-slate-100 dark:border-slate-700 overflow-hidden">
            <div class="p-6 border-b border-slate-100 dark:border-slate-700 flex items-center justify-between gap-3 flex-wrap">
                <div class="flex items-center gap-3">
                    <div class="bg-violet-50 dark:bg-violet-950 p-2 rounded-lg"><i data-lucide="calendar-clock" class="w-5 h-5 text-violet-600 dark:text-violet-300"></i></div>
                    <div>
                        <h3 class="font-semibold text-lg text-slate-800 dark:text-slate-100">Installment Plan</h3>
                        <p class="text-xs text-slate-500 dark:text-slate-400">@Model.Installments.Count installments · <span class="text-emerald-600 dark:text-emerald-300 font-semibold">@instPaid paid</span> · <span class="text-amber-600 dark:text-amber-300 font-semibold">@instDue due</span> · @instUpcoming upcoming</p>
                    </div>
                </div>
                @if (dueNow > 0)
                {
                    <div class="text-right">
                        <p class="text-xs text-slate-400 dark:text-slate-500 uppercase tracking-wider">Due now</p>
                        <p class="text-lg font-bold text-amber-600 dark:text-amber-300">@Model.Registration.CurrencyCode @dueNow.ToString("N2")</p>
                    </div>
                }
            </div>
            <div class="divide-y divide-slate-100 dark:divide-slate-700">
                @for (var n = 0; n < Model.Installments.Count; n++)
                {
                    var inst = Model.Installments[n];
                    var (instLabel, instCls) = Web_Backend.Areas.Admin.Models.PaymentInstallment.Badge(instStatuses[n]);
                    <div id="hl-@inst.InstallmentID" class="px-6 py-4 flex items-center justify-between gap-4 flex-wrap">
                        <div class="flex items-center gap-4 min-w-0">
                            <div class="w-9 h-9 rounded-full bg-slate-100 dark:bg-slate-800 flex items-center justify-center text-sm font-bold text-slate-600 dark:text-slate-300 flex-shrink-0">@inst.SeqNo</div>
                            <div class="min-w-0">
                                <p class="text-sm font-semibold text-slate-800 dark:text-slate-100">Due @inst.DueDate.ToString("d MMM yyyy")</p>
                                <p class="text-xs text-slate-500 dark:text-slate-400">
                                    @Model.Registration.CurrencyCode @inst.NetAmount.ToString("N2")
                                    @if (inst.HasDiscount)
                                    {
                                        <span class="text-emerald-600 dark:text-emerald-300"> · discount &minus;@inst.DiscountAmount.ToString("N2")@(string.IsNullOrEmpty(inst.DiscountReason) ? "" : " (" + inst.DiscountReason + ")")</span>
                                    }
                                    @if (inst.PaidAmount > 0 && inst.Remaining > 0)
                                    {
                                        <span> · paid @inst.PaidAmount.ToString("N2"), @inst.Remaining.ToString("N2") left</span>
                                    }
                                </p>
                            </div>
                        </div>
                        <span class="px-2 py-1 rounded-lg text-[11px] font-medium @instCls">@instLabel</span>
                    </div>
                }
            </div>
        </div>
    }

    @* ---------- Payment history ---------- *@
    <div class="bg-white dark:bg-slate-900/60 rounded-[24px] shadow-sm border border-slate-100 dark:border-slate-700 overflow-hidden">
        <div class="p-6 border-b border-slate-100 dark:border-slate-700 flex items-center gap-3">
            <div class="bg-indigo-50 dark:bg-indigo-950 p-2 rounded-lg"><i data-lucide="receipt" class="w-5 h-5 text-indigo-600 dark:text-indigo-300"></i></div>
            <h3 class="font-semibold text-lg text-slate-800 dark:text-slate-100">Payment History</h3>
        </div>
        @if (Model.Payments.Count == 0)
        {
            <div class="p-10 text-center">
                <p class="text-sm text-slate-400 dark:text-slate-500">No payments recorded yet.</p>
            </div>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="w-full text-sm">
                    <thead>
                        <tr class="text-left text-xs font-semibold text-slate-400 dark:text-slate-500 uppercase tracking-wider border-b border-slate-100 dark:border-slate-700">
                            <th class="px-6 py-3">Date</th>
                            <th class="px-6 py-3">Amount</th>
                            <th class="px-6 py-3">Method</th>
                            <th class="px-6 py-3">Status</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 dark:divide-slate-700">
                        @foreach (var payment in Model.Payments)
                        {
                            <tr>
                                <td class="px-6 py-3 text-slate-600 dark:text-slate-300">@payment.PaymentDate.ToString("MMM d, yyyy")</td>
                                <td class="px-6 py-3 font-medium text-slate-800 dark:text-slate-100">@Model.Registration.CurrencyCode @payment.Amount.ToString("N2")</td>
                                <td class="px-6 py-3 text-slate-600 dark:text-slate-300">@payment.PaymentMethod</td>
                                <td class="px-6 py-3">
                                    @switch (payment.ApprovalStatus)
                                    {
                                        case "Approved":
                                            <span class="inline-flex px-2.5 py-1 rounded-full text-xs font-medium bg-emerald-50 dark:bg-emerald-950 text-emerald-600 dark:text-emerald-300">Approved</span>
                                            break;
                                        case "Rejected":
                                            <span class="inline-flex px-2.5 py-1 rounded-full text-xs font-medium bg-red-50 dark:bg-red-950 text-red-600 dark:text-red-300">Rejected</span>
                                            <span class="block text-xs text-red-600 dark:text-red-300 mt-1">@payment.RejectReason · please pay this again</span>
                                            break;
                                        case "Voided":
                                            <span class="inline-flex px-2.5 py-1 rounded-full text-xs font-medium bg-slate-100 dark:bg-slate-800 text-slate-500">Voided</span>
                                            break;
                                        default:
                                            <span class="inline-flex px-2.5 py-1 rounded-full text-xs font-medium bg-amber-50 dark:bg-amber-950 text-amber-600 dark:text-amber-300">Pending approval</span>
                                            break;
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    @* ---------- Lecture materials ---------- *@
    <div class="bg-white dark:bg-slate-900/60 rounded-[24px] shadow-sm border border-slate-100 dark:border-slate-700 overflow-hidden">
        <div class="p-6 border-b border-slate-100 dark:border-slate-700 flex items-center gap-3">
            <div class="bg-emerald-50 dark:bg-emerald-950 p-2 rounded-lg"><i data-lucide="file-text" class="w-5 h-5 text-emerald-600 dark:text-emerald-300"></i></div>
            <h3 class="font-semibold text-lg text-slate-800 dark:text-slate-100">Assignment / Homework / Lecture Materials</h3>
        </div>
        @if (Model.IsContentRestricted)
        {
            <div class="p-10 text-center">
                <i data-lucide="lock" class="w-6 h-6 text-slate-300 dark:text-slate-600 mx-auto mb-2"></i>
                <p class="text-sm text-slate-400 dark:text-slate-500">Materials unlock once an administrator verifies your account.</p>
            </div>
        }
        else if (Model.Materials.Count == 0)
        {
            <div class="p-10 text-center">
                <p class="text-sm text-slate-400 dark:text-slate-500">No lecture materials have been shared for this course yet.</p>
            </div>
        }
        else
        {
            <div class="divide-y divide-slate-100 dark:divide-slate-700">
                @foreach (var m in Model.Materials.OrderByDescending(m => m.MaterialDate))
                {
                    <div class="p-4 px-6 flex items-center justify-between gap-4">
                        <div class="flex items-center gap-3">
                            <div class="p-2 rounded-lg bg-slate-50 dark:bg-slate-800 flex-shrink-0">
                                <i data-lucide="@(m.FileType == "Video" ? "video" : m.FileType == "Image" ? "image" : "file-text")" class="w-4 h-4 text-slate-500 dark:text-slate-400"></i>
                            </div>
                            <div>
                                <div class="flex items-center gap-2">
                                    <p class="text-sm font-medium text-slate-800 dark:text-slate-100">@m.Title</p>
                                    <span class="px-2 py-0.5 rounded-full text-xs font-medium @(m.IsSubmittable ? "bg-amber-50 dark:bg-amber-950 text-amber-700 dark:text-amber-300" : "bg-purple-50 dark:bg-purple-950 text-[#7c3aed] dark:text-purple-300")">
                                        @(m.IsSubmittable ? "Assignment / Homework" : "Lecture Note")
                                    </span>
                                </div>
                                <p class="text-xs text-slate-400 dark:text-slate-500">@m.MaterialDate.ToString("MMM d, yyyy") &middot; @m.FileType</p>
                            </div>
                        </div>
                        <button type="button" data-url="@m.FileURL" data-type="@m.FileType" data-title="@m.Title"
 onclick="if (this.dataset.type === 'Link' || this.dataset.type === 'Video') window.open(this.dataset.url, '_blank', 'noopener'); else openMaterialPreview(this.dataset.url, this.dataset.type, this.dataset.title)"
                           class="px-3 py-1.5 rounded-lg font-medium text-xs bg-slate-50 dark:bg-slate-800 text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-700 transition-colors flex-shrink-0">
                            View
                        </button>
                    </div>
                }
            </div>
        }
    </div>



    @* ---------- Schedule segments ---------- *@
    <div class="bg-white dark:bg-slate-900/60 rounded-[24px] shadow-sm border border-slate-100 dark:border-slate-700 overflow-hidden">
        <div class="p-6 border-b border-slate-100 dark:border-slate-700 flex items-center gap-3">
            <div class="bg-indigo-50 dark:bg-indigo-950 p-2 rounded-lg"><i data-lucide="calendar-days" class="w-5 h-5 text-indigo-600 dark:text-indigo-300"></i></div>
            <h3 class="font-semibold text-lg text-slate-800 dark:text-slate-100">Class Schedule</h3>
        </div>
        @if (Model.Segments.Count == 0)
        {
            <div class="p-10 text-center">
                <p class="text-sm text-slate-400 dark:text-slate-500">No schedule segments found for this course.</p>
            </div>
        }
        else
        {
            <div class="p-5 space-y-3">
                @foreach (var seg in Model.Segments)
                {
                    <div class="rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-100 dark:border-slate-700 px-4 py-3">
                        <p class="text-sm font-semibold text-slate-800 dark:text-slate-100">
                            @seg.ScheduleName &middot; @seg.StartTime.ToString(@"hh\:mm") - @seg.EndTime.ToString(@"hh\:mm") &middot; @seg.Location
                        </p>
                        @if (!string.IsNullOrEmpty(seg.InstructorNames))
                        {
                            <p class="text-xs text-slate-400 dark:text-slate-500 mt-0.5">Instructor(s): @seg.InstructorNames</p>
                        }
                        @if (!string.IsNullOrWhiteSpace(seg.TimeOverrides))
                        {
                            <p class="text-xs text-sky-600 dark:text-sky-300 mt-0.5">Different time on: @Web_Backend.Areas.Admin.Models.SegmentTimeOverrides.Describe(seg.TimeOverrides)</p>
                        }
                    </div>
                }
            </div>
        }
    </div>
</div>


@await Html.PartialAsync("_CourseVideoPlayer")

@await Html.PartialAsync("_MaterialPreviewModal")

