@model Web_Backend.Areas.StudentPortal.Models.PayBalanceFormModel
@{
    ViewData["Title"] = "Pay Balance";
    var registration = ViewBag.Registration as Web_Backend.Areas.Admin.Models.CourseRegistration;
    var course = ViewBag.Course as Web_Backend.Areas.Admin.Models.Course;
    var options = ViewBag.PaymentOptions as List<Web_Backend.Classes.PaymentOption> ?? new();
    var selectedKey = options.Any(o => o.Key == Model.Option) ? Model.Option : options.FirstOrDefault()?.Key;
}

<div class="max-w-xl mx-auto page-enter">
    <a asp-action="Details" asp-route-registrationId="@Model.RegistrationID" class="inline-flex items-center gap-1.5 text-sm font-medium text-slate-500 dark:text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 mb-4">
        <i data-lucide="arrow-left" class="w-4 h-4"></i> Back to course
    </a>

    <div class="mb-6">
        <h2 class="text-2xl font-bold text-slate-800 dark:text-slate-100 tracking-tight">Pay Balance</h2>
        <p class="text-slate-500 dark:text-slate-400 text-sm mt-1">@(course?.CourseTitle ?? registration?.CourseTitle)</p>
    </div>

    <div class="bg-white dark:bg-slate-900/60 rounded-[24px] shadow-sm border border-slate-100 dark:border-slate-700 p-6 mb-6 flex items-center justify-between">
        <div>
            <p class="text-xs text-slate-400 dark:text-slate-500">Course Fee</p>
            <p class="text-sm font-semibold text-slate-700 dark:text-slate-200">@registration?.CurrencyCode @registration?.CourseFee.ToString("N2")</p>
            @if (registration?.HasPersonalDiscount == true)
            {
                <p class="text-[11px] text-emerald-600 dark:text-emerald-300">Incl. personal discount &minus;@registration.CurrencyCode @registration.PersonalDiscountAmount.ToString("N2")</p>
            }
        </div>
        <div>
            <p class="text-xs text-slate-400 dark:text-slate-500">Already Paid</p>
            <p class="text-sm font-semibold text-emerald-600 dark:text-emerald-300">@registration?.CurrencyCode @registration?.AmountPaid.ToString("N2")</p>
        </div>
        <div class="text-right">
            <p class="text-xs text-slate-400 dark:text-slate-500">Balance Due</p>
            <p class="text-lg font-bold text-amber-600 dark:text-amber-300">@registration?.CurrencyCode @registration?.BalanceDue.ToString("N2")</p>
        </div>
    </div>

    <form method="post" asp-action="PayBalance" enctype="multipart/form-data" id="payBalanceForm" class="bg-white dark:bg-slate-900/60 rounded-[24px] shadow-sm border border-slate-100 dark:border-slate-700 p-6 space-y-5">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="RegistrationID" />

        <div class="space-y-1">
            <label class="text-sm font-medium text-slate-700 dark:text-slate-300">Payment Method</label>
            <select asp-for="PaymentMethod" id="pbMethodSelect" class="w-full rounded-xl border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-800 text-slate-800 dark:text-slate-100 px-4 py-2.5 text-sm outline-none focus:border-[#7c3aed] focus:ring-1 focus:ring-[#7c3aed]">
                <option value="">Select…</option>
                <option value="Cash">Cash</option>
                <option value="BankDeposit">Bank Deposit</option>
            </select>
        </div>

        <div class="space-y-2">
            <label class="text-sm font-medium text-slate-700 dark:text-slate-300">What are you paying?</label>
            <input type="hidden" name="Amount" id="pbAmount" value="@(options.FirstOrDefault(o => o.Key == selectedKey)?.Amount.ToString(System.Globalization.CultureInfo.InvariantCulture))" />
            @foreach (var o in options)
            {
                <label class="pb-opt">
                    <input type="radio" name="Option" value="@o.Key" data-amount="@o.Amount.ToString(System.Globalization.CultureInfo.InvariantCulture)" @(o.Key == selectedKey ? "checked" : "") />
                    <span class="pb-opt-body">
                        <span class="pb-opt-title">@o.Label</span>
                        <span class="pb-opt-detail">@o.Detail</span>
                    </span>
                    <span class="pb-opt-amount">@registration?.CurrencyCode @o.Amount.ToString("N2")</span>
                </label>
            }
            <p class="text-xs text-slate-400 dark:text-slate-500">Amounts are fixed by your payment plan. Contact Proton Support if you need a different arrangement.</p>
        </div>
        <style>
            .pb-opt { display: flex; align-items: center; gap: 12px; padding: 14px 16px; border: 1.5px solid #e2e8f0; border-radius: 16px; cursor: pointer; transition: border-color .15s, background-color .15s; }
            .pb-opt:hover { border-color: #c4b5fd; }
            .pb-opt:has(input:checked) { border-color: #7c3aed; background: #faf5ff; box-shadow: 0 0 0 3px rgba(124, 58, 237, .12); }
            .dark .pb-opt { border-color: #334155; }
            .dark .pb-opt:has(input:checked) { background: rgba(124, 58, 237, .12); }
            .pb-opt input { width: 18px; height: 18px; accent-color: #7c3aed; flex-shrink: 0; }
            .pb-opt-body { flex: 1; min-width: 0; display: flex; flex-direction: column; }
            .pb-opt-title { font-size: 14px; font-weight: 600; color: #1e293b; }
            .dark .pb-opt-title { color: #f1f5f9; }
            .pb-opt-detail { font-size: 12px; color: #64748b; }
            .pb-opt-amount { font-size: 16px; font-weight: 700; color: #7c3aed; white-space: nowrap; }
        </style>

        <div class="space-y-1">
            <label id="pbSlipLabel" class="text-sm font-medium text-slate-700 dark:text-slate-300">Receipt</label>
            <input type="file" name="PaymentSlip" accept="image/*,.pdf" class="w-full rounded-xl border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-800 text-slate-800 dark:text-slate-100 px-4 py-2 text-sm outline-none focus:border-[#7c3aed] focus:ring-1 focus:ring-[#7c3aed] file:mr-3 file:py-1.5 file:px-3 file:rounded-lg file:border-0 file:text-xs file:font-medium file:bg-purple-50 dark:file:bg-purple-950 file:text-[#7c3aed] dark:file:text-purple-300" />
            <p class="text-xs text-slate-400 dark:text-slate-500">Required — attach a photo or scan of your receipt/slip.</p>
        </div>

        <div class="space-y-1">
            <label class="text-sm font-medium text-slate-700 dark:text-slate-300">Notes (optional)</label>
            <input asp-for="Notes" class="w-full rounded-xl border border-slate-200 dark:border-slate-600 bg-white dark:bg-slate-800 text-slate-800 dark:text-slate-100 px-4 py-2.5 text-sm outline-none focus:border-[#7c3aed] focus:ring-1 focus:ring-[#7c3aed]" />
        </div>

        <button type="submit" id="pbSubmitBtn" class="w-full py-3 rounded-xl font-medium text-base bg-[#7c3aed] text-white hover:bg-[#6d28d9] shadow-lg shadow-purple-500/25 transition-all disabled:opacity-60 disabled:cursor-not-allowed">
            Submit Payment
        </button>
    </form>
</div>

@section Scripts {
    <script>
        (function () {
            var select = document.getElementById('pbMethodSelect');
            var label = document.getElementById('pbSlipLabel');
            function sync() {
                label.textContent = select.value === 'Cash' ? 'Cash Receipt' : 'Bank Deposit Slip';
            }
            select.addEventListener('change', sync);
            sync();
        })();

        // Fixed-amount choice (PaymentOptions): keep the hidden Amount in step.
        (function () {
            var amount = document.getElementById('pbAmount');
            document.querySelectorAll('input[name="Option"]').forEach(function (r) {
                r.addEventListener('change', function () { if (r.checked) amount.value = r.dataset.amount; });
            });
        })();

        (function () {
            var form = document.getElementById('payBalanceForm');
            var btn = document.getElementById('pbSubmitBtn');
            form.addEventListener('submit', function () {
                btn.disabled = true;
                btn.textContent = 'Submitting…';
            });
        })();
    </script>
}
