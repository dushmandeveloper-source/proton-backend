@model List<(Web_Backend.Areas.Admin.Models.CourseSchedule Batch, bool FullAccess)>
@{
    ViewData["Title"] = "Classroom";
    bool restricted = ViewBag.Restricted as bool? ?? false;
    var payIds = ViewBag.PayRegistrationIds as Dictionary<string, string> ?? new Dictionary<string, string>();
    var currentUser = ViewBag.CurrentUser as Web_Backend.Areas.Admin.Models.SessionUser;
}

<div class="max-w-6xl mx-auto space-y-6 page-enter">
    <div>
        <h2 class="text-2xl font-bold text-slate-800 dark:text-slate-100 tracking-tight">Classroom</h2>
        <p class="text-slate-500 dark:text-slate-400 text-sm mt-1">Pick your batch to see every lesson's notes, videos, homework and assignments &mdash; and submit your work.</p>
    </div>

    @if (restricted || Model.Count == 0)
    {
        <div class="bg-white dark:bg-slate-900/60 rounded-[24px] shadow-sm border border-slate-100 dark:border-slate-700 p-10 text-center">
            <p class="text-sm text-slate-400 dark:text-slate-500">
                @(restricted ? "Your account is still being verified. Classroom unlocks once an administrator verifies your account." : "You are not enrolled in any batch yet.")
            </p>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
            @foreach (var (b, fullAccess) in Model)
            {
                if (fullAccess)
                {
                    <a asp-action="Batch" asp-route-id="@b.ScheduleID"
                       class="group bg-white dark:bg-slate-900/60 rounded-[24px] shadow-sm border border-slate-100 dark:border-slate-700 p-5 hover:border-[#7c3aed]/40 hover:shadow-md transition-all">
                        <div class="flex items-start gap-3">
                            <div class="p-3 rounded-2xl bg-purple-50 dark:bg-purple-950 flex-shrink-0">
                                <i data-lucide="school" class="w-5 h-5 text-[#7c3aed] dark:text-purple-300"></i>
                            </div>
                            <div class="min-w-0">
                                <p class="text-sm font-semibold text-slate-800 dark:text-slate-100 truncate group-hover:text-[#7c3aed]">@b.ScheduleName</p>
                                <p class="text-xs text-slate-500 dark:text-slate-400 truncate">@b.CourseTitle</p>
                            </div>
                        </div>
                    </a>
                }
                else
                {
                    var regId = payIds.TryGetValue(b.ScheduleID, out var rid) ? rid : "";
                    <div class="bg-white dark:bg-slate-900/60 rounded-[24px] shadow-sm border border-amber-100 dark:border-amber-900 p-5 space-y-3">
                        <div class="flex items-start gap-3">
                            <div class="p-3 rounded-2xl bg-amber-50 dark:bg-amber-950 flex-shrink-0">
                                <i data-lucide="lock" class="w-5 h-5 text-amber-600 dark:text-amber-300"></i>
                            </div>
                            <div class="min-w-0">
                                <p class="text-sm font-semibold text-slate-800 dark:text-slate-100 truncate">@b.ScheduleName</p>
                                <p class="text-xs text-slate-500 dark:text-slate-400 truncate">@b.CourseTitle</p>
                                <p class="text-[11px] text-amber-600 dark:text-amber-300 mt-1">Payment pending &mdash; pay the course fee to enter this classroom.</p>
                            </div>
                        </div>
                        <div class="flex flex-wrap gap-2">
                            @if (!string.IsNullOrEmpty(regId))
                            {
                                <a asp-controller="Courses" asp-action="PayBalance" asp-route-registrationId="@regId"
                                   class="px-3 py-1.5 rounded-lg font-medium text-xs bg-[#7c3aed] text-white hover:bg-[#6d28d9] inline-flex items-center gap-1.5">
                                    <i data-lucide="credit-card" class="w-3.5 h-3.5"></i> Pay course fee
                                </a>
                            }
                            <a href="@Url.Action("RequestAccess", "Classroom", new { area = "Student", course = b.CourseTitle })" target="_blank" rel="noopener"
                               class="px-3 py-1.5 rounded-lg font-medium text-xs bg-emerald-50 dark:bg-emerald-950 text-emerald-700 dark:text-emerald-300 hover:bg-emerald-100 inline-flex items-center gap-1.5">
                                <i data-lucide="message-circle" class="w-3.5 h-3.5"></i> Request access
                            </a>
                        </div>
                    </div>
                }
            }
        </div>
    }
</div>
