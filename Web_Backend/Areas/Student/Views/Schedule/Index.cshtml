@model Web_Backend.Areas.StudentPortal.Models.StudentCalendarViewModel
@{
    ViewData["Title"] = "Schedule";
}

<div class="max-w-6xl mx-auto space-y-8 page-enter">

    <div class="flex items-center justify-between flex-wrap gap-4">
        <div>
            <p class="text-sm font-medium text-slate-500 dark:text-slate-400 mb-2">Monthly Calendar</p>
            <h1 class="text-3xl md:text-4xl font-bold text-slate-800 dark:text-slate-100 tracking-tight">
                @Model.MonthLabel
            </h1>
        </div>
        <div class="flex items-center gap-2">
            <a asp-action="Index" asp-route-year="@Model.PrevYear" asp-route-month="@Model.PrevMonth"
               class="p-2 rounded-xl bg-white dark:bg-slate-900/60 border border-slate-100 dark:border-slate-700 text-slate-500 dark:text-slate-400 hover:text-[#5a43f1] dark:hover:text-[#a78bfa] hover:bg-slate-50 dark:hover:bg-slate-800/60 transition-colors shadow-sm">
                <i data-lucide="chevron-left" class="w-5 h-5"></i>
            </a>
            <a asp-action="Index"
               class="px-4 py-2 rounded-xl bg-white dark:bg-slate-900/60 border border-slate-100 dark:border-slate-700 text-sm font-medium text-slate-600 dark:text-slate-300 hover:text-[#5a43f1] dark:hover:text-[#a78bfa] hover:bg-slate-50 dark:hover:bg-slate-800/60 transition-colors shadow-sm">
                Today
            </a>
            <a asp-action="Index" asp-route-year="@Model.NextYear" asp-route-month="@Model.NextMonth"
               class="p-2 rounded-xl bg-white dark:bg-slate-900/60 border border-slate-100 dark:border-slate-700 text-slate-500 dark:text-slate-400 hover:text-[#5a43f1] dark:hover:text-[#a78bfa] hover:bg-slate-50 dark:hover:bg-slate-800/60 transition-colors shadow-sm">
                <i data-lucide="chevron-right" class="w-5 h-5"></i>
            </a>
        </div>
    </div>

    <div class="bg-white dark:bg-slate-900/60 rounded-[24px] shadow-sm border border-slate-100 dark:border-slate-700 overflow-hidden">
        <div class="p-6 border-b border-slate-100 dark:border-slate-700 flex items-center gap-3">
            <div class="bg-indigo-50 dark:bg-indigo-950 p-2 rounded-lg"><i data-lucide="calendar-days" class="w-5 h-5 text-indigo-600 dark:text-indigo-300"></i></div>
            <h3 class="font-semibold text-lg text-slate-800 dark:text-slate-100">Class Calendar</h3>
        </div>

        <div class="overflow-x-auto">
            <div class="min-w-[700px]">
                <div class="grid grid-cols-7 border-b border-slate-100 dark:border-slate-700">
                    @foreach (var label in new[] { "Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun" })
                    {
                        <div class="px-3 py-2 text-xs font-semibold text-slate-400 dark:text-slate-500 uppercase tracking-wider text-center">@label</div>
                    }
                </div>

                @foreach (var week in Model.Weeks)
                {
                    <div class="grid grid-cols-7 divide-x divide-slate-100 dark:divide-slate-700 border-b border-slate-100 dark:border-slate-700 last:border-b-0">
                        @foreach (var day in week.Days)
                        {
                            var dayPayload = new
                            {
                                dateLabel = day.Date.ToString("dddd, MMMM d, yyyy"),
                                holidays = day.Holidays.Select(h => new { title = h.Title, description = h.Description }),
                                classes = day.Classes.Select(seg => new
                                {
                                    title = seg.CourseTitle,
                                    scheduleName = seg.ScheduleName,
                                    time = $"{seg.StartTime.ToString(@"hh\:mm")} - {seg.EndTime.ToString(@"hh\:mm")}",
                                    location = seg.Location,
                                    instructorNames = seg.InstructorNames,
                                    meetingLink = seg.MeetingLink
                                })
                            };
                            <button type="button" class="cal-day-cell text-left min-h-[110px] p-2 flex flex-col gap-1.5 @(day.IsCurrentMonth ? "" : "opacity-50") @(day.Holidays.Count > 0 ? "bg-amber-50/60 dark:bg-amber-950/30" : day.IsToday ? "bg-indigo-50/60 dark:bg-indigo-950/40" : "") hover:bg-slate-50 dark:hover:bg-slate-800/60 transition-colors"
                                    data-day='@Html.Raw(System.Text.Json.JsonSerializer.Serialize(dayPayload))'>
                                <div class="flex items-center justify-between">
                                    <span class="text-xs font-semibold inline-flex items-center justify-center w-6 h-6 rounded-full @(day.IsToday ? "bg-[#7c3aed] text-white" : day.IsCurrentMonth ? "text-slate-700 dark:text-slate-200" : "text-slate-300 dark:text-slate-600")">
                                        @day.Date.Day
                                    </span>
                                    @if (day.Holidays.Count > 0)
                                    {
                                        <i data-lucide="calendar-heart" class="w-3.5 h-3.5 text-amber-500 dark:text-amber-400" title="@string.Join(", ", day.Holidays.Select(h => h.Title))"></i>
                                    }
                                </div>
                                <div class="flex-1 space-y-1 overflow-hidden">
                                    @foreach (var holiday in day.Holidays)
                                    {
                                        <div class="text-[11px] truncate rounded-md bg-amber-100 dark:bg-amber-900/60 text-amber-700 dark:text-amber-300 px-1.5 py-0.5 font-medium" title="@holiday.Title@(string.IsNullOrEmpty(holiday.Description) ? "" : $" — {holiday.Description}")">
                                            @holiday.Title
                                        </div>
                                    }
                                    @foreach (var seg in day.Classes)
                                    {
                                        var classTitle = $"{seg.StartTime.ToString(@"hh\:mm")} {seg.CourseTitle}";
                                        var classTip = $"{seg.CourseTitle} ({seg.StartTime.ToString(@"hh\:mm")} - {seg.EndTime.ToString(@"hh\:mm")})";
                                        <div class="text-[11px] truncate rounded-md bg-indigo-50 dark:bg-indigo-950 text-indigo-700 dark:text-indigo-300 px-1.5 py-0.5" title="@classTip">
                                            @classTitle
                                        </div>
                                    }
                                </div>
                            </button>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    @* ---------- Selected-day details panel ---------- *@
    <div id="cal-day-panel" class="hidden bg-white dark:bg-slate-900/60 rounded-[24px] shadow-sm border border-slate-100 dark:border-slate-700 p-6">
        <div class="flex items-center justify-between mb-4">
            <h4 id="cal-day-title" class="font-semibold text-slate-800 dark:text-slate-100"></h4>
            <button type="button" id="cal-day-close" class="p-1.5 rounded-lg text-slate-400 dark:text-slate-500 hover:bg-slate-100 dark:hover:bg-slate-700">
                <i data-lucide="x" class="w-4 h-4"></i>
            </button>
        </div>
        <div id="cal-day-events" class="space-y-2"></div>
    </div>
</div>

<script>
    (function () {
        const dayPanel = document.getElementById('cal-day-panel');
        const dayTitle = document.getElementById('cal-day-title');
        const dayEvents = document.getElementById('cal-day-events');

        function eventCardsHtml(list) {
            if (list.length === 0) return '<p class="text-sm text-slate-400 dark:text-slate-500">No classes on this day.</p>';
            return list.map(e => `
                <div class="p-3 rounded-xl border border-slate-100 dark:border-slate-700 flex items-start justify-between gap-3">
                    <div class="min-w-0">
                        <p class="font-medium text-slate-800 dark:text-slate-100 text-sm mb-1">${e.title}</p>
                        <div class="text-xs text-slate-500 dark:text-slate-400 space-y-0.5">
                            ${e.scheduleName ? `<div>${e.scheduleName}</div>` : ''}
                            ${e.time ? `<div class="flex items-center gap-1"><i data-lucide="clock" class="w-3 h-3"></i> ${e.time}</div>` : ''}
                            ${e.location ? `<div class="flex items-center gap-1"><i data-lucide="map-pin" class="w-3 h-3"></i> ${e.location}</div>` : ''}
                            ${e.instructorNames ? `<div class="flex items-center gap-1"><i data-lucide="user" class="w-3 h-3"></i> ${e.instructorNames}</div>` : ''}
                        </div>
                    </div>
                    ${e.meetingLink ? `<a href="${e.meetingLink}" target="_blank" rel="noopener" class="px-3 py-1.5 rounded-lg font-medium text-xs bg-[#7c3aed] text-white hover:bg-[#6d28d9] transition-colors flex items-center gap-1 flex-shrink-0"><i data-lucide="video" class="w-3.5 h-3.5"></i> Join</a>` : ''}
                </div>
            `).join('');
        }

        function holidayBannerHtml(list) {
            return list.map(h => `
                <div class="p-3 rounded-xl border border-yellow-200 dark:border-yellow-800 bg-yellow-50 dark:bg-yellow-950/40 flex items-center gap-2 mb-2">
                    <i data-lucide="star" class="w-4 h-4 text-yellow-600 dark:text-yellow-400 flex-shrink-0"></i>
                    <span class="text-sm font-medium text-yellow-800 dark:text-yellow-300">Holiday: ${h.title}</span>
                </div>
            `).join('');
        }

        document.querySelectorAll('.cal-day-cell').forEach(cell => {
            cell.addEventListener('click', () => {
                const data = JSON.parse(cell.dataset.day || '{}');
                dayTitle.textContent = data.dateLabel || '';
                dayEvents.innerHTML = holidayBannerHtml(data.holidays || []) + eventCardsHtml(data.classes || []);
                dayPanel.classList.remove('hidden');
                if (window.lucide) lucide.createIcons();
                dayPanel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            });
        });

        document.getElementById('cal-day-close').addEventListener('click', () => dayPanel.classList.add('hidden'));
    })();
</script>
