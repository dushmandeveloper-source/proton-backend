@model Web_Backend.Areas.StudentPortal.Models.StudentDashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="max-w-5xl mx-auto space-y-8 page-enter">

    <div>
        <p class="text-sm font-medium text-slate-500 dark:text-slate-400 mb-2">@DateTime.Now.ToString("ddd, MMMM d")</p>
        <h1 class="text-3xl md:text-4xl font-bold text-slate-800 dark:text-slate-100 tracking-tight">
            Hello, @Model.StudentName
        </h1>
    </div>

    @* ---------- Verification-status banner ---------- *@
    @if (Model.PassportVerificationStatus == "Verified")
    {
        <div class="rounded-[20px] border border-emerald-100 dark:border-emerald-900 bg-emerald-50 dark:bg-emerald-950 p-4 flex items-center gap-3">
            <i data-lucide="badge-check" class="w-5 h-5 text-emerald-600 dark:text-emerald-300 flex-shrink-0"></i>
            <p class="text-sm text-emerald-700 dark:text-emerald-300"><strong>Passport verified.</strong> Your passport details are confirmed and locked against further edits.</p>
        </div>
    }
    else if (Model.PassportVerificationStatus == "Rejected")
    {
        <div class="rounded-[20px] border border-red-100 dark:border-red-900 bg-red-50 dark:bg-red-950 p-4 flex items-center gap-3">
            <i data-lucide="circle-x" class="w-5 h-5 text-red-600 dark:text-red-300 flex-shrink-0"></i>
            <p class="text-sm text-red-700 dark:text-red-300 flex-1"><strong>Passport rejected.</strong> Please update your passport details for review.</p>
            <a asp-area="Student" asp-controller="Profile" asp-action="Index" class="text-sm font-medium text-red-700 dark:text-red-300 underline whitespace-nowrap">Update now</a>
        </div>
    }
    else
    {
        <div class="rounded-[20px] border border-amber-100 dark:border-amber-900 bg-amber-50 dark:bg-amber-950 p-4 flex items-center gap-3">
            <i data-lucide="clock" class="w-5 h-5 text-amber-600 dark:text-amber-300 flex-shrink-0"></i>
            <p class="text-sm text-amber-700 dark:text-amber-300"><strong>Passport pending verification.</strong> An administrator will review your submitted passport details.</p>
        </div>
    }

    @* ---------- This Week's Classes ---------- *@
    <div class="bg-white dark:bg-slate-900/60 rounded-[24px] shadow-sm border border-slate-100 dark:border-slate-700 overflow-hidden">
        <div class="p-6 border-b border-slate-100 dark:border-slate-700 flex items-center gap-3">
            <div class="bg-indigo-50 dark:bg-indigo-950 p-2 rounded-lg"><i data-lucide="calendar-days" class="w-5 h-5 text-indigo-600 dark:text-indigo-300"></i></div>
            <h3 class="font-semibold text-lg text-slate-800 dark:text-slate-100">This Week's Classes</h3>
        </div>
        <div class="divide-y divide-slate-100 dark:divide-slate-700">
            @foreach (var day in Model.WeekSchedule)
            {
                <div class="p-5 flex flex-col md:flex-row gap-3 md:gap-6">
                    <div class="md:w-32 flex-shrink-0">
                        <p class="text-sm font-semibold text-slate-800 dark:text-slate-100">@day.DayLabel</p>
                        <p class="text-xs text-slate-400 dark:text-slate-500">@day.Date.ToString("MMM d")</p>
                    </div>
                    <div class="flex-1 space-y-2">
                        @if (day.Segments.Count == 0)
                        {
                            <p class="text-sm text-slate-400 dark:text-slate-500">No classes</p>
                        }
                        else
                        {
                            @foreach (var seg in day.Segments)
                            {
                                <div class="rounded-xl bg-slate-50 dark:bg-slate-800/60 border border-slate-100 dark:border-slate-700 px-4 py-3">
                                    <p class="text-sm font-semibold text-slate-800 dark:text-slate-100">@seg.CourseTitle</p>
                                    <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
                                        @seg.ScheduleName &middot; @seg.StartTime.ToString(@"hh\:mm") - @seg.EndTime.ToString(@"hh\:mm") &middot; @seg.Location
                                    </p>
                                    @if (!string.IsNullOrEmpty(seg.InstructorNames))
                                    {
                                        <p class="text-xs text-slate-400 dark:text-slate-500 mt-0.5">Instructor(s): @seg.InstructorNames</p>
                                    }
                                </div>
                            }
                        }
                    </div>
                </div>
            }
        </div>
    </div>

    @* ---------- Enrolled Courses + stat tiles ---------- *@
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-white dark:bg-slate-900/60 p-6 rounded-[24px] shadow-sm border border-slate-100 dark:border-slate-700">
            <div class="p-3 rounded-2xl bg-purple-50 dark:bg-purple-950 text-purple-600 dark:text-purple-300 w-fit mb-4"><i data-lucide="book-open" class="w-5 h-5"></i></div>
            <h3 class="text-3xl font-bold text-slate-800 dark:text-slate-100 mb-1">@(Model.Summary?.CourseCount ?? 0)</h3>
            <p class="text-sm text-slate-500 dark:text-slate-400 font-medium">Enrolled Courses</p>
        </div>
        <div class="bg-white dark:bg-slate-900/60 p-6 rounded-[24px] shadow-sm border border-slate-100 dark:border-slate-700">
            <div class="p-3 rounded-2xl bg-emerald-50 dark:bg-emerald-950 text-emerald-600 dark:text-emerald-300 w-fit mb-4"><i data-lucide="badge-dollar-sign" class="w-5 h-5"></i></div>
            <h3 class="text-3xl font-bold text-slate-800 dark:text-slate-100 mb-1">@(Model.Summary?.TotalPaid.ToString("N2") ?? "0.00")</h3>
            <p class="text-sm text-slate-500 dark:text-slate-400 font-medium">Total Paid</p>
        </div>
        <div class="bg-white dark:bg-slate-900/60 p-6 rounded-[24px] shadow-sm border border-slate-100 dark:border-slate-700">
            <div class="p-3 rounded-2xl bg-amber-50 dark:bg-amber-950 text-amber-600 dark:text-amber-300 w-fit mb-4"><i data-lucide="circle-dollar-sign" class="w-5 h-5"></i></div>
            <h3 class="text-3xl font-bold text-slate-800 dark:text-slate-100 mb-1">@(Model.Summary?.TotalBalance.ToString("N2") ?? "0.00")</h3>
            <p class="text-sm text-slate-500 dark:text-slate-400 font-medium">Total Balance</p>
        </div>
    </div>

    <div class="bg-white dark:bg-slate-900/60 rounded-[24px] shadow-sm border border-slate-100 dark:border-slate-700 overflow-hidden">
        <div class="p-6 border-b border-slate-100 dark:border-slate-700 flex items-center gap-3">
            <div class="bg-purple-50 dark:bg-purple-950 p-2 rounded-lg"><i data-lucide="graduation-cap" class="w-5 h-5 text-purple-600 dark:text-purple-300"></i></div>
            <h3 class="font-semibold text-lg text-slate-800 dark:text-slate-100">Enrolled Courses</h3>
        </div>
        @if (Model.Registrations.Count == 0)
        {
            <div class="p-10 text-center">
                <p class="text-sm text-slate-400 dark:text-slate-500">You are not enrolled in any courses yet.</p>
            </div>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="w-full text-sm">
                    <thead>
                        <tr class="text-left text-xs font-semibold text-slate-400 dark:text-slate-500 uppercase tracking-wider border-b border-slate-100 dark:border-slate-700">
                            <th class="px-6 py-3">Course</th>
                            <th class="px-6 py-3">Status</th>
                            <th class="px-6 py-3">Fee</th>
                            <th class="px-6 py-3">Paid</th>
                            <th class="px-6 py-3">Balance</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 dark:divide-slate-700">
                        @foreach (var reg in Model.Registrations)
                        {
                            <tr>
                                <td class="px-6 py-3 font-medium text-slate-800 dark:text-slate-100">@reg.CourseTitle</td>
                                <td class="px-6 py-3">
                                    <span class="inline-flex px-2.5 py-1 rounded-full text-xs font-medium @(reg.PaymentStatus == "Paid" ? "bg-emerald-50 dark:bg-emerald-950 text-emerald-600 dark:text-emerald-300" : reg.PaymentStatus == "PartiallyPaid" ? "bg-amber-50 dark:bg-amber-950 text-amber-600 dark:text-amber-300" : "bg-slate-100 dark:bg-slate-800 text-slate-500 dark:text-slate-400")">
                                        @reg.PaymentStatus
                                    </span>
                                </td>
                                <td class="px-6 py-3 text-slate-600 dark:text-slate-300">@reg.CurrencyCode @reg.CourseFee.ToString("N2")</td>
                                <td class="px-6 py-3 text-slate-600 dark:text-slate-300">@reg.CurrencyCode @reg.AmountPaid.ToString("N2")</td>
                                <td class="px-6 py-3 text-slate-600 dark:text-slate-300">@reg.CurrencyCode @reg.BalanceDue.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    @* ---------- Pending Payments ---------- *@
    <div class="bg-white dark:bg-slate-900/60 rounded-[24px] shadow-sm border border-slate-100 dark:border-slate-700 overflow-hidden">
        <div class="p-6 border-b border-slate-100 dark:border-slate-700 flex items-center gap-3">
            <div class="bg-amber-50 dark:bg-amber-950 p-2 rounded-lg"><i data-lucide="wallet" class="w-5 h-5 text-amber-600 dark:text-amber-300"></i></div>
            <h3 class="font-semibold text-lg text-slate-800 dark:text-slate-100">Pending Payments</h3>
        </div>
        @{
            var pending = Model.Registrations.Where(r => r.BalanceDue > 0).ToList();
        }
        @if (Model.Summary == null)
        {
            <div class="p-10 text-center">
                <p class="text-sm text-slate-400 dark:text-slate-500">No enrollments yet.</p>
            </div>
        }
        else if (pending.Count == 0)
        {
            <div class="p-10 text-center">
                <p class="text-sm text-slate-400 dark:text-slate-500">No pending payments — you're all caught up.</p>
            </div>
        }
        else
        {
            <div class="divide-y divide-slate-100 dark:divide-slate-700">
                @foreach (var reg in pending)
                {
                    <div class="p-4 px-6 flex items-center justify-between gap-4">
                        <p class="text-sm font-medium text-slate-800 dark:text-slate-100">@reg.CourseTitle</p>
                        <div class="flex items-center gap-3 flex-shrink-0">
                            <p class="text-sm font-semibold text-amber-600 dark:text-amber-300">@reg.CurrencyCode @reg.BalanceDue.ToString("N2") due</p>
                            <a asp-area="Student" asp-controller="Courses" asp-action="PayBalance" asp-route-registrationId="@reg.RegistrationID"
                               class="px-3 py-1.5 rounded-lg font-medium text-xs bg-[#7c3aed] text-white hover:bg-[#6d28d9] transition-all">
                                Pay Now
                            </a>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <div class="flex justify-center pb-4">
        <a asp-area="Student" asp-controller="Enrollment" asp-action="Browse"
           class="px-6 py-3 rounded-xl font-medium text-sm bg-[#7c3aed] text-white hover:bg-[#6d28d9] shadow-sm transition-all flex items-center gap-2">
            <i data-lucide="plus" class="w-4 h-4"></i> Enroll in a New Course
        </a>
    </div>
</div>
