@model Web_Backend.Areas.StudentPortal.Models.StudentDashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    var currentUser = ViewBag.CurrentUser as Web_Backend.Areas.Admin.Models.SessionUser;

    // A course segment's Join link is only shown when that course's own
    // registration has FullAccess -- separate from Model.IsContentRestricted,
    // which is an account-wide verification gate, not a per-course one.
    bool HasCourseFullAccess(string courseId) =>
        !Model.Registrations.Any(r => r.CourseID == courseId && r.IsActive == "A" && !r.FullAccess);
}

<div class="max-w-5xl mx-auto space-y-8 page-enter">

    <div>
        <div class="flex flex-wrap items-center gap-x-3 gap-y-2 mb-3">
            <p class="text-sm font-medium text-slate-500 dark:text-slate-400">@Web_Backend.Classes.SriLankaTime.Now.ToString("ddd, MMMM d")</p>
            <div class="inline-flex items-center gap-1.5">@await Html.PartialAsync("~/Views/Shared/_DualClock.cshtml") @await Html.PartialAsync("_ZonePicker")</div>
        </div>
        <h1 class="text-3xl md:text-4xl font-bold text-slate-800 dark:text-slate-100 tracking-tight">
            Hello, @Model.StudentName
        </h1>
    </div>

    @* ---------- Verification-status banner ---------- *@
    @if (Model.ShowPassportVerifiedBanner)
    {
        <div class="rounded-[20px] border border-emerald-100 dark:border-emerald-900 bg-emerald-50 dark:bg-emerald-950 p-4 flex items-center gap-3">
            <i data-lucide="badge-check" class="w-5 h-5 text-emerald-600 dark:text-emerald-300 flex-shrink-0"></i>
            <p class="text-sm text-emerald-700 dark:text-emerald-300"><strong>Passport verified.</strong> Your passport details are confirmed and locked against further edits.</p>
        </div>
    }
    else if (Model.PassportVerificationStatus == "Rejected")
    {
        <div class="rounded-[20px] border border-red-100 dark:border-red-900 bg-red-50 dark:bg-red-950 p-4 flex items-center gap-3">
            <i data-lucide="circle-x" class="w-5 h-5 text-red-600 dark:text-red-300 flex-shrink-0"></i>
            <p class="text-sm text-red-700 dark:text-red-300 flex-1"><strong>Passport rejected.</strong> Please update your passport details for review.</p>
            <a asp-area="Student" asp-controller="Profile" asp-action="Index" class="text-sm font-medium text-red-700 dark:text-red-300 underline whitespace-nowrap">Update now</a>
        </div>
    }
    else if (Model.PassportVerificationStatus != "Verified")
    {
        <div class="rounded-[20px] border border-amber-100 dark:border-amber-900 bg-amber-50 dark:bg-amber-950 p-4 flex items-center gap-3">
            <i data-lucide="clock" class="w-5 h-5 text-amber-600 dark:text-amber-300 flex-shrink-0"></i>
            <p class="text-sm text-amber-700 dark:text-amber-300"><strong>Passport pending verification.</strong> An administrator will review your submitted passport details.</p>
        </div>
    }

    @if (Model.IsContentRestricted)
    {
        <div class="rounded-[20px] border border-amber-100 dark:border-amber-900 bg-amber-50 dark:bg-amber-950 p-4 flex items-center gap-3">
            <i data-lucide="clock" class="w-5 h-5 text-amber-600 dark:text-amber-300 flex-shrink-0"></i>
            <p class="text-sm text-amber-700 dark:text-amber-300"><strong>Your account is still being verified.</strong> You can browse and join courses and make payments — course materials and joining links unlock once an administrator verifies your account.</p>
        </div>
    }

    @if (Model.PendingDocumentRequestCount > 0)
    {
        <a asp-area="Student" asp-controller="DocumentRequest" asp-action="Index"
           class="rounded-[20px] border border-orange-100 dark:border-orange-900 bg-orange-50 dark:bg-orange-950 p-4 flex items-center gap-3 hover:bg-orange-100 dark:hover:bg-orange-900 transition-colors">
            <i data-lucide="folder-up" class="w-5 h-5 text-orange-600 dark:text-orange-300 flex-shrink-0"></i>
            <p class="text-sm text-orange-700 dark:text-orange-300 flex-1">
                <strong>@Model.PendingDocumentRequestCount document@(Model.PendingDocumentRequestCount == 1 ? "" : "s") need@(Model.PendingDocumentRequestCount == 1 ? "s" : "") your attention.</strong>
                Administration has requested a document from you, or asked you to resubmit one.
            </p>
            <span class="text-sm font-medium text-orange-700 dark:text-orange-300 whitespace-nowrap">View &rarr;</span>
        </a>
    }

    @* A student with no enrolments has an empty dashboard — surface the next
       step up here as a banner rather than leaving them to find the empty
       "Enrolled Courses" card further down the page. *@
    @if (Model.Registrations.Count == 0)
    {
        <div class="rounded-[20px] border border-purple-100 dark:border-purple-900 bg-purple-50 dark:bg-purple-950 p-4 flex items-center gap-3">
            <i data-lucide="graduation-cap" class="w-5 h-5 text-purple-600 dark:text-purple-300 flex-shrink-0"></i>
            <p class="text-sm text-purple-700 dark:text-purple-300 flex-1"><strong>You're not enrolled in any courses yet.</strong> Browse the available courses to get started.</p>
            <a asp-area="Student" asp-controller="Enrollment" asp-action="Browse" class="text-sm font-medium text-purple-700 dark:text-purple-300 underline whitespace-nowrap">Enroll now</a>
        </div>
    }

    @* Android app, on every device: Download (in-page, with progress and the
       install steps) or the plain APK link to open/copy/share. On Android the
       layout's app-offer script switches Download to "Installed" + Open. *@
    @{ var apkUrl = $"{Context.Request.Scheme}://{Context.Request.Host}{Web_Backend.Controllers.StudentAppDownloadController.ApkRoute}"; }
    <div class="rounded-2xl border border-[#7c3aed]/20 bg-[#7c3aed]/[0.06] dark:bg-[#7c3aed]/15 px-3 py-2.5 flex flex-wrap items-center gap-x-3 gap-y-2">
        <div class="w-8 h-8 rounded-lg bg-[#7c3aed] text-white flex items-center justify-center flex-shrink-0">
            <i data-lucide="smartphone" class="w-4 h-4"></i>
        </div>
        <div class="flex-1 min-w-[11rem]">
            <p class="text-sm font-semibold text-slate-800 dark:text-slate-100 leading-tight truncate">Proton Student app <span class="font-normal text-slate-500 dark:text-slate-400">&middot; Android</span></p>
            <p class="text-xs text-slate-500 dark:text-slate-400 truncate" data-app-status>Schedule, exams and alerts on your phone</p>
        </div>
        <div class="flex items-center gap-2 ml-auto">
        <button type="button" data-app-copy title="Copy the APK link (@apkUrl)"
                class="inline-flex items-center gap-1 h-8 px-2 rounded-lg text-xs font-medium text-[#5a43f1] dark:text-[#a78bfa] hover:bg-[#7c3aed]/10 transition-colors flex-shrink-0">
            <i data-lucide="link" class="w-3.5 h-3.5"></i><span class="hidden sm:inline">Copy link</span>
        </button>
        <button type="button" data-app-download
                class="inline-flex items-center gap-1.5 h-8 px-3 rounded-lg bg-[#7c3aed] text-white text-xs font-semibold hover:bg-[#6d28d9] transition-colors flex-shrink-0 disabled:bg-slate-300 disabled:text-slate-600 dark:disabled:bg-slate-700 dark:disabled:text-slate-300 disabled:cursor-not-allowed">
            <i data-lucide="download" class="w-3.5 h-3.5"></i><span>Download</span>
        </button>
        <a data-app-open href="#"
           class="hidden inline-flex items-center gap-1.5 h-8 px-3 rounded-lg bg-[#7c3aed] text-white text-xs font-semibold hover:bg-[#6d28d9] transition-colors flex-shrink-0">
            <i data-lucide="external-link" class="w-3.5 h-3.5"></i>Open
        </a>
        </div>
    </div>


    <partial name="_OnlineAssignments" />

    @* ---------- This Week (classes + exams) ---------- *@
    @* Without an enrolment this is just seven rows of "Nothing scheduled",
       which adds nothing — the banner above already says what to do instead. *@
    @{
        var examJoinRows = ViewBag.ExamJoinRows as Dictionary<string, Web_Backend.Areas.Admin.Models.ExamJoinRow>;
    }
    @if (Model.Registrations.Count > 0)
    {
    <div class="bg-white dark:bg-slate-900/60 rounded-[24px] shadow-sm border border-slate-100 dark:border-slate-700 overflow-hidden">
        <div class="p-6 border-b border-slate-100 dark:border-slate-700 flex items-center gap-3">
            <div class="bg-indigo-50 dark:bg-indigo-950 p-2 rounded-lg"><i data-lucide="calendar-days" class="w-5 h-5 text-indigo-600 dark:text-indigo-300"></i></div>
            <h3 class="font-semibold text-lg text-slate-800 dark:text-slate-100">This Week</h3>
        </div>
        <div class="divide-y divide-slate-100 dark:divide-slate-700">
            @foreach (var day in Model.WeekSchedule)
            {
                <div class="p-5 flex flex-col md:flex-row gap-3 md:gap-6">
                    <div class="md:w-32 flex-shrink-0">
                        <p class="text-sm font-semibold text-slate-800 dark:text-slate-100">@day.DayLabel</p>
                        <p class="text-xs text-slate-400 dark:text-slate-500">@day.Date.ToString("MMM d")</p>
                    </div>
                    <div class="flex-1 space-y-2">
                        @if (day.Segments.Count == 0)
                        {
                            <p class="text-sm text-slate-400 dark:text-slate-500">Nothing scheduled</p>
                        }
                        else
                        {
                            @foreach (var seg in day.Segments)
                            {
                                var isExam = seg.Kind == "Exam";

                                // Course rows: Join unlocks 15 min before StartTime and closes
                                // 30 min after EndTime (classes often run a little over).
                                var joinAt = day.Date.Date.Add(seg.StartTime).AddMinutes(-15);
                                var joinUntil = day.Date.Date.Add(seg.EndTime).AddMinutes(30);

                                // Exam rows: Join is gated by the exam's own availability
                                // window + MaxAttempts (edu.ExamAttempt_Start enforces this
                                // server-side regardless of what's shown here) AND by this
                                // specific row's date being today — the same exam can span
                                // several days in the weekly grid, but only today's row
                                // should ever show an active button, so it's never ambiguous
                                // which day's row you're actually starting the attempt from.
                                Web_Backend.Areas.Admin.Models.ExamJoinRow? examJoin = null;
                                if (isExam && examJoinRows != null)
                                    examJoinRows.TryGetValue(seg.CourseID, out examJoin);
                                var isToday = day.Date.Date == Web_Backend.Classes.ScheduleTime.Now(seg.TimeZone).Date;
                                var canJoinToday = isExam && isToday && examJoin != null && examJoin.CanJoin;

                                <div class="rounded-xl border px-4 py-3 flex flex-col sm:flex-row sm:items-start sm:justify-between gap-3 @(isExam ? "bg-amber-50 dark:bg-amber-950/40 border-amber-200 dark:border-amber-800" : "bg-slate-50 dark:bg-slate-800/60 border-slate-100 dark:border-slate-700")">
                                    <div class="min-w-0">
                                        <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
                                            <span class="inline-flex px-2 py-0.5 rounded-full text-[10px] font-semibold uppercase tracking-wide @(isExam ? "bg-amber-100 dark:bg-amber-900 text-amber-700 dark:text-amber-300" : "bg-indigo-50 dark:bg-indigo-950 text-indigo-600 dark:text-indigo-300")">
                                                @(isExam ? "Exam" : "Course")
                                            </span>
                                            <p class="text-sm font-semibold text-slate-800 dark:text-slate-100 leading-snug">@seg.CourseTitle</p>
                                        </div>
                                        <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
                                            @seg.ScheduleName@(string.IsNullOrEmpty(seg.Location) ? "" : " · " + seg.Location)
                                        </p>
                                        <div class="flex flex-wrap items-center gap-1.5 mt-1.5 text-[11px] font-semibold">
                                            <span class="inline-flex flex-wrap gap-1.5" data-tz-start="@Web_Backend.Classes.ScheduleTime.IsoAt(day.Date, seg.StartTime, seg.TimeZone)" data-tz-end="@Web_Backend.Classes.ScheduleTime.IsoAt(day.Date, seg.EndTime, seg.TimeZone)">
                                                <span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded-md bg-red-50 dark:bg-red-950/50 text-red-700 dark:text-red-300 whitespace-nowrap">🇨🇳 @Web_Backend.Classes.ScheduleTime.RangeIn(day.Date, seg.StartTime, seg.EndTime, seg.TimeZone, Web_Backend.Classes.ScheduleTime.China)</span>
                                                <span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded-md bg-amber-50 dark:bg-amber-950/50 text-amber-800 dark:text-amber-300 whitespace-nowrap">🇱🇰 @Web_Backend.Classes.ScheduleTime.RangeIn(day.Date, seg.StartTime, seg.EndTime, seg.TimeZone, Web_Backend.Classes.ScheduleTime.SriLanka)</span>
                                            </span>
                                        </div>
                                        @if (!string.IsNullOrEmpty(seg.InstructorNames))
                                        {
                                            <p class="text-xs text-slate-400 dark:text-slate-500 mt-0.5">Instructor(s): @seg.InstructorNames</p>
                                        }
                                        @if (isExam && examJoin != null)
                                        {
                                            <p class="text-xs text-slate-400 dark:text-slate-500 mt-0.5">Attempts used: @examJoin.AttemptsUsed / @examJoin.MaxAttempts</p>
                                        }
                                    </div>

                                    @if (isExam)
                                    {
                                        @if (isToday && examJoin != null && examJoin.ShowPendingReviewInstead)
                                        {
                                            <a asp-area="Student" asp-controller="MyResults" asp-action="Index"
                                               class="px-3 py-1.5 rounded-lg font-medium text-xs bg-blue-50 dark:bg-blue-950 text-blue-700 dark:text-blue-300 hover:bg-blue-100 dark:hover:bg-blue-900 transition-colors flex items-center gap-1 flex-shrink-0 self-start sm:self-auto"
                                               title="Your last attempt is still being graded/approved">
                                                <i data-lucide="clock" class="w-3.5 h-3.5"></i> Pending Review
                                            </a>
                                        }
                                        else if (canJoinToday)
                                        {
                                            <a href="/Student/ExamAttempt/Start?examId=@seg.CourseID"
                                               class="px-3 py-1.5 rounded-lg font-medium text-xs bg-amber-500 text-slate-900 hover:bg-amber-600 transition-colors flex items-center gap-1 flex-shrink-0 self-start sm:self-auto">
                                                <i data-lucide="file-edit" class="w-3.5 h-3.5"></i> Join Exam
                                            </a>
                                        }
                                        else if (examJoin != null && !examJoin.HasFullAccess)
                                        {
                                            <a href="@Url.Action("RequestAccess", "Classroom", new { area = "Student", course = seg.CourseTitle })" target="_blank" rel="noopener"
                                               class="px-3 py-1.5 rounded-lg font-medium text-xs bg-emerald-50 dark:bg-emerald-950 text-emerald-700 dark:text-emerald-300 hover:bg-emerald-100 dark:hover:bg-emerald-900 transition-colors flex items-center gap-1.5 flex-shrink-0 self-start sm:self-auto"
                                               title="Pay the full course fee to unlock, or request access from admin">
                                                <i data-lucide="message-circle" class="w-3.5 h-3.5"></i> Request Access
                                            </a>
                                        }
                                        else
                                        {
                                            var opensLater = isToday && examJoin != null && !examJoin.IsWithinWindow && examJoin.HasFullAccess
                                                && examJoin.AttemptsUsed < examJoin.MaxAttempts && examJoin.WindowStart.HasValue
                                                && examJoin.WindowStart.Value > Web_Backend.Classes.ScheduleTime.Now(examJoin.TimeZone);
                                            string? opensAtIso = opensLater ? examJoin!.WindowStart!.Value.ToString("yyyy-MM-ddTHH:mm:ss") + Web_Backend.Classes.ScheduleTime.IsoOffset(examJoin.TimeZone) : null;
                                            <div class="flex flex-col items-start sm:items-end gap-0.5 flex-shrink-0 self-start sm:self-auto">
                                                <span class="px-3 py-1.5 rounded-lg font-medium text-xs bg-slate-100 dark:bg-slate-800 text-slate-400 dark:text-slate-500 cursor-not-allowed flex items-center gap-1"
                                                      @Html.Raw(opensLater ? $"data-exam-open-at=\"{opensAtIso}\" data-exam-url=\"/Student/ExamAttempt/Start?examId={System.Net.WebUtility.HtmlEncode(seg.CourseID)}\" data-exam-title=\"{System.Net.WebUtility.HtmlEncode(seg.CourseTitle)}\"" : "")
                                                      title="@(!isToday ? "Only available on the scheduled day" : examJoin != null && !examJoin.IsWithinWindow ? "Not open yet" : "Maximum attempts reached")">
                                                    <i data-lucide="file-edit" class="w-3.5 h-3.5"></i> Join Exam
                                                </span>
                                                @if (opensLater)
                                                {
                                                    <span class="join-hint text-[10px] text-slate-500 dark:text-slate-400"></span>
                                                }
                                            </div>
                                        }
                                    }
                                    else if (!Model.IsContentRestricted && !string.IsNullOrEmpty(seg.MeetingLink) && HasCourseFullAccess(seg.CourseID))
                                    {
                                        @if (isToday)
                                        {
                                            <div class="flex flex-col items-start sm:items-end gap-0.5 flex-shrink-0 self-start sm:self-auto">
                                            <a href="@seg.MeetingLink" target="_blank" rel="noopener" data-join-link data-join-title="@seg.CourseTitle" data-join-at="@joinAt.ToString("yyyy-MM-ddTHH:mm:ss")@Web_Backend.Classes.ScheduleTime.IsoOffset(seg.TimeZone)" data-join-until="@joinUntil.ToString("yyyy-MM-ddTHH:mm:ss")@Web_Backend.Classes.ScheduleTime.IsoOffset(seg.TimeZone)"
                                               class="join-link px-3 py-1.5 rounded-lg font-medium text-xs bg-[#7c3aed] text-white hover:bg-[#6d28d9] transition-colors flex items-center gap-1 flex-shrink-0 self-start sm:self-auto">
                                                <i data-lucide="video" class="w-3.5 h-3.5"></i> <span class="join-label">Join</span>
                                            </a>
                                            <span class="join-hint text-[10px] text-slate-500 dark:text-slate-400"></span>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="px-3 py-1.5 rounded-lg font-medium text-xs bg-slate-100 dark:bg-slate-800 text-slate-400 dark:text-slate-500 cursor-not-allowed flex-shrink-0 self-start sm:self-auto"
                                                  title="Only available on the scheduled day">
                                                Join
                                            </span>
                                        }
                                    }
                                    else if (!isExam && !Model.IsContentRestricted && string.IsNullOrEmpty(seg.MeetingLink) && HasCourseFullAccess(seg.CourseID))
                                    {
                                        <div class="flex flex-col items-start sm:items-end gap-0.5 flex-shrink-0 self-start sm:self-auto">
                                            <span class="px-3 py-1.5 rounded-lg font-medium text-xs bg-slate-100 dark:bg-slate-800 text-slate-400 dark:text-slate-500 cursor-not-allowed flex items-center gap-1" title="The meeting link hasn't been added yet">
                                                <i data-lucide="video" class="w-3.5 h-3.5"></i> Join
                                            </span>
                                            <span class="text-[10px] text-slate-500 dark:text-slate-400">Link not added yet</span>
                                        </div>
                                    }
                                    else if (!Model.IsContentRestricted && !string.IsNullOrEmpty(seg.MeetingLink) && !HasCourseFullAccess(seg.CourseID))
                                    {
                                        <a href="@Url.Action("RequestAccess", "Classroom", new { area = "Student", course = seg.CourseTitle })" target="_blank" rel="noopener"
                                           class="px-3 py-1.5 rounded-lg font-medium text-xs bg-emerald-50 dark:bg-emerald-950 text-emerald-700 dark:text-emerald-300 hover:bg-emerald-100 dark:hover:bg-emerald-900 transition-colors flex items-center gap-1.5 flex-shrink-0 self-start sm:self-auto"
                                           title="Pay the full course fee to unlock, or request access from admin">
                                            <i data-lucide="message-circle" class="w-3.5 h-3.5"></i> Request Access
                                        </a>
                                    }
                                </div>
                            }
                        }
                    </div>
                </div>
            }
        </div>
    </div>
    <script>
        (function () {
            // Course Join links: shown from the start as a greyed "Join" with
            // "Opens 🇨🇳 … · 🇱🇰 …" under it; enabled live 15 min before class
            // (joinAt, server-computed in the schedule's zone) until 30 min
            // after the end. Exam buttons that open later today flip live too
            // (the server re-checks on Start). When either opens, the student
            // gets an on-page "Join now" toast + a browser notification (if allowed).
            function formatTime(date) {
                // Fixed zones, so a wrong phone/PC zone never shows a misleading time.
                var f = function (z) { return date.toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit', timeZone: z }); };
                return '🇨🇳 ' + f('Asia/Shanghai') + ' · 🇱🇰 ' + f('Asia/Colombo');
            }
            function hintOf(el) {
                var box = el.parentElement;
                return box ? box.querySelector('.join-hint') : null;
            }

            var notified = {};
            function notify(key, title, body, url, external) {
                if (notified[key]) return;
                notified[key] = true;
                var toast = document.createElement('div');
                toast.setAttribute('role', 'status');
                toast.className = 'fixed z-50 bottom-4 right-4 left-4 sm:left-auto sm:w-96 rounded-2xl shadow-xl border border-[#7c3aed]/30 bg-white dark:bg-slate-900 p-4 flex items-start gap-3';
                toast.innerHTML = '<div class="w-9 h-9 rounded-xl bg-[#7c3aed] text-white flex items-center justify-center flex-shrink-0"><i data-lucide="bell-ring" class="w-4 h-4"></i></div>'
                    + '<div class="flex-1 min-w-0"><p class="text-sm font-semibold text-slate-800 dark:text-slate-100"></p><p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5"></p>'
                    + '<div class="mt-2 flex gap-2"><a class="inline-flex items-center gap-1 px-3 py-1.5 rounded-lg bg-[#7c3aed] text-white text-xs font-semibold hover:bg-[#6d28d9]">Join now</a>'
                    + '<button type="button" class="px-3 py-1.5 rounded-lg text-xs font-medium text-slate-500 hover:bg-slate-100 dark:hover:bg-slate-800">Later</button></div></div>';
                var ps = toast.querySelectorAll('p');
                ps[0].textContent = title;
                ps[1].textContent = body;
                var a = toast.querySelector('a');
                a.href = url;
                if (external) { a.target = '_blank'; a.rel = 'noopener'; }
                a.addEventListener('click', function () { toast.remove(); });
                toast.querySelector('button').addEventListener('click', function () { toast.remove(); });
                document.body.appendChild(toast);
                if (window.lucide) lucide.createIcons();
                try {
                    if ('Notification' in window && Notification.permission === 'granted') {
                        var n = new Notification(title, { body: body, tag: key });
                        n.onclick = function () { window.focus(); window.open(url, external ? '_blank' : '_self'); n.close(); };
                    }
                } catch (e) { }
            }

            function refreshJoinLinks() {
                var now = new Date();
                document.querySelectorAll('[data-join-link]').forEach(function (link) {
                    var joinAt = new Date(link.dataset.joinAt || '');
                    if (isNaN(joinAt.getTime())) return;
                    var joinUntil = link.dataset.joinUntil ? new Date(link.dataset.joinUntil) : null;
                    var label = link.querySelector('.join-label');
                    var hint = hintOf(link);
                    var off = function (on) {
                        link.classList.toggle('opacity-40', on);
                        link.classList.toggle('cursor-not-allowed', on);
                        link.classList.toggle('pointer-events-none', on);
                        if (on) link.setAttribute('aria-disabled', 'true'); else link.removeAttribute('aria-disabled');
                    };
                    if (joinUntil && now > joinUntil) {
                        off(true);
                        if (label) label.textContent = 'Class ended';
                        if (hint) hint.textContent = '';
                    } else if (now >= joinAt) {
                        off(false);
                        if (label) label.textContent = 'Join';
                        if (hint) hint.textContent = 'Open now';
                        notify('class:' + link.href + link.dataset.joinAt, 'Class is starting — join now',
                            (link.dataset.joinTitle || 'Your class') + ' · ' + formatTime(joinAt), link.href, true);
                    } else {
                        off(true);
                        if (label) label.textContent = 'Join';
                        if (hint) hint.textContent = 'Opens ' + formatTime(joinAt);
                    }
                });

                document.querySelectorAll('[data-exam-open-at]').forEach(function (btn) {
                    var openAt = new Date(btn.dataset.examOpenAt || '');
                    if (!btn.dataset.examUrl || isNaN(openAt.getTime())) return; // not an "opens later today" exam
                    var hint = hintOf(btn);
                    if (now < openAt) {
                        if (hint) hint.textContent = 'Opens ' + formatTime(openAt);
                        return;
                    }
                    // Window opened while the page was open: turn it into the real button.
                    var a = document.createElement('a');
                    a.href = btn.dataset.examUrl;
                    a.className = 'px-3 py-1.5 rounded-lg font-medium text-xs bg-amber-500 text-slate-900 hover:bg-amber-600 transition-colors flex items-center gap-1';
                    a.innerHTML = '<i data-lucide="file-edit" class="w-3.5 h-3.5"></i> Join Exam';
                    btn.replaceWith(a);
                    if (hint) hint.textContent = 'Open now';
                    if (window.lucide) lucide.createIcons();
                    notify('exam:' + btn.dataset.examUrl, 'Exam is open — join now', (btn.dataset.examTitle || 'Your exam') + ' · ' + formatTime(openAt), btn.dataset.examUrl, false);
                });
            }

            // Ask once for browser notifications when there is something to join today.
            if ('Notification' in window && Notification.permission === 'default'
                && document.querySelector('[data-join-link], [data-exam-open-at]')) {
                document.addEventListener('click', function ask() {
                    document.removeEventListener('click', ask);
                    try { Notification.requestPermission(); } catch (e) { }
                });
            }

            refreshJoinLinks();
            setInterval(refreshJoinLinks, 15000);
        })();
    </script>
    }

    @* ---------- Enrolled Courses + stat tiles ---------- *@
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-white dark:bg-slate-900/60 p-6 rounded-[24px] shadow-sm border border-slate-100 dark:border-slate-700">
            <div class="p-3 rounded-2xl bg-purple-50 dark:bg-purple-950 text-purple-600 dark:text-purple-300 w-fit mb-4"><i data-lucide="book-open" class="w-5 h-5"></i></div>
            <h3 class="text-3xl font-bold text-slate-800 dark:text-slate-100 mb-1">@(Model.Summary?.CourseCount ?? 0)</h3>
            <p class="text-sm text-slate-500 dark:text-slate-400 font-medium">Enrolled Courses</p>
        </div>
        <div class="bg-white dark:bg-slate-900/60 p-6 rounded-[24px] shadow-sm border border-slate-100 dark:border-slate-700">
            <div class="p-3 rounded-2xl bg-emerald-50 dark:bg-emerald-950 text-emerald-600 dark:text-emerald-300 w-fit mb-4"><i data-lucide="badge-dollar-sign" class="w-5 h-5"></i></div>
            <h3 class="text-3xl font-bold text-slate-800 dark:text-slate-100 mb-1">@(Model.Summary?.TotalPaid.ToString("N2") ?? "0.00")</h3>
            <p class="text-sm text-slate-500 dark:text-slate-400 font-medium">Total Paid</p>
        </div>
        <div class="bg-white dark:bg-slate-900/60 p-6 rounded-[24px] shadow-sm border border-slate-100 dark:border-slate-700">
            <div class="p-3 rounded-2xl bg-amber-50 dark:bg-amber-950 text-amber-600 dark:text-amber-300 w-fit mb-4"><i data-lucide="circle-dollar-sign" class="w-5 h-5"></i></div>
            <h3 class="text-3xl font-bold text-slate-800 dark:text-slate-100 mb-1">@(Model.Summary?.TotalBalance.ToString("N2") ?? "0.00")</h3>
            <p class="text-sm text-slate-500 dark:text-slate-400 font-medium">Total Balance</p>
        </div>
    </div>

    @* Hidden entirely when empty — the banner at the top of the page already
       carries this message and its "Enroll now" link, and repeating the same
       call to action twice on one screen just adds noise. *@
    @if (Model.Registrations.Count > 0)
    {
    <div class="bg-white dark:bg-slate-900/60 rounded-[24px] shadow-sm border border-slate-100 dark:border-slate-700 overflow-hidden">
        <div class="p-6 border-b border-slate-100 dark:border-slate-700 flex items-center gap-3">
            <div class="bg-purple-50 dark:bg-purple-950 p-2 rounded-lg"><i data-lucide="graduation-cap" class="w-5 h-5 text-purple-600 dark:text-purple-300"></i></div>
            <h3 class="font-semibold text-lg text-slate-800 dark:text-slate-100">Enrolled Courses</h3>
        </div>
        <div class="overflow-x-auto">
                <table class="w-full text-sm">
                    <thead>
                        <tr class="text-left text-xs font-semibold text-slate-400 dark:text-slate-500 uppercase tracking-wider border-b border-slate-100 dark:border-slate-700">
                            <th class="px-6 py-3">Course</th>
                            <th class="px-6 py-3">Status</th>
                            <th class="px-6 py-3">Fee</th>
                            <th class="px-6 py-3">Paid</th>
                            <th class="px-6 py-3">Balance</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100 dark:divide-slate-700">
                        @foreach (var reg in Model.Registrations)
                        {
                            <tr>
                                <td class="px-6 py-3 font-medium text-slate-800 dark:text-slate-100">@reg.CourseTitle</td>
                                <td class="px-6 py-3">
                                    <span class="inline-flex px-2.5 py-1 rounded-full text-xs font-medium @(reg.PaymentStatus == "Paid" ? "bg-emerald-50 dark:bg-emerald-950 text-emerald-600 dark:text-emerald-300" : reg.PaymentStatus == "PartiallyPaid" ? "bg-amber-50 dark:bg-amber-950 text-amber-600 dark:text-amber-300" : "bg-slate-100 dark:bg-slate-800 text-slate-500 dark:text-slate-400")">
                                        @reg.PaymentStatus
                                    </span>
                                </td>
                                @{
                                    var feeInstDiscount = Model.Installments.TryGetValue(reg.RegistrationID, out var feePlan) ? feePlan.Sum(i => i.DiscountAmount) : 0m;
                                }
                                <td class="px-6 py-3 text-slate-600 dark:text-slate-300">
                                    @if (reg.HasPersonalDiscount || feeInstDiscount > 0)
                                    {
                                        <span class="block text-xs line-through text-slate-400 dark:text-slate-500">@reg.CurrencyCode @((reg.FeeBeforePersonalDiscount + feeInstDiscount).ToString("N2"))</span>
                                    }
                                    @reg.CurrencyCode @reg.CourseFee.ToString("N2")
                                    @if (reg.HasPersonalDiscount)
                                    {
                                        <span class="block text-[11px] font-medium text-emerald-600 dark:text-emerald-300" title="@reg.PersonalDiscountReason">Personal discount &minus;@reg.PersonalDiscountAmount.ToString("N2")</span>
                                    }
                                    @if (feeInstDiscount > 0)
                                    {
                                        <span class="block text-[11px] font-medium text-emerald-600 dark:text-emerald-300">Installment discount &minus;@feeInstDiscount.ToString("N2")</span>
                                    }
                                </td>
                                <td class="px-6 py-3 text-slate-600 dark:text-slate-300">@reg.CurrencyCode @reg.AmountPaid.ToString("N2")</td>
                                <td class="px-6 py-3 text-slate-600 dark:text-slate-300">@reg.CurrencyCode @reg.BalanceDue.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
        </div>
    </div>
    }

    @* ---------- Pending Payments ---------- *@
    @* Nothing can be due without an enrolment, so this card only makes sense
       once the student has one. *@
    @if (Model.Registrations.Count > 0)
    {
    <div class="bg-white dark:bg-slate-900/60 rounded-[24px] shadow-sm border border-slate-100 dark:border-slate-700 overflow-hidden">
        <div class="p-6 border-b border-slate-100 dark:border-slate-700 flex items-center gap-3">
            <div class="bg-amber-50 dark:bg-amber-950 p-2 rounded-lg"><i data-lucide="wallet" class="w-5 h-5 text-amber-600 dark:text-amber-300"></i></div>
            <h3 class="font-semibold text-lg text-slate-800 dark:text-slate-100">Pending Payments</h3>
        </div>
        @{
            var pending = Model.Registrations.Where(r => r.BalanceDue > 0).ToList();
        }
        @if (pending.Count == 0)
        {
            <div class="p-10 text-center">
                <p class="text-sm text-slate-400 dark:text-slate-500">No pending payments — you're all caught up.</p>
            </div>
        }
        else
        {
            <div class="divide-y divide-slate-100 dark:divide-slate-700">
                @foreach (var reg in pending)
                {
                    var hasPlan = Model.Installments.TryGetValue(reg.RegistrationID, out var regPlan);
                    var planToday = Web_Backend.Classes.SriLankaTime.Today;
                    var duePlanItems = hasPlan ? regPlan!.Where(i => i.IsDueBy(planToday)).ToList() : new List<Web_Backend.Areas.Admin.Models.PaymentInstallment>();
                    var planDueNow = duePlanItems.Sum(i => i.Remaining);
                    var nextInst = hasPlan ? regPlan!.FirstOrDefault(i => i.Remaining > 0) : null;
                    <div class="p-4 px-6 flex items-center justify-between gap-4 flex-wrap">
                        <div class="min-w-0">
                            <div class="flex items-center gap-2 flex-wrap">
                                <p class="text-sm font-medium text-slate-800 dark:text-slate-100">@reg.CourseTitle</p>
                                @if (hasPlan)
                                {
                                    <span class="px-2 py-0.5 rounded-lg text-[11px] font-semibold bg-violet-50 dark:bg-violet-950 text-violet-700 dark:text-violet-300">Installment plan · @regPlan!.Count parts</span>
                                }
                                else
                                {
                                    <span class="px-2 py-0.5 rounded-lg text-[11px] font-semibold bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300">Full payment</span>
                                }
                            </div>
                            <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
                                @if (hasPlan)
                                {
                                    if (duePlanItems.Count > 0)
                                    {
                                        @string.Join(" + ", duePlanItems.Select(i => $"Installment {i.SeqNo} of {regPlan!.Count} · {(i.DueDate.Date < planToday ? "overdue since" : "due")} {i.DueDate:d MMM}"))
                                    }
                                    else if (nextInst != null)
                                    {
                                        @($"Nothing due this month · next is installment {nextInst.SeqNo} on {nextInst.DueDate:d MMM yyyy}")
                                    }
                                    <span> · total balance @reg.CurrencyCode @reg.BalanceDue.ToString("N2")</span>
                                }
                                else
                                {
                                    @("Whole remaining balance")
                                }
                                @if (reg.HasPersonalDiscount)
                                {
                                    <span class="text-emerald-600 dark:text-emerald-300"> · personal discount @reg.CurrencyCode @reg.PersonalDiscountAmount.ToString("N2")@(string.IsNullOrEmpty(reg.PersonalDiscountReason) ? "" : " (" + reg.PersonalDiscountReason + ")")</span>
                                }
                            </p>
                        </div>
                        <div class="flex items-center gap-3 flex-shrink-0">
                            <div class="text-right">
                                @if (hasPlan)
                                {
                                    <p class="text-sm font-semibold @(planDueNow > 0 ? "text-amber-600 dark:text-amber-300" : "text-slate-500 dark:text-slate-400")">
                                        @(planDueNow > 0 ? $"{reg.CurrencyCode} {planDueNow:N2}" : nextInst != null ? $"{reg.CurrencyCode} {nextInst.Remaining:N2}" : "")
                                    </p>
                                    <p class="text-[11px] text-slate-400 dark:text-slate-500">@(planDueNow > 0 ? "installment due now" : "next installment")</p>
                                }
                                else
                                {
                                    <p class="text-sm font-semibold text-amber-600 dark:text-amber-300">@reg.CurrencyCode @reg.BalanceDue.ToString("N2")</p>
                                    <p class="text-[11px] text-slate-400 dark:text-slate-500">full balance due</p>
                                }
                            </div>
                            <a asp-area="Student" asp-controller="Courses" asp-action="PayBalance" asp-route-registrationId="@reg.RegistrationID"
                               class="px-3 py-1.5 rounded-lg font-medium text-xs bg-[#7c3aed] text-white hover:bg-[#6d28d9] transition-all">
                                Pay Now
                            </a>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
    }

    <div class="flex justify-center pb-4">
        <a asp-area="Student" asp-controller="Enrollment" asp-action="Browse"
           class="px-6 py-3 rounded-xl font-medium text-sm bg-[#7c3aed] text-white hover:bg-[#6d28d9] shadow-sm transition-all flex items-center gap-2">
            <i data-lucide="plus" class="w-4 h-4"></i>
            @(Model.Registrations.Count == 0 ? "Enroll in a Course" : "Enroll in a New Course")
        </a>
    </div>
</div>

