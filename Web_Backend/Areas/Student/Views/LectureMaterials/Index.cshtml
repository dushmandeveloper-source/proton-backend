@model List<Web_Backend.Areas.Admin.Models.LectureMaterial>
@{
    ViewData["Title"] = "Lecture Materials";
    bool restricted = ViewBag.Restricted as bool? ?? false;
    bool hasLockedCourse = ViewBag.HasLockedCourse as bool? ?? false;
    var lockedCourseTitles = ViewBag.LockedCourseTitles as List<string> ?? new();
    var currentUser = ViewBag.CurrentUser as Web_Backend.Areas.Admin.Models.SessionUser;
}

<div class="max-w-4xl mx-auto space-y-6 page-enter">
    <div>
        <h2 class="text-2xl font-bold text-slate-800 dark:text-slate-100 tracking-tight">Lecture Materials</h2>
        <p class="text-slate-500 dark:text-slate-400 text-sm mt-1">Lecture notes and resources your lecturers have posted, across all your enrolled courses.</p>
    </div>

    @if (hasLockedCourse)
    {
        <div class="rounded-2xl border border-amber-100 dark:border-amber-900 bg-amber-50 dark:bg-amber-950/40 p-4 space-y-3">
            <div class="flex items-start gap-3">
                <i data-lucide="lock" class="w-5 h-5 text-amber-600 dark:text-amber-300 flex-shrink-0 mt-0.5"></i>
                <p class="text-sm text-amber-700 dark:text-amber-300">
                    Materials for the course(s) below are hidden because full access hasn't been granted yet.
                    <a asp-area="Student" asp-controller="Courses" asp-action="Index" class="font-medium underline">Pay the full course fee to unlock</a>, or request access from admin.
                </p>
            </div>
            <div class="flex flex-wrap gap-2 ml-8">
                @foreach (var courseTitle in lockedCourseTitles)
                {
                    <a href="@Web_Backend.Classes.WhatsAppLink.RequestAccess(currentUser?.Name ?? "", currentUser?.Email ?? "", courseTitle)" target="_blank" rel="noopener"
                       class="px-3 py-1.5 rounded-lg font-medium text-xs bg-emerald-50 dark:bg-emerald-950 text-emerald-700 dark:text-emerald-300 hover:bg-emerald-100 dark:hover:bg-emerald-900 transition-colors flex items-center gap-1.5">
                        <i data-lucide="message-circle" class="w-3.5 h-3.5"></i> Request access for @courseTitle
                    </a>
                }
            </div>
        </div>
    }

    <div class="bg-white dark:bg-slate-900/60 rounded-[24px] shadow-sm border border-slate-100 dark:border-slate-700 overflow-hidden">
        @if (restricted)
        {
            <div class="p-10 text-center">
                <p class="text-sm text-slate-400 dark:text-slate-500">Your account is still being verified. Lecture materials unlock once an administrator verifies your account.</p>
            </div>
        }
        else if (Model.Count == 0)
        {
            <div class="p-10 text-center">
                <p class="text-sm text-slate-400 dark:text-slate-500">No lecture materials have been shared for your courses yet.</p>
            </div>
        }
        else
        {
            <div class="divide-y divide-slate-100 dark:divide-slate-700">
                @foreach (var m in Model)
                {
                    <div class="p-4 px-6 flex items-center justify-between gap-4">
                        <div class="flex items-center gap-3 min-w-0">
                            <div class="p-2 rounded-lg bg-slate-50 dark:bg-slate-800 flex-shrink-0">
                                <i data-lucide="@(m.FileType == "Video" ? "video" : m.FileType == "Image" ? "image" : "file-text")" class="w-4 h-4 text-slate-500 dark:text-slate-400"></i>
                            </div>
                            <div class="min-w-0">
                                <div class="flex items-center gap-2 flex-wrap">
                                    <p class="text-sm font-medium text-slate-800 dark:text-slate-100 truncate">@m.Title</p>
                                    <span class="px-2 py-0.5 rounded-full text-xs font-medium bg-purple-50 dark:bg-purple-950 text-[#7c3aed] dark:text-purple-300 flex-shrink-0">
                                        Lecture Note
                                    </span>
                                </div>
                                <p class="text-xs text-slate-400 dark:text-slate-500 truncate">@m.CourseTitle &middot; @m.MaterialDate.ToString("MMM d, yyyy") &middot; @m.FileType</p>
                            </div>
                        </div>
                        <div class="flex items-center gap-2 flex-shrink-0">
                            @if (m.FileType == "Video")
                            {
                                <button type="button" onclick="openCourseVideoPreview('@m.FileURL')"
                                        class="px-3 py-1.5 rounded-lg font-medium text-xs bg-slate-50 dark:bg-slate-800 text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-700 transition-colors">
                                    Preview
                                </button>
                            }
                            else if (m.FileType == "Image" || m.FileURL.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase))
                            {
                                <button type="button" onclick="openMaterialPreview('@m.FileURL', '@m.FileType')"
                                        class="px-3 py-1.5 rounded-lg font-medium text-xs bg-slate-50 dark:bg-slate-800 text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-700 transition-colors">
                                    Preview
                                </button>
                            }
                            else
                            {
                                <span class="px-3 py-1.5 rounded-lg font-medium text-xs bg-slate-100 dark:bg-slate-800 text-slate-400 dark:text-slate-500 cursor-not-allowed"
                                      title="No preview available for this file type">
                                    No Preview
                                </span>
                            }
                            @if (m.AllowDownload)
                            {
                                <a href="@m.FileURL" download
                                   class="px-3 py-1.5 rounded-lg font-medium text-xs bg-[#7c3aed] text-white hover:bg-[#6d28d9] transition-colors">
                                    Download
                                </a>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

@await Html.PartialAsync("_CourseVideoPlayer")
@await Html.PartialAsync("_MaterialPreviewModal")
