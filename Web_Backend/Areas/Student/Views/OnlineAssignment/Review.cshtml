@using Web_Backend.Areas.Admin.Models
@model List<ExamAttemptAnswer>
@{
    var attempt = (ExamAttempt)ViewBag.Attempt;
    var exam = (Exam)ViewBag.Exam;
    var optionsByQuestion = ViewBag.OptionsByQuestion as Dictionary<string, List<ExamQuestionOption>> ?? new();
    var passed = attempt.Passed == true;
    var awarded = attempt.TotalMarksAwarded ?? 0;
    var pct = attempt.TotalMarks > 0 ? Math.Round(awarded / attempt.TotalMarks * 100) : 0;
    ViewBag.Title = "My answers - " + exam.ExamTitle;
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.18.4/dist/katex.min.css" integrity="sha384-u1zONI5gPXUx0UKI62c75/zww972y0v2rSK5ZYlVdS6xEuWDeZWUI66v6t1gvlXJ" crossorigin="anonymous">
<script defer src="https://cdn.jsdelivr.net/npm/katex@0.18.4/dist/katex.min.js" integrity="sha384-ykMNcWQhhTUb0YV9SPpPUFURHZ+tWmubkakGBP+OgNK/UXdO2gtzglWx0Rj9hnO3" crossorigin="anonymous"></script>
<script defer src="https://cdn.jsdelivr.net/npm/katex@0.18.4/dist/contrib/mhchem.min.js" integrity="sha384-fB8BH//9nBzROkMUsu/Dr35jWHIbnKesUo9rW0hfEgw8mZGnkAyBAjKX9F98OVuo" crossorigin="anonymous"></script>
<script defer src="~/js/exam-math.js" asp-append-version="true"></script>

<div class="max-w-3xl mx-auto space-y-5 page-enter pb-16">
    <a asp-controller="Classroom" asp-action="Batch" asp-route-id="@exam.AssignmentScheduleID" asp-route-module="@(string.IsNullOrEmpty(exam.AssignmentModuleID) ? "general" : exam.AssignmentModuleID)"
       class="text-xs text-slate-500 hover:text-[#7c3aed] inline-flex items-center gap-1">
        <i data-lucide="arrow-left" class="w-3.5 h-3.5"></i> Back to class
    </a>

    @* Summary *@
    <div class="bg-white dark:bg-slate-900/60 rounded-[24px] shadow-sm border border-slate-100 dark:border-slate-700 p-6 flex items-center gap-5 flex-wrap">
        <div class="w-20 h-20 rounded-full flex flex-col items-center justify-center flex-shrink-0 @(passed ? "bg-emerald-50 dark:bg-emerald-950 text-emerald-700 dark:text-emerald-300" : "bg-red-50 dark:bg-red-950 text-red-700 dark:text-red-300")">
            <span class="text-xl font-bold leading-none">@pct%</span>
            <span class="text-[11px] font-semibold mt-1">@(passed ? "Pass" : "Fail")</span>
        </div>
        <div class="min-w-0 flex-1">
            <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full text-[10px] font-semibold uppercase tracking-wide bg-purple-50 dark:bg-purple-950 text-[#7c3aed] dark:text-purple-300">
                <i data-lucide="notebook-pen" class="w-3 h-3"></i> Online assignment
            </span>
            <h1 class="text-xl font-bold text-slate-800 dark:text-slate-100 mt-1.5">@exam.ExamTitle</h1>
            <p class="text-sm text-slate-600 dark:text-slate-300 mt-0.5"><b>@awarded.ToString("0.##")</b> of @attempt.TotalMarks.ToString("0.##") marks</p>
            <p class="text-xs text-slate-400 mt-0.5">Released @attempt.ResultReleasedDate?.ToString("dd MMM yyyy, hh:mm tt")</p>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(attempt.TeacherReviewRemark))
    {
        <div class="rounded-[20px] border border-purple-100 dark:border-purple-900 bg-purple-50/60 dark:bg-purple-950/40 p-4 flex items-start gap-3">
            <i data-lucide="message-square-text" class="w-5 h-5 text-[#7c3aed] dark:text-purple-300 flex-shrink-0 mt-0.5"></i>
            <div><p class="text-xs font-semibold text-[#7c3aed] dark:text-purple-300">Lecturer's note</p><p class="text-sm text-slate-700 dark:text-slate-200 whitespace-pre-line">@attempt.TeacherReviewRemark</p></div>
        </div>
    }

    @for (var i = 0; i < Model.Count; i++)
    {
        var ans = Model[i];
        var full = ans.MarksAwarded.HasValue && ans.MarksAwarded >= ans.Marks;
        var none = !ans.MarksAwarded.HasValue || ans.MarksAwarded == 0;
        <div class="bg-white dark:bg-slate-900/60 rounded-[20px] shadow-sm border border-slate-100 dark:border-slate-700 p-6">
            <div class="flex items-center justify-between gap-2 mb-3">
                <span class="text-xs font-semibold text-slate-500 dark:text-slate-400">Question @(i + 1) of @Model.Count</span>
                <span class="px-2.5 py-1 rounded-full text-xs font-semibold @(full ? "bg-emerald-50 dark:bg-emerald-950 text-emerald-700 dark:text-emerald-300" : none ? "bg-red-50 dark:bg-red-950 text-red-700 dark:text-red-300" : "bg-amber-50 dark:bg-amber-950 text-amber-700 dark:text-amber-300")">
                    @((ans.MarksAwarded ?? 0).ToString("0.##")) / @ans.Marks.ToString("0.##") marks
                </span>
            </div>
            <div class="katex-render text-sm font-medium leading-relaxed text-slate-800 dark:text-slate-100 mb-4" data-latex="@ans.QuestionTextLatex">@ans.QuestionTextLatex</div>
            @if (!string.IsNullOrEmpty(ans.ImageURL))
            {
                <img src="@ans.ImageURL" alt="Question @(i + 1) figure" loading="lazy" decoding="async" class="block max-w-full sm:max-w-md h-auto mx-auto mb-4 rounded-xl border border-slate-100 dark:border-slate-700 bg-white p-2" />
            }

            @if (ans.IsMCQ)
            {
                <div class="-ml-10">
                    <partial name="~/Views/Shared/_McqAnswerReview.cshtml" model="ans"
                             view-data='new ViewDataDictionary(ViewData) { ["Options"] = optionsByQuestion.GetValueOrDefault(ans.QuestionID), ["AnswerLabel"] = "Your answer" }' />
                </div>
            }
            else
            {
                <div class="rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800/60 px-4 py-3">
                    <p class="text-xs text-slate-500 dark:text-slate-400 mb-1">Your answer</p>
                    <p class="text-sm text-slate-800 dark:text-slate-100 whitespace-pre-line">@(string.IsNullOrWhiteSpace(ans.WrittenAnswerText) ? "No answer" : ans.WrittenAnswerText)</p>
                </div>
            }
        </div>
    }
</div>
