@* Shown after Download: Android never installs an APK by itself, so walk
   the student through the three taps it does need. *@
<div id="app-install-guide" class="hidden fixed inset-0 z-[90] bg-black/50 backdrop-blur-sm items-end sm:items-center justify-center p-4">
    <div class="w-full max-w-sm max-h-[92vh] overflow-y-auto bg-white dark:bg-slate-800 rounded-3xl p-6 shadow-xl border border-white/60 dark:border-slate-700">
        <div class="flex items-center gap-3 mb-4">
            <div class="w-11 h-11 rounded-2xl bg-[#7c3aed]/10 text-[#5a43f1] dark:text-[#a78bfa] flex items-center justify-center">
                <i data-lucide="download" class="w-5 h-5"></i>
            </div>
            <div>
                <h3 class="font-semibold text-slate-900 dark:text-slate-100" id="app-dl-title">Downloading the app…</h3>
                <p class="text-xs text-slate-500 dark:text-slate-400">Then install it — steps below</p>
            </div>
        </div>
        <div id="app-dl-progress" class="mb-5">
            <div class="h-2.5 rounded-full bg-slate-100 dark:bg-slate-700 overflow-hidden">
                <div id="app-dl-bar" class="h-full w-0 rounded-full bg-gradient-to-r from-[#5a43f1] to-[#7c3aed] transition-[width] duration-200"></div>
            </div>
            <div class="mt-1.5 flex justify-between text-xs tabular-nums text-slate-500 dark:text-slate-400">
                <span id="app-dl-size">Starting…</span><span id="app-dl-pct" class="font-semibold text-[#5a43f1] dark:text-[#a78bfa]"></span>
            </div>
        </div>
        @{ const string StepNum = "w-6 h-6 rounded-full bg-[#7c3aed] text-white text-xs font-bold flex items-center justify-center flex-shrink-0"; }
        <ol class="space-y-4 text-sm text-slate-600 dark:text-slate-300">
            <li class="flex gap-3"><span class="@StepNum">1</span><span>When the download finishes, tap <b>Open</b> at the bottom of the screen (or tap the download in your notifications).</span></li>
            <li class="flex gap-3"><span class="@StepNum">2</span><span>If asked, allow Chrome to <b>install unknown apps</b> — only the first time — then go back.</span></li>
            <li class="flex gap-3"><span class="@StepNum">3</span><span>Tap <b>Install</b>.</span></li>
            <li class="flex gap-3">
                <span class="@StepNum">4</span>
                <div class="flex-1 min-w-0">
                    <p><b>Google Play Protect</b> may check the app. Tap <b class="text-[#5a43f1] dark:text-[#a78bfa]">Install without scanning</b> — it's Proton's own app, just not from the Play Store.</p>
                    @* Drawing of Android's Play Protect pop-up, the button to tap highlighted. *@
                    <div class="mt-2.5 rounded-2xl bg-slate-100 dark:bg-slate-900 p-3 border border-slate-200 dark:border-slate-700" aria-hidden="true">
                        <div class="flex items-center gap-2 mb-1.5">
                            <i data-lucide="shield-check" class="w-4 h-4 text-emerald-600"></i>
                            <span class="text-[11px] font-semibold text-slate-700 dark:text-slate-200">App scan recommended</span>
                        </div>
                        <p class="text-[10.5px] leading-snug text-slate-500 dark:text-slate-400 mb-2.5">Play Protect hasn't seen this app before…</p>
                        <div class="flex flex-col items-end gap-1.5 text-[11px] font-semibold">
                            <span class="text-slate-400 dark:text-slate-500 px-2">Scan app</span>
                            <span class="relative px-2.5 py-1 rounded-lg ring-2 ring-[#7c3aed] bg-[#7c3aed]/10 text-[#5a43f1] dark:text-[#c4b5fd]">
                                Install without scanning
                                <i data-lucide="pointer" class="absolute -right-2 -bottom-3 w-4 h-4 text-[#7c3aed] fill-white dark:fill-slate-900"></i>
                            </span>
                        </div>
                    </div>
                    <p class="mt-2 text-xs text-slate-500 dark:text-slate-400">If it says <b>blocked</b> instead: tap <b>More details</b> → <b>Install anyway</b>.</p>
                </div>
            </li>
            <li class="flex gap-3"><span class="@StepNum">5</span><span>Tap <b>Open</b> and sign in with your portal email and password.</span></li>
        </ol>
        <button type="button" id="app-install-guide-close"
                class="mt-6 w-full py-2.5 rounded-xl bg-[#7c3aed] text-white text-sm font-semibold hover:bg-[#6d28d9] transition-colors">Got it</button>
    </div>
</div>

<script>
    // ---------- Android app offer ----------
    // Android phones/tablets only. If Chrome reports the app is installed
    // (getInstalledRelatedApps, via /student-app.webmanifest + the app's
    // asset_statements) Download is disabled and "Open app" shows instead.
    (function () {
        if (!/Android/i.test(navigator.userAgent)) return;
        document.querySelectorAll('[data-app-hint]').forEach(el => el.classList.add('hidden'));
        const offers = document.querySelectorAll('[data-app-offer]');
        offers.forEach(el => { el.classList.remove('hidden'); if (el.tagName === 'BUTTON') el.classList.add('inline-flex'); });

        const guide = document.getElementById('app-install-guide');
        const showGuide = (on) => { guide.classList.toggle('hidden', !on); guide.classList.toggle('flex', on); };
        document.getElementById('app-install-guide-close').addEventListener('click', () => showGuide(false));
        guide.addEventListener('click', e => { if (e.target === guide) showGuide(false); });

        // Downloaded by the page (not a plain link) so it can show live
        // progress; the finished file is then handed to the browser to save,
        // which offers "Open" -> install. Falls back to a plain link on error.
        const apkUrl = '@Web_Backend.Controllers.StudentAppDownloadController.ApkRoute';
        const bar = document.getElementById('app-dl-bar'), size = document.getElementById('app-dl-size'),
              pct = document.getElementById('app-dl-pct'), title = document.getElementById('app-dl-title');
        const mb = n => (n / 1048576).toFixed(1);
        let downloading = false;

        async function download() {
            downloading = true;
            title.textContent = 'Downloading the app…';
            bar.style.width = '0'; pct.textContent = ''; size.textContent = 'Starting…';
            showGuide(true);
            try {
                const res = await fetch(apkUrl);
                if (!res.ok || !res.body) throw new Error(res.status);
                const total = +res.headers.get('Content-Length') || 0;
                const reader = res.body.getReader(), chunks = [];
                let got = 0;
                for (;;) {
                    const { done, value } = await reader.read();
                    if (done) break;
                    chunks.push(value); got += value.length;
                    size.textContent = total ? `${mb(got)} of ${mb(total)} MB` : `${mb(got)} MB`;
                    if (total) { const p = Math.round(got * 100 / total); bar.style.width = p + '%'; pct.textContent = p + '%'; }
                }
                const url = URL.createObjectURL(new Blob(chunks, { type: 'application/vnd.android.package-archive' }));
                const a = Object.assign(document.createElement('a'), { href: url, download: 'Proton Student.apk' });
                document.body.appendChild(a); a.click(); a.remove();
                setTimeout(() => URL.revokeObjectURL(url), 60000);
                bar.style.width = '100%'; pct.textContent = '100%';
                title.textContent = 'Downloaded — now install it';
            } catch {
                title.textContent = 'Downloading the app…';
                size.textContent = 'See your browser\'s download bar';
                window.location.href = apkUrl;
            } finally {
                downloading = false;
            }
        }

        document.querySelectorAll('[data-app-download]').forEach(btn => btn.addEventListener('click', () => {
            if (btn.disabled) return;
            if (downloading) { showGuide(true); return; }
            download();
        }));

        if (!navigator.getInstalledRelatedApps) return;
        navigator.getInstalledRelatedApps().then(apps => {
            if (!apps.some(a => a.id === '@Web_Backend.Controllers.StudentAppDownloadController.PackageId')) return;
            document.querySelectorAll('[data-app-download]').forEach(b => { b.disabled = true; b.title = 'The app is already installed'; });
            document.querySelectorAll('[data-app-download] span:not([data-app-label])').forEach(s => s.textContent = 'Installed');
            document.querySelectorAll('[data-app-label]').forEach(s => s.textContent = 'Installed');
            document.querySelectorAll('[data-app-status]').forEach(s => s.textContent = 'Installed on this device');
            document.querySelectorAll('[data-app-open]').forEach(a => {
                a.href = 'intent://open#Intent;scheme=protonstudent;package=@Web_Backend.Controllers.StudentAppDownloadController.PackageId;end';
                a.classList.remove('hidden');
            });
        }).catch(() => {});
    })();
</script>
}

@RenderSection("Scripts", required: false)

<script>
    // ---------- Mobile sidebar drawer ----------
    (function () {
        const sidebar = document.getElementById('sidebar');
        const backdrop = document.getElementById('sidebar-backdrop');
        if (!sidebar || !backdrop) return;

        function openSidebar() {
            sidebar.style.transform = 'translateX(0)';
            backdrop.classList.remove('hidden');
        }
        function closeSidebar() {
            sidebar.style.transform = '';
            backdrop.classList.add('hidden');
        }
        document.getElementById('sidebar-open')?.addEventListener('click', openSidebar);
        document.getElementById('sidebar-close')?.addEventListener('click', closeSidebar);
        backdrop.addEventListener('click', closeSidebar);
        document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeSidebar(); });
        window.addEventListener('resize', () => { if (window.innerWidth >= 768) closeSidebar(); });
    })();

    // ---------- Theme toggle ----------
    (function () {
        const root = document.documentElement;
        const lightIcon = document.getElementById('theme-icon-light');
        const darkIcon = document.getElementById('theme-icon-dark');
        function syncIcon() {
            const isDark = root.classList.contains('dark');
            if (lightIcon) lightIcon.classList.toggle('hidden', !isDark);
            if (darkIcon) darkIcon.classList.toggle('hidden', isDark);
        }
        syncIcon();
        document.getElementById('theme-toggle')?.addEventListener('click', () => {
            root.classList.toggle('dark');
            localStorage.setItem('theme', root.classList.contains('dark') ? 'dark' : 'light');
            syncIcon();
        });
    })();

    // ---------- Toasts ----------
    function showToast(message, type) {
        const container = document.getElementById('toast-container');
        if (!container || !message) return;
        const isError = type === 'error';
        const toast = document.createElement('div');
        toast.className = 'toast-in pointer-events-auto max-w-sm w-full rounded-xl shadow-lg border px-4 py-3 flex items-start gap-3 ' +
            (isError
                ? 'bg-red-50 dark:bg-red-950 border-red-100 dark:border-red-900 text-red-700 dark:text-red-300'
                : 'bg-emerald-50 dark:bg-emerald-950 border-emerald-100 dark:border-emerald-900 text-emerald-700 dark:text-emerald-300');
        toast.innerHTML =
            '<i data-lucide="' + (isError ? 'circle-x' : 'circle-check') + '" class="w-5 h-5 flex-shrink-0 mt-0.5"></i>' +
            '<span class="text-sm flex-1">' + message + '</span>' +
            '<button type="button" class="flex-shrink-0 opacity-60 hover:opacity-100" onclick="this.closest(\'div.toast-in\').remove()">' +
            '<i data-lucide="x" class="w-4 h-4"></i></button>';
        container.appendChild(toast);
        if (window.lucide) lucide.createIcons();
        setTimeout(() => toast.remove(), 6000);
    }

    @if (!string.IsNullOrEmpty(successMsg))
    {
        @Html.Raw($"showToast({System.Text.Json.JsonSerializer.Serialize(successMsg)}, 'success');")
    }
    @if (!string.IsNullOrEmpty(errorMsg))
    {
        @Html.Raw($"showToast({System.Text.Json.JsonSerializer.Serialize(errorMsg)}, 'error');")
    }

    if (window.lucide) { lucide.createIcons(); }
</script>

</body>
</html>
