                <i data-lucide="message-circle" class="w-5 h-5 @(activeController == "Messages" ? "text-[#5a43f1] dark:text-[#a78bfa]" : "text-slate-400 dark:text-slate-500 group-hover:text-slate-600 dark:group-hover:text-slate-300")"></i>
