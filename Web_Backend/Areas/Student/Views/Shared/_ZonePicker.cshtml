@* Compact "My time" button next to the clock: 🌐 (or the chosen country's flag) + ▾.
   A native <select> covers it invisibly, so tapping opens the full country list
   (keyboard and screen readers use the select directly). wwwroot/js/student-tz.js
   fills the list and keeps the button in sync; the choice stays until changed. *@
<label class="tz-button relative inline-flex items-center gap-1 h-7 pl-2 pr-1.5 rounded-full border border-slate-200/80 dark:border-slate-700 bg-white/80 dark:bg-slate-900/70 shadow-sm text-slate-600 dark:text-slate-300 hover:border-[#7c3aed]/50 hover:text-[#7c3aed] dark:hover:text-purple-300 transition-colors cursor-pointer focus-within:ring-2 focus-within:ring-[#7c3aed]/40"
       title="Show times in my country">
    <span data-tz-current class="text-sm leading-none" aria-hidden="true"></span>
    <i data-tz-globe data-lucide="globe" class="w-4 h-4" aria-hidden="true"></i>
    <i data-lucide="chevron-down" class="w-3 h-3 opacity-60" aria-hidden="true"></i>
    <select data-tz-picker aria-label="Show schedule times in my country's time zone"
            class="absolute inset-0 w-full h-full opacity-0 cursor-pointer">
        <option value="">China + Sri Lanka only</option>
    </select>
    @Html.AntiForgeryToken()
</label>
