@* "Show times in my country" picker (wwwroot/js/student-tz.js fills the list).
   The choice is saved to the student's account and kept until they change it. *@
<label class="inline-flex items-center gap-2 rounded-full border border-slate-200/80 dark:border-slate-700 bg-white/80 dark:bg-slate-900/70 shadow-sm pl-3 pr-1 py-0.5 text-xs font-medium text-slate-600 dark:text-slate-300 focus-within:ring-2 focus-within:ring-[#7c3aed]/40">
    <i data-lucide="globe" class="w-3.5 h-3.5 text-[#7c3aed] dark:text-purple-300" aria-hidden="true"></i>
    <span class="whitespace-nowrap">My time</span>
    <select data-tz-picker aria-label="Show schedule times in my country's time zone"
            class="max-w-[11rem] sm:max-w-[14rem] bg-transparent border-0 py-1 pl-1 pr-6 text-xs font-semibold text-slate-800 dark:text-slate-100 focus:ring-0 cursor-pointer">
        <option value="">🇨🇳 China + 🇱🇰 Sri Lanka only</option>
    </select>
    @Html.AntiForgeryToken()
</label>
