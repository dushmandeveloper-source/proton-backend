# Build results
bin/
obj/
out/

# Visual Studio / Rider / VS Code
.vs/
.vscode/*
!.vscode/extensions.json
.idea/
*.user
*.suo

# NuGet
*.nupkg
packages/

# npm (Web_Backend/package.json — Tailwind CLI build for the Admin views'
# compiled CSS, replacing the play-CDN script; see wwwroot/css/tailwind.css)
node_modules/

# OS
.DS_Store

# Local secrets / overrides — never commit real connection strings or keys
appsettings.*.local.json
appsettings.Development.json
appsettings.Production.json
publish/
DEPLOY_CREDENTIALS.md

# Generated at publish time (Database/tools) — a snapshot of pending
# migrations for whatever DB appsettings.Production.json points at, not source
Database/generated/

# User-uploaded files (student/profile photos, university images, etc.) —
# runtime data written by IImageUploader, not source. Each environment
# (local dev, hosted) accumulates its own independently.
Web_Backend/wwwroot/Uploads/

# Admin/Agent document library uploads (Classes/DocumentStorage.cs) — stored
# outside wwwroot on purpose (see 0063_agent_document_library.sql), but still
# runtime data, not source.
Web_Backend/PrivateStorage/

# Local dev server console output
Web_Backend/run_stdout.log
Web_Backend/run_stderr.log
